/* Windows application resources. The icon is embedded in the executable,
   not merely shown by the splash image at development time. Constants are
   inlined so brcc32 needs no SDK headers. */

MAINICON ICON "udaw.ico"
UDAW_SPLASH RCDATA "udaw-icon-image.png"
UDAW_HELP RCDATA "about-udaw.dat"
UDAW_LICENSE RCDATA "udaw-license.dat"

#define VOS__WINDOWS32 0x00000004L
#define VFT_APP        0x00000001L

1 VERSIONINFO
 FILEVERSION 1,0,0,682
 PRODUCTVERSION 1,0,0,682
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Ultimanium\0"
      VALUE "FileDescription",  "Ultimanium Digital Audio Workstation (UDAW)\0"
      VALUE "FileVersion",      "1.0.682\0"
      VALUE "InternalName",     "UDAW\0"
      VALUE "OriginalFilename", "UDAW.exe\0"
      VALUE "ProductName",      "Ultimanium Digital Audio Workstation (UDAW)\0"
      VALUE "ProductVersion",   "1.0.682\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
