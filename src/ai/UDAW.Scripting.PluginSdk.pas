    'PRESETS = {',
    '    #            carrier note oct chord bands attack release formant bright sib   voice level',
    '    "Classic Robot":   (0, 9, 3, 0, 20, 4.0, 45.0, 0.0, 3.0, 35, 0, 0.0),',
