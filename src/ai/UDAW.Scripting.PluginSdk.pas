    '        cv.text(6, 2, tag + " (%d ms)" % int(S / sr * 1000.0), "#8a93a3", 9, True)',
    '',
    '    def paint_gcurve(self, cv):',
    '        w, h = cv.width, cv.height',
    '        cv.gradient(0, 0, w, h, "#1d2027", "#12141a")',
