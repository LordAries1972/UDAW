function Join(const ALines: array of string): string;
var
  sb: TStringBuilder;
  s: string;
begin
  sb := TStringBuilder.Create;
  try
    for s in ALines do sb.Append(s).Append(#10);
    Result := sb.ToString;
  finally
    sb.Free;
  end;
end;

function PluginSdkSource: string;
begin
  Result := Join(SDK_LINES);
end;

