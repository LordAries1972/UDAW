    '        a_lp = 1.0 - math.exp(-2.0 * math.pi * min(p.tone, sr * 0.45) / sr)',
    '        a_att = 1.0 - math.exp(-1.0 / (0.001 * sr))                 # gate: 1 ms open',
    '        a_rel = 1.0 - math.exp(-1.0 / (0.080 * sr))                 # gate: 80 ms close',
    '        a_env = 1.0 - math.exp(-1.0 / (0.010 * sr))',
