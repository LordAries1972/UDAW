    '',
    '    # ---- custom drawing -------------------------------------------------------------------------',
    '    def paint_scope(self, cv):',
    '        """Left: the transfer curve for the current voicing; right: the last output block."""',
    '        w, h = cv.width, cv.height',
    '        cv.gradient(0, 0, w, h, "#1d2027", "#12141a")',
