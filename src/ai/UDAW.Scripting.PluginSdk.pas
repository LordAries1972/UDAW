    '            idx = (self._ppos + np.arange(m)) % self._plen',
    '            self._pbuf[idx] = mono',
    '            mono = self._pbuf[(self._ppos + np.arange(m) - pre) % self._plen]',
    '            self._ppos = (self._ppos + m) % self._plen',
