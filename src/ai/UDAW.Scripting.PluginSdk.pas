    '        mix = p.c_mix * 0.01',
    '        return x * (1.0 - 0.5 * mix) + (acc / voices) * mix',
    '',
    '    # -- reverb ----------------------------------------------------------------------------------',
    '    @staticmethod',
    '    def _comb(st, x, g, damp):',
    '        m = len(x)',
    '        D = st["D"]',
    '        buf = st["buf"]',
    '        idx = (st["pos"] + np.arange(m)) % D',
    '        d = buf[idx]',
    '        prev = np.empty(m)',
    '        prev[0] = st["last"]',
    '        prev[1:] = d[:-1]',
    '        df = d * (1.0 - damp) + prev * damp',
    '        st["last"] = d[-1]',
    '        buf[idx] = x + g * df',
    '        st["pos"] = (st["pos"] + m) % D',
    '        return df',
    '',
    '    @staticmethod',
    '    def _allpass(st, x):',
    '        m = len(x)',
    '        D = st["D"]',
    '        buf = st["buf"]',
    '        idx = (st["pos"] + np.arange(m)) % D',
    '        vd = buf[idx]',
    '        buf[idx] = x + 0.5 * vd',
    '        st["pos"] = (st["pos"] + m) % D',
