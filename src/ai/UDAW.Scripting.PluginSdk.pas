    'NOTES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]',
    'CARRIERS = ["Sawtooth", "Pulse", "Choir (detuned saws)", "Noise (whisper)"]',
