    '    # ---- audio ----------------------------------------------------------------------------------',
    '    def prepare(self, sample_rate, channels, max_frames):',
    '        sr = float(sample_rate)',
    '        self._sr = sr',
    '        # per-channel state, plain floats so the per-sample loop stays fast',
