  SDK_LINES: array[0..1755] of string = (
    '"""UDAW Python plug-in SDK  (requires Python 3.14 or newer, standard library only).',
    '',
    'A UDAW plug-in is an ordinary Python file that defines one class derived from',
    '``udaw_plugin.Plugin``.  UDAW runs it as an audio effect on any Timeline lane or',
    'Tracker channel, draws the window it describes with UDAW''s own controls, and keeps the',
    'plug-in''s settings inside the project.',
    '',
    'Minimal example::',
    '',
    '    import udaw_plugin as up',
    '',
    '    class Plugin(up.Plugin):',
    '        name = "Gain"',
    '',
    '        def setup(self):',
    '            self.add_param("gain", "Gain", min=-24, max=24, default=0, unit="dB")',
    '',
    '        def process(self, block):',
    '            g = up.db_to_lin(self.p.gain)',
    '            for ch in range(block.channels):',
    '                src, dst = block.inp[ch], block.out[ch]',
    '                for i in range(block.frames):',
    '                    dst[i] = src[i] * g',
    '',
    'Everything below the line "Public API" is what plug-in authors use.  The part after',
    '"Host runtime" is UDAW''s side of the conversation and should not be edited.',
    '',
    'This file is regenerated by UDAW whenever it starts; keep your own plug-ins in other files.',
    '"""',
    '',
    'import array',
    'import ast',
    'import builtins',
    'import io',
    'import json',
    'import math',
    'import os',
    'import struct',
    'import sys',
    'import threading',
    'import time',
    'import traceback',
    'import importlib.util',
    '',
    'try:                                    # optional: heavy plug-ins (vocoder, reverb) vectorise with it',
    '    import numpy as _np',
    'except Exception:                       # pragma: no cover',
    '    _np = None',
    '',
    'HAS_NUMPY = _np is not None',
    '',
    'SDK_VERSION = "1.3"',
    'MIN_PYTHON = (3, 14)',
    '',
    '# ---------------------------------------------------------------------------------------',
    '# Public API',
    '# ---------------------------------------------------------------------------------------',
    '',
    '__all__ = [',
    '    "Plugin", "Param", "Block", "UI", "Canvas", "SDK_VERSION", "HAS_NUMPY",',
    '    "db_to_lin", "lin_to_db", "clamp", "lerp", "midi_to_hz", "hz_to_midi",',
    '    "Biquad", "OnePole", "DCBlocker", "Smoother", "EnvelopeFollower", "DelayLine", "LFO",',
    '    "rgb", "tanh", "soft_clip",',
    ']',
    '',
    '',
    'def db_to_lin(db):',
    '    """Decibels -> linear gain (-120 dB and below is silence)."""',
    '    return 0.0 if db <= -120.0 else 10.0 ** (db / 20.0)',
    '',
    '',
    'def lin_to_db(lin):',
    '    """Linear gain -> decibels (floored at -120)."""',
    '    return -120.0 if lin <= 1e-6 else 20.0 * math.log10(lin)',
    '',
    '',
    'def clamp(x, lo, hi):',
    '    return lo if x < lo else hi if x > hi else x',
    '',
    '',
    'def lerp(a, b, t):',
    '    return a + (b - a) * t',
    '',
    '',
    'def midi_to_hz(note):',
    '    return 440.0 * 2.0 ** ((note - 69) / 12.0)',
    '',
    '',
    'def hz_to_midi(hz):',
    '    return 69.0 + 12.0 * math.log2(max(hz, 1e-9) / 440.0)',
    '',
    '',
    'def rgb(r, g, b):',
    '    """0-255 channels -> "#rrggbb" (every colour argument also accepts a (r, g, b) tuple)."""',
    '    return "#%02x%02x%02x" % (int(clamp(r, 0, 255)), int(clamp(g, 0, 255)), int(clamp(b, 0, 255)))',
    '',
    '',
    'tanh = math.tanh',
    '',
    '',
    'def soft_clip(x):',
    '    """Cheap smooth limiter, |result| < 1 (x / (1 + |x|)); faster than tanh in pure Python."""',
    '    return x / (1.0 + (x if x >= 0.0 else -x))',
    '',
    '',
    '# ---- DSP building blocks (pure Python, per-sample) --------------------------------------',
    '',
    'class Biquad:',
    '    """RBJ biquad.  ``Biquad("lowpass", sr, 1000, 0.707)`` then ``y = f.tick(x)``.',
    '',
    '    Kinds: lowpass, highpass, bandpass, notch, peak, lowshelf, highshelf, allpass.',
    '    ``gain_db`` is used by peak / shelves."""',
    '',
    '    def __init__(self, kind="lowpass", sample_rate=48000.0, freq=1000.0, q=0.7071, gain_db=0.0):',
    '        self.kind, self.sr = kind, float(sample_rate)',
    '        self.z1 = self.z2 = 0.0',
    '        self.set(freq, q, gain_db)',
    '',
    '    def set(self, freq, q=0.7071, gain_db=0.0, kind=None):',
    '        if kind:',
    '            self.kind = kind',
    '        freq = clamp(freq, 10.0, self.sr * 0.49)',
    '        q = max(q, 0.05)',
    '        w0 = 2.0 * math.pi * freq / self.sr',
    '        cw, sw = math.cos(w0), math.sin(w0)',
    '        alpha = sw / (2.0 * q)',
    '        a = 10.0 ** (gain_db / 40.0)',
    '        k = self.kind',
    '        if k == "lowpass":',
    '            b0, b1, b2 = (1 - cw) / 2, 1 - cw, (1 - cw) / 2',
    '            a0, a1, a2 = 1 + alpha, -2 * cw, 1 - alpha',
    '        elif k == "highpass":',
    '            b0, b1, b2 = (1 + cw) / 2, -(1 + cw), (1 + cw) / 2',
    '            a0, a1, a2 = 1 + alpha, -2 * cw, 1 - alpha',
    '        elif k == "bandpass":',
    '            b0, b1, b2 = alpha, 0.0, -alpha',
    '            a0, a1, a2 = 1 + alpha, -2 * cw, 1 - alpha',
    '        elif k == "notch":',
    '            b0, b1, b2 = 1.0, -2 * cw, 1.0',
    '            a0, a1, a2 = 1 + alpha, -2 * cw, 1 - alpha',
    '        elif k == "peak":',
    '            b0, b1, b2 = 1 + alpha * a, -2 * cw, 1 - alpha * a',
    '            a0, a1, a2 = 1 + alpha / a, -2 * cw, 1 - alpha / a',
    '        elif k == "allpass":',
    '            b0, b1, b2 = 1 - alpha, -2 * cw, 1 + alpha',
    '            a0, a1, a2 = 1 + alpha, -2 * cw, 1 - alpha',
    '        elif k in ("lowshelf", "highshelf"):',
    '            sq = 2.0 * math.sqrt(a) * alpha',
    '            if k == "lowshelf":',
    '                b0 = a * ((a + 1) - (a - 1) * cw + sq)',
    '                b1 = 2 * a * ((a - 1) - (a + 1) * cw)',
    '                b2 = a * ((a + 1) - (a - 1) * cw - sq)',
    '                a0 = (a + 1) + (a - 1) * cw + sq',
    '                a1 = -2 * ((a - 1) + (a + 1) * cw)',
    '                a2 = (a + 1) + (a - 1) * cw - sq',
    '            else:',
    '                b0 = a * ((a + 1) + (a - 1) * cw + sq)',
    '                b1 = -2 * a * ((a - 1) + (a + 1) * cw)',
    '                b2 = a * ((a + 1) + (a - 1) * cw - sq)',
    '                a0 = (a + 1) - (a - 1) * cw + sq',
    '                a1 = 2 * ((a - 1) - (a + 1) * cw)',
    '                a2 = (a + 1) - (a - 1) * cw - sq',
    '        else:',
    '            raise ValueError("unknown biquad kind: " + str(k))',
    '        self.b0, self.b1, self.b2 = b0 / a0, b1 / a0, b2 / a0',
    '        self.a1, self.a2 = a1 / a0, a2 / a0',
    '',
    '    def tick(self, x):',
    '        y = self.b0 * x + self.z1',
    '        self.z1 = self.b1 * x - self.a1 * y + self.z2',
    '        self.z2 = self.b2 * x - self.a2 * y',
    '        return y',
    '',
    '    def reset(self):',
    '        self.z1 = self.z2 = 0.0',
    '',
    '',
    'class OnePole:',
    '    """One-pole filter: ``OnePole(sr, freq, "lowpass"|"highpass")``; ``y = f.tick(x)``."""',
    '',
    '    def __init__(self, sample_rate=48000.0, freq=1000.0, kind="lowpass"):',
    '        self.sr, self.kind, self.z = float(sample_rate), kind, 0.0',
    '        self.set(freq)',
    '',
    '    def set(self, freq):',
    '        self.a = 1.0 - math.exp(-2.0 * math.pi * clamp(freq, 1.0, self.sr * 0.49) / self.sr)',
    '',
    '    def tick(self, x):',
    '        self.z += self.a * (x - self.z)',
    '        return self.z if self.kind == "lowpass" else x - self.z',
    '',
    '    def reset(self):',
    '        self.z = 0.0',
    '',
    '',
    'class DCBlocker:',
    '    """Removes DC offset (asymmetric distortion creates plenty)."""',
    '',
    '    def __init__(self, sample_rate=48000.0, freq=15.0):',
    '        self.r = 1.0 - 2.0 * math.pi * freq / float(sample_rate)',
    '        self.x1 = self.y1 = 0.0',
    '',
    '    def tick(self, x):',
    '        y = x - self.x1 + self.r * self.y1',
    '        self.x1, self.y1 = x, y',
    '        return y',
    '',
    '    def reset(self):',
    '        self.x1 = self.y1 = 0.0',
    '',
    '',
    'class Smoother:',
    '    """Glides a value to its target to avoid zipper noise: ``s.target = v`` ... ``s.tick()``."""',
    '',
    '    def __init__(self, value=0.0, sample_rate=48000.0, ms=15.0):',
    '        self.value = self.target = float(value)',
    '        self.set_time(sample_rate, ms)',
    '',
    '    def set_time(self, sample_rate, ms):',
    '        self.coef = 1.0 - math.exp(-1.0 / max(1.0, 0.001 * ms * sample_rate))',
    '',
    '    def tick(self):',
    '        self.value += self.coef * (self.target - self.value)',
    '        return self.value',
    '',
    '    def jump(self, v):',
    '        self.value = self.target = float(v)',
    '',
    '',
    'class EnvelopeFollower:',
    '    """Peak envelope with separate attack / release (milliseconds)."""',
    '',
    '    def __init__(self, sample_rate=48000.0, attack_ms=5.0, release_ms=120.0):',
    '        self.sr, self.env = float(sample_rate), 0.0',
    '        self.set(attack_ms, release_ms)',
    '',
    '    def set(self, attack_ms, release_ms):',
    '        self.ca = math.exp(-1.0 / max(1.0, 0.001 * attack_ms * self.sr))',
    '        self.cr = math.exp(-1.0 / max(1.0, 0.001 * release_ms * self.sr))',
    '',
    '    def tick(self, x):',
    '        x = -x if x < 0 else x',
    '        c = self.ca if x > self.env else self.cr',
    '        self.env = c * self.env + (1.0 - c) * x',
    '        return self.env',
    '',
    '',
    'class DelayLine:',
    '    """Circular delay with linear interpolation: ``d.write(x)`` then ``d.read(samples)``."""',
    '',
    '    def __init__(self, max_samples):',
    '        self.n = int(max_samples) + 2',
    '        self.buf = [0.0] * self.n',
    '        self.pos = 0',
    '',
    '    def write(self, x):',
    '        self.buf[self.pos] = x',
    '        self.pos = (self.pos + 1) % self.n',
    '',
    '    def read(self, delay):',
    '        d = clamp(delay, 0.0, self.n - 2)',
    '        i = int(d)',
    '        f = d - i',
    '        a = self.buf[(self.pos - 1 - i) % self.n]',
    '        b = self.buf[(self.pos - 2 - i) % self.n]',
    '        return a + (b - a) * f',
    '',
    '',
    'class LFO:',
    '    """Sine / triangle / saw / square LFO: ``LFO(sr, hz, "sine")``; ``v = l.tick()`` is -1..1."""',
    '',
    '    def __init__(self, sample_rate=48000.0, freq=1.0, shape="sine"):',
    '        self.sr, self.freq, self.shape, self.ph = float(sample_rate), freq, shape, 0.0',
    '',
    '    def tick(self):',
    '        p = self.ph',
    '        self.ph = (p + self.freq / self.sr) % 1.0',
    '        s = self.shape',
    '        if s == "sine":',
    '            return math.sin(2.0 * math.pi * p)',
    '        if s == "triangle":',
    '            return 4.0 * abs(p - 0.5) - 1.0',
    '        if s == "saw":',
    '            return 2.0 * p - 1.0',
    '        return 1.0 if p < 0.5 else -1.0',
    '',
    '',
    '# ---- parameters -------------------------------------------------------------------------',
    '',
    'class Param:',
    '    """One automatable setting.  kind: "float" (default), "int", "bool" or "choice"."""',
    '',
    '    def __init__(self, pid, name, min=0.0, max=1.0, default=0.0, unit="", kind="float",',
    '                 choices=None, log=False, step=0.0, decimals=None, group=""):',
    '        self.id, self.name, self.unit, self.group = str(pid), str(name), str(unit), str(group)',
    '        self.kind = kind',
    '        self.choices = list(choices) if choices else []',
    '        if kind == "choice":',
    '            min, max = 0, builtins.max(0, len(self.choices) - 1)',
    '        elif kind == "bool":',
    '            min, max = 0, 1',
    '        self.min, self.max, self.default = float(min), float(max), float(default)',
    '        self.log, self.step = bool(log), float(step)',
    '        self.decimals = decimals if decimals is not None else (0 if kind in ("int", "bool", "choice") else 2)',
    '        self.value = self.default',
    '',
    '    def to_norm(self, v):',
    '        """0..1 position of ``v`` in the range (logarithmic for ``log`` parameters)."""',
    '        lo, hi = self.min, self.max',
    '        if hi <= lo:',
    '            return 0.0',
    '        if self.log and lo > 0:',
    '            n = (math.log(builtins.max(float(v), lo)) - math.log(lo)) / (math.log(hi) - math.log(lo))',
    '        else:',
    '            n = (float(v) - lo) / (hi - lo)',
    '        return clamp(n, 0.0, 1.0)',
    '',
    '    def from_norm(self, n):',
    '        """The value at 0..1 position ``n`` (inverse of ``to_norm``), snapped like ``clamp``."""',
    '        n = clamp(float(n), 0.0, 1.0)',
    '        lo, hi = self.min, self.max',
    '        v = lo * (hi / lo) ** n if (self.log and lo > 0) else lo + n * (hi - lo)',
    '        return self.clamp(v)',
    '',
    '    def clamp(self, v):',
    '        v = float(v)',
    '        if v != v:                      # NaN',
    '            v = self.default',
    '        v = clamp(v, self.min, self.max)',
    '        if self.kind in ("int", "bool", "choice"):',
    '            v = float(round(v))',
    '        elif self.step > 0:',
    '            v = self.min + round((v - self.min) / self.step) * self.step',
    '        return v',
    '',
    '    def describe(self):',
    '        return {"id": self.id, "name": self.name, "min": self.min, "max": self.max,',
    '                "default": self.default, "value": self.value, "unit": self.unit,',
    '                "kind": self.kind, "choices": self.choices, "log": self.log,',
    '                "step": self.step, "decimals": self.decimals, "group": self.group}',
    '',
    '',
    'class _Params:',
    '    """``self.p.drive`` / ``self.p["drive"]`` -> current value (bool params give a bool,',
    '    choice params the chosen index)."""',
    '',
    '    def __init__(self):',
    '        object.__setattr__(self, "_d", {})',
    '',
    '    def _add(self, prm):',
    '        self._d[prm.id] = prm',
    '',
    '    def __getattr__(self, k):',
    '        try:',
    '            prm = self._d[k]',
    '        except KeyError:',
    '            raise AttributeError("no parameter named %r (declared: %s)" % (k, ", ".join(self._d))) from None',
    '        return bool(prm.value) if prm.kind == "bool" else (int(prm.value) if prm.kind in ("int", "choice") else prm.value)',
    '',
    '    __getitem__ = __getattr__',
    '',
    '    def __iter__(self):',
    '        return iter(self._d.values())',
    '',
    '',
    '# ---- audio block ------------------------------------------------------------------------',
    '',
    'class Block:',
    '    """One buffer of audio.',
    '',
    '    ``inp[ch]`` and ``out[ch]`` are ``array.array(''f'')`` (or numpy float32 arrays when the',
    '    plug-in sets ``use_numpy = True`` and numpy is installed), ``frames`` long.  ``out``',
    '    starts as a copy of ``inp``, so a plug-in that does not write a channel passes it',
    '    through unchanged."""',
    '',
    '    __slots__ = ("frames", "channels", "sample_rate", "inp", "out", "position")',
    '',
    '    def __init__(self, frames, channels, sample_rate, inp, out, position):',
    '        self.frames, self.channels, self.sample_rate = frames, channels, sample_rate',
    '        self.inp, self.out, self.position = inp, out, position',
    '',
    '    def peak(self, ch=None):',
    '        """Largest absolute input sample (all channels, or just ``ch``)."""',
    '        chans = range(self.channels) if ch is None else (ch,)',
    '        m = 0.0',
    '        for c in chans:',
    '            for v in self.inp[c]:',
    '                v = -v if v < 0 else v',
    '                if v > m:',
    '                    m = v',
    '        return m',
    '',
    '    def copy_through(self):',
    '        for c in range(self.channels):',
    '            self.out[c][:] = self.inp[c]',
    '',
    '',
    '# ---- canvas (custom drawing) -----------------------------------------------------------',
    '',
    'def _script_line():',
    '    """Line of the plug-in script that is creating a control (for validation messages)."""',
    '    f = sys._getframe(1)',
    '    me = f.f_code.co_filename',
    '    while f is not None and f.f_code.co_filename == me:',
    '        f = f.f_back',
    '    return f.f_lineno if f is not None else 0',
    '',
    '',
    'def _col(c):',
    '    if c is None:',
    '        return None',
    '    if isinstance(c, (tuple, list)):',
    '        return rgb(*c[:3])',
    '    return str(c)',
    '',
    '',
    'class Canvas:',
    '    """Draw commands for a ``ui.canvas(...)`` control, recorded by ``paint`` and replayed by',
    '    UDAW on its OpenGL canvas.  Origin top-left, pixels, colours "#rrggbb" or (r, g, b).',
    '',
    '    Every call is cheap; UDAW asks for a fresh picture about 30 times a second while the',
    '    window is open and the control is visible."""',
    '',
    '    def __init__(self, width, height):',
    '        self.width, self.height = int(width), int(height)',
    '        self.cmds = []',
    '',
    '    # state ---------------------------------------------------------------------------',
    '    def alpha(self, a):',
    '        """Opacity 0..1 for everything drawn after this call."""',
    '        self.cmds.append(["alpha", float(a)])',
    '',
    '    def push_clip(self, x, y, w, h):',
    '        self.cmds.append(["clip", int(x), int(y), int(w), int(h)])',
    '',
    '    def pop_clip(self):',
    '        self.cmds.append(["unclip"])',
    '',
    '    # fills & shapes ---------------------------------------------------------------------',
    '    def clear(self, color):',
    '        self.fill_rect(0, 0, self.width, self.height, color)',
    '',
    '    def fill_rect(self, x, y, w, h, color):',
    '        self.cmds.append(["fr", int(x), int(y), int(w), int(h), _col(color)])',
    '',
    '    def rect(self, x, y, w, h, color, width=1):',
    '        self.cmds.append(["sr", int(x), int(y), int(w), int(h), _col(color), int(width)])',
    '',
    '    def round_rect(self, x, y, w, h, radius, fill=None, stroke=None, width=1):',
    '        self.cmds.append(["rr", int(x), int(y), int(w), int(h), int(radius), _col(fill), _col(stroke), int(width)])',
    '',
    '    def ellipse(self, x, y, w, h, fill=None, stroke=None, width=1):',
    '        self.cmds.append(["el", int(x), int(y), int(w), int(h), _col(fill), _col(stroke), int(width)])',
    '',
    '    def circle(self, cx, cy, r, fill=None, stroke=None, width=1):',
    '        self.ellipse(cx - r, cy - r, 2 * r, 2 * r, fill, stroke, width)',
    '',
    '    def line(self, x1, y1, x2, y2, color, width=1, dashed=False):',
    '        self.cmds.append(["ln", float(x1), float(y1), float(x2), float(y2), _col(color), int(width), bool(dashed)])',
    '',
    '    def polyline(self, points, color, width=1):',
    '        self.cmds.append(["pl", [[round(float(x), 2), round(float(y), 2)] for x, y in points], _col(color), int(width)])',
    '',
    '    def polygon(self, points, fill=None, stroke=None, width=1):',
    '        self.cmds.append(["pg", [[round(float(x), 2), round(float(y), 2)] for x, y in points],',
    '                          _col(fill), _col(stroke), int(width)])',
    '',
    '    def arc(self, cx, cy, r, start_deg, end_deg, color, width=1, steps=48):',
    '        """Arc from start to end degrees (0 = right, clockwise on screen)."""',
    '        pts = []',
    '        for i in range(steps + 1):',
    '            a = math.radians(start_deg + (end_deg - start_deg) * i / steps)',
    '            pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))',
    '        self.polyline(pts, color, width)',
    '',
    '    def gradient(self, x, y, w, h, top, bottom, horizontal=False):',
    '        self.cmds.append(["gr", int(x), int(y), int(w), int(h), _col(top), _col(bottom), bool(horizontal)])',
    '',
    '    def plot(self, ys, x=0, y=0, w=None, h=None, lo=-1.0, hi=1.0, color="#6fe0a0", width=1):',
    '        """Plots a list of values as a line scaled into a box (waveforms, curves, spectra)."""',
    '        w = self.width if w is None else w',
    '        h = self.height if h is None else h',
    '        n = len(ys)',
    '        if n < 2:',
    '            return',
    '        span = (hi - lo) or 1.0',
    '        pts = [(x + w * i / (n - 1), y + h - h * (clamp(v, lo, hi) - lo) / span) for i, v in enumerate(ys)]',
    '        self.polyline(pts, color, width)',
    '',
    '    def grid(self, x, y, w, h, cols, rows, color="#2a2f38"):',
    '        for i in range(cols + 1):',
    '            xx = x + w * i / cols',
    '            self.line(xx, y, xx, y + h, color)',
    '        for j in range(rows + 1):',
    '            yy = y + h * j / rows',
    '            self.line(x, yy, x + w, yy, color)',
    '',
    '    # text -------------------------------------------------------------------------------',
    '    def text(self, x, y, s, color="#dddddd", size=12, bold=False, align="left", width=0):',
    '        """``align`` "left" | "center" | "right" within a box ``width`` px wide starting at x',
    '        (width 0: x is the anchor)."""',
    '        self.cmds.append(["tx", int(x), int(y), str(s), _col(color), int(size), bool(bold), align, int(width)])',
    '',
    '    def text_width(self, s, size=12):',
    '        """Rough text width in pixels (UDAW centres/right-aligns exactly when drawing)."""',
    '        return int(len(str(s)) * size * 0.56)',
    '',
    '',
    '# ---- user interface builder ---------------------------------------------------------------',
    '',
    'class UI:',
    '    """Describes the plug-in window.  Called once from ``Plugin.ui(self, ui)``.',
    '',
    '    Every method takes the control''s *id* first, then position and size in pixels',
    '    (``x, y, w, h``) relative to its ``parent`` (the window by default).  A control bound',
    '    with ``param="id"`` follows that parameter in both directions, picks up its range,',
    '    default, logarithmic scale and unit, takes part in automation and is saved with the',
    '    project.  Extra keyword arguments are passed straight to the control''s property of the',
    '    same name (``Decimals=1``, ``font_size=14`` ...), so every property of UDAW''s controls',
    '    is reachable.',
    '',
    '    Control types',
    '    -------------',
    '    label, button, check, knob, slider, eq_slider, meter, progress, combo, list, edit, memo,',
    '    group, panel, recess, collapse, tabs (pages; parent "id#n"), tab_strip, scroll_bar,',
    '    scroll_box, list_view, tree, bevel, shine, splitter, status, canvas (your own drawing).',
    '    """',
    '',
    '    #: a control that lies wholly on one of these becomes its child (see ``add``)',
    '    _FRAMES = ("group", "panel", "recess")',
    '',
    '    def __init__(self, params):',
    '        self._params = params',
    '        self.controls = []',
    '        self.win = {"width": 480, "height": 320, "title": "", "color": None}',
    '        self._ids = set()',
    '        self._frames = []        # (id, parent, x, y, w, h) of the frames placed so far, as the script gave them',
    '',
    '    # window ------------------------------------------------------------------------------',
    '    def window(self, width=480, height=320, title="", color=None):',
    '        self.win = {"width": int(width), "height": int(height), "title": str(title), "color": _col(color)}',
    '',
    '    # generic ----------------------------------------------------------------------------',
    '    def add(self, ctype, cid, x=0, y=0, w=None, h=None, parent=None, **kw):',
    '        """Adds any control by type name; the typed helpers below call this."""',
    '        ctl = {"type": ctype, "id": str(cid), "x": int(x), "y": int(y), "parent": parent or "",',
    '               "line": _script_line()}',
    '        if w is not None:',
    '            ctl["w"] = int(w)',
    '        if h is not None:',
    '            ctl["h"] = int(h)',
    '        for k in ("param", "label"):',
    '            if kw.get(k) is not None:',
    '                ctl[k] = kw.pop(k)',
    '            else:',
    '                kw.pop(k, None)',
    '        for k in list(kw):',
    '            v = kw[k]',
    '            if k.lower() in ("color", "font_color", "head_color", "corner_color") and v is not None:',
    '                kw[k] = _col(v)',
    '        ctl["props"] = kw',
    '        # A control placed wholly on a group / panel belongs to it: it is created inside the frame, so it',
    '        # takes the frame''s background instead of painting the page colour over it, and it moves and',
    '        # scales with the frame.  Coordinates stay as written in the script (relative to the frame''s parent).',
    '        if w is not None and h is not None:',
    '            rect = (int(x), int(y), int(w), int(h))',
    '            for fid, fpar, fx, fy, fw, fh in reversed(self._frames):',
    '                if fpar == (parent or "") and fid != str(cid) and \',
    '                        rect[0] >= fx and rect[1] >= fy and rect[0] + rect[2] <= fx + fw and rect[1] + rect[3] <= fy + fh:',
    '                    ctl["parent"] = fid',
    '                    ctl["x"], ctl["y"] = rect[0] - fx, rect[1] - fy',
    '                    break',
    '            if ctype in self._FRAMES:',
    '                self._frames.append((str(cid), parent or "", rect[0], rect[1], rect[2], rect[3]))',
    '        self.controls.append(ctl)',
    '        return str(cid)',
    '',
    '    def label(self, cid, text, x, y, w=None, h=None, **kw):',
    '        return self.add("label", cid, x, y, w, h, caption=text, **kw)',
    '',
    '    def button(self, cid, text, x, y, w=80, h=26, toggle=False, param=None, **kw):',
    '        return self.add("button", cid, x, y, w, h, caption=text, toggle=toggle, param=param, **kw)',
    '',
    '    def icon_button(self, cid, icon, x, y, w=28, h=26, toggle=False, param=None, **kw):',
    '        """A button showing a drawn icon instead of a caption.  ``icon``: "save" (a disk) or',
    '        "delete" (a bin).  Give it a ``hint=`` so people learn what it does."""',
    '        return self.add("button", cid, x, y, w, h, caption="", toggle=toggle, param=param,',
    '                        icon="bi" + str(icon).capitalize(), **kw)',
    '',
    '    def check(self, cid, text, x, y, w=120, h=22, param=None, **kw):',
    '        return self.add("check", cid, x, y, w, h, caption=text, param=param, **kw)',
    '',
    '    def knob(self, cid, x, y, w=64, h=84, param=None, label=None, **kw):',
    '        return self.add("knob", cid, x, y, w, h, param=param, caption=label if label is not None else "", **kw)',
    '',
    '    def slider(self, cid, x, y, w=160, h=28, param=None, vertical=False, **kw):',
    '        return self.add("slider", cid, x, y, w, h, param=param, vertical=vertical, **kw)',
    '',
    '    def eq_slider(self, cid, x, y, w=28, h=160, param=None, **kw):',
    '        return self.add("eq_slider", cid, x, y, w, h, param=param, **kw)',
    '',
    '    def meter(self, cid, x, y, w=12, h=100, vertical=True, min=0.0, max=1.0, **kw):',
    '        """Level bar; drive it with ``self.ui_set(cid, value=level)``."""',
    '        return self.add("meter", cid, x, y, w, h, vertical=vertical, min=min, max=max, **kw)',
    '',
    '    progress = meter',
    '',
    '    def combo(self, cid, items, x, y, w=140, h=24, param=None, **kw):',
    '        return self.add("combo", cid, x, y, w, h, param=param, items=list(items), **kw)',
    '',
    '    def list(self, cid, items, x, y, w=160, h=120, **kw):',
    '        return self.add("list", cid, x, y, w, h, items=list(items), **kw)',
    '',
    '    def edit(self, cid, text, x, y, w=140, h=24, **kw):',
    '        return self.add("edit", cid, x, y, w, h, text=text, **kw)',
    '',
    '    def memo(self, cid, text, x, y, w=240, h=120, read_only=True, **kw):',
    '        return self.add("memo", cid, x, y, w, h, text=text, read_only=read_only, **kw)',
    '',
    '    def group(self, cid, title, x, y, w, h, parent=None, **kw):',
    '        return self.add("group", cid, x, y, w, h, parent, caption=title, **kw)',
    '',
    '    def panel(self, cid, x, y, w, h, parent=None, title="", **kw):',
    '        return self.add("panel", cid, x, y, w, h, parent, caption=title, **kw)',
    '',
    '    def recess(self, cid, x, y, w, h, parent=None, **kw):',
    '        return self.add("recess", cid, x, y, w, h, parent, **kw)',
    '',
    '    def collapse(self, cid, title, x, y, w, h, parent=None, **kw):',
    '        return self.add("collapse", cid, x, y, w, h, parent, title=title, **kw)',
    '',
    '    def tabs(self, cid, pages, x, y, w, h, parent=None, **kw):',
    '        """Page control.  Put children on page n with ``parent="<cid>#n"``."""',
    '        return self.add("tabs", cid, x, y, w, h, parent, pages=list(pages), **kw)',
    '',
    '    def tab_strip(self, cid, tabs, x, y, w=300, h=28, **kw):',
    '        return self.add("tab_strip", cid, x, y, w, h, tabs=list(tabs), **kw)',
    '',
    '    def scroll_bar(self, cid, x, y, w=160, h=18, vertical=False, **kw):',
    '        return self.add("scroll_bar", cid, x, y, w, h, vertical=vertical, **kw)',
    '',
    '    def scroll_box(self, cid, x, y, w, h, parent=None, **kw):',
    '        return self.add("scroll_box", cid, x, y, w, h, parent, **kw)',
    '',
    '    def list_view(self, cid, columns, rows, x, y, w=300, h=140, **kw):',
    '        """``columns`` = [("Name", 120), ...], ``rows`` = [["a", "b"], ...]."""',
    '        return self.add("list_view", cid, x, y, w, h, columns=[list(c) for c in columns],',
    '                        rows=[list(r) for r in rows], **kw)',
    '',
    '    def tree(self, cid, nodes, x, y, w=200, h=140, **kw):',
    '        """``nodes`` = ["leaf", ("parent", ["child", ...]), ...]."""',
    '        return self.add("tree", cid, x, y, w, h, nodes=nodes, **kw)',
    '',
    '    def bevel(self, cid, x, y, w, h, parent=None, **kw):',
    '        return self.add("bevel", cid, x, y, w, h, parent, **kw)',
    '',
    '    def shine(self, cid, x, y, w, h=8, **kw):',
    '        return self.add("shine", cid, x, y, w, h, **kw)',
    '',
    '    def splitter(self, cid, x, y, w, h, **kw):',
    '        return self.add("splitter", cid, x, y, w, h, **kw)',
    '',
    '    def status(self, cid, text, x, y, w, h=22, **kw):',
    '        return self.add("status", cid, x, y, w, h, simple_text=text, **kw)',
    '',
    '    def canvas(self, cid, x, y, w, h, parent=None, fps=30, mouse=True, **kw):',
    '        """A surface you draw yourself in ``paint(self, cid, canvas)``.  ``fps`` 0 = only when',
    '        ``self.repaint(cid)`` is called; ``mouse`` forwards mouse events to ``on_mouse``."""',
    '        return self.add("canvas", cid, x, y, w, h, parent, fps=fps, mouse=mouse, **kw)',
    '',
    '    # automatic layout -------------------------------------------------------------------------',
    '    def auto(self, columns=4):',
    '        """A generic window: one control per parameter in a grid (used when ``ui()`` is not',
    '        overridden)."""',
    '        prms = list(self._params)',
    '        cw, ch = 110, 112',
    '        rows = max(1, -(-len(prms) // columns))',
    '        self.window(columns * cw + 20, rows * ch + 20, "")',
    '        for i, prm in enumerate(prms):',
    '            x, y = 10 + (i % columns) * cw, 10 + (i // columns) * ch',
    '            if prm.kind == "bool":',
    '                self.check("c_" + prm.id, prm.name, x, y + 30, cw - 10, 22, param=prm.id)',
    '            elif prm.kind == "choice":',
    '                self.label("l_" + prm.id, prm.name, x, y, cw - 10, 16)',
    '                self.combo("c_" + prm.id, prm.choices, x, y + 22, cw - 10, 24, param=prm.id)',
    '            else:',
    '                self.knob("c_" + prm.id, x + 8, y, 80, 100, param=prm.id, label=prm.name)',
    '',
    '    def to_dict(self):',
    '        return {"window": self.win, "controls": self.controls}',
    '',
    '',
    '# ---- the plug-in base class -----------------------------------------------------------------',
    '',
    'class Plugin:',
    '    """Derive from this.  All hooks are optional except ``process`` (a plug-in without it',
    '    passes audio through, which is useful for pure utilities / analysers)."""',
    '',
    '    #: shown in the mixer and the window title',
    '    name = "Python Plug-in"',
    '    vendor = ""',
    '    #: who wrote the plug-in; shown in the plug-in window''s About box and listed by Validate when missing',
    '    author = ""',
    '    version = "1.0"',
    '    description = ""',
    '    #: True: UDAW hands the plug-in''s results back one block late instead of waiting for',
    '    #: them; use it for plug-ins too heavy for real-time (adds one block of latency).',
    '    buffered = False',
    '    #: True: ``block.inp`` / ``block.out`` are numpy arrays when numpy is installed.',
    '    use_numpy = False',
    '',
    '    # ---- hooks you override -------------------------------------------------------------',
    '    def setup(self):',
    '        """Declare parameters with ``self.add_param(...)``."""',
    '',
    '    def ui(self, ui):',
    '        """Describe the window.  Default: a knob per parameter."""',
    '        ui.auto()',
    '',
    '    def prepare(self, sample_rate, channels, max_frames):',
    '        """Allocate filters / delay lines here (called again if the audio format changes)."""',
    '',
    '    def process(self, block):',
    '        """Fill ``block.out`` from ``block.inp``."""',
    '        block.copy_through()',
    '',
    '    def reset(self):',
    '        """Clear filter memory (transport restarted / plug-in re-enabled)."""',
    '',
    '    def on_param(self, pid, value):',
    '        """A parameter changed (from the window, automation or ``set_param``)."""',
    '',
    '    def on_event(self, cid, event, data):',
    '        """A control without a parameter did something (``button`` -> "click", ``list`` ->',
    '        "select", ``edit`` -> "change" ...).  ``on_<id>(self, event, data)`` is tried first."""',
    '',
    '    def paint(self, cid, canvas):',
    '        """Draw a ``ui.canvas`` control.  ``paint_<id>(self, canvas)`` is tried first."""',
    '',
    '    def on_mouse(self, cid, kind, x, y, button):',
    '        """Mouse on a ``ui.canvas``: kind is "down", "move", "up", "wheel" (button = delta) or',
    '        "double"."""',
    '',
    '    def on_timer(self):',
    '        """About 20 times a second while the window is open (poll state, animate)."""',
    '',
    '    def on_midi(self, kind, channel, data1, data2):',
    '        """A MIDI message from the device chosen in the plug-in window (or from a MIDI track routed to',
    '        it).  ``kind`` is "note_on", "note_off", "cc" (data1 = controller, data2 = value), "pitch_bend"',
    '        (data1 = -8192..8191, data2 = 0), "program", "aftertouch", "channel_pressure" or "other";',
    '        ``channel`` is 0-15.  For notes data1 = note number, data2 = velocity.  Runs on the control',
    '        thread, not in ``process()``: store what you need and read it in ``process()``."""',
    '',
    '    def get_state(self):',
    '        """Extra JSON-serialisable data to keep in the project besides parameter values."""',
    '        return None',
    '',
    '    def set_state(self, state):',
    '        """Receives what ``get_state`` returned."""',
    '',
    '    # ---- services you call ---------------------------------------------------------------',
    '    def add_param(self, pid, name, min=0.0, max=1.0, default=0.0, unit="", kind="float",',
    '                  choices=None, log=False, step=0.0, decimals=None, group=""):',
    '        prm = Param(pid, name, min, max, default, unit, kind, choices, log, step, decimals, group)',
    '        if prm.id in self._params._d:',
    '            raise ValueError("parameter id %r declared twice" % prm.id)',
    '        self._params._add(prm)',
    '        return prm',
    '',
    '    def add_bool(self, pid, name, default=False, **kw):',
    '        return self.add_param(pid, name, default=1.0 if default else 0.0, kind="bool", **kw)',
    '',
    '    def add_choice(self, pid, name, choices, default=0, **kw):',
    '        return self.add_param(pid, name, default=default, kind="choice", choices=choices, **kw)',
    '',
    '    def set_param(self, pid, value):',
    '        """Changes a parameter from the plug-in (moves the bound control too)."""',
    '        prm = self._params._d[pid]',
    '        v = prm.clamp(value)',
    '        if v != prm.value:',
    '            prm.value = v',
    '            self._ui_params[pid] = v',
    '            self.on_param(pid, v)',
    '            self._midi_feedback(pid, v)',
    '',
    '    def ui_set(self, cid, **props):',
    '        """Changes a control: ``value=``, ``caption=``, ``visible=``, ``enabled=`` or any',
    '        property.  Batched and sent at most ~30 times a second, so it is safe in ``process``."""',
    '        self._ui_controls.setdefault(cid, {}).update(props)',
    '',
    '    def repaint(self, cid=None):',
    '        """Asks UDAW to redraw a canvas now (all canvases when ``cid`` is None)."""',
    '        self._ui_repaint.add(cid or "*")',
    '',
    '    def send_midi(self, kind, channel=0, data1=0, data2=0):',
    '        """Sends a MIDI message out of the plug-in (to the MIDI output device chosen in the plug-in',
    '        window).  Takes the same ``kind`` / ``channel`` / ``data1`` / ``data2`` as ``on_midi``:',
    '        "note_on", "note_off", "cc", "pitch_bend" (data1 = -8192..8191), "program", "aftertouch" or',
    '        "channel_pressure".  Values are clamped to the legal MIDI range.  Safe to call from',
    '        ``process()``, ``on_midi``, ``on_timer`` and the event hooks; messages are delivered in the',
    '        order sent."""',
    '        ch = min(max(int(channel), 0), 15)',
    '        a, b = int(data1), int(data2)',
    '        if kind == "note_on":',
    '            st, a, b = 0x90, a & 0x7F, min(max(b, 0), 127)',
    '        elif kind == "note_off":',
    '            st, a, b = 0x80, a & 0x7F, min(max(b, 0), 127)',
    '        elif kind == "cc":',
    '            st, a, b = 0xB0, a & 0x7F, min(max(b, 0), 127)',
    '        elif kind == "pitch_bend":',
    '            v = min(max(a, -8192), 8191) + 8192',
    '            st, a, b = 0xE0, v & 0x7F, v >> 7',
    '        elif kind == "program":',
    '            st, a, b = 0xC0, a & 0x7F, 0',
    '        elif kind == "aftertouch":',
    '            st, a, b = 0xA0, a & 0x7F, min(max(b, 0), 127)',
    '        elif kind == "channel_pressure":',
    '            st, a, b = 0xD0, a & 0x7F, 0',
    '        else:',
    '            raise ValueError("send_midi: unknown kind %r" % (kind,))',
    '        self._midi_out.append((st | ch, a, b))',
    '',
    '    def note_on(self, note, velocity=100, channel=0):',
    '        """Shortcut for ``send_midi("note_on", channel, note, velocity)``."""',
    '        self.send_midi("note_on", channel, note, velocity)',
    '',
    '    def note_off(self, note, channel=0):',
    '        """Shortcut for ``send_midi("note_off", channel, note, 0)``."""',
    '        self.send_midi("note_off", channel, note, 0)',
    '',
    '    def all_notes_off(self, channel=None):',
    '        """Sends "all notes off" (CC 123) on one channel, or on all 16 when ``channel`` is None."""',
    '        for ch in ([channel] if channel is not None else range(16)):',
    '            self.send_midi("cc", ch, 123, 0)',
    '',
    '    # ---- ready-made MIDI behaviour (opt in with add_midi_params) ----------------------------',
    '    #: controller number -> parameter id: the controller moves the parameter, and (with "MIDI',
    '    #: feedback" on) moving the parameter sends the controller out again',
    '    midi_cc = {}',
    '    #: one line per extra thing the plug-in''s own on_midi does (shown on the MIDI page)',
    '    midi_notes = ()',
    '',
    '    def add_midi_params(self, control="midi_in", control_default=True):',
    '        """Adds the standard MIDI settings: ``control`` (respond to MIDI), ``midi_fb`` (send a',
    '        controller message out when a mapped parameter changes), ``midi_thru`` (pass incoming MIDI',
    '        to the output) and ``midi_ch`` (Omni or channel 1-16).  Call it from ``setup()``; show them',
    '        with ``ui_midi_page``.  With it, ``midi_cc`` is applied for you and ``on_midi`` only runs',
    '        when the control switch is on and the channel matches."""',
    '        self._midi_ctl = control',
    '        self.add_bool(control, "MIDI control", default=control_default, group="MIDI")',
    '        self.add_bool("midi_fb", "MIDI feedback", default=False, group="MIDI")',
    '        self.add_bool("midi_thru", "MIDI thru", default=False, group="MIDI")',
    '        self.add_choice("midi_ch", "MIDI channel", ["Omni"] + [str(i) for i in range(1, 17)], default=0,',
    '                        group="MIDI")',
    '',
    '    def midi_help_text(self):',
    '        lines = ["MIDI in:  pick a keyboard or controller in the MIDI input list of the plug-in window.",',
    '                 "MIDI out: pick a device in the MIDI out list (or in Settings for a plug-in on a mixer strip).",',
    '                 ""]',
    '        if self.midi_cc:',
    '            lines.append("Controllers (moving one moves the parameter; with MIDI feedback on, moving the parameter")',
    '            lines.append("sends the controller out, so a controller with motor faders or lights follows):")',
    '            for cc in sorted(self.midi_cc):',
    '                prm = self._params._d.get(self.midi_cc[cc])',
    '                if prm is not None:',
    '                    lines.append("   CC %-3d  ->  %s" % (cc, prm.name + (" (%s)" % prm.group if prm.group else "")))',
    '            lines.append("")',
    '        for ln in self.midi_notes:',
    '            lines.append(ln)',
    '        return "\n".join(lines)',
    '',
    '    def ui_midi_page(self, ui, parent, extra_rows=0):',
    '        """Builds the MIDI page''s controls on ``parent`` (e.g. ``"tabs#1"``).  ``extra_rows`` leaves',
    '        that many 26-pixel rows free under the channel selector (first at y=146 on the page, inside',
    '        the MIDI group) for the plug-in''s own MIDI options."""',
    '        ctl = getattr(self, "_midi_ctl", "midi_in")',
    '        ui.group("midi_g", "MIDI", 8, 8, 756, 320, parent=parent)',
    '        ui.check("midi_x_in", "MIDI control: respond to the MIDI input", 20, 30, 360, 22, param=ctl, parent=parent)',
    '        ui.check("midi_x_fb", "MIDI feedback: send a controller message out when a knob moves", 20, 56, 460, 22,',
    '                 param="midi_fb", parent=parent,',
    '                 hint="Needs a MIDI output device. Lets a controller with motor faders or lights follow the knobs.")',
    '        ui.check("midi_x_thru", "MIDI thru: pass the incoming MIDI on to the MIDI output", 20, 82, 460, 22,',
    '                 param="midi_thru", parent=parent)',
    '        ui.label("midi_l_ch", "Channel", 20, 114, 60, 20, parent=parent)',
    '        ui.combo("midi_c_ch", ["Omni"] + [str(i) for i in range(1, 17)], 84, 110, 120, 24, param="midi_ch",',
    '                 parent=parent, hint="Which MIDI channel to listen to, and to send on (Omni listens to all, sends on 1)")',
    '        ui.memo("midi_m_map", self.midi_help_text(), 20, 146 + 26 * extra_rows, 724, 168 - 26 * extra_rows,',
    '                parent=parent, read_only=True)',
    '',
    '    def _midi_dispatch(self, kind, ch, a, b):',
    '        d = self._params._d',
    '        thru = d.get("midi_thru")',
    '        if thru is not None and thru.value >= 0.5 and kind != "other":',
    '            self.send_midi(kind, ch, a, b)',
    '        ctl = d.get(getattr(self, "_midi_ctl", ""))',
    '        if ctl is not None:',
    '            if ctl.value < 0.5:',
    '                return',
    '            sel = d["midi_ch"].value',
    '            if sel > 0 and ch != int(sel) - 1:',
    '                return',
    '        if kind == "cc":',
    '            prm = d.get(self.midi_cc.get(a, ""))',
    '            if prm is not None:',
    '                self._cc_guard = True',
    '                try:',
    '                    self.set_param(prm.id, prm.from_norm(b / 127.0))',
    '                finally:',
    '                    self._cc_guard = False',
    '        self.on_midi(kind, ch, a, b)',
    '',
    '    def _midi_feedback(self, pid, v):',
    '        if self._cc_guard:',
    '            return',
    '        d = self._params._d',
    '        fb = d.get("midi_fb")',
    '        if fb is None or fb.value < 0.5:',
    '            return',
    '        for cc, mapped in self.midi_cc.items():',
    '            if mapped == pid:',
    '                val = int(round(d[pid].to_norm(v) * 127.0))',
    '                if self._cc_sent.get(cc) != val:',
    '                    self._cc_sent[cc] = val',
    '                    self.send_midi("cc", max(int(d["midi_ch"].value) - 1, 0), cc, val)',
    '                return',
    '',
    '    # ---- presets: the plug-in''s built-in ones and the user''s own files ---------------------------',
    '    #: parameter ids a preset never stores (the MIDI settings are never stored either)',
    '    preset_skip = ()',
    '',
    '    def builtin_presets(self):',
    '        """Names of the built-in presets, in the order of the preset box.  Default: the module''s',
    '        ``PRESET_ORDER`` list; with ``load_builtin`` it can be overridden."""',
    '        return list(getattr(sys.modules.get(type(self).__module__), "PRESET_ORDER", []))',
    '',
    '    def load_builtin(self, index):',
    '        """Loads built-in preset ``index`` (0-based).  Default: ``on_preset("select", index + 1)``."""',
    '        fn = getattr(self, "on_preset", None)',
    '        if callable(fn):',
    '            fn("select", index + 1)',
    '',
    '    def preset_begin(self):',
    '        """A preset file is about to set several parameters: switch off any logic in ``on_param``',
    '        that would react to one parameter by changing others."""',
    '',
    '    def preset_end(self):',
    '        """The preset file has been applied."""',
    '',
    '    def preset_folder(self):',
    '        """This plug-in''s own folder inside the presets folder chosen in Settings."""',
    '        base = self._presets_root or os.path.join(self._script_dir or os.getcwd(), "Presets")',
    '        safe = "".join(c if (c.isalnum() or c in " -_") else "_" for c in self.name).strip() or "Plugin"',
    '        return os.path.join(base, "PythonPlugins", safe)',
    '',
    '    def _preset_path(self, name):',
    '        safe = "".join(c if (c.isalnum() or c in " -_.()") else "_" for c in name).strip(" .")[:80]',
    '        if not safe:',
    '            raise ValueError("a preset needs a name")',
    '        return os.path.join(self.preset_folder(), safe + PRESET_EXT)',
    '',
    '    def user_presets(self):',
    '        """Names of the presets the user has saved for this plug-in."""',
    '        folder = self.preset_folder()',
    '        try:',
    '            files = os.listdir(folder)',
    '        except OSError:',
    '            return []',
    '        names = []',
    '        for fn in files:',
    '            if fn.lower().endswith(PRESET_EXT):',
    '                names.append(self._preset_name_in(os.path.join(folder, fn), fn[:-len(PRESET_EXT)]))',
    '        return sorted(names, key=str.lower)',
    '',
    '    @staticmethod',
    '    def _preset_name_in(path, fallback):',
    '        try:',
    '            with open(path, encoding="utf-8") as fh:',
    '                return str(json.load(fh).get("name") or fallback)',
    '        except (OSError, ValueError, AttributeError):',
    '            return fallback',
    '',
    '    def save_preset(self, name):',
    '        """Writes every parameter (and ``get_state()``) to the presets folder under ``name``."""',
    '        name = str(name).strip()',
    '        path = self._preset_path(name)',
    '        data = {"format": 1, "plugin": self.name, "name": name, "sdk": SDK_VERSION,',
    '                "values": {p.id: p.value for p in self._params',
    '                           if p.group != "MIDI" and p.id not in self.preset_skip},',
    '                "custom": self.get_state()}',
    '        os.makedirs(os.path.dirname(path), exist_ok=True)',
    '        tmp = path + ".tmp"',
    '        with open(tmp, "w", encoding="utf-8") as fh:',
    '            json.dump(data, fh, indent=1)',
    '        os.replace(tmp, path)',
    '',
    '    def load_preset(self, name):',
    '        """Loads a saved preset: parameters first, then ``set_state``."""',
    '        with open(self._preset_path(name), encoding="utf-8") as fh:',
    '            data = json.load(fh)',
    '        values = data.get("values") or {}',
    '        self.preset_begin()',
    '        try:',
    '            for pid, v in values.items():',
    '                prm = self._params._d.get(pid)',
    '                if prm is not None and prm.group != "MIDI" and pid not in self.preset_skip:',
    '                    self.set_param(pid, v)',
    '        finally:',
    '            self.preset_end()',
    '        if data.get("custom") is not None:',
    '            self.set_state(data["custom"])',
    '',
    '    def delete_preset(self, name):',
    '        os.remove(self._preset_path(name))',
    '',
    '    def _pset_labels(self):',
    '        b, u = self.builtin_presets(), self.user_presets()',
    '        return ["Presets..."] + b + ["User: " + n for n in u], b, u',
    '',
    '    def _pset_index(self):',
    '        _, b, u = self._pset_labels()',
    '        n = self._pset_name',
    '        if n.startswith("b:") and n[2:] in b:',
    '            return 1 + b.index(n[2:])',
    '        if n.startswith("u:") and n[2:] in u:',
    '            return 1 + len(b) + u.index(n[2:])',
    '        return 0',
    '',
    '    def _pset_refresh(self):',
    '        if self._pset_ui:',
    '            labels, _, _ = self._pset_labels()',
    '            self.ui_set("pset", items=labels, value=self._pset_index())',
    '',
    '    def ui_presets(self, ui, x=None, y=None, w=None, tabs="tabs"):',
    '        """The preset box with the name field and the icon buttons (save, delete), after a separator.',
    '        Call it LAST in ``ui()``.  It finds the page tabs control (``tabs``) and puts the controls',
    '        INSIDE it, on its tab row straight after the last tab: they are positioned relative to the',
    '        tab strip, so wherever the tabs control sits in the window they stay level with the tabs.',
    '        ``x`` / ``y`` / ``w`` override the position (relative to the tabs control; ``w`` is the whole',
    '        width of the row).  Picking a preset loads it at once; the disk saves the current settings',
    '        under the name in the field (loading a preset fills the field in, so the disk overwrites it)."""',
    '        t = next((c for c in ui.controls if c["id"] == tabs and c["type"] == "tabs"), None)',
    '        parent = None',
    '        if t is not None:',
    '            parent = tabs',
    '            pages = t.get("props", {}).get("pages", [])',
    '            if x is None:                                   # tab headers: about 24 px + 6.2 px a letter, a touch generous',
    '                x = sum(int(24 + 6.2 * len(str(p))) for p in pages) + 16',
    '            if y is None:',
    '                y = 0',
    '            if w is None:',
    '                w = max(250, min(346, t["w"] - x - 4))',
    '        else:                                               # no tabs: a row of its own at the top of the window',
    '            x = 466 if x is None else x',
    '            y = 8 if y is None else y',
    '            w = 346 if w is None else w',
    '        self._pset_ui = True',
    '        labels, _, _ = self._pset_labels()',
    '        cw = w - 170',
    '        ui.recess("pset_sep", x - 10, y + 2, 2, 22, parent=parent)',
    '        ui.combo("pset", labels, x, y, cw, 26, value=self._pset_index(), parent=parent,',
    '                 hint="Pick a preset and it loads at once. ''User:'' presets are your own.")',
    '        ui.edit("pset_name", self._pset_text, x + cw + 6, y, 96, 26, parent=parent,',
    '                hint="The name to save the settings under (loading a preset fills this in, so Save overwrites it)")',
    '        ui.icon_button("pset_save", "save", x + cw + 108, y, 28, 26, parent=parent,',
    '                       hint="Save the current settings as a preset with this name, in the presets folder")',
    '        ui.icon_button("pset_del", "delete", x + cw + 142, y, 28, 26, parent=parent,',
    '                       hint="Delete the selected user preset")',
    '',
    '    def select_builtin(self, index):',
    '        """Loads built-in preset ``index`` (0-based) and shows it in the preset box (MIDI program change)."""',
    '        b = self.builtin_presets()',
    '        if 0 <= index < len(b):',
    '            self.load_builtin(index)',
    '            self._pset_name = "b:" + b[index]',
    '            self._pset_refresh()',
    '',
    '    def on_pset(self, event, value):',
    '        try:',
    '            idx = int(value)',
    '        except (TypeError, ValueError):',
    '            return',
    '        labels, b, u = self._pset_labels()',
    '        if idx <= 0 or idx >= len(labels):',
    '            return',
    '        if idx <= len(b):',
    '            self.load_builtin(idx - 1)',
    '            self._pset_name = "b:" + b[idx - 1]',
    '            return',
    '        name = u[idx - 1 - len(b)]',
    '        try:',
    '            self.load_preset(name)',
    '        except (OSError, ValueError) as e:',
    '            self.log("preset: could not load %r: %s" % (name, e))',
    '            return',
    '        self._pset_name = "u:" + name',
    '        self._pset_text = name',
    '        self.ui_set("pset_name", text=name)',
    '',
    '    def on_pset_name(self, event, value):',
    '        self._pset_text = "" if value is None else str(value)',
    '',
    '    def on_pset_save(self, event, value):',
    '        if event != "click":',
    '            return',
    '        name = self._pset_text.strip()',
    '        if not name:',
    '            self.log("preset: type a name in the box next to the disk first")',
    '            return',
    '        try:',
    '            self.save_preset(name)',
    '        except (OSError, ValueError) as e:',
    '            self.log("preset: could not save %r: %s" % (name, e))',
    '            return',
    '        self._pset_name = "u:" + name',
    '        self._pset_refresh()',
    '        self.log("preset saved: " + name)',
    '',
    '    def on_pset_del(self, event, value):',
    '        if event != "click":',
    '            return',
    '        if not self._pset_name.startswith("u:"):',
    '            self.log("preset: pick one of your own presets (User: ...) to delete it")',
    '            return',
    '        name = self._pset_name[2:]',
    '        try:',
    '            self.delete_preset(name)',
    '        except (OSError, ValueError) as e:',
    '            self.log("preset: could not delete %r: %s" % (name, e))',
    '            return',
    '        self._pset_name = ""',
    '        self._pset_refresh()',
    '        self.log("preset deleted: " + name)',
    '',
    '    def log(self, *args):',
    '        print(*args)',
    '',
    '    p = property(lambda self: self._params)',
    '',
    '    # ---- internals ------------------------------------------------------------------------',
    '    def __init__(self):',
    '        self._params = _Params()',
    '        self._ui_params = {}',
    '        self._ui_controls = {}',
    '        self._ui_repaint = set()',
    '        self._midi_out = []',
    '        self._midi_ctl = ""',
    '        self._cc_guard = False',
    '        self._cc_sent = {}',
    '        self._pset_ui = False',
    '        self._pset_name = ""',
    '        self._pset_text = ""',
    '        self._presets_root = ""',
    '        self._script_dir = ""',
    '        self.sample_rate = 48000',
    '        self.channels = 2',
    '        self.max_frames = 512',
    '',
    '',
    '# ---------------------------------------------------------------------------------------',
    '# Host runtime (UDAW''s side - do not edit below this line)',
    '# ---------------------------------------------------------------------------------------',
    '',
    'M_INIT, M_PROCESS, M_PARAM, M_SHUTDOWN, M_EVENT, M_PAINT, M_GETSTATE, M_SETSTATE, M_RESET, M_TICK, M_MIDI = range(1, 12)',
    'R_READY, R_PROCESSED, R_LOG, R_UI, R_PAINT, R_STATE, R_ERROR, R_MIDI = range(101, 109)',
    'PRESET_EXT = ".udawpreset"',
    '_HDR = struct.Struct("<II")',
    '_PHDR = struct.Struct("<QII")',
    '',
    'try:                                    # optional, only used when a plug-in asks for it',
    '    import numpy as _np',
    'except Exception:                       # pragma: no cover',
    '    _np = None',
    '',
    '',
    'def _find_plugin_class(mod):',
    '    cls = getattr(mod, "PLUGIN", None)',
    '    if isinstance(cls, type) and issubclass(cls, Plugin):',
    '        return cls',
    '    found = [v for v in vars(mod).values()',
    '             if isinstance(v, type) and issubclass(v, Plugin) and v is not Plugin and v.__module__ == mod.__name__]',
    '    if not found:',
    '        raise RuntimeError("the script defines no class derived from udaw_plugin.Plugin")',
    '    return found[-1]',
    '',
    '',
    'def load_plugin(source, filename, script_dir=None):',
    '    """Compiles and executes the script; returns (module, plugin instance)."""',
    '    if script_dir and script_dir not in sys.path:',
    '        sys.path.insert(0, script_dir)',
    '    code = compile(source, filename, "exec")',
    '    name = "udaw_user_plugin"',
    '    spec = importlib.util.spec_from_loader(name, loader=None)',
    '    mod = importlib.util.module_from_spec(spec)',
    '    mod.__file__ = filename',
    '    sys.modules[name] = mod',
    '    exec(code, mod.__dict__)',
    '    inst = _find_plugin_class(mod)()',
    '    inst.setup()',
    '    return mod, inst',
    '',
    '',
    'def build_ui(inst):',
    '    ui = UI(inst._params)',
    '    inst.ui(ui)',
    '    return ui',
    '',
    '',
    'class _Runtime:',
    '    def __init__(self, rin, rout):',
    '        self.rin, self.rout = rin, rout',
    '        self.wlock = threading.Lock()',
    '        self.inst = None',
    '        self.sr, self.ch, self.maxf = 48000, 2, 512',
    '        self.position = 0',
    '        self.last_flush = 0.0',
    '        self.err_count = 0',
    '        self.faulted = False',
    '        self.out_cache = {}',
    '',
    '    # -- wire ------------------------------------------------------------------------------',
    '    def send(self, mtype, payload=b""):',
    '        with self.wlock:',
    '            self.rout.write(_HDR.pack(mtype, len(payload)))',
    '            if payload:',
    '                self.rout.write(payload)',
    '            self.rout.flush()',
    '',
    '    def send_json(self, mtype, obj):',
    '        self.send(mtype, json.dumps(obj, separators=(",", ":"), allow_nan=False).encode("utf-8"))',
    '',
    '    def log(self, level, text):',
    '        try:',
    '            self.send_json(R_LOG, {"level": level, "text": text})',
    '        except Exception:',
    '            pass',
    '',
    '    def error(self, text, fatal=False):',
    '        try:',
    '            self.send_json(R_ERROR, {"text": text, "fatal": fatal})',
    '        except Exception:',
    '            pass',
    '',
    '    def read_exact(self, n):',
    '        buf = self.rin.read(n)',
    '        if buf is None or len(buf) < n:',
    '            raise EOFError',
    '        return buf',
    '',
    '    # -- ui flush --------------------------------------------------------------------------',
    '    def flush_ui(self, force=False):',
    '        inst = self.inst',
    '        if inst is None:',
    '            return',
    '        now = time.perf_counter()',
    '        if not force and now - self.last_flush < 0.033:',
    '            return',
    '        if inst._ui_params or inst._ui_controls or inst._ui_repaint:',
    '            msg = {"params": inst._ui_params, "controls": inst._ui_controls,',
    '                   "repaint": sorted(inst._ui_repaint)}',
    '            inst._ui_params, inst._ui_controls, inst._ui_repaint = {}, {}, set()',
    '            try:',
    '                self.send_json(R_UI, msg)',
    '            except (TypeError, ValueError) as e:',
    '                self.log("error", "ui_set value is not JSON-serialisable: %s" % e)',
    '        self.last_flush = now',
    '',
    '    def flush_midi(self):',
    '        inst = self.inst',
    '        if inst is None or not inst._midi_out:',
    '            return',
    '        msgs, inst._midi_out = inst._midi_out[:4096], inst._midi_out[4096:]',
    '        self.send(R_MIDI, b"".join(bytes(m) for m in msgs))',
    '',
    '    # -- handlers -------------------------------------------------------------------------',
    '    def on_init(self, d):',
    '        if sys.version_info < MIN_PYTHON:',
    '            raise RuntimeError("UDAW plug-ins need Python %d.%d or newer (this is %d.%d.%d)" %',
    '                               (MIN_PYTHON + sys.version_info[:3]))',
    '        self.sr, self.ch, self.maxf = int(d["sample_rate"]), int(d["channels"]), int(d["max_frames"])',
    '        mod, inst = load_plugin(d["source"], d.get("filename", "plugin.py"), d.get("script_dir"))',
    '        self.inst = inst',
    '        inst.sample_rate, inst.channels, inst.max_frames = self.sr, self.ch, self.maxf',
    '        inst._presets_root = d.get("presets_dir") or ""',
    '        inst._script_dir = d.get("script_dir") or ""',
    '        for pid, v in (d.get("values") or {}).items():',
    '            prm = inst._params._d.get(pid)',
    '            if prm is not None:',
    '                prm.value = prm.clamp(v)',
    '        if d.get("state") is not None:',
    '            self.restore_custom(d["state"])',
    '        inst.prepare(self.sr, self.ch, self.maxf)',
    '        ui = build_ui(inst)',
    '        found = []',
    '        _check_overlaps(ui, lambda sev, line, col, msg: found.append((line, msg)))',
    '        _check_sizes(ui, lambda sev, line, col, msg: found.append((line, msg)))',
    '        for line, msg in found:',
    '            self.log("warning", "window layout%s: %s" % (" (script line %d)" % line if line else "", msg))',
    '        self.send_json(R_READY, {',
    '            "name": inst.name, "vendor": inst.vendor, "author": inst.author, "version": inst.version,',
    '            "description": inst.description, "sdk": SDK_VERSION,',
    '            "python": "%d.%d.%d" % sys.version_info[:3],',
    '            "buffered": bool(inst.buffered), "numpy": bool(_np and inst.use_numpy),',
    '            "params": [p.describe() for p in inst._params],',
    '            "ui": ui.to_dict()})',
    '',
    '    def on_process(self, payload):',
    '        seq, frames, chans = _PHDR.unpack_from(payload, 0)',
    '        base = _PHDR.size',
    '        inst = self.inst',
    '        n = frames * 4',
    '        use_np = _np is not None and inst.use_numpy',
    '        inp, out = [], []',
    '        for c in range(chans):',
    '            raw = payload[base + c * n: base + (c + 1) * n]',
    '            if use_np:',
    '                a = _np.frombuffer(raw, dtype=_np.float32).copy()',
    '                inp.append(a)',
    '                out.append(a.copy())',
    '            else:',
    '                a = array.array("f")',
    '                a.frombytes(raw)',
    '                inp.append(a)',
    '                out.append(array.array("f", a))',
    '        blk = Block(frames, chans, self.sr, inp, out, self.position)',
    '        self.position += frames',
    '        if not self.faulted:',
    '            try:',
    '                inst.process(blk)',
    '            except Exception:',
    '                self.err_count += 1',
    '                if self.err_count == 1 or self.err_count % 500 == 0:',
    '                    self.error("process() raised (x%d):\n%s" % (self.err_count, traceback.format_exc()))',
    '                blk.copy_through()',
    '        body = bytearray(_PHDR.pack(seq, frames, chans))',
    '        for c in range(chans):',
    '            body += out[c].tobytes()',
    '        self.send(R_PROCESSED, bytes(body))',
    '',
    '    def on_param(self, d):',
    '        inst = self.inst',
    '        prm = inst._params._d.get(d["id"])',
    '        if prm is None:',
    '            return',
    '        v = prm.clamp(d["value"])',
    '        prm.value = v',
    '        inst.on_param(prm.id, v)',
    '        inst._midi_feedback(prm.id, v)',
    '',
    '    def on_event(self, d):',
    '        inst = self.inst',
