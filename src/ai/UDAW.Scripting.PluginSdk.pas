    '        if ge is None:',
    '            cv.text(w / 2, h / 2 - 6, "No Gesture loaded", "#8a93a3", 12, False, "center", 0)',
    '            return',
    '        left, top, pw, ph = 8, 22, w - 16, h - 30',
    '        for gi in range(1, 4):',
