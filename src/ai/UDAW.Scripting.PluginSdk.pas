    '        l0 = getattr(self, "_lvl_now", lvl_target)',
    '        dg = (g_target - g0) / n          # ramp over the block: no zipper noise on automation',
    '        dl = (lvl_target - l0) / n',
    '        sg = STAGE_GAIN',
    '        amp = self._amp',
    '        pk_in = pk_out = 0.0',
