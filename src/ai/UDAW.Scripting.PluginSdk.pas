    '',
    '    def _reverb(self, xl, xr):',
    '        p = self.p',
    '        n = len(xl)',
    '        sr = self._sr',
    '        outl = np.empty(n)',
    '        outr = np.empty(n)',
    '        pre = int(p.r_pre * 0.001 * sr)',
    '        damp = min(0.9, p.r_damp * 0.009)',
    '        decay = max(0.1, p.r_decay)',
    '        width = p.r_width * 0.01',
