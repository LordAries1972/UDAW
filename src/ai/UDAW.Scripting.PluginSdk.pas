    '        for ch in range(block.channels):',
    '            src, dst = block.inp[ch], block.out[ch]',
    '            st = self._st[ch]',
    '            hp, lp = st["hp"], st["lp"]',
    '            genv, ggain = st["gate_env"], st["gate_g"]',
    '            prev, dcx, dcy = st["prev"], st["dc_x"], st["dc_y"]',
