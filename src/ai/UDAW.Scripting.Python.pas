unit UDAW.Scripting.Python;
{$I udaw.inc}

{ Python process bridge.

  UDAW does not embed an interpreter. A script runs in the user's own Python
  (3.8+) as a child process and drives the DAW through the MCP server UDAW
  already exposes (the same tool commands the AI assistants use, so scripts get
  undo, validation and the destructive-tool gate for free). The child gets the
  endpoint and bearer token in its environment (UDAW_MCP_URL, UDAW_MCP_TOKEN)
  and a stdlib-only helper module, udaw.py, is written next to the scripts.

  Run is pumped: the child's output streams to the caller while the window
  stays responsive, which also lets the MCP worker threads hand their tool
  calls to the main thread. }

interface

uses
  Windows, SysUtils, Classes;

type
  TPythonOutput = reference to procedure(const ALine: string);

  TPythonBridge = class
  private
    FExe: string;
    FScriptsDir: string;
    FRunning: Boolean;
    FCancel: Boolean;
    FOnPoll: TProc;
    function FindInterpreter: string;
  public
    constructor Create(const AScriptsDir: string);
    { Full path of a usable python.exe, or '' (searches PATH, the py launcher
      and the common per-user / all-user install folders). }
    function InterpreterPath: string;
    procedure WriteHelperModule;
    { Runs AScript; returns the exit code (-1 if it could not start). }
    function Run(const AScript, AEndpoint, AToken: string; const AOnOutput: TPythonOutput;
      out AError: string): Integer;
    procedure Cancel;
    { called every ~25 ms while a script runs, after the message pump (the UI uses it to
      watch for Esc and keep the status bar's elapsed time moving) }
    property OnPoll: TProc read FOnPoll write FOnPoll;
    property Running: Boolean read FRunning;
    property ScriptsDir: string read FScriptsDir;
  end;

const
  UDAW_PY_HELPER = 'udaw.py';

implementation

uses
  Forms;

const
  HELPER_SOURCE =
    '"""UDAW scripting helper (stdlib only). Generated by UDAW - edits are overwritten."""'#10 +
    'import json, os, urllib.request'#10 +
    #10 +
    'class UDAWError(Exception):'#10 +
    '    pass'#10 +
    #10 +
    'class UDAW:'#10 +
    '    """Calls UDAW''s MCP tools: UDAW().tools(), UDAW().call("tool_name", arg=1)."""'#10 +
    #10 +
    '    def __init__(self, url=None, token=None):'#10 +
    '        self.url = url or os.environ["UDAW_MCP_URL"]'#10 +
    '        self.token = token or os.environ.get("UDAW_MCP_TOKEN", "")'#10 +
    '        self._id = 0'#10 +
    '        self._rpc("initialize", {"protocolVersion": "2025-03-26", "capabilities": {},'#10 +
    '                                 "clientInfo": {"name": "udaw-python", "version": "1"}})'#10 +
    #10 +
    '    def _rpc(self, method, params):'#10 +
    '        self._id += 1'#10 +
    '        body = json.dumps({"jsonrpc": "2.0", "id": self._id, "method": method, "params": params}).encode()'#10 +
    '        req = urllib.request.Request(self.url, data=body, headers={'#10 +
    '            "Content-Type": "application/json", "Accept": "application/json",'#10 +
    '            "Authorization": "Bearer " + self.token})'#10 +
    '        with urllib.request.urlopen(req, timeout=120) as r:'#10 +
    '            msg = json.loads(r.read().decode("utf-8") or "{}")'#10 +
    '        if "error" in msg:'#10 +
    '            raise UDAWError(msg["error"].get("message", str(msg["error"])))'#10 +
    '        return msg.get("result", {})'#10 +
    #10 +
    '    def tools(self):'#10 +
    '        return self._rpc("tools/list", {}).get("tools", [])'#10 +
    #10 +
    '    def call(self, name, **arguments):'#10 +
    '        res = self._rpc("tools/call", {"name": name, "arguments": arguments})'#10 +
    '        text = "\n".join(c.get("text", "") for c in res.get("content", []) if c.get("type") == "text")'#10 +
    '        if res.get("isError"):'#10 +
    '            raise UDAWError(text)'#10 +
    '        return text'#10;

constructor TPythonBridge.Create(const AScriptsDir: string);
begin
  inherited Create;
  FScriptsDir := ExcludeTrailingPathDelimiter(AScriptsDir);
end;

function TPythonBridge.FindInterpreter: string;
var
  dirs: TArray<string>;
  d, p, root: string;
  sr: TSearchRec;
  found: TStringList;
begin
  { PATH first, skipping the Microsoft Store stub (a 0-byte alias that opens
    the Store instead of running Python). }
  dirs := GetEnvironmentVariable('PATH').Split([';']);
  for d in dirs do
    if d <> '' then
    begin
      p := IncludeTrailingPathDelimiter(d) + 'python.exe';
      if FileExists(p) and (Pos('\WindowsApps\', p) = 0) then Exit(p);
    end;
  { per-user and all-user installers: ...\Python\Python3xx\python.exe, newest first }
  found := TStringList.Create;
  try
    for root in TArray<string>.Create(
      IncludeTrailingPathDelimiter(GetEnvironmentVariable('LOCALAPPDATA')) + 'Programs\Python\',
      IncludeTrailingPathDelimiter(GetEnvironmentVariable('ProgramFiles')) + 'Python\',
      'C:\') do
    begin
      if FindFirst(root + 'Python3*', faDirectory, sr) = 0 then
      begin
        try
          repeat
            if FileExists(root + sr.Name + '\python.exe') then
              found.Add(root + sr.Name + '\python.exe');
          until FindNext(sr) <> 0;
        finally
          FindClose(sr);
        end;
      end;
    end;
    found.Sort;
    if found.Count > 0 then Exit(found[found.Count - 1]);
  finally
    found.Free;
  end;
  Result := '';
end;

function TPythonBridge.InterpreterPath: string;
begin
  if (FExe = '') or not FileExists(FExe) then FExe := FindInterpreter;
  Result := FExe;
end;

procedure TPythonBridge.WriteHelperModule;
var
  sl: TStringList;
begin
  ForceDirectories(FScriptsDir);
  sl := TStringList.Create;
  try
    sl.Text := HELPER_SOURCE;
    sl.SaveToFile(IncludeTrailingPathDelimiter(FScriptsDir) + UDAW_PY_HELPER, TEncoding.UTF8);
  finally
    sl.Free;
  end;
end;

procedure TPythonBridge.Cancel;
begin
  FCancel := True;
end;

function TPythonBridge.Run(const AScript, AEndpoint, AToken: string; const AOnOutput: TPythonOutput;
  out AError: string): Integer;
var
  sa: TSecurityAttributes;
  rd, wr: THandle;
  si: TStartupInfo;
  pi: TProcessInformation;
  cmd, env, pending, chunk: string;
  envBlock: TBytes;
  avail, got: DWORD;
  raw: AnsiString;
  code: DWORD;
  exe: string;

  procedure Drain;
  var
    nl: Integer;
  begin
    while PeekNamedPipe(rd, nil, 0, nil, @avail, nil) and (avail > 0) do
    begin
      SetLength(raw, avail);
      if not ReadFile(rd, raw[1], avail, got, nil) or (got = 0) then Break;
      SetLength(raw, got);
      pending := pending + UTF8ToString(raw);
    end;
    repeat
      nl := Pos(#10, pending);
      if nl = 0 then Break;
      chunk := Copy(pending, 1, nl - 1);
      Delete(pending, 1, nl);
      if Assigned(AOnOutput) then AOnOutput(TrimRight(chunk));
    until False;
  end;

begin
  Result := -1;
  AError := '';
  exe := InterpreterPath;
  if exe = '' then
  begin
    AError := 'Python 3 was not found. Install it from python.org (or the Microsoft Store) and make sure ' +
      'python.exe is on PATH.';
    Exit;
  end;
  if not FileExists(AScript) then
  begin
    AError := 'Script not found: ' + AScript;
    Exit;
  end;
  if FRunning then
  begin
    AError := 'A script is already running.';
    Exit;
  end;
  WriteHelperModule;

  FillChar(sa, SizeOf(sa), 0);
  sa.nLength := SizeOf(sa);
  sa.bInheritHandle := True;
  if not CreatePipe(rd, wr, @sa, 0) then
  begin
    AError := 'Could not create an output pipe: ' + SysErrorMessage(GetLastError);
    Exit;
  end;
  SetHandleInformation(rd, HANDLE_FLAG_INHERIT, 0);

  { child environment = ours + the bridge variables; unbuffered UTF-8 output }
  env := '';
  begin
    var blk := GetEnvironmentStrings;
    var q: PChar := blk;
    while q^ <> #0 do
    begin
      env := env + q + #0;
      Inc(q, StrLen(q) + 1);
    end;
    FreeEnvironmentStrings(blk);
  end;
  env := env + 'UDAW_MCP_URL=' + AEndpoint + #0 + 'UDAW_MCP_TOKEN=' + AToken + #0 +
    'PYTHONUNBUFFERED=1'#0'PYTHONIOENCODING=utf-8'#0'PYTHONPATH=' + FScriptsDir + #0#0;
  SetLength(envBlock, Length(env) * SizeOf(Char));
  Move(env[1], envBlock[0], Length(envBlock));

  FillChar(si, SizeOf(si), 0);
  si.cb := SizeOf(si);
  si.dwFlags := STARTF_USESTDHANDLES or STARTF_USESHOWWINDOW;
  si.wShowWindow := SW_HIDE;
  si.hStdOutput := wr;
  si.hStdError := wr;
  si.hStdInput := GetStdHandle(STD_INPUT_HANDLE);
  FillChar(pi, SizeOf(pi), 0);
  cmd := '"' + exe + '" -u "' + AScript + '"';
  UniqueString(cmd);

  if not CreateProcess(nil, PChar(cmd), nil, nil, True,
       CREATE_NO_WINDOW or CREATE_UNICODE_ENVIRONMENT, @envBlock[0],
       PChar(ExtractFilePath(AScript)), si, pi) then
  begin
    AError := 'Could not start Python: ' + SysErrorMessage(GetLastError);
    CloseHandle(rd);
    CloseHandle(wr);
    Exit;
  end;
  CloseHandle(wr);   // our copy; the child holds the write end
  FRunning := True;
  FCancel := False;
  try
    while WaitForSingleObject(pi.hProcess, 25) = WAIT_TIMEOUT do
    begin
      Drain;
      Application.ProcessMessages;
      if Assigned(FOnPoll) then FOnPoll();
      if FCancel then
      begin
        TerminateProcess(pi.hProcess, 1);
        AError := 'Script cancelled.';
        Break;
      end;
    end;
    Drain;
    if pending <> '' then
    begin
      if Assigned(AOnOutput) then AOnOutput(TrimRight(pending));
      pending := '';
    end;
    code := 0;
    GetExitCodeProcess(pi.hProcess, code);
    Result := Integer(code);
  finally
    FRunning := False;
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);
    CloseHandle(rd);
  end;
end;

end.
