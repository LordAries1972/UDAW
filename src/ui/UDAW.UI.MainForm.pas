{ a script picked from the Plugins menu: its window opens on a fresh instance. Listen plays program material
  through it, the controls can be tried, and Add to Mixer puts it on the strip selected in the Mixer tab with
  the settings shown }
procedure TfrmMain.OpenPythonScriptWindow(const AFileName: string);
var
  src, err: string;
  host: TPyPluginHost;
  frm: TfrmPyPlugin;
  rate: Integer;
begin
  PyPluginSetup;
  try
    src := TFile.ReadAllText(AFileName, TEncoding.UTF8);
  except
    on E: Exception do
    begin
      MessageDlg('Could not read ' + AFileName + ':'#13#10 + E.Message, mtError, [mbOK], 0);
      Exit;
    end;
  end;
  rate := 0;
  if Assigned(PyAuditionRate) then rate := PyAuditionRate();
  if rate <= 0 then
    if FProject <> nil then rate := FProject.SampleRate else rate := UDAW_DEFAULT_SAMPLE_RATE;
  stbMain.SimpleText := 'Starting ' + ExtractFileName(AFileName) + '...';
  host := TPyPluginHost.Create;
  if not host.Start(src, ExtractFileName(AFileName), ExtractFilePath(AFileName), '', '', rate, 2,
       UDAW_DEFAULT_BUFFER_FRAMES, err) then
  begin
    host.Release;
    MessageDlg('The Python plug-in could not start:'#13#10#13#10 + err, mtError, [mbOK], 0);
    Exit;
  end;
  frm := TfrmPyPlugin.Create(Self);
  frm.SourceFile := AFileName;
  frm.OnAddToMixer := PyWindowAddToMixer;
  frm.AutoListen := True;
  if not frm.Open(host, '', ChangeFileExt(ExtractFileName(AFileName), ''), nil) then
  begin
    frm.Free;
    host.Release;
    Exit;
  end;
  host.Release;   // the window holds its own reference
  frm.Show;
  stbMain.SimpleText := host.Name + ' is open - Listen plays it on a guitar phrase or your highlighted Timeline range.';
end;

{ A Python plug-in picked from a strip's + FX menu: started once for its name, parameters and starting
  settings, then inserted on that strip (double-click the insert for its window) }
procedure TfrmMain.MixAddPythonPlugin(const AFileName: string);
var
  src, err, st, vals, custom: string;
  host: TPyPluginHost;
  v: TJSONValue;
  o: TJSONObject;
  target: TPyTarget;
  strip: TMixStrip;
  rate: Integer;
begin
  if (FProject = nil) or (SelectedMixStripId = 0) then Exit;
  PyPluginSetup;
  try
    src := TFile.ReadAllText(AFileName, TEncoding.UTF8);
  except
    on E: Exception do
    begin
      MessageDlg('Could not read ' + AFileName + ':'#13#10 + E.Message, mtError, [mbOK], 0);
      Exit;
    end;
  end;
  rate := 0;
  if Assigned(PyAuditionRate) then rate := PyAuditionRate();
  if rate <= 0 then rate := FProject.SampleRate;
  stbMain.SimpleText := 'Starting ' + ExtractFileName(AFileName) + '...';
  host := TPyPluginHost.Create;
  if not host.Start(src, ExtractFileName(AFileName), ExtractFilePath(AFileName), '', '', rate, 2,
       UDAW_DEFAULT_BUFFER_FRAMES, err) then
  begin
    host.Release;
    MessageDlg('The Python plug-in could not start:'#13#10#13#10 + err, mtError, [mbOK], 0);
    Exit;
  end;
  try
    st := host.CaptureState;
    vals := '';
    custom := '';
    v := TJSONObject.ParseJSONValue(st);
    try
      if v is TJSONObject then
      begin
        o := TJSONObject(v);
        if o.GetValue('values') <> nil then vals := o.GetValue('values').ToJSON;
        if (o.GetValue('custom') <> nil) and not (o.GetValue('custom') is TJSONNull) then
          custom := o.GetValue('custom').ToJSON;
      end;
    finally
      v.Free;
    end;
    target.Tracker := FMixViewTracker;
    target.StripId := SelectedMixStripId;
    strip := MixCur.StripById(target.StripId);
    if strip <> nil then target.Caption := strip.Name else target.Caption := 'the selected strip';
    PyEditorAddToMixer(target, AFileName, host.Name, vals, custom, host.ParamNames);
    stbMain.SimpleText := 'Added "' + host.Name + '" to ' + target.Caption +
      ' - double-click it in the strip to open its window.';
  finally
    host.Release;
  end;
end;

{ Add to Mixer pressed in a plug-in window }
procedure TfrmMain.PyWindowAddToMixer(Sender: TObject);
var
  frm: TfrmPyPlugin;
  st, vals, custom: string;
  v: TJSONValue;
  o: TJSONObject;
  sel, i: Integer;
  mi: TMenuItem;
  pt: TPoint;
  lastTracker: Boolean;
begin
  frm := TfrmPyPlugin(Sender);
  if FProject = nil then
  begin
    MessageDlg('Open or create a project first.', mtInformation, [mbOK], 0);
    Exit;
  end;
  st := frm.Host.CaptureState;
  vals := '';
  custom := '';
  v := TJSONObject.ParseJSONValue(st);
  try
    if v is TJSONObject then
    begin
      o := TJSONObject(v);
      if o.GetValue('values') <> nil then vals := o.GetValue('values').ToJSON;
      if (o.GetValue('custom') <> nil) and not (o.GetValue('custom') is TJSONNull) then
        custom := o.GetValue('custom').ToJSON;
    end;
  finally
    v.Free;
  end;
  PyCollectTargets(FPyAddTargets, sel);
  FPyAddFile := frm.SourceFile;
  FPyAddName := frm.Host.Name;
  FPyAddVals := vals;
  FPyAddState := custom;
  FPyAddNames := frm.Host.ParamNames;
  if FPyAddMenu = nil then FPyAddMenu := TPopupMenu.Create(Self);
  FPyAddMenu.Items.Clear;
  lastTracker := False;
  for i := 0 to High(FPyAddTargets) do
  begin
    if (i > 0) and (FPyAddTargets[i].Tracker <> lastTracker) then
    begin
      mi := TMenuItem.Create(FPyAddMenu);
      mi.Caption := '-';
      FPyAddMenu.Items.Add(mi);
    end;
    lastTracker := FPyAddTargets[i].Tracker;
    mi := TMenuItem.Create(FPyAddMenu);
    mi.Caption := FPyAddTargets[i].Caption;
    mi.Tag := i;
    mi.Default := i = sel;
    mi.OnClick := PyAddMenuItemClick;
    FPyAddMenu.Items.Add(mi);
  end;
  if FPyAddMenu.Items.Count = 0 then
  begin
    MessageDlg('There are no mixer strips to add the plug-in to.', mtInformation, [mbOK], 0);
    Exit;
  end;
  { the press came from the button, so the pointer is on it }
  GetCursorPos(pt);
  FPyAddMenu.Popup(pt.X, pt.Y);
end;

{ the engine stops writing into a plug-in window's live-input ring (before that ring can be freed) }
procedure TfrmMain.PyLiveDetach;
begin
  if not FPyLiveRingOn then Exit;
  FPyLiveRingOn := False;
  if (App = nil) or (App.Audio = nil) then Exit;
  App.Audio.Stop;
  App.Audio.SetCaptureRing(nil);
  App.Audio.Start;
end;

{ the plug-in windows listen through the application's audio engine }
procedure TfrmMain.InstallPyAuditionHooks;
begin
  PyAuditionRate :=
    function: Integer
    begin
      Result := 0;
      if (App = nil) or (App.Audio = nil) then Exit;
      if App.Audio.State in [aesIdle, aesFailed] then App.Audio.Open(True);
      Result := App.Audio.Granted.SampleRate;
    end;
  PyAuditionAttach :=
    function(const ASource: IAudioSource): Boolean
    begin
      Result := False;
      if (App = nil) or (App.Audio = nil) then Exit;
      PyLiveDetach;
      if ASource = nil then
      begin
        App.Audio.ClearSource;
        Exit(True);
      end;
      if FTlPlaying then StopTimelinePlayback;
      if App.Audio.State in [aesIdle, aesFailed] then App.Audio.Open(True)
      else if App.Audio.State <> aesRunning then App.Audio.Start;
      App.Audio.SetSource(ASource);
      Result := True;
    end;
  PyLiveInfo :=
    function(out AChannels, ARate: Integer; out AMsg: string): Boolean
    begin
      Result := False;
      AChannels := 0;
      ARate := 0;
      AMsg := '';
      if (App = nil) or (App.Audio = nil) then Exit;
      if App.Audio.State in [aesIdle, aesFailed] then App.Audio.Open(True);
      if (App.Audio.Granted.CaptureChannels <= 0) or
         (Pos('software', LowerCase(App.Audio.BackendName)) > 0) then
      begin
        AMsg := 'Live input needs an input device. Choose one in Settings, enable audio input, then reopen ' +
          'the audio device.';
        Exit;
      end;
      AChannels := App.Audio.Granted.CaptureChannels;
      ARate := App.Audio.Granted.SampleRate;
      Result := True;
    end;
  PyAuditionAttachLive :=
    function(const ASource: IAudioSource; ARing: TAudioRing; out AMsg: string): Boolean
    begin
      Result := False;
      AMsg := '';
      if (App = nil) or (App.Audio = nil) then Exit;
      if FRecWriter <> nil then
      begin
        AMsg := 'A recording is in progress. Stop it before listening to the live input.';
        Exit;
      end;
      if FTlPlaying then StopTimelinePlayback;
      PyLiveDetach;
      if App.Audio.State in [aesIdle, aesFailed] then App.Audio.Open(True);
      App.Audio.Stop;
      App.Audio.SetCaptureRing(ARing);
      App.Audio.SetInputMonitoring(False);
      App.Audio.SetSource(ASource);
      FPyLiveRingOn := True;
      App.Audio.Start;
      Result := App.Audio.State = aesRunning;
      if not Result then
      begin
        PyLiveDetach;
        AMsg := 'Could not start the input device.';
      end;
    end;
  PyAuditionRange :=
    function(ARate: Integer; out APlanar: TPyPlanar): Boolean
    begin
      Result := PyRenderTimelineRange(ARate, APlanar);
    end;
end;

{ the Timeline range the user highlighted (at most 30 s), as the dry sum of the lanes, for listening }
function TfrmMain.PyRenderTimelineRange(ARate: Integer; out APlanar: TPyPlanar): Boolean;
const
  BLK = 1024;
  MAX_SECONDS = 30.0;
var
  st, en, oldPlayhead, peak, g: Double;
  oldLoop: Boolean;
  player: TTimelinePlayer;
  buf: TAudioBuffer;
  total, done, n, c, i: Integer;
begin
  Result := False;
  SetLength(APlanar, 0);
  if (FProject = nil) or not FTlRangeActive then Exit;
  st := Min(FTlRangeStartSec, FTlRangeEndSec);
  en := Max(FTlRangeStartSec, FTlRangeEndSec);
  if en - st < 0.05 then Exit;
  en := Min(en, st + MAX_SECONDS);
  total := Round((en - st) * ARate);
  oldPlayhead := FProject.Timeline.PlayheadSeconds;
  oldLoop := FProject.Timeline.LoopEnabled;
  player := nil;
  buf := nil;
  stbMain.SimpleText := 'Rendering the highlighted range for listening...';
  try
    try
      FProject.Timeline.PlayheadSeconds := st;
      FProject.Timeline.LoopEnabled := False;
      player := TTimelinePlayer.Create(FProject.Timeline);
      player.AttachMidi(FProject.Midi);
      player.SetStretchTempo(FProject.TempoBPM);
      player.SetTempoMap(FProject.TempoBPM, FProject.TempoMap);
      player.EnsureSourcesLoaded(
        procedure(AFraction: Double)
        begin
          Application.ProcessMessages;
        end);
      player.ValidateLoadedSources;
      player.Prepare(ARate, BLK, 2);
      buf := TAudioBuffer.Create(2, BLK, ARate);
      SetLength(APlanar, 2);
      for c := 0 to 1 do SetLength(APlanar[c], total);
      done := 0;
      while done < total do
      begin
        n := Min(BLK, total - done);
        buf.SetActiveFrames(n);
        player.RenderBlock(buf);
        for c := 0 to 1 do Move(buf.ChannelPtr(c)^, APlanar[c][done], n * SizeOf(Single));
        Inc(done, n);
      end;
      peak := 0;
      for c := 0 to 1 do
        for i := 0 to total - 1 do
          if Abs(APlanar[c][i]) > peak then peak := Abs(APlanar[c][i]);
      if peak < 0.00001 then
      begin
        SetLength(APlanar, 0);
        Exit;
      end;
      if peak > 0.9 then
      begin
        g := 0.9 / peak;
        for c := 0 to 1 do
          for i := 0 to total - 1 do APlanar[c][i] := APlanar[c][i] * g;
      end;
      Result := True;
    except
      on E: Exception do
      begin
        Logger.Warn('ui', 'Could not render the highlighted range for listening: ' + E.Message);
        SetLength(APlanar, 0);
      end;
    end;
  finally
    buf.Free;
    player.Free;
    FProject.Timeline.PlayheadSeconds := oldPlayhead;
    FProject.Timeline.LoopEnabled := oldLoop;
  end;
end;

{ A project that uses Python plug-ins: their inserts come back on the Mixer strips with the project (each one
  points at its script file and keeps its settings). Here every script is located and read, so a plug-in whose
  file has moved or gone is reported at once instead of silently passing sound through when the project plays. }
procedure TfrmMain.PyRestoreInsertsOnLoad;
var
  missing: TStringList;
  total, mi, i, k: Integer;
  model: TMixerModel;
  s: TMixStrip;
  ins: TMixInsert;
  src, name, dir, err: string;
begin
  if FProject = nil then Exit;
  total := 0;
  missing := TStringList.Create;
  try
    for mi := 0 to 1 do
    begin
      if mi = 0 then model := FProject.Mixer else model := FProject.TrackerMixer;
      for i := 0 to model.StripCount - 1 do
      begin
        s := model.GetStrip(i);
        for k := 0 to s.InsertCount - 1 do
        begin
          ins := s.GetInsert(k);
          if not SameText(ins.Kind, 'python') then Continue;
          Inc(total);
          if not PyInsertSource(ins.Params, src, name, dir, err) then
            missing.Add(s.Name + ': ' + IfThen(PyParamGet(ins.Params, 'path') <> '',
              PyDecode(PyParamGet(ins.Params, 'path')), name));
        end;
      end;
    end;
    if total = 0 then Exit;
    PyPluginSetup;
    if missing.Count > 0 then
    begin
      Logger.Warn('ui', 'Python plug-in script(s) not found: ' + missing.CommaText);
      stbMain.SimpleText := Format('%d of %d Python plug-in(s) could not be loaded - script file missing.', [missing.Count, total]);
      MessageDlg('This project uses Python plug-ins whose script files could not be found:'#13#10#13#10 +
        missing.Text + #13#10'Until the files are back those inserts pass the sound through unchanged. ' +
        'Put the scripts back where they were, or add the plug-ins again from their new location.',
        mtWarning, [mbOK], 0);
    end
    else
      stbMain.SimpleText := Format('%d Python plug-in(s) restored on the mixer from their script files.', [total]);
  finally
    missing.Free;
  end;
end;

procedure TfrmMain.PyWindowClosing(Sender: TObject);
var
  frm: TfrmPyPlugin;
begin
  { closing the window means "do not reopen it next time", like the VST editors; one still open when the
    project is saved is captured by CaptureOpenWindowLayout }
  frm := TfrmPyPlugin(Sender);
  if (FProject <> nil) and (frm.WindowKey <> '') then FProject.Windows.Remove(frm.WindowKey);
  if FOpenPyWindows <> nil then FOpenPyWindows.Remove(frm);
end;

function TfrmMain.OpenPythonInsertWindowByIid(ATracker: Boolean; AStripId: Integer; const AIid: string): Boolean;
var
  model: TMixerModel;
  s: TMixStrip;
  i: Integer;
begin
  Result := False;
  if FProject = nil then Exit;
  if ATracker then model := FProject.TrackerMixer else model := FProject.Mixer;
  s := model.StripById(AStripId);
  if s = nil then Exit;
  for i := 0 to s.InsertCount - 1 do
    if SameText(s.GetInsert(i).Kind, 'python') and (PyParamGet(s.GetInsert(i).Params, 'iid') = AIid) then
    begin
      OpenPythonInsertWindow(ATracker, AStripId, i);
      Exit(True);
    end;
end;

{ double-click on a Python insert: its window, attached to the instance that is playing when there is one }
procedure TfrmMain.OpenPythonInsertWindow(ATracker: Boolean; AStripId, AIndex: Integer);
var
  model: TMixerModel;
  s: TMixStrip;
  ins: TMixInsert;
  iid, err, plugName, key, scriptText, scriptName, scriptDir: string;
  host: TPyPluginHost;
  frm: TfrmPyPlugin;
  stripId, k: Integer;
begin
  if FProject = nil then Exit;
  if ATracker then model := FProject.TrackerMixer else model := FProject.Mixer;
  s := model.StripById(AStripId);
  if (s = nil) or (AIndex < 0) or (AIndex >= s.InsertCount) then Exit;
  ins := s.GetInsert(AIndex);
  if not SameText(ins.Kind, 'python') then Exit;
  PyPluginSetup;
  stripId := s.Id;
  iid := PyParamGet(ins.Params, 'iid');
  key := '';
  if iid <> '' then
  begin
    key := Format('%s%s:%d:%s', [WINKEY_PY_PREFIX, IfThen(ATracker, 'T', 'M'), stripId, iid]);
    for k := 0 to FOpenPyWindows.Count - 1 do
      if FOpenPyWindows[k].WindowKey = key then
      begin
        FOpenPyWindows[k].BringToFront;
        Exit;
      end;
  end;
  plugName := ChangeFileExt(PyDecode(PyParamGet(ins.Params, 'file')), '');
  host := nil;
  if iid <> '' then host := PyLive.Acquire(iid);
  if host = nil then
  begin
    if not PyInsertSource(ins.Params, scriptText, scriptName, scriptDir, err) then
    begin
      MessageDlg(err, mtWarning, [mbOK], 0);
      Exit;
    end;
    host := TPyPluginHost.Create;
    if not host.Start(scriptText, scriptName, scriptDir,
         PyDecode(PyParamGet(ins.Params, 'vals')), PyDecode(PyParamGet(ins.Params, 'state')),
         FProject.SampleRate, FProject.Channels, UDAW_DEFAULT_BUFFER_FRAMES, err) then
    begin
      host.Release;
      MessageDlg('The Python plug-in could not start:'#13#10#13#10 + err, mtError, [mbOK], 0);
      Exit;
    end;
  end;
  frm := TfrmPyPlugin.Create(Self);
  if not frm.Open(host, iid, IfThen(plugName <> '', plugName, host.Name),
       procedure(AState: string)
       begin
         PySaveInsertState(ATracker, stripId, iid, AState);
       end) then
  begin
    frm.Free;
    host.Release;
    Exit;
  end;
  host.Release;   // the window holds its own reference
  frm.WindowKey := key;
  frm.OnEditorClosing := PyWindowClosing;
  FOpenPyWindows.Add(frm);
  if key <> '' then ApplySavedGeometry(frm, FProject.Windows.Find(key));
  frm.Show;
end;

function TfrmMain.PluginCacheFile: string;
begin
  if App <> nil then
    Result := IncludeTrailingPathDelimiter(App.Paths.Config) + 'plugins.cache'
  else
    Result := '';
end;

{ The scanner, created on first use with the cached results of the last scan. }
function TfrmMain.PluginScanner: TPluginScanner;
begin
  if FPluginScan = nil then
  begin
    FPluginScan := TPluginScanner.Create;
    FPluginScan.AddDefaultRoots;
    try
      if PluginCacheFile <> '' then FPluginScan.LoadFromFile(PluginCacheFile);
    except
      on E: Exception do Logger.Warn('ui', 'Plug-in cache unreadable: ' + E.Message);
    end;
  end;
  Result := FPluginScan;
end;

{ Walks the VST2 / VST3 folders with a status-bar progress bar and per-plug-in
  names, then caches the result. Runs inline: plug-ins must be loaded on this
  thread's COM/message context anyway. }
procedure TfrmMain.ScanPluginsNow;
var
  found, i: Integer;
  msg: string;
begin
  ShowStatusProgress('Scanning for plug-ins...', 1);
  try
    found := PluginScanner.Scan(
      procedure(ADone, ATotal: Integer; const ACurrent: string)
      begin
        prgStatus.Max := Max(1, ATotal);
        UpdateStatusProgress(ADone, 'Scanning plug-ins: ' + ACurrent);
        Application.ProcessMessages;
      end);
    try
      if PluginCacheFile <> '' then PluginScanner.SaveToFile(PluginCacheFile);
    except
      on E: Exception do Logger.Warn('ui', 'Could not save plug-in cache: ' + E.Message);
    end;
  finally
    HideStatusProgress;
  end;
  msg := Format('Plug-in scan: %d effect plug-in(s) found, %d skipped (instruments / unusable).',
    [found, PluginScanner.Skipped]);
  stbMain.SimpleText := msg;
  Logger.Info('ui', msg);
  RefreshPluginsMenu(True);
  for i := 0 to PluginScanner.LastErrors.Count - 1 do
    Logger.Info('ui', 'plug-in skipped: ' + PluginScanner.LastErrors[i]);
end;

{ Probes AFileName (really loads it) and inserts it on the selected mixer strip.
  VST2 .dll, VST3 and CLAP; shared by the file dialog and the scanned list. }
procedure TfrmMain.MixAddPluginFile(const AFileName: string);
var
  pathB64, loadError, ext, plugName, kind: string;
  paramCount: Integer;
  clapProbe: TCLAPHost;
  isInst, wantsMidi: Boolean;
begin
  if (FProject = nil) or (SelectedMixStripId = 0) then Exit;
  ext := LowerCase(ExtractFileExt(AFileName));
  pathB64 := TNetEncoding.Base64.EncodeBytesToString(TEncoding.UTF8.GetBytes(AFileName));
  if ext = '.clap' then
  begin
    { CLAP: probe by really loading the module, then insert by kind }
    try
      clapProbe := TCLAPHost.Create;
      try
        clapProbe.LoadOnly(AFileName);
        plugName := clapProbe.EffectName;
      finally
        clapProbe.Free;
      end;
    except
      on E: Exception do
      begin
        MessageDlg('Not a usable plugin:'#13#10 + AFileName + #13#10#13#10 + E.Message,
          mtError, [mbOK], 0);
        Exit;
      end;
    end;
    MixPerform(TAddMixInsertCommand.Create(FProject, SelectedMixStripId,
      Copy(ext, 2, MaxInt), Format('path=%s;state=', [pathB64]), -1,
      IfThen(plugName <> '', plugName, ExtractFileName(AFileName))));
    RefreshMixerTab;
    Exit;
  end;

  if MixStripHasVst2Insert(MixCur.StripById(SelectedMixStripId), pathB64) then
  begin
    MessageDlg('That plugin is already on this strip.', mtInformation, [mbOK], 0);
    Exit;
  end;

  { VST2 / VST3: really load it first, so a bad file is refused here and not left as a broken insert }
  if not ProbePluginFile(AFileName, kind, plugName, paramCount, isInst, wantsMidi, loadError) then
  begin
    MessageDlg('Not a usable ' + UpperCase(kind) + ' plugin:'#13#10 + AFileName + #13#10#13#10 + loadError,
      mtError, [mbOK], 0);
    Exit;
  end;

  MixPerform(TAddMixInsertCommand.Create(FProject, SelectedMixStripId, kind,
    Format('path=%s;state=;paramcount=%d', [pathB64, paramCount]), -1,
    IfThen((kind = 'vst3') and (plugName <> ''), plugName, ExtractFileName(AFileName))));
  RefreshMixerTab;
  if isInst then
    stbMain.SimpleText := plugName + ' is an instrument: it plays the MIDI of the lane this strip is fed from, ' +
      'and the MIDI keyboard. Open it with Edit VST to listen.'
  else if wantsMidi then
    stbMain.SimpleText := plugName + ' takes MIDI as well as audio: it hears the lane''s MIDI and the MIDI keyboard.';
end;

procedure TfrmMain.btnMixAddVSTClick(Sender: TObject);
begin
  if (FProject = nil) or (SelectedMixStripId = 0) then Exit;
  if not dlgOpenVst.Execute then Exit;
  MixAddPluginFile(dlgOpenVst.FileName);
end;

function TfrmMain.OpenVST2EditorForInsert(AStripId, AIndex: Integer): Boolean;
var
  s: TMixStrip;
  ins: TMixInsert;
  pathB64, stateB64, path, key, kind: string;
  frm: TfrmVST2Editor;
  capturedStripId, capturedIndex, capturedParamCount: Integer;
  capturedPathB64: string;
  live: Boolean;
begin
  Result := False;
  if FProject = nil then Exit;
  s := MixCur.StripById(AStripId);
  if s = nil then Exit;
  if (AIndex < 0) or (AIndex >= s.InsertCount) then Exit;
  ins := s.GetInsert(AIndex);
  kind := LowerCase(ins.Kind);
  if (kind <> 'vst2') and (kind <> 'vst3') then Exit;

  pathB64 := MixInsertKV(ins.Params, 'path');
  stateB64 := MixInsertKV(ins.Params, 'state');
  path := TEncoding.UTF8.GetString(TNetEncoding.Base64.DecodeStringToBytes(pathB64));
  live := MixInsertKV(ins.Params, 'live') <> '0';

  capturedStripId := s.Id;
  capturedIndex := AIndex;
  capturedPathB64 := pathB64;
  capturedParamCount := StrToIntDef(MixInsertKV(ins.Params, 'paramcount'), 0);
  key := Format('%s%d:%d', [WINKEY_VST2_PREFIX, capturedStripId, capturedIndex]);

  frm := TfrmVST2Editor.Create(Self);
  { This scratch host is separate from whatever TMixerProcessor node exists
    at render time (see UDAW.UI.VST2Editor's header comment) - Save writes
    the edited state back into the mixer model as an ordinary undo-safe
    TSetMixInsertParamsCommand, same as the AI mastering assistant's insert
    tuning. }
  if not frm.OpenPlugin(kind, path, stateB64, FProject.SampleRate, UDAW_DEFAULT_BUFFER_FRAMES,
    FProject.Channels, live,
    procedure(ANewState: string)
    begin
      MixPerform(TSetMixInsertParamsCommand.Create(FProject, capturedStripId, capturedIndex,
        Format('path=%s;state=%s;paramcount=%d;live=%d',
          [capturedPathB64, ANewState, capturedParamCount, Ord(frm.LiveMidi)])));
      RefreshMixerTab;
    end) then
  begin
    frm.Free;
    Exit;
  end;
  frm.WindowKey := key;
  frm.OnEditorClosing := VST2EditorClosing;
  FOpenVST2Editors.Add(frm);
  ApplySavedGeometry(frm, FProject.Windows.Find(key));
  frm.Show;
  Result := True;
end;

procedure TfrmMain.VST2EditorClosing(Sender: TObject);
var
  frm: TfrmVST2Editor;
begin
  { See LogViewerFormClose: the user closing this plugin editor means "don't
    reopen it next time" - forget its remembered geometry rather than
    updating it, or it would keep coming back on every future project load.
    An editor still open when the project is saved/closed is captured
    separately by CaptureOpenWindowLayout. }
  frm := TfrmVST2Editor(Sender);
  if (FProject <> nil) and (frm.WindowKey <> '') then
    FProject.Windows.Remove(frm.WindowKey);
  if FOpenVST2Editors <> nil then
    FOpenVST2Editors.Remove(frm);
end;

procedure TfrmMain.btnMixEditVSTClick(Sender: TObject);
var
  s: TMixStrip;
  i, idx: Integer;
begin
  if FProject = nil then Exit;
  s := MixCur.StripById(SelectedMixStripId);
  if s = nil then Exit;
  idx := -1;
  for i := s.InsertCount - 1 downto 0 do
    if SameText(s.GetInsert(i).Kind, 'vst2') or SameText(s.GetInsert(i).Kind, 'vst3') then
    begin
      idx := i;
      Break;
    end;
  if idx < 0 then
  begin
    MessageDlg('The selected strip has no VST plugin insert. Use "Add VST..." first.',
      mtInformation, [mbOK], 0);
    Exit;
  end;
  OpenVST2EditorForInsert(s.Id, idx);
end;

