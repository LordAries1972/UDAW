end;

procedure TfrmMain.CaptureOpenWindowLayout;
var
  i, dockH, togMask: Integer;
  e: TWindowLayoutEntry;
  frm: TfrmVST2Editor;
begin
  if FProject = nil then Exit;
  if FTlView <> nil then
    FProject.Windows.Put(WINKEY_TIMELINEVIEW, Round(FTlView.PixelsPerSecond * 1000),
      Round(FTlView.ScrollSeconds * 1000), 0, 0);
  { the splitter between the lanes and the editor dock: only meaningful while the dock sits
    under the lanes (not when a full-page editor mode owns the whole tab) }
  { Left = dock height (kept from the last time it was measurable) }
  { FTlDockHeight is what the user set with the splitter (see splTlDockMoved). The panel's own height is not read here: right after a load, or while the tab is hidden, it can be a clamped stand-in, and saving that would overwrite the real position. }
  if (FTlDockHeight <= 0) and (pnlTlDock.Align = alBottom) and pnlTlDock.Visible then FTlDockHeight := pnlTlDock.Height;
  dockH := FTlDockHeight;
  e := FProject.Windows.Find(WINKEY_TIMELINESPLIT);
  if (dockH <= 0) and (e <> nil) then dockH := e.Left;
  FProject.Windows.Put(WINKEY_TIMELINESPLIT, dockH, 0, 0, 0);
  togMask := 0;
  if FVideoPanelOff then togMask := togMask or TL_TOG_VIDEO_OFF;
  if FEditorOn then togMask := togMask or TL_TOG_EDITOR_ON;
  if FStageVisible then togMask := togMask or TL_TOG_STAGE_ON;
  if FBrowserOff then togMask := togMask or TL_TOG_BROWSER_OFF;
  if FMetronomeOn then togMask := togMask or TL_TOG_METRONOME_ON;
  if not FLanesVisible then togMask := togMask or TL_TOG_LANES_OFF;
  if FChordsVisible then togMask := togMask or TL_TOG_CHORDS_ON;
  FProject.Windows.Put(WINKEY_TIMELINETOGGLES, togMask, 0, 0, 0);
  FProject.Windows.Put(WINKEY_MIXERVIEW, Ord(FMixViewTracker), 0, 0, 0);
  if (FBrowserWindow <> nil) and FBrowserWindow.Visible then
    FProject.Windows.Put(WINKEY_BROWSER, FBrowserWindow.Left, FBrowserWindow.Top,
      FBrowserWindow.Width, FBrowserWindow.Height, SavedWindowStateOf(FBrowserWindow));
  if FOpenVST2Editors <> nil then
    for i := 0 to FOpenVST2Editors.Count - 1 do
    begin
      frm := FOpenVST2Editors[i];
      if frm.WindowKey <> '' then
        FProject.Windows.Put(frm.WindowKey, frm.Left, frm.Top, frm.Width, frm.Height,
          SavedWindowStateOf(frm));
    end;
  if FOpenPyWindows <> nil then
    for i := 0 to FOpenPyWindows.Count - 1 do
      if FOpenPyWindows[i].WindowKey <> '' then
        FProject.Windows.Put(FOpenPyWindows[i].WindowKey, FOpenPyWindows[i].Left, FOpenPyWindows[i].Top,
          FOpenPyWindows[i].Width, FOpenPyWindows[i].Height, SavedWindowStateOf(FOpenPyWindows[i]));
end;

procedure TfrmMain.RestoreWindowLayout;
var
  i, stripId, idx, sep, togMask: Integer;
  e: TWindowLayoutEntry;
  keyTail: string;
begin
  if FProject = nil then Exit;

  e := FProject.Windows.Find(WINKEY_TIMELINEVIEW);
  if (e <> nil) and (FTlView <> nil) and (e.Left > 0) then
  begin
    FTlView.SetZoom(e.Left / 1000.0);
    FTlView.ScrollToSeconds(e.Top / 1000.0);
    RefreshTimelineTab;
    pbTimeline.Invalidate;
  end;

  { the Timeline's switches: a project without the entry gets the defaults (video, browser and
    lanes shown; editor, clip stage, chords and metronome off) }
  e := FProject.Windows.Find(WINKEY_TIMELINETOGGLES);
  if e <> nil then togMask := e.Left else togMask := 0;
  FVideoPanelOff := togMask and TL_TOG_VIDEO_OFF <> 0;
  FStageVisible := togMask and TL_TOG_STAGE_ON <> 0;
  TlSetBrowser(togMask and TL_TOG_BROWSER_OFF = 0);
  TlSetMetronome(togMask and TL_TOG_METRONOME_ON <> 0);
  FLanesVisible := togMask and TL_TOG_LANES_OFF = 0;
  FChordsVisible := togMask and TL_TOG_CHORDS_ON <> 0;
  TlSetEditor(togMask and TL_TOG_EDITOR_ON <> 0);
  RefreshTimelineTab;

  { the Mixer tab's Timeline / Tracker view; the Mixer tab itself refreshes right after this load }
  e := FProject.Windows.Find(WINKEY_MIXERVIEW);
  FMixViewTracker := (e <> nil) and (e.Left = 1);
  FMixRefreshing := True;   // setting the box must not run its change handler mid-load
  try
    cboMixView.ItemIndex := Ord(FMixViewTracker);
  finally
    FMixRefreshing := False;
  end;
  pnlMixEq.Title := IfThen(FMixViewTracker, 'Tracker Master Graphic 16-Band EQ', 'Master Graphic 16-Band EQ');

  e := FProject.Windows.Find(WINKEY_TIMELINESPLIT);
  if (e <> nil) and (e.Left > 0) then
  begin
    FTlDockHeight := e.Left;
    TlApplyDockHeight;
  end;

  if FProject.Windows.Find(WINKEY_BROWSER) <> nil then
    OpenBrowserWindowClick(nil);

  { Every remembered VST2 editor: key is "VST2Editor:<stripId>:<insertIndex>"
    (see OpenVST2EditorForInsert). A malformed key or an insert that no
    longer exists in this project is dropped rather than left to fail again
    on every future load. }
  for i := FProject.Windows.Entries.Count - 1 downto 0 do
  begin
    e := FProject.Windows.Entries[i];
    if not e.Key.StartsWith(WINKEY_VST2_PREFIX, True) then Continue;
    keyTail := Copy(e.Key, Length(WINKEY_VST2_PREFIX) + 1, MaxInt);
    sep := Pos(':', keyTail);
    if (sep = 0) or
       not TryStrToInt(Copy(keyTail, 1, sep - 1), stripId) or
       not TryStrToInt(Copy(keyTail, sep + 1, MaxInt), idx) then
    begin
      FProject.Windows.Remove(e.Key);
      Continue;
    end;
    if not OpenVST2EditorForInsert(stripId, idx) then
      FProject.Windows.Remove(e.Key);
  end;

  { Python plug-in windows: key is "PyPlugin:<M|T>:<stripId>:<instance id>"; the insert (with the script
    inside it) came back with the project, so the window reopens on it }
  for i := FProject.Windows.Entries.Count - 1 downto 0 do
  begin
    e := FProject.Windows.Entries[i];
    if not e.Key.StartsWith(WINKEY_PY_PREFIX, True) then Continue;
    keyTail := Copy(e.Key, Length(WINKEY_PY_PREFIX) + 1, MaxInt);   // M:12:iid
    if (Length(keyTail) < 5) or (keyTail[2] <> ':') then
    begin
      FProject.Windows.Remove(e.Key);
      Continue;
    end;
    sep := Pos(':', Copy(keyTail, 3, MaxInt));
    if (sep = 0) or not TryStrToInt(Copy(keyTail, 3, sep - 1), stripId) or
       not OpenPythonInsertWindowByIid(keyTail[1] = 'T', stripId, Copy(keyTail, 3 + sep, MaxInt)) then
      FProject.Windows.Remove(e.Key);
  end;
end;

{ Quiets the whole application before it starts shutting down: the recording is finished and saved,
  every transport (Timeline, tracker, graph, previews, the one-note audition) is stopped, the audio
  output is detached, and running background work (decoding, effect renders, exports) is cancelled,
  so nothing is still producing audio or touching the project while it is torn down. }
procedure TfrmMain.StopEverythingForClose;
begin
  tmrUI.Enabled := False;
  StopLiveRecording;
  StopAllPlayback;
  TrkFreeAudition;
  if (App <> nil) and (App.Audio <> nil) then App.Audio.ClearSource;
  if FTimelineExportJob <> nil then FTimelineExportJob.Cancel;
  if FTlFxJob <> nil then FTlFxJob.Cancel;
  if App <> nil then App.Jobs.CancelAll;
end;

procedure TfrmMain.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  StopEverythingForClose;
  CaptureOpenWindowLayout;
  FormResize(nil);
  if (App <> nil) and (App.Config <> nil) then
    if not App.Config.Save then Logger.Warn('ui', 'Could not save window state on close');
end;

procedure TfrmMain.FormDestroy(Sender: TObject);
var
  i: Integer;
begin
  FreeAndNil(FDisplay);   // the monitor goes back to the mode it had
  TimelinePumpHook := nil;
  GLDialogRecall := nil;
  GLDialogRemember := nil;
  FormResize(nil);
  if (App <> nil) and (App.Config <> nil) then
    if not App.Config.Save then Logger.Warn('ui', 'Could not save window state');
  FWindowStateReady := False;
  {$IFNDEF FPC}
  // TUDAWLicense.OnStateChanged := nil;   // registration disabled
  {$ENDIF}
  tmrUI.Enabled := False;
  StopLiveRecording;
  FreeAndNil(FFoley);   // takes its pads off the audio engine
  FreeAndNil(FOpenPyWindows);
  FreeAndNil(FOpenVST2Editors);  // does not own the forms - they free via caFree or MainForm's own ownership
  FreeAndNil(FPluginScan);
  FreeAndNil(FTrkNotation);
  FreeAndNil(FPyBridge);
  {$IFNDEF FPC}
  FreeAndNil(FKeyHooks);   // unregisters every hotkey with the OS
  {$ENDIF}
  {$IFNDEF FPC}
  DragAcceptFiles(Handle, False);
  {$ENDIF}
  if (App <> nil) and (App.Audio <> nil) and (FGraphPlaying or FWavPlaying or FTrkPlaying or FTlPlaying) then
    App.Audio.ClearSource;
  FGraphPlaying := False;
  FWavPlaying := False;
  FWavSource := nil;
  FMidiEngine := nil;
  FMidiEngineRef := nil;
  FreeAndNil(FMidiInDevice);    // closes the device (Destroy calls Close)
  FreeAndNil(FMidiOutDevice);
  FreeAndNil(FPyMidiOutBuf);
  FreeAndNil(FMidiCapture);
  TMidiSynth.SharedDrum := nil;
  DrumAudioDetach;
  FDrumIntf := nil;
  FDrum := nil;
  FreeAndNil(FDrumPanels);
  FreeAndNil(FMidiMonitorSynth);
  FTrkPlaying := False;
  FreeAndNil(FTrkPlayer);
  TrkFreeAudition;
  FTlPlaying := False;
  FreeAndNil(FTlVideo);
  FreeAndNil(FTlThumbnailer);
  FreeAndNil(FTlFxThumbA);
  FreeAndNil(FTlFxThumbB);
  FreeAndNil(FTlFxBmp);
  FreeAndNil(FTlThumbBmp);
  FreeAndNil(FTlPlayer);
  FreeAndNil(FTlCacheHolder);
  FTlWaveformWarned.Free;
  if FCacheThread <> nil then
  begin
    FCacheCancel := True;
    while FCacheThread <> nil do CheckSynchronize(20);   // lets its OnTerminate run
    CheckSynchronize(0);                                 // and any progress still queued
  end;
  if App <> nil then
  begin
    App.Jobs.CancelAll;
    App.Jobs.WaitAll; // workers must finish before caller-owned jobs are freed
  end;
  if FRecoverySessionActive then
    FRecovery.EndSessionClean;
  FRecovery.Free;
  FComp.Free;
  FCompLane.Free;
  FRec.Free;
  FRecovery2.Free;
  FMixSession.Free;
  FMasterSession.Free;
  FCmds.Free;
  FProject.Free;
  FGraph.Free;
  FTlView.Free;
  FTlSpectrum.Free;
  for i := 0 to FTrackedJobs.Count - 1 do
    TJob(FTrackedJobs[i]).Free;
  FTrackedJobs.Free;
  FScopeSpectrum.Free;
  FScopeSpectrogram.Free;
  FScopeGonio.Free;
  FScopeCapture.Free;
  FAiMcpServers.Free;
  FMcpServer.Free;
  FMcpBridge.Free;
  FSunoRefCapture.Free; // discards any in-progress reference recording, same as a cancelled take
  FSunoRefs.Free;
end;

procedure TfrmMain.FormResize(Sender: TObject);
begin
  DrumFitToPage;
  if (FDisplay <> nil) and FDisplay.IsFullScreen then Exit;   // a full screen window is not the size to remember
  if not FWindowStateReady or (App = nil) or (App.Config = nil) then Exit;
  { minimized geometry is meaningless to persist - leave the last known good
    normal/maximized state alone until the window is normal or maximized again }
  case WindowState of
    wsNormal:
      begin
        App.Config.SetBool(CFG_SEC_UI, CFG_UI_MAXIMIZED, False);
        App.Config.SetInt(CFG_SEC_UI, CFG_UI_WIDTH, Width);
        App.Config.SetInt(CFG_SEC_UI, CFG_UI_HEIGHT, Height);
      end;
    wsMaximized:
      App.Config.SetBool(CFG_SEC_UI, CFG_UI_MAXIMIZED, True);
  end;
end;

{ Single source of truth for every app-focused key hook (fixed rows below) plus
  the live state of every global/system-wide hook owned by FKeyHooks, so the
  Settings > Key Hooks list can never drift from what FormKeyDown/WMHotKey
  actually does. Fixed rows have Data = nil (not reassignable); global-hook
  rows have Data = Pointer(hookIndex + 1) so btnKeyHookAssignClick and
  FormKeyDown's capture-mode branch can find the matching FKeyHooks entry. }
const
  KeyHookTable: array[0..44] of record
    Action, Keys, Context, Description: string;
  end = (
    (Action: 'Project: New'; Keys: 'Ctrl+N'; Context: 'Global (not while typing in a text field)'; Description: 'Starts a new, empty project (asks first if the current one has unsaved changes).'),
    (Action: 'Undo'; Keys: 'Ctrl+Z'; Context: 'Global (not while typing in a text field)'; Description: 'Reverses the last edit. Every tab shares one undo history, so this works the same wherever you are.'),
    (Action: 'Redo'; Keys: 'Ctrl+Y or Ctrl+Shift+Z'; Context: 'Global (not while typing in a text field)'; Description: 'Re-applies the edit you just undid.'),
    (Action: 'Delete active channel (Timeline track + Mixer strip)'; Keys: 'Delete'; Context: 'Timeline tab'; Description: 'Removes the selected Timeline track and the Mixer strip it feeds (two undoable steps). Refused while anything is playing.'),
    (Action: 'Delete selected clip'; Keys: 'Backspace'; Context: 'Timeline tab, with a clip selected'; Description: 'Deletes only the selected clip and leaves its track in place.'),
    (Action: 'New Timeline (add channel)'; Keys: 'Insert'; Context: 'Timeline tab'; Description: 'Adds a new audio track below the existing ones.'),
    (Action: 'Go to start of Timeline'; Keys: 'Home'; Context: 'Timeline tab'; Description: 'Moves the playhead to 0:00.'),
    (Action: 'Go to end of Timeline'; Keys: 'End'; Context: 'Timeline tab'; Description: 'Moves the playhead to the end of the last clip.'),
    (Action: 'Project: Open'; Keys: 'Ctrl+O'; Context: 'Global (not while typing in a text field)'; Description: 'Opens a saved project file.'),
    (Action: 'Project: Save'; Keys: 'Ctrl+S'; Context: 'Global (not while typing in a text field)'; Description: 'Saves the project (asks for a name the first time).'),
    (Action: 'Project: Save As'; Keys: 'Ctrl+Shift+S'; Context: 'Global (not while typing in a text field)'; Description: 'Saves the project under a new name or in a new place.'),
    (Action: 'Pan the Timeline horizontally'; Keys: 'Middle mouse button + drag'; Context: 'Timeline tab'; Description: 'Slides the view left and right without moving the playhead or any clip.'),
    (Action: 'Position the playhead (start point)'; Keys: 'Left click'; Context: 'Timeline ruler (top time area) only'; Description: 'Sets where playback starts and where Space plays from.'),
    (Action: 'Highlight / select a time range'; Keys: 'Left mouse button + drag'; Context: 'Timeline ruler or empty lane space'; Description: 'Marks a time range that Cut, Copy, Fade, Normalize and the other range commands then act on.'),
    (Action: 'Move the selected range'; Keys: 'Right mouse button + drag'; Context: 'Timeline lane, with a range selected'; Description: 'Drags the highlighted range, with its audio, to a new position.'),
    (Action: 'Open Timeline context menu'; Keys: 'Right click (no drag)'; Context: 'Timeline lane / ruler'; Description: 'Shows the commands that apply to whatever is under the mouse.'),
    (Action: 'Resize the channel header column'; Keys: 'Left mouse button + drag'; Context: 'Timeline, header-side edge of the column divider'; Description: 'Makes the track-name column wider or narrower.'),
    (Action: 'Move clip(s)'; Keys: 'Left mouse button + drag'; Context: 'Timeline, on a clip'; Description: 'Moves the clip, or all selected clips together, in time and between tracks.'),
    (Action: 'Duplicate clip(s) while dragging'; Keys: 'Alt + left drag'; Context: 'Timeline, on a clip'; Description: 'Drags a copy and leaves the original where it was.'),
    (Action: 'Add to / toggle clip selection'; Keys: 'Ctrl or Shift + click'; Context: 'Timeline, on a clip'; Description: 'Builds up a selection of several clips for moving, nudging, locking or deleting together.'),
    (Action: 'Rubber-band select clips'; Keys: 'Ctrl or Shift + left drag'; Context: 'Timeline, empty lane space'; Description: 'Draws a box that selects every clip it touches.'),
    (Action: 'Zoom the Timeline'; Keys: 'Mouse wheel'; Context: 'Timeline tab'; Description: 'Zooms the time axis in and out around the mouse.'),
    (Action: 'Split clip at the playhead'; Keys: 'S'; Context: 'Timeline tab'; Description: 'Cuts the selected clip in two at the playhead.'),
    (Action: 'Add marker at the playhead'; Keys: 'M'; Context: 'Timeline tab'; Description: 'Drops a named marker at the playhead; , and . jump between markers.'),
    (Action: 'Toggle loop playback'; Keys: 'L'; Context: 'Timeline tab'; Description: 'Turns looping of the loop region on or off.'),
    (Action: 'Set loop start'; Keys: '['; Context: 'Timeline tab'; Description: 'Makes the playhead position the start of the loop region.'),
    (Action: 'Set loop end'; Keys: ']'; Context: 'Timeline tab'; Description: 'Makes the playhead position the end of the loop region.'),
    (Action: 'Zoom to fit'; Keys: 'F'; Context: 'Timeline tab'; Description: 'Zooms so the whole project is visible.'),
    (Action: 'Zoom to selection'; Keys: 'Z'; Context: 'Timeline tab'; Description: 'Zooms so the selected range or clip fills the view.'),
    (Action: 'Zoom in'; Keys: '+'; Context: 'Timeline tab'; Description: 'Zooms in one step.'),
    (Action: 'Zoom out'; Keys: '-'; Context: 'Timeline tab'; Description: 'Zooms out one step.'),
    (Action: 'Previous marker'; Keys: ','; Context: 'Timeline tab'; Description: 'Moves the playhead to the marker before it.'),
    (Action: 'Next marker'; Keys: '.'; Context: 'Timeline tab'; Description: 'Moves the playhead to the marker after it.'),
    (Action: 'Nudge selected clip(s)'; Keys: 'Left / Right arrow'; Context: 'Timeline tab, with clips selected'; Description: 'Moves the selection one snap-grid step earlier or later (a few pixels when snapping is off).'),
    (Action: 'Nudge selected clip(s) coarsely'; Keys: 'Shift + Left / Right arrow'; Context: 'Timeline tab, with clips selected'; Description: 'Moves the selection four grid steps at a time.'),
    (Action: 'Play / stop the Timeline'; Keys: 'Space'; Context: 'Timeline tab, when no button or list has the focus'; Description: 'Starts playback from the playhead, or stops it (the playhead rewinds to where it started).'),
    (Action: 'Play the Timeline from the beginning'; Keys: 'Shift + Space'; Context: 'Timeline tab, when no button or list has the focus'; Description: 'Starts playback from 0:00 whatever the playhead says.'),
    (Action: 'Cut'; Keys: 'Ctrl+X'; Context: 'Timeline tab'; Description: 'Cuts the highlighted range, or the selected clip, to the clipboard.'),
    (Action: 'Copy'; Keys: 'Ctrl+C'; Context: 'Timeline tab'; Description: 'Copies the highlighted range, or the selected clip, to the clipboard.'),
    (Action: 'Paste'; Keys: 'Ctrl+V'; Context: 'Timeline tab'; Description: 'Pastes the clipboard at the playhead.'),
    (Action: 'Lock / unlock selected clip(s)'; Keys: 'Ctrl+L'; Context: 'Timeline tab, with clips selected'; Description: 'A locked clip cannot be moved, trimmed, split or deleted until unlocked.'),
    (Action: 'Move the selected track up'; Keys: 'Ctrl + Up arrow'; Context: 'Timeline tab, with a track selected'; Description: 'Swaps the track with the one above it (its Mixer strip follows).'),
    (Action: 'Move the selected track down'; Keys: 'Ctrl + Down arrow'; Context: 'Timeline tab, with a track selected'; Description: 'Swaps the track with the one below it.'),
    (Action: 'Previous main tab'; Keys: 'Ctrl + Page Up'; Context: 'Global (not while typing in a text field)'; Description: 'Switches to the tab on the left (Timeline, Mixer, Tracker ...).'),
    (Action: 'Next main tab'; Keys: 'Ctrl + Page Down'; Context: 'Global (not while typing in a text field)'; Description: 'Switches to the tab on the right.')
  );

procedure TfrmMain.LoadKeyHooksTab;
var
  i: Integer;
  it: TGLListItem;
  {$IFNDEF FPC}
  h: TKeyHookDef;
  status: string;
  {$ENDIF}
begin
  lvKeyHooks.Items.BeginUpdate;
  try
    lvKeyHooks.Items.Clear;
    for i := Low(KeyHookTable) to High(KeyHookTable) do
    begin
      it := lvKeyHooks.Items.Add;
      it.Caption := KeyHookTable[i].Action;
      it.SubItems.Add(KeyHookTable[i].Keys);
      it.SubItems.Add(KeyHookTable[i].Context);
      it.SubItems.Add(KeyHookTable[i].Description);
      it.SubItems.Add('built-in (not reassignable)');
      it.Data := nil;
    end;
    {$IFNDEF FPC}
    if FKeyHooks <> nil then
      for i := 0 to FKeyHooks.Count - 1 do
      begin
        h := FKeyHooks.GetHook(i);
        it := lvKeyHooks.Items.Add;
        it.Caption := KeyHookActionName(h.Action);
        it.SubItems.Add(FKeyHooks.KeysToString(h.Modifiers, h.VirtualKey));
        it.SubItems.Add('Global (works even when UDAW is not the focused window)');
        it.SubItems.Add(KeyHookDescription(h.Action));
        if not h.Enabled then status := 'disabled'
        else if h.Registered then status := 'OK'
        else status := 'FAILED: ' + h.LastError;
        it.SubItems.Add(status);
        it.Data := Pointer(NativeInt(i + 1));
      end;
    {$ENDIF}
  finally
    lvKeyHooks.Items.EndUpdate;
  end;
end;

{$IFNDEF FPC}
{ Applies every configured global hook on startup. Failures are logged and
  left visible (per-row, with the OS error text) on the Key Hooks tab rather
  than silently dropped - see LoadKeyHooksTab. }
procedure TfrmMain.ApplyKeyHooksOnStartup;
var
  failCount: Integer;
begin
  if (App = nil) or (FKeyHooks = nil) then Exit;
  FKeyHooks.LoadFromConfig(App.Config);
  failCount := FKeyHooks.ApplyAll;
  if failCount > 0 then
    Logger.Warn('KeyHooks', Format(
      '%d global key hook(s) could not be applied at startup - see Settings > Key Hooks.',
      [failCount]))
  else
    Logger.Info('KeyHooks', 'All global key hooks applied.');
end;

{ Ctrl+Pause/Break by default: unconditional, instant, never raises - closes
  and saves whatever audio take is currently recording, regardless of which
  tab or state UDAW is in. }
procedure TfrmMain.DoEmergencyStop;
begin
  if FRecWriter <> nil then StopLiveRecording;
  stbMain.SimpleText := 'Emergency stop: recordings closed and saved.';
end;

{ Global toggle for timeline transport - lets the user start/stop playback
  from anywhere on the system without switching to the UDAW window. }
procedure TfrmMain.DoToggleTimelinePlayback;
begin
  if FTlPlaying then
  begin
    StopTimelinePlayback;
    RefreshTimelineTab;
    stbMain.SimpleText := 'Timeline playback stopped.';
  end
  else
  begin
    StartTimelinePlayback(False, False, False);
    stbMain.SimpleText := 'Timeline playback started.';
  end;
end;

{ Global "panic" - immediately silences whatever is currently playing
  (timeline, tracker, graph/WAV preview) without touching recording or video
  capture, which khaEmergencyStop already covers. }
procedure TfrmMain.DoPanicStopAudio;
begin
  if FTlPlaying then StopTimelinePlayback;
  if FTrkPlaying then btnTrkStopClick(nil);
  if (App <> nil) and (App.Audio <> nil) and (FGraphPlaying or FWavPlaying) then
    App.Audio.ClearSource;
  FGraphPlaying := False;
  FWavPlaying := False;
  RefreshTimelineTab;
  stbMain.SimpleText := 'Panic: all audio playback stopped.';
end;

{ Global master-output mute toggle. }
procedure TfrmMain.DoToggleMasterMute;
var
  master: TMixStrip;
begin
  if FProject = nil then Exit;
  master := FProject.Mixer.MasterStrip;
  if master = nil then Exit;
  master.Muted := not master.Muted;
  RefreshMixerTab;
  if master.Muted then
    stbMain.SimpleText := 'Master output muted.'
  else
    stbMain.SimpleText := 'Master output unmuted.';
end;

procedure TfrmMain.WMHotKey(var Msg: TMessage);
var
  action: TKeyHookAction;
begin
  if (FKeyHooks <> nil) and FKeyHooks.ActionForHotkeyId(Msg.WParam, action) then
  begin
    case action of
      khaEmergencyStop: DoEmergencyStop;
      khaStopRecording: if FRecWriter <> nil then StopLiveRecording;
      khaTogglePlayback: DoToggleTimelinePlayback;
      khaPanicStopAudio: DoPanicStopAudio;
      khaToggleMasterMute: DoToggleMasterMute;
    end;
    Msg.Result := 0;
  end;
end;

procedure TfrmMain.btnKeyHookAssignClick(Sender: TObject);
begin
  if lvKeyHooks.Selected = nil then
  begin
    lblKeyHooksHint.Caption := 'Select a row first, then click Assign New Key.';
    Exit;
  end;
  if NativeInt(lvKeyHooks.Selected.Data) - 1 < 0 then
  begin
    lblKeyHooksHint.Caption := 'That row is a built-in shortcut and cannot be reassigned.';
    Exit;
  end;
  FKeyHookCaptureRow := lvKeyHooks.Selected.Index;
  lblKeyHooksHint.Caption := 'Press the new key combination now (Esc to cancel)...';
end;

procedure TfrmMain.btnKeyHookSaveClick(Sender: TObject);
begin
  if (FKeyHooks = nil) or (App = nil) then Exit;
  FKeyHooks.SaveToConfig(App.Config);
  lblKeyHooksHint.Caption := 'Key hooks saved.';
  LoadKeyHooksTab;
end;

procedure TfrmMain.btnKeyHookRestoreClick(Sender: TObject);
begin
  if (FKeyHooks = nil) or (App = nil) then Exit;
  FKeyHooks.RestoreDefaults(App.Config);
  lblKeyHooksHint.Caption := 'All key hooks restored to their defaults.';
  LoadKeyHooksTab;
end;

{ Lets the user "get rid of" a hook that keeps failing (rather than only
  reassign it) - toggles Enabled and re-applies, without disturbing the
  other rows. Re-click to bring it back. }
procedure TfrmMain.btnKeyHookToggleClick(Sender: TObject);
var
  hookIdx: Integer;
  h: TKeyHookDef;
begin
  if (FKeyHooks = nil) or (lvKeyHooks.Selected = nil) then Exit;
  hookIdx := NativeInt(lvKeyHooks.Selected.Data) - 1;
  if hookIdx < 0 then
  begin
    lblKeyHooksHint.Caption := 'That row is a built-in shortcut and cannot be disabled.';
    Exit;
  end;
  h := FKeyHooks.GetHook(hookIdx);
  FKeyHooks.SetEnabled(hookIdx, not h.Enabled);
  if not h.Enabled then
    lblKeyHooksHint.Caption := KeyHookActionName(h.Action) + ' enabled - click Save to keep it.'
  else
    lblKeyHooksHint.Caption := KeyHookActionName(h.Action) + ' disabled - click Save to keep it.';
  LoadKeyHooksTab;
end;
{$ENDIF}

{ Global shortcuts (KeyPreview = True in the .dfm routes every keystroke here
  first). Delete only acts on the Timeline tab's own selection - it must not
  fire from an editbox/memo elsewhere in the form, so it's gated on both the
  active tab and the focused control not being a text-editing one. Undo/Redo
  are safe everywhere: FCmds is the one shared TCommandManager every tab's
  own Undo/Redo buttons already call (see btnTlUndoClick etc.), so Ctrl+Z/
  Ctrl+Y here is just another caller of the same thing.
  Every branch below corresponds to one row of KeyHookTable above - keep both
  in sync when adding, removing or rebinding a shortcut. }
{ The Timeline tab's transport / clipboard keys that are not plain letters: Space, Shift+Space and
  the Ctrl combinations. Space is left to a focused button, check box or list (it activates them);
  Ctrl+X / C / V are the Tracker grid's own while that grid has the focus (TrkGridKey runs first). }
function TfrmMain.TlTransportKey(var Key: Word; Shift: TShiftState): Boolean;
begin
  Result := True;
  if FProject = nil then Exit(False);
  if (Key = VK_SPACE) and ((Shift = []) or (Shift = [ssShift])) then
  begin
    if (ActiveControl is TGLButton) or (ActiveControl is TGLCheck) or (ActiveControl is TGLList) or
       (ActiveControl is TGLTree) or (ActiveControl is TGLListView) or (ActiveControl is TGLCombo) then
      Exit(False);
    if FTlPlaying then btnTlStopClick(Self)
    else if Shift = [ssShift] then TlPlayFromBeginningClick(Self)
    else btnTlPlayClick(Self);
  end
  else if Shift = [ssCtrl] then
    case Key of
      Ord('X'): btnTlCutClick(Self);
      Ord('C'): btnTlCopyClick(Self);
      Ord('V'): btnTlPasteClick(Self);
      Ord('L'): btnTlLockClipClick(Self);
      VK_UP, VK_DOWN:
        begin
          if FTlSelectedTrackId >= 0 then FTlCtxTrackId := FTlSelectedTrackId;
          if Key = VK_UP then btnTlTrackUpClick(Self) else btnTlTrackDownClick(Self);
        end;
    else
      Result := False;
    end
  else
    Result := False;
end;

{ the main menu is drawn by mbMain (the form's own Menu is unassigned), so its
  shortcut keys are offered to the TMainMenu here }
function TfrmMain.IsShortCut(var Message: TWMKey): Boolean;
begin
  Result := inherited IsShortCut(Message);
  if not Result and (mnuMain <> nil) then Result := mnuMain.IsShortCut(Message);
end;

procedure TfrmMain.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
var
  inTextEditor: Boolean;
  {$IFNDEF FPC}
  mods: Word;
  err: string;
  hookIdx: Integer;
  {$ENDIF}
begin
  {$IFNDEF FPC}
  if FKeyHookCaptureRow >= 0 then
  begin
    if Key in [VK_CONTROL, VK_MENU, VK_SHIFT, VK_LWIN, VK_RWIN] then
      Exit;   // wait for a real key, not the modifier being held on the way there
    hookIdx := NativeInt(lvKeyHooks.Items[FKeyHookCaptureRow].Data) - 1;
    if Key = VK_ESCAPE then
      lblKeyHooksHint.Caption := 'Assignment cancelled - key hook unchanged.'
    else if hookIdx < 0 then
      lblKeyHooksHint.Caption := 'That row is not reassignable.'
    else
    begin
      mods := 0;
      if ssCtrl in Shift then mods := mods or MOD_CONTROL;
      if ssAlt in Shift then mods := mods or MOD_ALT;
      if ssShift in Shift then mods := mods or MOD_SHIFT;
      if FKeyHooks.TrySetKeys(hookIdx, mods, Key, err) then
        lblKeyHooksHint.Caption := 'Key hook updated - click Save to keep it.'
      else
        lblKeyHooksHint.Caption := 'Could not apply that combination: ' + err;
    end;
    FKeyHookCaptureRow := -1;
    LoadKeyHooksTab;
    Key := 0;
    Exit;
  end;
  {$ENDIF}
  inTextEditor := (ActiveControl is TCustomEdit) or (ActiveControl is TCustomMemo) or (ActiveControl is TGLEdit);
  if inTextEditor then Exit;   // leave native single-field undo/typing alone

  { the Foley pads take their keys while the Foley page is in front }
  if (Shift * [ssCtrl, ssAlt] = []) and FoleyPageShowing and (TFoleySampler.PadForKey(Key) >= 0) then
  begin
    FoleyEnsure;
    if FFoley.KeyDown(TFoleySampler.PadForKey(Key)) then
      FFoley.Hit(TFoleySampler.PadForKey(Key), True, chkFoleyTimeline.Checked, chkFoleyRecord.Checked);
    Key := 0;
    Exit;
  end;

  { the Tracker's pattern grid takes its own editing keys while it has the focus }
  if TabIs(tabTracker) and (pgcTrk.ActivePage = tsTrkModule) and pbTracker.Focused then
    if TrkGridKey(Key, Shift) then Exit;

  if (Key = Ord('Z')) and (Shift = [ssCtrl]) then
  begin
    FCmds.Undo;
    RefreshTimelineTab;
    Key := 0;
    Exit;
  end;
  if ((Key = Ord('Y')) and (Shift = [ssCtrl])) or
     ((Key = Ord('Z')) and (Shift = [ssCtrl, ssShift])) then
  begin
    FCmds.Redo;
    RefreshTimelineTab;
    Key := 0;
    Exit;
  end;

  { Ctrl+Page Up / Page Down: the previous / next main tab }
  if (Shift = [ssCtrl]) and ((Key = VK_PRIOR) or (Key = VK_NEXT)) then
  begin
    pgc.SelectNextPage(Key = VK_NEXT);
    Key := 0;
    Exit;
  end;

  if (pgc.ActivePage = tabTimeline) and not DockHasFocus and TlTransportKey(Key, Shift) then
  begin
    Key := 0;
    Exit;
  end;

  if (pgc.ActivePage = tabTimeline) and not DockHasFocus and TlHotKey(Key, Shift) then
  begin
    Key := 0;
    Exit;
  end;

  if (Shift = []) and (pgc.ActivePage = tabTimeline) and not DockHasFocus then
    case Key of
      VK_DELETE:
        begin
          DeleteActiveChannel;
          Key := 0;
        end;
      VK_BACK:
        begin
          if FTlSelClipId >= 0 then
            btnTlDeleteClipClick(Self);
          Key := 0;
        end;
      VK_INSERT:
        begin
          btnTlAddTrackClick(Self);
          Key := 0;
        end;
      VK_HOME:
        begin
          btnTlGoStartClick(Self);
          Key := 0;
        end;
      VK_END:
        begin
          btnTlGoEndClick(Self);
          Key := 0;
        end;
    end;
end;

{ DEL: removes the active channel (last-selected/clicked Timeline track) and
  the Mixer strip fed by it, as two undoable commands. Refused during
  playback for the same reason btnMixRemoveClick is. }
procedure TfrmMain.DeleteActiveChannel;
var
  trackId, j: Integer;
  stripId: Integer;
begin
  if FProject = nil then Exit;
  trackId := FTlSelectedTrackId;
  if trackId < 0 then trackId := FTlCtxTrackId;
  if (trackId < 0) or (FProject.Timeline.TrackById(trackId) = nil) then Exit;
  if FGraphPlaying or FWavPlaying or FTrkPlaying or FTlPlaying then Exit;
  stripId := 0;
  for j := 0 to FProject.Mixer.StripCount - 1 do
    if FProject.Mixer.GetStrip(j).InputSourceId = trackId then
    begin
      stripId := FProject.Mixer.GetStrip(j).Id;
      Break;
    end;
  try
    if stripId <> 0 then
      FCmds.Perform(TRemoveMixStripCommand.Create(FProject, stripId));
  except
    on E: EUDAWError do ;  // strip may be non-removable; still remove the track
  end;
  FTlCtxTrackId := trackId;
  btnTlRemoveTrackClick(Self);
  RefreshMixerTab;
end;

{ ---- Diagnostics > System: the full system report ---- }

{ what only the application knows, added to the machine report: its own start-up summary, the
  project, the OpenGL driver (with every extension), the screen mode settings and the render rate }
procedure TfrmMain.SysInfoAddApplication(AInfo: TSysInfo);
var
  ln, key, val: string;
  p: Integer;
  rep, ext: TArray<string>;
  e: string;
  cur: TDisplayMode;
begin
  if App <> nil then
    for ln in App.DescribeStartup.Split([sLineBreak]) do
    begin
      if Trim(ln) = '' then Continue;
      if ln[1] <> ' ' then
      begin
        AInfo.Section('UDAW - ' + Trim(ln));
        Continue;
      end;
      p := Pos(' : ', ln);
      if p = 0 then p := Pos(' = ', ln);
      if p > 0 then AInfo.Row(Trim(Copy(ln, 1, p - 1)), Trim(Copy(ln, p + 3, MaxInt)))
      else AInfo.Row(Trim(ln), '');
    end;

  AInfo.Section('UDAW - project');
  if FProject = nil then
    AInfo.Row('Project', '(none open)')
  else
  begin
    AInfo.Row('Name', FProject.Name);
    AInfo.Row('File', IfThen(FProject.FileName = '', '(not saved yet)', FProject.FileName));
    AInfo.Row('Unsaved changes', IfThen(FProject.Dirty, 'yes', 'no'));
    AInfo.Row('Tempo / time signature', '%s BPM, %d/%d', [FloatToStr(FProject.TempoBPM), FProject.TimeSigNum, FProject.TimeSigDen]);
    AInfo.Row('Sample rate / channels', '%d Hz / %d', [FProject.SampleRate, FProject.Channels]);
    AInfo.Row('Timeline tracks / clips / sources', '%d / %d / %d', [FProject.Timeline.TrackCount,
      FProject.Timeline.ClipCountTotal, FProject.Timeline.SourceCount]);
    AInfo.Row('Mixer strips', IntToStr(FProject.Mixer.StripCount));
    AInfo.Row('Undo steps available', IntToStr(FCmds.UndoCount));
    AInfo.Row('Score line spacing', '%d %%', [Round(FProject.ScoreSpread * 100)]);
  end;

  AInfo.Section('OpenGL (graphics driver)');
  ext := nil;
  rep := GLDriverReport;
  for ln in rep do
  begin
    p := Pos('|', ln);
    if p = 0 then Continue;
    key := Copy(ln, 1, p - 1);
    val := Copy(ln, p + 1, MaxInt);
    if key = 'extension' then ext := ext + [val] else AInfo.Row(key, val);
  end;
  AInfo.Row('GL surfaces in this window', IntToStr(FGlSurfaceCount));
  AInfo.Row('Render rate - busiest surface', '%.1f frames per second', [FGlFps]);
  AInfo.Row('Render rate - all surfaces together', '%.1f draws per second', [FGlDraws]);

  AInfo.Section('UDAW - screen mode');
  if FDisplay <> nil then
  begin
    AInfo.Row('Screen mode', ScreenModeName(FDisplay.Mode));
    AInfo.Row('Monitor in use', IfThen(FDisplay.Device = '', '(window on its own monitor)', FDisplay.Device));
    if (FDisplay.Device <> '') and CurrentDisplayMode(FDisplay.Device, cur) then
      AInfo.Row('Monitor mode now', DisplayModeText(cur));
  end;
  AInfo.Row('Window', '%d x %d at %d,%d', [Width, Height, Left, Top]);
  AInfo.Row('Client area', '%d x %d', [ClientWidth, ClientHeight]);
  AInfo.Row('Frame rate display', IfThen(mbMain.StatusText <> '', 'shown', 'hidden'));

  AInfo.Section(Format('OpenGL extensions (%d)', [Length(ext)]));
  for e in ext do AInfo.Row(e, 'supported');
end;

procedure TfrmMain.RefreshSystemTab;
var
  info: TSysInfo;
  rows, i: Integer;
begin
  info := TSysInfo.Create;
  try
    CollectSystemInfo(info,
      procedure(AInfo: TSysInfo)
      begin
        SysInfoAddApplication(AInfo);
      end);
    ivSystem.SetReport(info);
    rows := 0;
    for i := 0 to info.Count - 1 do
      if info[i].Kind = sikRow then Inc(rows);
    lblSysCount.Caption := Format('%d rows, collected %s', [rows, FormatDateTime('hh:nn:ss', Now)]);
