  memSunoLyrics.Visible := chkSunoCustom.Checked;
  lblSunoLyricsCount.Visible := chkSunoCustom.Checked;
  lblSunoStyle.Visible := chkSunoCustom.Checked;
  edtSunoStyle.Visible := chkSunoCustom.Checked;
