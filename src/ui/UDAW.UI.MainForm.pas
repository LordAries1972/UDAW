  for i := Low(TABLE) to High(TABLE) do
  begin
    c := FindComponent(TABLE[i][0]);
    if c is TControl then
      TControl(c).Hint := TABLE[i][1] + #10 + TABLE[i][2];
  end;
  for i := Low(TABLE2) to High(TABLE2) do
  begin
    c := FindComponent(TABLE2[i][0]);
