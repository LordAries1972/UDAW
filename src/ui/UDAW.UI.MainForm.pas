const
  { [ui] - persisted main-window geometry (Settings has no tab for this; it's
    saved automatically on every resize and restored at startup). }
  CFG_SEC_UI        = 'ui';
  CFG_UI_WIDTH      = 'window_width';
  CFG_UI_HEIGHT     = 'window_height';
  CFG_UI_MAXIMIZED  = 'window_maximized';
  CFG_UI_MIXER_STRIP_WIDTH = 'mixer_strip_width';  // FMixZoomFactor, persisted across sessions
  CFG_UI_METERS_SOURCE = 'meters_source';          // the Loudness and Phase window's Source box (0..2)

  { tmrUI.Interval: 500ms is fine for the log/jobs/meters polling it normally
    drives, but that's far too coarse for the Tracker tab's live row/pattern
    readout and pattern-grid highlight while the transport is running - it
    reads as a choppy jump every half second instead of a moving playhead.
    btnTrkPlayClick/btnTrkStopClick swap the timer to/from this faster rate
    for the duration of tracker playback only. }
  TRK_UI_IDLE_INTERVAL_MS = 500;
  TRK_UI_PLAY_INTERVAL_MS = 33;   // ~30 fps
  DEFAULT_TL_REFRESH_HZ = 20;     // Timeline redraws per second while playing (Settings > General)
  WM_MIXSYNC = WM_APP + 41;       // posted when the mixer strip widgets need re-laying out (MixSyncStrips)
  WM_TLSYNC  = WM_APP + 42;       // posted when the Timeline track-header widgets need re-building (TlHeaderSync)
  MIXPICK_PY_BASE = 100000;       // MixPickClick tag base for a Python plug-in picked from + FX (tag - base = FPlgEntries index)
  WM_MIXPICK = WM_APP + 44;       // posted when an effect was picked from a strip's + FX menu (the editor opens once the menu has gone)
  WM_DRUM_REFRESH = WM_APP + 43;   // posted when the drum instrument panels need rebuilding (after a panel's own click has finished)

type
  { TPaintBox (TGraphicControl) does not publish OnMouseWheel, so the DFM/LFM
    streamer raises EReadError on pbTimeline's OnMouseWheel binding at
    startup. This subclass republishes the (already-implemented) property so
    it can be set at design time / streamed from the form resource. }
  TWheelPaintBox = class(TPaintBox)
  published
    property OnMouseWheel;
  end;

  { What the transient chooser under a mixer strip's + FX / + Send button picks. }
  TMixPickKind = (pkFx, pkSend);

  { one row of the right-hand browser panel: what a double-click does (see TlRightFill) }
  TRightItem = record
    Kind, Index: Integer;
    Path: string;
  end;

  { One track's Clip Stage override: the scene (a Timeline region) it was
    launched from, or silent when the scene has nothing for that track. }
  TStageLaunch = record
    TrackId: Integer;
    SceneId: Integer;
    Silent: Boolean;
    Continuous: Boolean;   // the scene's flag: loop on and on instead of playing its region once
    StartSec, LengthSec, ActivateAt: Double;
  end;

  { what a Timeline clip is, for the icon at its left end and the editor that icon opens }
  TTlClipKind = (ckAudio, ckMidi, ckTracker, ckPattern, ckVideo);

  { Timeline range clipboard (Cut/Copy/Paste Selection) - everything that
    lives inside the copied time range, not only the audio: each clip slice
    with its rendered effect regions, the markers and regions in the range,
    and the title band of every channel copied from. }
  TTlRangeClip = record
    State: TClipState;     // sliced to the range (see CaptureTimelineClipSlice)
    RelStart: Double;      // slice start - range start
    RelTrack: Integer;     // channel index relative to the anchor channel
  end;
  TTlRangeMarker = record
    Name: string;
    RelSeconds: Double;
  end;
  TTlRangeRegion = record
    Name: string;
    RelStart, LengthSeconds: Double;
    Color: Integer;
  end;
  TTlRangeTitle = record
    RelTrack: Integer;
    Title: string;
  end;
  { enough of a TMediaSource to re-register it when a paste lands in a
    project (or a reloaded one) that no longer has that source id }
  TTlClipboardSource = record
    Id: Integer;
    Path: string;
    SampleRate, Channels: Integer;
    FrameCount: Int64;
    Kind: TMediaKind;
  end;

  { raised by UpdateStatusProgress when the user presses Esc during a status-bar job;
    the job's own handler unwinds, the changes it made are already rolled back }
  EJobCancelled = class(EAbort);

  { one entry of the Plugins menu: a Python script, or a scanned VST2 / VST3 effect }
  TPlgEntry = record
    Name, Path, Group: string;   // Group: sub-folder (Python) / vendor (VST)
    Kind: Integer;               // 0 Python, 1 VST2, 2 VST3
  end;

