function Mp4FmtFromCombo(AIndex: Integer): TMP4EncodeCodec;
begin
  case AIndex of
    1: Result := mecPCM24;
    2: Result := mecFloat32;
  else
    Result := mecPCM16;
  end;
end;

procedure TfrmMain.btnMp4ExportToneClick(Sender: TObject);
var
  sr, i, ch: Integer;
  pcm: TAudioPlanar;
begin
  if not RequireRegistration('Exporting MP4') then Exit;
  if not dlgSaveMp4.Execute then Exit;
  sr := 48000;
  EnsurePlanar(pcm, 2, sr);   // 1 s stereo
  for ch := 0 to 1 do
    for i := 0 to sr - 1 do
      pcm[ch][i] := 0.5 * FastSin(2 * Pi * (330.0 + ch * 110.0) * i / sr);
  try
    if Mp4EncodeAudioToFile(pcm, sr, Mp4FmtFromCombo(cboMp4Fmt.ItemIndex), dlgSaveMp4.FileName) then
      memMp4.Lines.Text := Format('exported %s (%s, %d Hz stereo, 1.0 s)',
        [ExtractFileName(dlgSaveMp4.FileName), cboMp4Fmt.Text, sr])
    else
      memMp4.Lines.Text := 'export produced no file';
    Logger.Info('ui', 'MP4 test tone exported: ' + dlgSaveMp4.FileName);
  except
    on E: Exception do
      memMp4.Lines.Text := 'export FAILED: ' + E.Message;
  end;
end;

procedure TfrmMain.btnMp4RoundTripClick(Sender: TObject);
var
  sr, i, ch: Integer;
  pcm: TAudioPlanar;
  bytes: TBytes;
  dres: TMP4DecodeResult;
  info: TMP4ProbeInfo;
begin
  sr := 44100;
  EnsurePlanar(pcm, 2, sr);
  for ch := 0 to 1 do
    for i := 0 to sr - 1 do
      pcm[ch][i] := 0.5 * FastSin(2 * Pi * (440.0 + ch * 220.0) * i / sr);
  try
    if not Mp4EncodeAudio(pcm, sr, Mp4FmtFromCombo(cboMp4Fmt.ItemIndex), bytes) then
    begin memMp4.Lines.Text := 'encode failed'; Exit; end;
    Mp4Probe(bytes, info);
    if not Mp4DecodeAudio(bytes, dres) then
    begin memMp4.Lines.Text := 'decode of the encoded stream failed'; Exit; end;
    memMp4.Lines.Text := Format(
      'PCM-in-MP4 round-trip OK'#13#10 +
      '  wrote     : %d bytes, %s'#13#10 +
      '  container : MP4 (%s)   codec: %s'#13#10 +
      '  decoded   : %d Hz, %d ch, %d frames'#13#10 +
      '  decodable : %s',
      [Length(bytes), cboMp4Fmt.Text, info.MajorBrand, info.CodecName,
       dres.SampleRate, dres.Channels, dres.Frames, BoolToStr(info.Decodable, True)]);
  except
    on E: Exception do
      memMp4.Lines.Text := 'round-trip FAILED: ' + E.Message;
  end;
end;

{ Import the selected MP4/M4A onto the timeline as an undoable non-destructive
  clip (TImportMp4Command), mirroring the MP3 add-clip path. }
procedure TfrmMain.btnMp4ToTimelineClick(Sender: TObject);
var
  tl: TTimeline;
  cmd: TImportMp4Command;
  i: Integer;
begin
  if FProject = nil then
  begin
    memMp4.Lines.Insert(0, 'open or create a project first');
    Exit;
  end;
  if not dlgOpenMp4.Execute then Exit;
  try
    if not Mp4SniffFile(dlgOpenMp4.FileName) then
    begin
      memMp4.Lines.Insert(0, 'not an MP4/M4A: ' + dlgOpenMp4.FileName);
      Exit;
    end;
    tl := FProject.Timeline;

    { Sound and picture land on separate channels at the same start time: an
      audio channel for the sound, a video channel for the picture. Only the
      channels the file actually needs are created. }
    cmd := TImportMp4Command.Create(FProject, -1, dlgOpenMp4.FileName,
      FTlView.Snap(tl.PlayheadSeconds), 0);
    try
      cmd.Resolve;
    except
      cmd.Free;
      raise;
    end;
    { every sound stream of the file gets its own track, decoded into the cache }
    for i := 0 to cmd.AudioStreamCount - 1 do
      cmd.SetStreamTrack(i, TlNewAudioTrackId);
    if cmd.HasVideo then cmd.VideoTrackId := TlNewVideoTrackId;
    FCmds.Perform(cmd);
    for i := 0 to cmd.AudioStreamCount - 1 do
      WarmClipWaveform(cmd.AudioStreams[i].SourceId);
    FMp4Path := dlgOpenMp4.FileName;
    memMp4.Lines.Text := 'imported onto timeline: ' + dlgOpenMp4.FileName;
    for i := 0 to cmd.AudioStreamCount - 1 do
      with cmd.AudioStreams[i] do
        memMp4.Lines.Add(Format('  sound %d: %s, %d Hz, %d ch, %.3f s  (clip id %d, cached)',
          [i + 1, CodecName, SampleRate, Channels, LenSeconds, ClipId]));
    if cmd.AudioSkipNote <> '' then
      memMp4.Lines.Add('  ' + cmd.AudioSkipNote);
    if cmd.HasVideo then
      memMp4.Lines.Add(Format('  video: %s, %dx%d, %.3f s  (clip id %d)',
        [cmd.ImportedVideoCodecName, cmd.ImportedVideoWidth, cmd.ImportedVideoHeight,
         cmd.ImportedVideoLengthSeconds, cmd.CreatedVideoClipId]));
    Logger.Info('ui', 'MP4 imported to timeline: ' + dlgOpenMp4.FileName);
    if cmd.HasAudio then ApplyBaselineTempoOnImport(cmd.CreatedClipId);
    RefreshTimelineTab;
  except
    on E: Exception do
      memMp4.Lines.Insert(0, 'timeline import FAILED: ' + E.Message);
  end;
end;

{ Audition an MP4/M4A straight through the audio engine with a seekable
  streaming source (TMP4StreamSource). PCM-in-MP4 and MP3-in-MP4 play today;
  AAC-LC .m4a raises until Phase 16b's codebook tables land. }
procedure TfrmMain.btnMp4PlayClick(Sender: TObject);
var
  fn: string;
  src: TMP4StreamSource;
  devRate, devCh: Integer;
  t0: Cardinal;
  decodeMs: Cardinal;
  prevCursor: TCursor;
  engineStateMsg: string;
  openOk: Boolean;
begin
  if (FMp4Path <> '') and FileExists(FMp4Path) then
    dlgOpenMp4.FileName := FMp4Path;
  if not dlgOpenMp4.Execute then Exit;
  fn := dlgOpenMp4.FileName;
  try
    if not Mp4SniffFile(fn) then
    begin
      memMp4.Lines.Insert(0, 'not an MP4/M4A: ' + fn);
      Exit;
    end;
    FMp4Path := fn;

    { Decoding the whole file up front (TMP4StreamSource's design - see its
      header comment) runs synchronously on this, the UI thread.  For a
      several-minute file that is several seconds of real work with nothing
      on screen to show for it - which reads as a hang.  Give visible
      feedback before it starts and report how long it actually took, so a
      slow decode is at least visibly a decode and not an apparent freeze. }
    memMp4.Lines.Text := 'decoding "' + ExtractFileName(fn) + '" ...';
    prevCursor := Screen.Cursor;
    Screen.Cursor := crHourGlass;
    Application.ProcessMessages;
    t0 := GetTickCount;
    try
      src := TMP4StreamSource.CreateFromFile(fn, False);
    finally
      Screen.Cursor := prevCursor;
    end;
    decodeMs := GetTickCount - t0;
    FMp4Source := src;

    devRate := 0;
    devCh := 0;
    engineStateMsg := 'App is nil';
    openOk := True;
    if App <> nil then
    begin
      { Granted.SampleRate only becomes real once the device is actually
        open+running (TAudioEngine.Open negotiates the format and calls
        RefreshGranted).  Until then it reads back 0, and SetSource just
        Prepares the source against a guessed default rather than the real
        device format - which is exactly the "device rate: 0 Hz" this button
        was reporting.  Make Play self-sufficient: ensure the engine is
        actually running before attaching the source, the same way the Audio
        tab's Start button does, instead of silently assuming some other tab
        already did it this session.  Open() swallows its own exception and
        just sets aesFailed, so if the device genuinely won't open, surface
        that explicitly instead of leaving devRate=0 to look like the same
        cosmetic timing issue this used to be. }
      if App.Audio.State in [aesIdle, aesFailed] then
        openOk := App.Audio.Open(True)
      else if App.Audio.State <> aesRunning then
        App.Audio.Start;
      devRate := App.Audio.Granted.SampleRate;
      devCh := App.Audio.Granted.RenderChannels;
      engineStateMsg := Format('%s (backend %s)%s',
        [AudioEngineStateName(App.Audio.State), App.Audio.BackendName,
         IfThen(openOk, '', ' - Open() FAILED, see log')]);
      App.Audio.SetSource(FMp4Source);
    end;

    memMp4.Lines.Text := Format(
      'playing through the engine: %s'#13#10 +
      '  %s'#13#10 +
      '  file rate    : %d Hz'#13#10 +
      '  device rate  : %d Hz   %s'#13#10 +
      '  device chans : %d'#13#10 +
      '  audio engine : %s'#13#10 +
      '  decode time  : %.1f s',
      [fn, src.Name, src.SourceRate, devRate,
       IfThen(devRate = src.SourceRate, '(matches file - no resampling)',
                                        '(differs - Render resamples)'),
       devCh, engineStateMsg,
       decodeMs / 1000.0]);
    Logger.Info('ui', Format('MP4 streaming source started: %s (file %d Hz, device %d Hz/%d ch, engine %s, decode %d ms)',
      [fn, src.SourceRate, devRate, devCh, engineStateMsg, decodeMs]));
  except
    on E: Exception do
    begin
      Screen.Cursor := crDefault;
      FMp4Source := nil;
      memMp4.Lines.Insert(0, 'play FAILED: ' + E.Message);
    end;
  end;
end;

procedure TfrmMain.btnMp4StopClick(Sender: TObject);
begin
  if App <> nil then
    App.Audio.ClearSource;
  FMp4Source := nil;
  memMp4.Lines.Insert(0, 'playback stopped');
end;

{ ============================ Piano Roll tab (Phase 17) ========== }

function TfrmMain.CurrentMidiSeq: TMidiSequence;
begin
  Result := nil;
  if FProject = nil then Exit;
  if (FMidiClipIndex >= 0) and (FMidiClipIndex < FProject.Midi.ClipCount) then
    Result := FProject.Midi.Clip(FMidiClipIndex);
end;

function MidiGridDenom(AIndex: Integer): Integer;
begin
  case AIndex of
    0: Result := 4;
    1: Result := 8;
    3: Result := 32;
  else
    Result := 16;
  end;
end;

const
  MIDI_PR_LO_NOTE = 36;
  MIDI_PR_HI_NOTE = 96;

{ The piano roll's geometry: a keyboard down the left edge, a bar ruler and the
  chord lane along the top, the note grid, and the velocity lane under it. }
const
  PR_KEY_W = 62;
  PR_RULER_H = 24;
  PR_CHORD_H = 28;
  PR_VEL_H = 76;

function TfrmMain.PrGridTop: Integer;
begin
  Result := PR_RULER_H + PR_CHORD_H;
end;

function TfrmMain.PrGridBottom: Integer;
begin
  Result := Max(PrGridTop + 60, pbPianoRoll.Height - PR_VEL_H);
end;

function TfrmMain.PrSpanTicks: Int64;
var
  seq: TMidiSequence;
begin
  Result := 0;
  seq := CurrentMidiSeq;
  if seq = nil then Exit;
  Result := Max(seq.DurationTicks, seq.TicksPerBar(0) * 8);
  if Result <= 0 then Result := seq.PPQ * 32;
end;

{ timeline seconds = this clip's start (where the Timeline places it) + the clip's own time }
function TfrmMain.PrChordOffsetSec: Double;
var
  tl: TTimeline;
  i, j, id: Integer;
  c: TTimelineClip;
begin
  Result := 0;
  if (FProject = nil) or (FMidiClipIndex < 0) then Exit;
  id := FProject.Midi.IdOfIndex(FMidiClipIndex);
  tl := FProject.Timeline;
  for i := 0 to tl.TrackCount - 1 do
    for j := 0 to tl.GetTrack(i).ClipCount - 1 do
    begin
      c := tl.GetTrack(i).GetClip(j);
      if c.IsMidiClip and (c.MidiClipId = id) then
        Exit(c.StartSeconds - c.SourceOffsetSeconds);
    end;
end;

function TfrmMain.PrZoom: Double;
begin
  if FMidiZoomX < 1 then Result := 1 else Result := FMidiZoomX;
end;

function TfrmMain.PrPxPerTick: Double;
var
  span: Int64;
begin
  span := PrSpanTicks;
  if span <= 0 then Exit(1);
  Result := (pbPianoRoll.Width - PR_KEY_W) / span * PrZoom;
end;

{ where the music being played is, in this clip's ticks: the clip's own playback, or the Timeline's
  playhead while the Timeline plays. False when nothing is playing. }
function TfrmMain.PrPlayTick(out ATick: Int64): Boolean;
var
  seq: TMidiSequence;
  sec: Double;
begin
  Result := False;
  ATick := 0;
  seq := CurrentMidiSeq;
  if (seq = nil) or (FProject = nil) then Exit;
  if (FMidiEngineRef <> nil) and FMidiEngineRef.Playing then
    sec := FMidiEngineRef.PositionSeconds
  else if FTlPlaying then
    sec := FProject.Timeline.PlayheadSeconds - PrChordOffsetSec
  else
    Exit;
  if sec < 0 then Exit;
  ATick := seq.SecondsToTick(sec);
  Result := True;
end;

function TfrmMain.PrTickToX(ATick: Int64): Integer;
begin
  Result := PR_KEY_W + Round((ATick - FMidiViewStart) * PrPxPerTick);
end;

{ keep the zoomed window inside the clip }
procedure TfrmMain.PrClampView;
var
  visible: Int64;
begin
  if FMidiZoomX < 1 then FMidiZoomX := 1;
  if FMidiZoomX > 64 then FMidiZoomX := 64;
  visible := Round(PrSpanTicks / PrZoom);
  if FMidiViewStart > PrSpanTicks - visible then FMidiViewStart := PrSpanTicks - visible;
  if FMidiViewStart < 0 then FMidiViewStart := 0;
  { the horizontal scrollbar mirrors the zoomed window: range = clip span, page = visible span }
  FMidiHBusy := True;
  try
    sbMidiH.Min := 0;
    sbMidiH.Max := Integer(Max(1, PrSpanTicks));
    sbMidiH.PageSize := Integer(Max(1, Min(visible, PrSpanTicks)));
    sbMidiH.Position := Integer(FMidiViewStart);
  finally
    FMidiHBusy := False;
  end;
end;

procedure TfrmMain.sbMidiHChange(Sender: TObject);
begin
  if FMidiHBusy then Exit;
  FMidiViewStart := sbMidiH.Position;
  PrClampView;
  pbPianoRoll.Invalidate;
end;

{ 36..96 by default, widened by whole octaves so every note of the clip (all
  tracks) is on screen - drums and basses sit below C2, leads above C7 }
procedure TfrmMain.PrFitNoteRange;
var
  seq: TMidiSequence;
  t, i, lo, hi: Integer;
  trk: TMidiTrackSeq;
begin
  lo := MIDI_PR_LO_NOTE;
  hi := MIDI_PR_HI_NOTE;
  seq := CurrentMidiSeq;
  if seq <> nil then
    for t := 0 to seq.TrackCount - 1 do
    begin
      trk := seq.GetTrack(t);
      for i := 0 to trk.NoteCount - 1 do
      begin
        if trk.Notes[i].Note < lo then lo := (trk.Notes[i].Note div 12) * 12;
        if trk.Notes[i].Note >= hi then hi := (trk.Notes[i].Note div 12 + 1) * 12;
      end;
    end;
  FMidiLo := Max(0, lo);
  FMidiHi := Min(128, hi);
end;

const
  PR_MIN_ROW_H = 12;   { a note row is never thinner than this; a taller range scrolls }

{ the whole note range of the clip; the vertical scroll bar moves a window over it }
function TfrmMain.PrFullLo: Integer;
begin
  if FMidiHi <= FMidiLo then Result := MIDI_PR_LO_NOTE else Result := FMidiLo;
end;

function TfrmMain.PrFullHi: Integer;
begin
  if FMidiHi <= FMidiLo then Result := MIDI_PR_HI_NOTE else Result := FMidiHi;
end;

function TfrmMain.PrVisRows: Integer;
begin
  Result := Max(1, Min(PrFullHi - PrFullLo, (PrGridBottom - PrGridTop) div PR_MIN_ROW_H));
end;

{ keeps the note window inside the range and mirrors it on the vertical scroll bar
  (position 0 = the highest notes) }
procedure TfrmMain.PrClampV;
var
  total, rows: Integer;
begin
  total := PrFullHi - PrFullLo;
  rows := PrVisRows;
  if FMidiVHi <= 0 then FMidiVHi := 60 + rows div 2;
  if FMidiVHi < PrFullLo + rows then FMidiVHi := PrFullLo + rows;
  if FMidiVHi > PrFullHi then FMidiVHi := PrFullHi;
  FMidiVBusy := True;
  try
    sbMidiV.Enabled := rows < total;
    sbMidiV.Min := 0;
    sbMidiV.Max := Max(1, total - 1);
    sbMidiV.PageSize := rows;
    sbMidiV.Position := PrFullHi - FMidiVHi;
  finally
    FMidiVBusy := False;
  end;
end;

procedure TfrmMain.sbMidiVChange(Sender: TObject);
begin
  if FMidiVBusy then Exit;
  FMidiVHi := PrFullHi - sbMidiV.Position;
  PrClampV;
  pbPianoRoll.Invalidate;
end;

function TfrmMain.PrLoNote: Integer;
begin
  Result := PrHiNote - PrVisRows;
end;

function TfrmMain.PrHiNote: Integer;
begin
  if FMidiVHi <= 0 then PrClampV;
  Result := Max(FMidiVHi, PrFullLo + PrVisRows);
  if Result > PrFullHi then Result := PrFullHi;
end;

function TfrmMain.MidiRowHeight: Integer;
begin
  Result := Max(PR_MIN_ROW_H, (PrGridBottom - PrGridTop) div (PrHiNote - PrLoNote));
end;

function TfrmMain.MidiNoteAtY(AY: Integer): Integer;
begin
  Result := PrHiNote - 1 - ((AY - PrGridTop) div MidiRowHeight);
end;

function TfrmMain.MidiTickAtX(AX: Integer): Int64;
var
  pxPerTick: Double;
begin
  Result := 0;
  pxPerTick := PrPxPerTick;
  if pxPerTick <= 0 then Exit;
  Result := FMidiViewStart + Round((AX - PR_KEY_W) / pxPerTick);
  if Result < 0 then Result := 0;
end;

{ Wheel zooms the time axis about the pointer; Shift+wheel pans. }
procedure TfrmMain.pbPianoRollMouseWheel(Sender: TObject; Shift: TShiftState;
  WheelDelta: Integer; MousePos: TPoint; var Handled: Boolean);
var
  anchor: Int64;
  frac: Double;
begin
  Handled := True;
  if CurrentMidiSeq = nil then Exit;
  if ssCtrl in Shift then
  begin
    FMidiVHi := PrHiNote + Sign(WheelDelta) * 3;
    PrClampV;
    pbPianoRoll.Invalidate;
    Exit;
  end;
  if ssShift in Shift then
    FMidiViewStart := FMidiViewStart - Round(WheelDelta / 120 * PrSpanTicks / PrZoom / 8)
  else
  begin
    if MousePos.X < PR_KEY_W then frac := 0
    else frac := (MousePos.X - PR_KEY_W) / Max(1, pbPianoRoll.Width - PR_KEY_W);
    anchor := FMidiViewStart + Round(frac * PrSpanTicks / PrZoom);
    if WheelDelta > 0 then FMidiZoomX := PrZoom * 1.25
    else FMidiZoomX := PrZoom / 1.25;
    if FMidiZoomX < 1 then FMidiZoomX := 1;
    if FMidiZoomX > 64 then FMidiZoomX := 64;
    FMidiViewStart := anchor - Round(frac * PrSpanTicks / PrZoom);
  end;
  PrClampView;
  pbPianoRoll.Invalidate;
end;

procedure TfrmMain.cboMidiTrackChange(Sender: TObject);
begin
  if FMidiRefreshing then Exit;
  if cboMidiTrack.ItemIndex >= 0 then FMidiTrackIndex := cboMidiTrack.ItemIndex;
  FMidiSelectedNoteId := -1;
  RefreshMidiTab;
end;

function TfrmMain.MidiFindNoteAt(AX, AY: Integer; out ATrk: TMidiTrackSeq;
  out ANote: TMidiNote): Boolean;
var
  tick: Int64;
  note, i: Integer;
  n: TMidiNote;
begin
  Result := False;
  ATrk := nil;
  if CurrentMidiSeq = nil then Exit;
  if (AX < PR_KEY_W) or (AY < PrGridTop) or (AY >= PrGridBottom) then Exit;
  ATrk := CurrentMidiSeq.GetTrack(FMidiTrackIndex);
  if ATrk = nil then Exit;
  tick := MidiTickAtX(AX);
  note := MidiNoteAtY(AY);
  for i := 0 to ATrk.NoteCount - 1 do
  begin
    n := ATrk.Notes[i];
    if (n.Note = note) and (tick >= n.StartTick) and (tick < n.EndTick) then
    begin
      ANote := n;
      Exit(True);
    end;
  end;
end;

{ 0 = start edge grabbed (resize from the left), 1 = end edge, -1 = neither -
  mirrors TlHitTestClipEdge's ~6px hit zone on the Timeline. }
function TfrmMain.MidiHitTestNoteEdge(const ANote: TMidiNote; AX: Integer): Integer;
const
  EDGE_PX = 6;
var
  x0, x1: Integer;
begin
  Result := -1;
  if PrSpanTicks <= 0 then Exit;
  x0 := PrTickToX(ANote.StartTick);
  x1 := PrTickToX(ANote.EndTick);
  if Abs(AX - x1) <= EDGE_PX then Exit(1);
  if Abs(AX - x0) <= EDGE_PX then Exit(0);
end;

{ the chord under a click in the piano roll's chord lane, nil when none }
function TfrmMain.PrChordAtX(AX: Integer): TTimelineChord;
var
  seq: TMidiSequence;
  sec: Double;
begin
  Result := nil;
  seq := CurrentMidiSeq;
  if (seq = nil) or (FProject = nil) or (AX < PR_KEY_W) then Exit;
  sec := PrChordOffsetSec + seq.TickToSeconds(MidiTickAtX(AX));
  Result := FProject.Timeline.ChordAt(sec);
end;

{ Chords > Detect: names the chord of every bar of the clip from the notes sounding
  in it (every track), and writes them into the Chords lane over the clip }
procedure TfrmMain.btnMidiDetectChordsClick(Sender: TObject);
const
  NAMES: array[0..11] of string = ('C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B');
  QUALS: array[0..7] of record Sym: string; Pcs: array[0..3] of Integer; N: Integer; end = (
    (Sym: '';     Pcs: (0, 4, 7, -1);  N: 3),
    (Sym: 'm';    Pcs: (0, 3, 7, -1);  N: 3),
    (Sym: '7';    Pcs: (0, 4, 7, 10);  N: 4),
    (Sym: 'maj7'; Pcs: (0, 4, 7, 11);  N: 4),
    (Sym: 'm7';   Pcs: (0, 3, 7, 10);  N: 4),
    (Sym: 'dim';  Pcs: (0, 3, 6, -1);  N: 3),
    (Sym: 'sus4'; Pcs: (0, 5, 7, -1);  N: 3),
    (Sym: 'sus2'; Pcs: (0, 2, 7, -1);  N: 3));
var
  seq: TMidiSequence;
  tl: TTimeline;
  tr, k, bar, bars, r, q, p, hit, extra, bestRoot, bestQual, bestScore, score, bassPc, lowest, found: Integer;
  barTicks, b0, b1, ov: Int64;
  w: array[0..11] of Double;
  trk: TMidiTrackSeq;
  nt: TMidiNote;
  off, s0, s1: Double;
  old, snap, nm: string;
  total: Double;
  inTpl: Boolean;
begin
  seq := CurrentMidiSeq;
  if (seq = nil) or (FProject = nil) then
  begin
    MessageDlg('Add or import a MIDI clip first.', mtInformation, [mbOK], 0);
    Exit;
  end;
  tl := FProject.Timeline;
  off := PrChordOffsetSec;
  barTicks := Max(Int64(1), seq.TicksPerBar(0));
  bars := Max(1, Integer((seq.DurationTicks + barTicks - 1) div barTicks));
  old := tl.ChordsSnapshot;
  found := 0;
  { clear the lane over the clip first, then write the detected chords }
  s0 := off;
  s1 := off + seq.TickToSeconds(bars * barTicks);
  for k := tl.ChordCount - 1 downto 0 do
    if (tl.GetChord(k).StartSeconds >= s0 - 0.001) and (tl.GetChord(k).StartSeconds < s1) then
      tl.RemoveChord(tl.GetChord(k).Id);
  for bar := 0 to bars - 1 do
  begin
    b0 := bar * barTicks;
    b1 := b0 + barTicks;
    for p := 0 to 11 do w[p] := 0;
    lowest := 127;
    for tr := 0 to seq.TrackCount - 1 do
    begin
      trk := seq.GetTrack(tr);
      for k := 0 to trk.NoteCount - 1 do
      begin
        nt := trk.Notes[k];
        ov := Min(nt.EndTick, b1) - Max(nt.StartTick, b0);
        if ov <= 0 then Continue;
        w[nt.Note mod 12] := w[nt.Note mod 12] + ov;
        lowest := Min(lowest, nt.Note);
      end;
    end;
    total := 0;
    for p := 0 to 11 do total := total + w[p];
    if total <= 0 then Continue;
    bassPc := lowest mod 12;
    bestScore := -1000;
    bestRoot := 0;
    bestQual := 0;
    for r := 0 to 11 do
      for q := 0 to High(QUALS) do
      begin
        hit := 0;
        for p := 0 to QUALS[q].N - 1 do
          if w[(r + QUALS[q].Pcs[p]) mod 12] > total * 0.08 then Inc(hit);
        extra := 0;
        for p := 0 to 11 do
          if (w[p] > total * 0.08) then
          begin
            inTpl := False;
            for k := 0 to QUALS[q].N - 1 do
              if (r + QUALS[q].Pcs[k]) mod 12 = p then inTpl := True;
            if not inTpl then Inc(extra);
          end;
        score := hit * 10 - extra * 7 - Ord(QUALS[q].N = 4) * 1;
        if r = bassPc then Inc(score, 3);
        if (hit = QUALS[q].N) and (score > bestScore) then
        begin
          bestScore := score;
          bestRoot := r;
          bestQual := q;
        end;
      end;
    if bestScore < 0 then Continue;
    nm := NAMES[bestRoot] + QUALS[bestQual].Sym;
    tl.AddChord(nm, off + seq.TickToSeconds(b0), seq.TickToSeconds(b1) - seq.TickToSeconds(b0));
    Inc(found);
  end;
  snap := tl.ChordsSnapshot;
  tl.RestoreChords(old);
  if found = 0 then
  begin
    MessageDlg('No chords could be named from the notes in this clip.', mtInformation, [mbOK], 0);
    Exit;
  end;
  TlChordsCommit(Format('Detect %d chord(s)', [found]), snap);
  FChordsVisible := True;
  RefreshTimelineTab;   // the chords lane appears and its button lights
  pbPianoRoll.Invalidate;
end;

procedure TfrmMain.chkMidiChordsClick(Sender: TObject);
begin
  pbPianoRoll.Invalidate;
end;

procedure TfrmMain.pbPianoRollPaint(Sender: TObject);
var
  c: TGLCanvas;
  th: TUDAWTheme;
  w, h, loNote, hiNote, noteRange, i, gT, gB, bar, kw: Integer;
  seq: TMidiSequence;
  trk: TMidiTrackSeq;
  span, barTicks, t: Int64;
  x0, x1, y0, rowH, bx, vh: Integer;
  n: TMidiNote;
  pxPerTick, off: Double;
  chd: TTimelineChord;
  chCol: TColor;
  white, black: TColor;
  note: Integer;
  k, tix: Integer;
  otr: TMidiTrackSeq;
begin
  c := pbPianoRoll.GL;
  th := CurrentTheme;
  w := pbPianoRoll.Width;
  h := pbPianoRoll.Height;
  c.Brush.Style := bsSolid;
  c.Pen.Style := psClear;
  c.Brush.Color := th.Background;
  c.FillRect(Rect(0, 0, w, h));

  PrFitNoteRange;
  PrClampView;
  PrClampV;
  loNote := PrLoNote; hiNote := PrHiNote;
  noteRange := hiNote - loNote;
  rowH := MidiRowHeight;
  gT := PrGridTop;
  gB := PrGridBottom;
  white := TlMix(th.PanelBackground, clWhite, 0.78);
  black := TlMix(th.PanelBackground, th.Background, 0.4);

  { key rows (black keys darker); rows outside the scale get an extra dim wash when
    "Highlight scale" is on }
  for i := 0 to noteRange - 1 do
  begin
    note := hiNote - 1 - i;
    y0 := gT + i * rowH;
    if y0 >= gB then Break;
    if MidiNoteIsBlack(note) then c.Brush.Color := TlMix(th.Background, th.PanelBackground, 0.12)
    else c.Brush.Color := TlMix(th.Background, th.PanelBackground, 0.42);
    c.FillRect(Rect(PR_KEY_W, y0, w, Min(gB, y0 + rowH)));
    if not MidiNoteInScale(note) then
    begin
      c.Alpha := 0.5;
      c.Brush.Color := th.Background;
      c.FillRect(Rect(PR_KEY_W, y0, w, Min(gB, y0 + rowH)));
      c.Alpha := 1;
    end;
    { octave line under every C }
    if note mod 12 = 0 then
    begin
      c.Pen.Style := psSolid;
      c.Pen.Color := th.Border;
      c.MoveTo(PR_KEY_W, y0 + rowH - 1);
      c.LineTo(w, y0 + rowH - 1);
      c.Pen.Style := psClear;
    end;
  end;

  { keyboard }
  c.Font.Size := 7;
  for i := 0 to noteRange - 1 do
  begin
    note := hiNote - 1 - i;
    y0 := gT + i * rowH;
    if y0 >= gB then Break;
    if MidiNoteIsBlack(note) then
    begin
      c.Brush.Color := white;
      c.FillRect(Rect(0, y0, PR_KEY_W, Min(gB, y0 + rowH)));
      kw := PR_KEY_W * 6 div 10;
      c.Brush.Color := black;
      c.FillRect(Rect(0, y0, kw, Min(gB, y0 + rowH)));
    end
    else
    begin
      c.Brush.Color := white;
      c.FillRect(Rect(0, y0, PR_KEY_W, Min(gB, y0 + rowH)));
      c.Pen.Style := psSolid;
      c.Pen.Color := TlMix(white, th.Background, 0.35);
      c.MoveTo(0, y0 + rowH - 1);
      c.LineTo(PR_KEY_W, y0 + rowH - 1);
      c.Pen.Style := psClear;
    end;
    if note mod 12 = 0 then
    begin
      c.Brush.Style := bsClear;
      c.Font.Color := th.Background;
      c.TextOut(PR_KEY_W - 22, y0 + (rowH - c.TextHeight('C')) div 2, 'C' + IntToStr(note div 12 - 1));
      c.Brush.Style := bsSolid;
    end;
  end;

  seq := CurrentMidiSeq;
  if seq = nil then
  begin
    c.Brush.Style := bsClear;
    c.Font.Size := 9;
    c.Font.Color := th.SecondaryText;
    c.TextOut(PR_KEY_W + 16, gT + 16, 'No MIDI clip yet - add one from the MIDI menu, or import a .mid file.');
    Exit;
  end;
  trk := seq.GetTrack(FMidiTrackIndex);

  span := PrSpanTicks;
  pxPerTick := PrPxPerTick;
  off := PrChordOffsetSec;

  { ruler: bar numbers and beat ticks }
  c.Brush.Color := TlMix(th.PanelBackground, th.Background, 0.3);
  c.FillRect(Rect(PR_KEY_W, 0, w, PR_RULER_H));
  barTicks := seq.TicksPerBar(0);
  c.Pen.Style := psSolid;
  t := 0;
  bar := 1;
  while (barTicks > 0) and (t <= span) do
  begin
    bx := PrTickToX(t);
    if bx > w then Break;
    if (bx < PR_KEY_W) and (PrTickToX(t + barTicks) < PR_KEY_W) then
    begin
      Inc(t, barTicks);
      Inc(bar);
      Continue;
    end;
    if bx < PR_KEY_W then bx := PR_KEY_W;
    c.Pen.Color := th.Grid;
    c.MoveTo(bx, 0);
    c.LineTo(bx, gB);
    c.Brush.Style := bsClear;
    c.Font.Size := 8;
    c.Font.Color := th.Text;
    c.TextOut(bx + 4, 6, IntToStr(bar));
    { beat lines }
    for k := 1 to Max(1, Integer(barTicks div Max(1, seq.PPQ))) - 1 do
    begin
      x0 := PrTickToX(t + k * seq.PPQ);
      if x0 < PR_KEY_W then Continue;
      c.Pen.Color := TlMix(th.Grid, th.Background, 0.55);
      c.MoveTo(x0, PR_RULER_H);
      c.LineTo(x0, gB);
      c.MoveTo(x0, PR_RULER_H - 5);
      c.LineTo(x0, PR_RULER_H);
    end;
    Inc(t, barTicks);
    Inc(bar);
  end;
  c.Pen.Style := psClear;

  { chord lane }
  c.Brush.Style := bsSolid;
  c.Brush.Color := TlMix(th.PanelBackground, th.Background, 0.15);
  c.FillRect(Rect(0, PR_RULER_H, w, gT));
  c.Brush.Style := bsClear;
  c.Font.Size := 8;
  c.Font.Color := th.SecondaryText;
  if (FProject <> nil) and (FProject.Timeline.ChordCount = 0) then
    c.TextOut(PR_KEY_W + 8, PR_RULER_H + 7, 'Chords: double-click to add one, or Detect to name them from the notes');
  c.TextOut(8, PR_RULER_H + 7, 'Chords');
  if FProject <> nil then
    for i := 0 to FProject.Timeline.ChordCount - 1 do
    begin
      chd := FProject.Timeline.GetChord(i);
      x0 := PrTickToX(seq.SecondsToTick(chd.StartSeconds - off));
      x1 := PrTickToX(seq.SecondsToTick(chd.EndSeconds - off));
      if (x1 < PR_KEY_W) or (x0 > w) then Continue;
      x0 := Max(x0, PR_KEY_W);
      chCol := TlChordColor(chd.Name);
      c.Brush.Style := bsSolid;
      c.Brush.Color := TlMix(th.Background, chCol, 0.7);
      c.Pen.Style := psSolid;
      c.Pen.Color := chCol;
      c.RoundRect(x0, PR_RULER_H + 3, Max(x1 - 1, x0 + 6), gT - 3, 6, 6);
      c.Pen.Style := psClear;
      c.Brush.Style := bsClear;
      c.Font.Color := clBlack;
      c.TextRect(Rect(x0 + 2, PR_RULER_H + 3, Max(x1 - 1, x0 + 6), gT - 3), x0 + 6, PR_RULER_H + 7, chd.Name);
    end;

  if trk = nil then Exit;

  { Ctrl+drag highlighted range }
  if FMidiRangeActive then
  begin
    c.Alpha := 0.35;
    c.Brush.Style := bsSolid;
    c.Brush.Color := th.Selection;
    c.FillRect(Rect(Max(PR_KEY_W, PrTickToX(FMidiRangeStart)), gT,
      Max(PR_KEY_W, PrTickToX(FMidiRangeEnd)), gB));
    c.Alpha := 1;
  end;

  { notes: every track of the clip; the track being edited is full colour,
    the others are shown dimmed behind it }
  c.Brush.Style := bsSolid;
  for tix := 0 to seq.TrackCount - 1 do
  begin
    if tix = FMidiTrackIndex then Continue;
    otr := seq.GetTrack(tix);
    c.Alpha := 0.4;
    for i := 0 to otr.NoteCount - 1 do
    begin
      n := otr.Notes[i];
      if (n.Note < loNote) or (n.Note >= hiNote) then Continue;
      x0 := Max(PR_KEY_W, PrTickToX(n.StartTick));
      x1 := PrTickToX(n.EndTick);
      if (x1 <= PR_KEY_W) or (x0 > w) then Continue;
      if x1 <= x0 then x1 := x0 + 2;
      y0 := gT + (hiNote - 1 - n.Note) * rowH;
      if y0 + rowH > gB then Continue;
      c.Brush.Color := TlMix(th.MidiNote, clWhite, 0.15);
      c.Pen.Style := psClear;
      c.FillRect(Rect(x0, y0 + 1, x1, y0 + rowH));
    end;
    c.Alpha := 1;
  end;
  for i := 0 to trk.NoteCount - 1 do
  begin
    n := trk.Notes[i];
    if (n.Note < loNote) or (n.Note >= hiNote) then Continue;
    x0 := PrTickToX(n.StartTick);
    x1 := PrTickToX(n.EndTick);
    if (x1 <= PR_KEY_W) or (x0 > w) then Continue;
    x0 := Max(x0, PR_KEY_W);
    if x1 <= x0 then x1 := x0 + 3;
    y0 := gT + (hiNote - 1 - n.Note) * rowH;
    if y0 + rowH > gB then Continue;
    if (n.Id = FMidiSelectedNoteId) or n.Selected then c.Brush.Color := th.Accent
    else c.Brush.Color := TlMix(th.MidiNote, clWhite, 0.15);
    c.Pen.Style := psSolid;
    c.Pen.Color := TlMix(c.Brush.Color, clBlack, 0.45);
    c.RoundRect(x0, y0 + 1, x1, y0 + rowH, 3, 3);
    c.Pen.Style := psClear;
  end;

  { the play position, a line down the whole grid while the clip (or the Timeline) is playing }
  if PrPlayTick(t) then
  begin
    x0 := PrTickToX(t);
    if (x0 >= PR_KEY_W) and (x0 <= w) then
    begin
      c.Brush.Style := bsSolid;
      c.Brush.Color := th.Accent;
      c.Alpha := 0.9;
      c.FillRect(Rect(x0 - 1, gT, x0 + 1, gB));
      c.Alpha := 1;
      c.Polygon([Point(x0 - 5, gT), Point(x0 + 5, gT), Point(x0, gT + 7)]);
    end;
  end;

  { velocity lane }
  c.Brush.Style := bsSolid;
  c.Brush.Color := TlMix(th.PanelBackground, th.Background, 0.25);
  c.FillRect(Rect(0, gB, w, h));
  c.Pen.Style := psSolid;
  c.Pen.Color := th.Border;
  c.MoveTo(0, gB);
  c.LineTo(w, gB);
  c.Pen.Style := psClear;
  c.Brush.Style := bsClear;
  c.Font.Size := 7;
  c.Font.Color := th.SecondaryText;
  c.TextOut(8, gB + 8, 'VEL');
  vh := h - gB - 10;
  c.Brush.Style := bsSolid;
  for i := 0 to trk.NoteCount - 1 do
  begin
    n := trk.Notes[i];
    x0 := PrTickToX(n.StartTick);
    if (x0 < PR_KEY_W) or (x0 > w) then Continue;
    c.Brush.Color := TlMix(th.MidiNote, clWhite, 0.15);
    c.FillRect(Rect(x0, h - 4 - Round(vh * n.Velocity / 127), x0 + 3, h - 4));
  end;
  c.Font.Size := 9;
end;

{ FMidiScaleType indexes cboMidiScaleType's items - see RefreshMidiTab. Used
  by pbPianoRollPaint to tint in-scale rows, matching FL Studio's piano roll
  "highlight scale" feature. }
function TfrmMain.MidiNoteInScale(ANote: Integer): Boolean;
type
  TScaleSet = set of 0..11;
const
  SCALES: array[0..3] of TScaleSet = (
    [0,2,4,5,7,9,11],   // Major
    [0,2,3,5,7,8,10],   // Natural minor
    [0,2,4,7,9],        // Major pentatonic
    [0,3,5,7,10]        // Minor pentatonic
  );
var
  pc: Integer;
begin
  if not FMidiScaleHighlight then Exit(True);
  if (FMidiScaleType < Low(SCALES)) or (FMidiScaleType > High(SCALES)) then Exit(True);
  pc := ((ANote - FMidiScaleRoot) mod 12 + 12) mod 12;
  Result := pc in SCALES[FMidiScaleType];
end;

procedure TfrmMain.RefreshMidiTab;
var
  i: Integer;
  seq: TMidiSequence;
begin
  if FMidiRefreshing then Exit;
  FMidiRefreshing := True;
  try
    cboMidiClip.Items.BeginUpdate;
    try
      cboMidiClip.Items.Clear;
      if FProject <> nil then
        for i := 0 to FProject.Midi.ClipCount - 1 do
          cboMidiClip.Items.Add(Format('%d: %s', [i, FProject.Midi.ClipName(i)]));
    finally
      cboMidiClip.Items.EndUpdate;
    end;
    if (FMidiClipIndex < 0) and (cboMidiClip.Items.Count > 0) then
      FMidiClipIndex := 0;
    if FMidiClipIndex >= cboMidiClip.Items.Count then
      FMidiClipIndex := cboMidiClip.Items.Count - 1;
    cboMidiClip.ItemIndex := FMidiClipIndex;

    seq := CurrentMidiSeq;
    cboMidiTrack.Items.BeginUpdate;
    try
      cboMidiTrack.Items.Clear;
      if seq <> nil then
        for i := 0 to seq.TrackCount - 1 do
          cboMidiTrack.Items.Add(Format('%d: %s (%d notes)', [i, seq.GetTrack(i).Name, seq.GetTrack(i).NoteCount]));
    finally
      cboMidiTrack.Items.EndUpdate;
    end;
    if (seq <> nil) and (FMidiTrackIndex >= seq.TrackCount) then FMidiTrackIndex := 0;
    cboMidiTrack.ItemIndex := FMidiTrackIndex;
    if seq = nil then
      memMidi.Lines.Text :=
        'No MIDI clip yet.  "Add clip" creates one (PPQ 480, 4/4, 120 BPM).'#13#10 +
        'Then add notes (note/start/len/vel), quantize/humanize the track,'#13#10 +
        'Play through the internal poly synth, or Import/Export a .mid file.'
    else
      memMidi.Lines.Text := seq.Describe + sLineBreak +
        Format('editing track %d;  grid = 1/%d (%d ticks)',
          [FMidiTrackIndex, MidiGridDenom(cboMidiGrid.ItemIndex),
           GridTicks(seq, MidiGridDenom(cboMidiGrid.ItemIndex))]);
    pbPianoRoll.Invalidate;
  finally
    FMidiRefreshing := False;
  end;
end;

{ Left-click an empty cell draws a new note (snapped to the grid, length one
  grid division, velocity from edtMidiVel); left-click an existing note
  selects it and starts a move-drag, or a resize-drag when the click lands
  within MidiHitTestNoteEdge's edge zone; right-click a note deletes it. All
  of this rides the same TAddMidiNoteCommand/TMoveMidiNoteCommand/
  TResizeMidiNoteCommand/TDeleteMidiNoteCommand undo stack btnMidi* already
  used - the commands existed since Phase 17, only the mouse wiring was
  missing. }
procedure TfrmMain.pbPianoRollMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  seq: TMidiSequence;
  trk: TMidiTrackSeq;
  n: TMidiNote;
  tick, len, gridLen: Int64;
  note, vv, edge: Integer;
  chd: TTimelineChord;
begin
  seq := CurrentMidiSeq;
  if seq = nil then Exit;
  FMidiDragMode := mdmMidiNone;

  { the chord lane: double-click adds / renames, right-click deletes }
  if (X >= PR_KEY_W) and (Y >= PR_RULER_H) and (Y < PrGridTop) then
  begin
    chd := PrChordAtX(X);
    if Button = mbRight then
    begin
      if chd <> nil then TlChordDelete(chd.Id);
    end
    else if (Button = mbLeft) and (ssDouble in Shift) then
    begin
      if chd <> nil then TlChordRename(chd.Id)
      else
      begin
        tick := MidiTickAtX(X);
        tick := tick - (tick mod Max(Int64(1), seq.TicksPerBar(0)));
        TlChordAdd(PrChordOffsetSec + seq.TickToSeconds(tick));
      end;
    end;
    pbPianoRoll.Invalidate;
    Exit;
  end;
  if (X < PR_KEY_W) or (Y < PrGridTop) or (Y >= PrGridBottom) then Exit;

  if Button = mbRight then
  begin
    if MidiFindNoteAt(X, Y, trk, n) then
    begin
      FCmds.Perform(TDeleteMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex, n.Id));
      if FMidiSelectedNoteId = n.Id then FMidiSelectedNoteId := -1;
      RefreshMidiTab;
    end;
    Exit;
  end;

  if Button <> mbLeft then Exit;

  if ssCtrl in Shift then
  begin
    gridLen := Max(Int64(1), GridTicks(seq, MidiGridDenom(cboMidiGrid.ItemIndex)));
    FMidiRangeDragging := True;
    FMidiRangeActive := False;
    FMidiRangeAnchor := (MidiTickAtX(X) div gridLen) * gridLen;
    FMidiRangeStart := FMidiRangeAnchor;
    FMidiRangeEnd := FMidiRangeAnchor;
    pbPianoRoll.Invalidate;
    Exit;
  end;
  FMidiRangeActive := False;

  if MidiFindNoteAt(X, Y, trk, n) then
  begin
    FMidiSelectedNoteId := n.Id;
    FMidiDragNoteId := n.Id;
    FMidiDragStartX := X;
    FMidiDragStartY := Y;
    FMidiDragAppliedTick := 0;
    FMidiDragAppliedNote := 0;
    edge := MidiHitTestNoteEdge(n, X);
    if edge = 0 then FMidiDragMode := mdmMidiResizeStart
    else if edge = 1 then FMidiDragMode := mdmMidiResizeEnd
    else FMidiDragMode := mdmMidiMove;
  end
  else
  begin
    gridLen := Max(Int64(1), GridTicks(seq, MidiGridDenom(cboMidiGrid.ItemIndex)));
    tick := (MidiTickAtX(X) div gridLen) * gridLen;
    len := gridLen;
    note := MidiNoteAtY(Y);
    vv := StrToIntDef(Trim(edtMidiVel.Text), 100);
    FCmds.Perform(TAddMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
      tick, len, note, vv, 0));
    trk := seq.GetTrack(FMidiTrackIndex);
    if (trk <> nil) and (trk.NoteCount > 0) then
      FMidiSelectedNoteId := trk.Notes[trk.NoteCount - 1].Id;
  end;
  RefreshMidiTab;
end;

procedure TfrmMain.pbPianoRollMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
var
  trk: TMidiTrackSeq;
  hoverNote: TMidiNote;
  totalTick, incTick: Int64;
  totalNote, incNote: Integer;
begin
  if FMidiRangeDragging and (CurrentMidiSeq <> nil) then
  begin
    incTick := Max(Int64(1), GridTicks(CurrentMidiSeq, MidiGridDenom(cboMidiGrid.ItemIndex)));
    totalTick := (MidiTickAtX(X) div incTick) * incTick;
    FMidiRangeStart := Min(FMidiRangeAnchor, totalTick);
    FMidiRangeEnd := Max(FMidiRangeAnchor, totalTick);
    FMidiRangeActive := FMidiRangeEnd > FMidiRangeStart;
    pbPianoRoll.Invalidate;
    Exit;
  end;
  if FMidiDragMode = mdmMidiNone then
  begin
    { hover feedback: a resize cursor over a note's edge zone }
    if MidiFindNoteAt(X, Y, trk, hoverNote) and (MidiHitTestNoteEdge(hoverNote, X) >= 0) then
      pbPianoRoll.Cursor := crSizeWE
    else
      pbPianoRoll.Cursor := crDefault;
    Exit;
  end;
  if (CurrentMidiSeq = nil) or (FMidiDragNoteId < 0) then Exit;
  trk := CurrentMidiSeq.GetTrack(FMidiTrackIndex);
  if trk = nil then Exit;
  if trk.IndexOfNoteId(FMidiDragNoteId) < 0 then
  begin
    FMidiDragMode := mdmMidiNone;
    Exit;
  end;

  totalTick := MidiTickAtX(X) - MidiTickAtX(FMidiDragStartX);

  case FMidiDragMode of
    mdmMidiMove:
      begin
        totalNote := MidiNoteAtY(Y) - MidiNoteAtY(FMidiDragStartY);
        incTick := totalTick - FMidiDragAppliedTick;
        incNote := totalNote - FMidiDragAppliedNote;
        if (incTick <> 0) or (incNote <> 0) then
        begin
          FCmds.Perform(TMoveMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
            FMidiDragNoteId, incTick, incNote));
          FMidiDragAppliedTick := totalTick;
          FMidiDragAppliedNote := totalNote;
        end;
      end;
    mdmMidiResizeStart:
      begin
        { ResizeNote(..., AFromStart=True) subtracts the delta from
          StartTick, so a positive on-screen "drag right" (totalTick > 0,
          which should shrink the note) needs a negated delta here - see
          TPianoRoll.ResizeNote's header comment for the sign convention. }
        incTick := -totalTick - FMidiDragAppliedTick;
        if incTick <> 0 then
        begin
          FCmds.Perform(TResizeMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
            FMidiDragNoteId, incTick, True));
          FMidiDragAppliedTick := -totalTick;
        end;
      end;
    mdmMidiResizeEnd:
      begin
        incTick := totalTick - FMidiDragAppliedTick;
        if incTick <> 0 then
        begin
          FCmds.Perform(TResizeMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
            FMidiDragNoteId, incTick, False));
          FMidiDragAppliedTick := totalTick;
        end;
      end;
  end;
  RefreshMidiTab;
end;

procedure TfrmMain.pbPianoRollMouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  FMidiDragMode := mdmMidiNone;
  FMidiRangeDragging := False;
end;

procedure TfrmMain.chkMidiScaleHighlightClick(Sender: TObject);
begin
  FMidiScaleHighlight := chkMidiScaleHighlight.Checked;
  pbPianoRoll.Invalidate;
end;

procedure TfrmMain.cboMidiScaleChange(Sender: TObject);
begin
  FMidiScaleRoot := Max(0, cboMidiScaleRoot.ItemIndex);
  FMidiScaleType := Max(0, cboMidiScaleType.ItemIndex);
  pbPianoRoll.Invalidate;
end;

procedure TfrmMain.cboMidiClipChange(Sender: TObject);
begin
  if FMidiRefreshing then Exit;
  FMidiClipIndex := cboMidiClip.ItemIndex;
  FMidiTrackIndex := 0;
  FMidiZoomX := 1;
  FMidiViewStart := 0;
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiAddClipClick(Sender: TObject);
begin
  if FProject = nil then Exit;
  FCmds.Perform(TAddMidiClipCommand.Create(FProject,
    Format('Clip %d', [FProject.Midi.ClipCount + 1]), MIDI_DEFAULT_PPQ));
  FMidiClipIndex := FProject.Midi.ClipCount - 1;
  FMidiTrackIndex := 0;
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiAddTrackClick(Sender: TObject);
begin
  if CurrentMidiSeq = nil then Exit;
  FCmds.Perform(TAddMidiTrackCommand.Create(FProject, FMidiClipIndex,
    Format('Track %d', [CurrentMidiSeq.TrackCount + 1])));
  FMidiTrackIndex := CurrentMidiSeq.TrackCount - 1;
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiAddNoteClick(Sender: TObject);
var
  nn, st, ln, vv: Integer;
begin
  if CurrentMidiSeq = nil then
  begin
    memMidi.Lines.Text := 'add a clip first';
    Exit;
  end;
  nn := StrToIntDef(Trim(edtMidiNote.Text), 60);
  st := StrToIntDef(Trim(edtMidiStart.Text), 0);
  ln := StrToIntDef(Trim(edtMidiLen.Text), CurrentMidiSeq.PPQ);
  vv := StrToIntDef(Trim(edtMidiVel.Text), 100);
  FCmds.Perform(TAddMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
    st, ln, nn, vv, 0));
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiDelNoteClick(Sender: TObject);
var
  trk: TMidiTrackSeq;
begin
  if CurrentMidiSeq = nil then Exit;
  trk := CurrentMidiSeq.GetTrack(FMidiTrackIndex);
  if (trk = nil) or (trk.NoteCount = 0) then Exit;
  FCmds.Perform(TDeleteMidiNoteCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
    trk.Notes[trk.NoteCount - 1].Id));
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiQuantizeClick(Sender: TObject);
var
  seq: TMidiSequence;
begin
  seq := CurrentMidiSeq;
  if seq = nil then Exit;
  FCmds.Perform(TQuantizeMidiCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
    GridTicks(seq, MidiGridDenom(cboMidiGrid.ItemIndex)), 1.0, 0.0, False, False));
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiHumanizeClick(Sender: TObject);
var
  seq: TMidiSequence;
begin
  seq := CurrentMidiSeq;
  if seq = nil then Exit;
  FCmds.Perform(THumanizeMidiCommand.Create(FProject, FMidiClipIndex, FMidiTrackIndex,
    Max(Int64(1), GridTicks(seq, 32) div 2), 12,
    Cardinal(seq.DurationTicks * 2654435761) or 1, False));
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiPlayClick(Sender: TObject);
var
  eng: TMidiPlaybackEngine;
begin
  if (App = nil) or (App.Audio = nil) or (CurrentMidiSeq = nil) then Exit;
  App.Audio.ClearSource;
  eng := TMidiPlaybackEngine.Create;
  FMidiEngine := eng;                 // hold as interface (ref-counted)
  FMidiEngineRef := eng;
  eng.SetSequence(CurrentMidiSeq);
  eng.SeekSeconds(0);
  eng.Play;
  FGraphPlaying := False;
  FWavPlaying := False;
  StopTimelinePlayback;
  App.Audio.SetSource(FMidiEngine);
  tmrUI.Interval := TRK_UI_PLAY_INTERVAL_MS;   // the play position line needs a quick refresh
  memMidi.Lines.Text := 'playing "' + FProject.Midi.ClipName(FMidiClipIndex) +
    '" through the internal poly synth';
end;

procedure TfrmMain.btnMidiStopClick(Sender: TObject);
begin
  if (App <> nil) and (App.Audio <> nil) then
    App.Audio.ClearSource;
  if FMidiEngineRef <> nil then
    FMidiEngineRef.Stop;
  FMidiEngine := nil;
  FMidiEngineRef := nil;
  if not (FTlPlaying or FTrkPlaying) then tmrUI.Interval := TRK_UI_IDLE_INTERVAL_MS;
  RefreshMidiTab;
end;

{ Phase 38 - MIDI recording: toggles live capture from the Settings-selected
  MIDI input device straight onto the Timeline, mirroring the audio Record
  button's arm/stop shape (btnRecArmClick/StopLiveRecording) but far simpler
  - no disk-streaming take container, since a captured MIDI event stream is
  tiny; the whole performance lives in memory (FMidiCapture) until Stop
  commits it as one TCommitMidiTakeCommand. }
procedure TfrmMain.mnuMidiRecordClick(Sender: TObject);
var
  trk: TTimelineTrack;
  targetTrackId: Integer;
  seq: TMidiSequence;
  cmd: TCommitMidiTakeCommand;
  startSeconds, elapsedSinceStart: Double;
  clipName: string;
  nowDeviceMs: Int64;
begin
  if (App = nil) or (FProject = nil) or (FMidiCapture = nil) then Exit;

  if FMidiRecording then
  begin
    { ---- stop & commit ---- }
    nowDeviceMs := Int64(GetTickCount64) - Int64(FMidiInDevice.OpenTickCount64);
    elapsedSinceStart := (nowDeviceMs - Int64(FMidiRecStartTick)) / 1000.0;
    seq := FMidiCapture.Stop(elapsedSinceStart);
    FMidiRecording := False;
    mnuMidiRecord.Caption := 'Record from MIDI device';
    if seq = nil then
    begin
      memMidi.Lines.Insert(0, 'nothing captured - no notes/CC arrived from the input device');
      Exit;
    end;
    clipName := 'MIDI Take ' + FormatDateTime('hh:nn:ss', Now);
    cmd := TCommitMidiTakeCommand.Create(FProject, FMidiRecTrackId, seq, clipName,
      FMidiCapture.TimelineStartSeconds);
    FCmds.Perform(cmd);
    if FTlPlayer <> nil then FTlPlayer.InvalidateAllMidi;
    memMidi.Lines.Insert(0, Format('committed recorded MIDI ("%s") to the timeline', [clipName]));
    RefreshTimelineTab;
    Exit;
  end;

  { ---- arm & start ---- }
  if (FMidiInDevice = nil) or not FMidiInDevice.IsOpen then
  begin
    MessageDlg('Select a MIDI input device in Settings first.', mtInformation, [mbOK], 0);
    Exit;
  end;
  trk := FProject.Timeline.TrackById(FTlSelectedTrackId);
  if (trk <> nil) and (trk.Kind = tkMidi) then targetTrackId := trk.Id
  else targetTrackId := 0;   // TCommitMidiTakeCommand creates a fresh tkMidi track
  FMidiRecTrackId := targetTrackId;

  { the Timeline transport has to actually be rendering for the live monitor
    synth (AttachLiveMidiMonitor) to be audible - start it if it isn't
    already, exactly like arming audio recording does (btnRecArmClick). }
  if not FTlPlaying then
    StartTimelinePlayback(False, False, False);
  startSeconds := FProject.Timeline.PlayheadSeconds;

  FMidiRecStartTick := GetTickCount64 - FMidiInDevice.OpenTickCount64;
  FMidiCapture.Start(startSeconds, FProject.TempoBPM);
  FMidiRecording := True;
  mnuMidiRecord.Caption := 'Stop recording';
  memMidi.Lines.Insert(0, 'MIDI recording armed - play your controller now');
end;

procedure TfrmMain.btnMidiImportSMFClick(Sender: TObject);
var
  ti: Integer;
  smf: TSmfFile;
  seq: TMidiSequence;
  nm: string;
begin
  if FProject = nil then Exit;
  if not dlgOpenMidi.Execute then Exit;
  smf := TSmfFile.Create;
  try
    try
      smf.LoadFromFile(dlgOpenMidi.FileName);
      seq := TMidiSequence.Create;
      seq.BuildFromSMF(smf);
      nm := ChangeFileExt(ExtractFileName(dlgOpenMidi.FileName), '');
      { place it on the Timeline (new MIDI track at 0) as well as the library,
        so the arrangement and piano roll both show it }
      FCmds.Perform(TCommitMidiTakeCommand.Create(FProject, 0, seq, nm, 0.0, nm));
      EnsureMixerStripsForTimelineTracks;   // the new MIDI lane gets its mixer strip
      FMidiClipIndex := FProject.Midi.ClipCount - 1;
      FMidiTrackIndex := 0;
      { a type-1 file's first track is usually just tempo/meta - open the first one with notes }
      with FProject.Midi.Clip(FMidiClipIndex) do
        for ti := 0 to TrackCount - 1 do
          if GetTrack(ti).NoteCount > 0 then
          begin
            FMidiTrackIndex := ti;
            Break;
          end;
      FMidiZoomX := 1;
      FMidiViewStart := 0;
      if FTlPlayer <> nil then FTlPlayer.InvalidateAllMidi;
      memMidi.Lines.Text := 'imported ' + ExtractFileName(dlgOpenMidi.FileName) +
        sLineBreak + smf.Describe;
      RefreshTimelineTab;
    except
      on E: Exception do
        memMidi.Lines.Text := 'import FAILED: ' + E.Message;
    end;
  finally
    smf.Free;
  end;
  RefreshMidiTab;
end;

procedure TfrmMain.btnMidiExportSMFClick(Sender: TObject);
var
  smf: TSmfFile;
begin
  if not RequireRegistration('Exporting MIDI') then Exit;
  if CurrentMidiSeq = nil then Exit;
  if not dlgSaveMidi.Execute then Exit;
  smf := CurrentMidiSeq.ToSMF(1);
  try
    try
      smf.SaveToFile(dlgSaveMidi.FileName);
      memMidi.Lines.Text := 'exported ' + ExtractFileName(dlgSaveMidi.FileName) +
        sLineBreak + smf.Describe;
    except
      on E: Exception do
        memMidi.Lines.Text := 'export FAILED: ' + E.Message;
    end;
  finally
    smf.Free;
  end;
end;

