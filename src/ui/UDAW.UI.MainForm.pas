{ A tracker module dropped on the Timeline: loaded and offered to the same prompt as the
  Timeline's Import menu items (live notation clip / one-off audio clip / cancel); either clip
  lands at the playhead. }
procedure TfrmMain.TlDropTrackerModule(const APath: string);
var
  fs: TFileStream;
  data: TBytes;
  module: TTrackerModule;
  ext, kind: string;
begin
  ext := LowerCase(ExtractFileExt(APath));
  try
    fs := TFileStream.Create(APath, fmOpenRead or fmShareDenyWrite);
    try
      SetLength(data, fs.Size);
      if Length(data) > 0 then fs.ReadBuffer(data[0], Length(data));
    finally
      fs.Free;
    end;
    if ext = '.mod' then
    begin
      module := ModToModule(data); kind := 'MOD';
    end
    else if ext = '.xm' then
    begin
      module := XmToModule(data); kind := 'XM';
    end
    else if IsLegacyModuleExt(ext) then
    begin
      module := LegacyToModule(data); kind := 'S3M';
    end
    else
    begin
      MptmSetSampleFolder(ExtractFilePath(ExpandFileName(APath)));
      module := MptmToModule(data); kind := 'IT/MPTM';
    end;
    try
      ImportTrackerModuleToTimeline(module, APath, kind);
    finally
      module.Free;
    end;
  except
    on E: Exception do
      MessageDlg('Module import to timeline FAILED:' + sLineBreak + E.Message, mtError, [mbOK], 0);
  end;
end;

procedure TfrmMain.pbTimelineDragOver(Sender, Source: TObject; X, Y: Integer;
  State: TDragState; var Accept: Boolean);
begin
  if Source = trTlRight then
  begin
    Accept := (FProject <> nil) and ((TlRightSelectedInstr >= 0) or (TlRightSelectedModule <> '') or
      (TlRightSelectedSample <> '') or (TlRightSelectedPlugin <> ''));
    Exit;
  end;
  Accept := (Source = tvBrowser) and (FProject <> nil) and
    (tvBrowser.Selected <> nil) and (tvBrowser.Selected.Data = BRND_FILE) and
    (BrowserIsAudioExt(LowerCase(ExtractFileExt(BrowserNodePath(tvBrowser.Selected)))) or
     SameText(ExtractFileExt(BrowserNodePath(tvBrowser.Selected)), '.vst3') or
     SameText(ExtractFileExt(BrowserNodePath(tvBrowser.Selected)), '.dll'));
end;

{ Drops onto an existing audio track import onto that track at the dropped
  time; anywhere else (a non-audio track, or empty space below the last
  track) gets its own new audio track, same as the Timeline's Import menu
  items - dropping should never silently fail to find a place to land. }
procedure TfrmMain.pbTimelineDragDrop(Sender, Source: TObject; X, Y: Integer);
var
  path: string;
  trackId, instrItem: Integer;
  sec: Double;
begin
  if Source = trTlRight then
  begin
    { a library sample dropped on the Timeline goes in at the playhead }
    if (FProject <> nil) and (TlRightSelectedSample <> '') then
    begin
      TlAddSampleAtPlayhead(TlRightSelectedSample);
      Exit;
    end;
    { a VST2 / VST3 plug-in dropped on the Timeline: an instrument gets its own lane and strip }
    if (FProject <> nil) and (TlRightSelectedPlugin <> '') then
    begin
      TlDropPlugin(TlRightSelectedPlugin, X, Y);
      Exit;
    end;
    { a tracker module dropped on the Timeline asks how to add it, at the playhead }
    if (FProject <> nil) and (TlRightSelectedModule <> '') then
    begin
      TlDropTrackerModule(TlRightSelectedModule);
      Exit;
    end;
    { a tracker instrument dropped on the Timeline goes in at the playhead }
    instrItem := TlRightSelectedInstr;
    if (instrItem < 0) or (FProject = nil) then Exit;
    cboTrkInstrSel.ItemIndex := instrItem;
    cboTrkInstrSelChange(nil);
    btnTrkInstrAddTimelineClick(nil);
    Exit;
  end;
  if (Source <> tvBrowser) or (tvBrowser.Selected = nil) or
     (tvBrowser.Selected.Data <> BRND_FILE) or (FProject = nil) then Exit;
  path := BrowserNodePath(tvBrowser.Selected);
  if SameText(ExtractFileExt(path), '.vst3') or SameText(ExtractFileExt(path), '.dll') then
  begin
    TlDropPlugin(path, X, Y);
    Exit;
  end;
  if not BrowserIsAudioExt(LowerCase(ExtractFileExt(path))) then Exit;

  FTlView.SetViewportWidth(pbTimeline.Width);
  sec := FTlView.Snap(FTlView.XToSeconds(X));
  if sec < 0 then sec := 0;

  trackId := TlDropTargetTrackId(X, Y);

  if ImportBrowserFileToTimeline(path, trackId, sec) then
  begin
    memBrowser.Lines.Insert(0, 'dropped onto Timeline: ' + path);
    EnsureMixerStripsForTimelineTracks;      // the lane the clip landed on has its linked strip
    RefreshMixerTab;
  end
  else
    memBrowser.Lines.Insert(0, 'drop import FAILED: ' + path);
end;

{$IFNDEF FPC}
{ OS Explorer drag-in - DragAcceptFiles is registered on the FORM's handle in
  FormCreate, not pbTimeline's: pbTimeline is a TWheelPaintBox, i.e. a
  TPaintBox/TGraphicControl, which is windowless and has no HWND of its own
  to register. DragQueryPoint therefore returns a point in the FORM's client
  coordinates, which gets mapped into pbTimeline's own client space below (and
  ignored entirely if the drop landed outside pbTimeline, e.g. on another
  tab) before it plugs into the same FTlView/TlDropTargetTrackId math the
  in-app Browser-tree drop above uses. Every dropped file lands at the same
  snapped drop time; the first usable file uses TlDropTargetTrackId's normal
  "track under the drop, else the selected track, else a new one" rule, and
  any further files each get their own new audio track rather than
  overlapping the first clip on the same track. }
procedure TfrmMain.WMDropFiles(var Msg: TWMDropFiles);
var
  dropPtForm: TPoint;
begin
  DragQueryPoint(Msg.Drop, dropPtForm);
  DoTimelineFileDrop(Msg.Drop, pbTimeline.ScreenToClient(ClientToScreen(dropPtForm)));
  Msg.Result := 0;
end;

{ pbTimeline is a real window now (OpenGL surface), so Explorer drops over it
  arrive here via its own OnDropFiles instead of the form's WM_DROPFILES. }
procedure TfrmMain.pbTimelineDropFiles(Sender: TObject; ADrop: HDROP; const APoint: TPoint);
begin
  DoTimelineFileDrop(ADrop, APoint);
end;

procedure TfrmMain.DoTimelineFileDrop(ADrop: HDROP; const ADropPt: TPoint);
var
  fileCount, i, len: Integer;
  fileName: string;
  dropPt: TPoint;
  trackId: Integer;
  sec: Double;
  firstFile: Boolean;
begin
  dropPt := ADropPt;
  try
    if FProject = nil then Exit;
    if not PtInRect(pbTimeline.ClientRect, dropPt) then
    begin
      memBrowser.Lines.Insert(0, 'drop ignored (not over the Timeline)');
      Exit;
    end;
    FTlView.SetViewportWidth(pbTimeline.Width);
    sec := FTlView.Snap(FTlView.XToSeconds(dropPt.X));
    if sec < 0 then sec := 0;

    fileCount := DragQueryFile(ADrop, $FFFFFFFF, nil, 0);
    firstFile := True;
    for i := 0 to fileCount - 1 do
    begin
      len := DragQueryFile(ADrop, i, nil, 0);
      SetLength(fileName, len);
      DragQueryFile(ADrop, i, PChar(fileName), len + 1);
      if SameText(ExtractFileExt(fileName), '.vst3') then
      begin
        TlDropPlugin(fileName, dropPt.X, dropPt.Y);
        Continue;
      end;
      if not BrowserIsAudioExt(LowerCase(ExtractFileExt(fileName))) then
      begin
        memBrowser.Lines.Insert(0, 'skipped (not an importable audio format): ' + fileName);
        Continue;
      end;
      if firstFile then
      begin
        trackId := TlDropTargetTrackId(dropPt.X, dropPt.Y);
        firstFile := False;
      end
      else
        trackId := TlNewAudioTrackId;
      if ImportBrowserFileToTimeline(fileName, trackId, sec) then
        memBrowser.Lines.Insert(0, 'dropped from Explorer onto Timeline: ' + fileName)
      else
        memBrowser.Lines.Insert(0, 'Explorer drop import FAILED: ' + fileName);
    end;
    EnsureMixerStripsForTimelineTracks;      // every lane the files landed on has its linked strip
    RefreshMixerTab;
  finally
    DragFinish(ADrop);
  end;
end;
{$ENDIF}

procedure TfrmMain.pbMixerDragOver(Sender, Source: TObject; X, Y: Integer;
  State: TDragState; var Accept: Boolean);
begin
  Accept := (Source = tvBrowser) and (FProject <> nil) and
    (tvBrowser.Selected <> nil) and (tvBrowser.Selected.Data = BRND_FILE) and
    (SameText(ExtractFileExt(BrowserNodePath(tvBrowser.Selected)), '.dll') or
     SameText(ExtractFileExt(BrowserNodePath(tvBrowser.Selected)), '.vst3'));
end;

{ Mirrors btnMixAddVSTClick's own load-probe-before-adding safety check: a
  DLL that doesn't scan as a usable VST2 effect is rejected here exactly the
  same way, rather than becoming a broken insert. }
procedure TfrmMain.pbMixerDragDrop(Sender, Source: TObject; X, Y: Integer);
var
  path, pathB64, loadError, dropKind, dropName: string;
  i, targetStripId, paramCount: Integer;
  targetStrip: TMixStrip;
  dropInst, dropMidi: Boolean;
begin
  if (Source <> tvBrowser) or (tvBrowser.Selected = nil) or
     (tvBrowser.Selected.Data <> BRND_FILE) or (FProject = nil) then Exit;
  path := BrowserNodePath(tvBrowser.Selected);
  if not (SameText(ExtractFileExt(path), '.dll') or SameText(ExtractFileExt(path), '.vst3')) then Exit;

  targetStripId := -1;
  for i := 0 to High(FMixStripRects) do
    if PtInRect(FMixStripRects[i], Point(X, Y)) then
    begin
      targetStripId := FMixStripIds[i];
      Break;
    end;
  if targetStripId < 0 then
  begin
    memBrowser.Lines.Insert(0, 'drop a plugin directly on a mixer strip');
    Exit;
  end;

  pathB64 := TNetEncoding.Base64.EncodeBytesToString(TEncoding.UTF8.GetBytes(path));
  targetStrip := MixCur.StripById(targetStripId);
  if (targetStrip <> nil) and MixStripHasVst2Insert(targetStrip, pathB64) then
  begin
    memBrowser.Lines.Insert(0, 'already on that strip, ignored: ' + path);
    Exit;
  end;

  ShowStatusProgress('Adding plugin ' + ExtractFileName(path) + '...', 100);
  try
    UpdateStatusProgress(15, 'Probing plugin...');
    if not ProbePluginFile(path, dropKind, dropName, paramCount, dropInst, dropMidi, loadError) then
    begin
      memBrowser.Lines.Insert(0, 'not a usable plugin: ' + path + '  (' + loadError + ')');
      Exit;
    end;

    UpdateStatusProgress(70, 'Adding plugin insert to selected mixer strip...');
    MixPerform(TAddMixInsertCommand.Create(FProject, targetStripId, dropKind,
      Format('path=%s;state=;paramcount=%d', [pathB64, paramCount]), -1,
      IfThen((dropKind = 'vst3') and (dropName <> ''), dropName, ExtractFileName(path))));
    RefreshMixerTab;
    UpdateStatusProgress(100, 'Plugin insert ready: ' + ExtractFileName(path));
    memBrowser.Lines.Insert(0, 'dropped VST insert onto strip: ' + path);
  finally
    HideStatusProgress;
  end;
end;

