  FMixFirst := 0;
  FMixSig := '';
  mnuMixRemove.Enabled := False;
  pmMixRemove.Enabled := False;
  RefreshMixerTab;
  MixEqSync;
  pnlMixEq.Title := IfThen(FMixViewTracker, 'Tracker Master Graphic 16-Band EQ', 'Master Graphic 16-Band EQ');
