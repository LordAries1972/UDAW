  FEditorOn := False;
  TlSetMode(MODE_ARRANGE);
end;

{ the dock's own tab header (visible beside the arrangement) switches the editor
  without leaving the arrangement }
procedure TfrmMain.pgcDockChange(Sender: TObject);
