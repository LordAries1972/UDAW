{ Stem Splitting - Scan Loop Segments: walks the selected lane(s) - inside the
  marked range when there is one, otherwise the whole lane - and cuts the audio
  from one near-silent point to the next (UDAW.Timeline.LoopScan). Every segment
  whose length is a whole 1/4, 1/8, 1/16, 1/32, 1/64, 2/4 or 4/4 at the project
  tempo becomes a clip on a new "<lane> - Loops <division>" track: the clips
  point into the original source, so nothing is rendered and Undo removes them. }
procedure TfrmMain.TlScanLoopSegments;
type
  THit = record
    Div_: TLoopDivision;
    SourceId: Integer;
    StartSec, OffsetSec, LengthSec: Double;   // length in source seconds
    SourceBpm: Double;                        // > 0 when the clip plays tempo-conformed
    Name: string;
  end;
var
  tl: TTimeline;
  trk: TTimelineTrack;
  c: TTimelineClip;
  src: TMediaSource;
  player: TTimelinePlayer;
  dec: TDecodedSource;
  tids, clipIds: TArray<Integer>;
  cuts: TArray<Integer>;
  hits: array[TLoopDivision] of TArray<THit>;
  h: THit;
  d: TLoopDivision;
  tid, id, j, k, sr, startFrame, frameCount, clipNo, skippedClips, unmatched, total, added: Integer;
  ovStart, ovEnd, segStart, segLen, regionStart, factor, srcQuarter, segSrcStart: Double;
  stretched: Boolean;
  addClipCmd: TAddTimelineClipCommand;
  segs: TArray<TLoopSegment>;
  totalCuts, skippedCuts, regionRate: Integer;
  dbText: string;
  silenceDb: Double;
  trackCmd: TAddTimelineTrackCommand;
  summary: string;

  function ClipSelected(AClipId: Integer): Boolean;
  var
    n: Integer;
  begin
    Result := AClipId = FTlSelClipId;
    for n := 0 to High(FTlSelClipIds) do
      if FTlSelClipIds[n] = AClipId then Exit(True);
  end;

begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  if FTlRangeActive then
    tids := TlRangeTrackIds
  else if FTlSelectedTrackId >= 0 then
    tids := [FTlSelectedTrackId];
  { no lane picked: the lane this menu acts on (right-clicked, else the selected clip's) }
  if (Length(tids) = 0) and (TlContextTrack <> nil) then
    tids := [TlContextTrack.Id];
  { still none: the lane(s) holding the selected clip(s) }
  if Length(tids) = 0 then
    for j := 0 to tl.TrackCount - 1 do
    begin
      trk := tl.GetTrack(j);
      for k := 0 to trk.ClipCount - 1 do
        if ClipSelected(trk.GetClip(k).Id) then
        begin
          tids := tids + [trk.Id];
          Break;
        end;
    end;
  if Length(tids) = 0 then
  begin
    memTimeline.Lines.Insert(0, 'Scan Loop Segments: select a lane or a clip first.');
    Exit;
  end;
  dbText := FormatFloat('0', LOOP_DEFAULT_SILENCE_DB);
  if not PromptValueBelow('Scan Loop Segments',
    'Quiet-point depth - how many dB a dip must lie below the music around it to be a loop cut (0 to 80, smaller = more cuts):', dbText) then Exit;
  silenceDb := EnsureRange(StrToFloatDef(Trim(dbText), LOOP_DEFAULT_SILENCE_DB), 0, 80);
  try
    ShowStatusProgress('Scan Loop Segments - reading source...', 100);
    player := TTimelinePlayer.Create(tl);
    try
      player.EnsureSourcesLoaded;
      for tid in tids do
      begin
        trk := tl.TrackById(tid);
        if (trk = nil) or (trk.Kind <> tkAudio) then Continue;
        for d := Low(TLoopDivision) to High(TLoopDivision) do hits[d] := nil;
        clipIds := nil;
        for j := 0 to trk.ClipCount - 1 do clipIds := clipIds + [trk.GetClip(j).Id];
        clipNo := 0;
        skippedClips := 0;
        unmatched := 0;
        totalCuts := 0;
        for id in clipIds do
        begin
          Inc(clipNo);
          UpdateStatusProgress(Round(100 * clipNo / (Length(clipIds) + 1)),
            Format('Scan Loop Segments - %s - clip %d/%d', [trk.Name, clipNo, Length(clipIds)]));
          Application.ProcessMessages;
          c := tl.ClipById(id);
          if c = nil then Continue;
          { reversed clips don't map onto their source, and MIDI clips have no audio }
          if c.IsMidiClip or c.Reversed then begin Inc(skippedClips); Continue; end;
          { a clip with a Source BPM plays tempo-conformed: timeline time d after the clip start is
            source time d / factor, and the source's own notes are one 60 / SourceBPM apart }
          factor := c.ConformFactor(FProject.TempoBPM);
          if factor <= 0 then factor := 1.0;
          stretched := Abs(factor - 1.0) > 0.001;
          srcQuarter := 0;
          if stretched then srcQuarter := 60.0 / c.SourceBPM;
          ovStart := c.StartSeconds;
          ovEnd := c.EndSeconds;
          if FTlRangeActive then
          begin
            ovStart := Max(ovStart, Min(FTlRangeStartSec, FTlRangeEndSec));
            ovEnd := Min(ovEnd, Max(FTlRangeStartSec, FTlRangeEndSec));
          end;
          if ovEnd - ovStart <= TIMELINE_MIN_CLIP_SECONDS then Continue;
          src := tl.SourceById(c.SourceId);
          if src = nil then Continue;
          dec := player.GetDecodedSource(src.Id);
          if (dec = nil) or dec.Failed or (dec.FrameCount = 0) then begin Inc(skippedClips); Continue; end;
          sr := dec.SampleRate;
          if (sr <= 0) or (dec.Channels <= 0) then Continue;
          startFrame := Max(Round((c.SourceOffsetSeconds + (ovStart - c.StartSeconds) / factor) * sr), 0);
          frameCount := Min(Round((ovEnd - ovStart) / factor * sr), dec.FrameCount - startFrame);
          if frameCount <= 0 then Continue;
          cuts := FindLoopCuts(dec.Data, dec.Channels, startFrame, frameCount, sr, silenceDb);
          Inc(totalCuts, Length(cuts));
          regionStart := ovStart;
          regionRate := sr;
          segs := MatchLoopSegments(cuts, sr,
            function(AFrame: Integer): Double
            var
              t: Double;
            begin
              if srcQuarter > 0 then Exit(srcQuarter);
              t := regionStart + AFrame / regionRate;
              Result := 60.0 / Max(FProject.GridContext.TempoAt(t), 1.0);
            end, skippedCuts);
          Inc(unmatched, skippedCuts);
          for k := 0 to High(segs) do
          begin
            d := segs[k].Division;
            { source seconds of the cut, then where that lands on the timeline }
            segSrcStart := startFrame / sr + segs[k].StartFrame / sr;
            segLen := (segs[k].EndFrame - segs[k].StartFrame) / sr;   // source seconds
            segStart := c.StartSeconds + (segSrcStart - c.SourceOffsetSeconds) * factor;
            h.Div_ := d;
            h.SourceId := c.SourceId;
            h.StartSec := segStart;
            h.OffsetSec := segSrcStart;
            h.LengthSec := segLen;
            h.SourceBpm := 0;
            if stretched then h.SourceBpm := c.SourceBPM;
            h.Name := Format('%s %s #%d', [trk.Name, LoopDivisionName(d), Length(hits[d]) + 1]);
            hits[d] := hits[d] + [h];
          end;
        end;
        total := 0;
        summary := '';
        for d := Low(TLoopDivision) to High(TLoopDivision) do
        begin
          if Length(hits[d]) = 0 then Continue;
          Inc(total, Length(hits[d]));
          summary := summary + Format(' %s x%d', [LoopDivisionName(d), Length(hits[d])]);
          trackCmd := TAddTimelineTrackCommand.Create(FProject, tkAudio,
            Format('%s - Loops %s', [trk.Name, LoopDivisionName(d)]));
          FCmds.Perform(trackCmd);
          for added := 0 to High(hits[d]) do
          begin
            addClipCmd := TAddTimelineClipCommand.Create(FProject, trackCmd.CreatedId,
              hits[d][added].SourceId, hits[d][added].Name, hits[d][added].StartSec,
              hits[d][added].OffsetSec, hits[d][added].LengthSec);
            FCmds.Perform(addClipCmd);
            { the segment plays tempo-conformed like its parent: setting the Source BPM rescales the
              source-seconds length given above to timeline seconds }
            if hits[d][added].SourceBpm > 0 then
              FCmds.Perform(TSetTimelineClipSourceBpmCommand.Create(FProject, addClipCmd.CreatedId,
                hits[d][added].SourceBpm));
          end;
        end;
        if total = 0 then
          memTimeline.Lines.Insert(0, Format(
            'Scan Loop Segments - %s: no loop segments found - %d near-silent point(s) located, %d did not start a note-length segment%s. ' +
            IfThen(totalCuts < 2, 'No quiet gaps at this threshold: try a smaller dB value.',
              'Gaps were found but their spacing is not a whole 1/4..4/4 at the project tempo: check the project BPM.'),
            [trk.Name, totalCuts, unmatched, IfThen(skippedClips > 0, Format(', %d clip(s) skipped', [skippedClips]), '')]))
        else
          memTimeline.Lines.Insert(0, Format('Scan Loop Segments - %s: %d segment(s) captured:%s; %d did not fit a note length%s.',
            [trk.Name, total, summary, unmatched,
             IfThen(skippedClips > 0, Format(', %d reversed/MIDI/undecodable clip(s) skipped', [skippedClips]), '')]));
      end;
    finally
      player.Free;
    end;
    EnsureMixerStripsForTimelineTracks;
    RefreshTimelineTab;
    HideStatusProgress;
  except
    on E: Exception do
    begin
      HideStatusProgress;
      memTimeline.Lines.Insert(0, 'Scan Loop Segments FAILED: ' + E.Message);
    end;
  end;
end;

{ Audio to MIDI: transcribes the selected clip into a new Piano Roll clip
  (mono = melody/bass line, poly = chords) via undoable commands. }
procedure TfrmMain.TlAudioToMidiSelected;
var
  tl: TTimeline;
  c: TTimelineClip;
  src: TMediaSource;
  player: TTimelinePlayer;
  dec: TDecodedSource;
  mono: TAudioSampleArray;
  notes: TSeqNotes;
  opts: TA2MOptions;
  modeText: string;
  sr, ch, i, k, startFrame, frameCount, clipIdx: Integer;
  ppq: Integer;
  v: Double;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  c := tl.ClipById(FTlSelClipId);
  if c = nil then
  begin
    memTimeline.Lines.Insert(0, 'Audio to MIDI: select a clip first.');
    Exit;
  end;
  modeText := 'mono';
  if not PromptValueBelow('Audio to MIDI',
    'Transcription mode: "mono" (single melody / bass line) or "poly" (chords):', modeText) then Exit;
  try
    ShowStatusProgress('Audio to MIDI - reading source...', 300);
    player := TTimelinePlayer.Create(tl);
    try
      player.EnsureSourcesLoaded;
      src := tl.SourceById(c.SourceId);
      if src = nil then Exit;
      dec := player.GetDecodedSource(src.Id);
      if (dec = nil) or dec.Failed or (dec.FrameCount = 0) then Exit;
      sr := dec.SampleRate;
      ch := dec.Channels;
      startFrame := Max(Round(c.SourceOffsetSeconds * sr), 0);
      frameCount := Min(Round(c.LengthSeconds * sr), dec.FrameCount - startFrame);
      if frameCount <= 0 then Exit;
      SetLength(mono, frameCount);
      for i := 0 to frameCount - 1 do
      begin
        v := 0;
        for k := 0 to ch - 1 do v := v + dec.Data[k][startFrame + i];
        mono[i] := v / ch;
      end;
    finally
      player.Free;
    end;
    UpdateStatusProgress(100, 'Audio to MIDI - analysing pitch...');
    Application.ProcessMessages;
    opts := TA2MOptions.Default;
    opts.Bpm := FProject.TempoBPM;
    if SameText(Trim(modeText), 'poly') then opts.Mode := a2mPoly else opts.Mode := a2mMono;
    notes := AudioToMidi(mono, sr, opts);
    UpdateStatusProgress(200, Format('Audio to MIDI - writing %d notes...', [Length(notes)]));
    if Length(notes) = 0 then
    begin
      HideStatusProgress;
      memTimeline.Lines.Insert(0, 'Audio to MIDI: no notes detected (try poly mode or a louder clip).');
      Exit;
    end;
    ppq := MIDI_DEFAULT_PPQ;
    FCmds.Perform(TAddMidiClipCommand.Create(FProject, 'Transcribed ' + c.Name, ppq));
    clipIdx := FProject.Midi.ClipCount - 1;
    for i := 0 to High(notes) do
      FCmds.Perform(TAddMidiNoteCommand.Create(FProject, clipIdx, 0,
        Round(notes[i].Beat * ppq), Max(Round(notes[i].Length * ppq), 1),
        notes[i].Key, notes[i].Velocity, 0));
    FMidiClipIndex := clipIdx;
    FMidiTrackIndex := 0;
    RefreshMidiTab;
    memTimeline.Lines.Insert(0, Format('Audio to MIDI: %d notes written to a new Piano Roll clip.', [Length(notes)]));
    HideStatusProgress;
  except
    on E: Exception do
    begin
      HideStatusProgress;
      memTimeline.Lines.Insert(0, 'Audio to MIDI FAILED: ' + E.Message);
    end;
  end;
end;

{ transcriber progress: 0..100 maps onto the 300..380 stretch of the Create to Score bar }
function TfrmMain.TlScoreProgress(APercent: Integer): Boolean;
begin
  UpdateStatusProgress(300 + APercent * 80 div 100, 'Create to Score - listening to the lane...');
  Result := not TlJobCancelled;
end;

{ Pumps the message queue so the UI never jams during a long job, and reports whether
  Escape was pressed since the job began (sticky: once cancelled it stays cancelled
  until the next job clears FTlJobCancelled). }
function TfrmMain.TlJobCancelled: Boolean;
begin
  Application.ProcessMessages;
  JobPollEscape;
  Result := FTlJobCancelled;
end;

{ Esc while a status-bar job runs (and this window is the active one) marks it cancelled }
procedure TfrmMain.JobPollEscape;
begin
  {$IFNDEF FPC}
  if FSyncProgressActive and (not FTlJobCancelled) and Application.Active and
     (GetAsyncKeyState(VK_ESCAPE) and $8001 <> 0) then
    FTlJobCancelled := True;
  {$ENDIF}
end;

{ Long-running steps in the engine units call this (TimelinePumpHook): only while a
  status-bar job is running does it pump the message queue - so the periodic source
  poll during playback never re-enters the UI - and Esc cancels the job from here. }
procedure TfrmMain.JobPump;
begin
  if (TThread.CurrentThread.ThreadID <> MainThreadID) or not FSyncProgressActive then Exit;
  Application.ProcessMessages;
  JobPollEscape;
  if FTlJobCancelled and (prgStatus.Style = pbstNormal) then JobCancelNow;
  JobRefreshStatus;
end;

{ Esc while a long job runs in the background - the timeline export, the video-effects render,
  the audio stretching / decoding before Play, the AI (Suno) generation or the Luma job - cancels it. Each tick looks only at jobs that are really
  running, and only when this window is the active one. }
procedure TfrmMain.RenderJobsPollEscape;
var
  hit: Boolean;
begin
  { FPC}
  if not Application.Active then Exit;
  if (FCacheThread <> nil) and (GetAsyncKeyState(VK_ESCAPE) and $8001 <> 0) then
    FCacheCancel := True;   // Delete Cache stops after the file it is on
  if ((FTimelineExportJob = nil) or FTimelineExportJob.IsTerminal) and
     ((FTlFxJob = nil) or FTlFxJob.IsTerminal) and
     ((FTlPrepJob = nil) or FTlPrepJob.IsTerminal) and
     ((FSunoJob = nil) or FSunoJob.IsTerminal) and
     ((FLumaJob = nil) or FLumaJob.IsTerminal) then
  begin
    GetAsyncKeyState(VK_ESCAPE);   // no render running: forget any Esc pressed meanwhile
    Exit;
  end;
  if GetAsyncKeyState(VK_ESCAPE) and $8001 = 0 then Exit;
  hit := False;
  if (FTimelineExportJob <> nil) and not FTimelineExportJob.IsTerminal then
  begin
    FTimelineExportJob.Cancel;
    hit := True;
  end;
  if (FTlFxJob <> nil) and not FTlFxJob.IsTerminal then
  begin
    FTlFxJob.Cancel;
    hit := True;
  end;
  if (FTlPrepJob <> nil) and not FTlPrepJob.IsTerminal then
  begin
    FTlPrepJob.Cancel;
    hit := True;
  end;
  if (FSunoJob <> nil) and not FSunoJob.IsTerminal then
  begin
    FSunoJob.Cancel;
    memAiLog.Lines.Add('AI/SI generation cancelled with Esc.');
    hit := True;
  end;
  if (FLumaJob <> nil) and not FLumaJob.IsTerminal then
  begin
    FLumaJob.Cancel;
    memAiLog.Lines.Add('Luma job cancelled with Esc (Luma may still charge for work already started).');
    hit := True;
  end;
  if hit then
  begin
    stbMain.SimpleText := 'Job CANCELLED (Esc) - it is being stopped.';
    memTimeline.Lines.Insert(0, 'Background job cancelled with Esc.');
  end;
  {}
end;

{ the status bar always says what the job is doing, how long it has been going, and that Esc stops it }
function TfrmMain.JobStatusText(const AText: string): string;
begin
  FJobBaseText := AText;
  if AText = '' then
  begin
    prgStatus.Text := '';
    Exit('');
  end;
  FJobLastSec := Integer((GetTickCount64 - FJobTick) div 1000);
  { the capsule progress bar shows the percentage alone (no Text); the status line on the left names
    the action being done - the two never repeat each other }
  prgStatus.Text := '';
  Result := AText;
end;

{ keeps the elapsed time ticking while a step is busy and has nothing new to report }
procedure TfrmMain.JobRefreshStatus;
begin
  if (FJobBaseText = '') or (Integer((GetTickCount64 - FJobTick) div 1000) = FJobLastSec) then Exit;
  stbMain.SimpleText := JobStatusText(FJobBaseText);
  stbMain.Update;
end;

{ Runs a blocking call (a network request) on a worker thread while this thread keeps
  pumping messages, ticking the elapsed time and watching for Esc, so the program never
  looks frozen. On Esc: AAbandonOnEsc = True walks away from the call at once (everything
  the call uses must be kept alive by the closure - interfaces are); False waits for it to
  return, still responsive, for calls that use an object the caller frees afterwards.
  An exception raised by AWork is re-raised here. }
procedure TfrmMain.JobAwait(const AWork: TProc; AAbandonOnEsc: Boolean);
var
  task: ITask;
  failure: TObject;
  cancelled: Boolean;
begin
  failure := nil;
  cancelled := False;
  task := TTask.Run(
    procedure
    begin
      try
        AWork();
      except
        failure := AcquireExceptionObject;
      end;
    end);
  while task.Status in [TTaskStatus.Created, TTaskStatus.WaitingToRun, TTaskStatus.Running] do
  begin
    Sleep(15);
    Application.ProcessMessages;
    JobPollEscape;
    if FTlJobCancelled and not cancelled then
    begin
      cancelled := True;
      if AAbandonOnEsc then Break;
      stbMain.SimpleText := 'Cancelling - waiting for the server to answer (the program stays usable)...';
    end;
    if not cancelled then JobRefreshStatus;
  end;
  if cancelled then
  begin
    failure.Free;
    JobCancelNow;
  end;
  if failure <> nil then raise failure;
end;

{ polled by the Python bridge while a script runs: Esc stops the script }
procedure TfrmMain.PyPoll;
begin
  JobPollEscape;
  JobRefreshStatus;
  if FTlJobCancelled and (FPyBridge <> nil) then FPyBridge.Cancel;
end;

{ first status-bar call of a job: remember the undo depth, forget any earlier Esc }
procedure TfrmMain.JobBegin;
begin
  if FSyncProgressActive then Exit;   // nested step of a job already running
  FTlJobCancelled := False;
  FJobTick := GetTickCount64;
  FJobBaseText := '';
  FJobFiles := nil;
  FJobUndo := nil;
  if FCmds <> nil then FJobUndoMark := FCmds.UndoCount else FJobUndoMark := 0;
  {$IFNDEF FPC}
  GetAsyncKeyState(VK_ESCAPE);   // clear the "pressed since last call" bit
  {$ENDIF}
end;

{ discards everything the job did through commands, tells the status bar, and unwinds the job }
{ a rendered / cached file the running job just wrote: deleted if the job is cancelled }
procedure TfrmMain.JobNoteFile(const AFile: string);
begin
  if AFile = '' then Exit;
  FJobFiles := FJobFiles + [AFile];
end;

{ call BEFORE the job edits a clip directly (effect labels and regions are not commands):
  remembers how it was so a cancel can put it back }
procedure TfrmMain.JobNoteClip(AClip: TTimelineClip);
var
  id: Integer;
  nm: string;
  off, len: Double;
  col: TColor;
  regs: TArray<TClipEffectRegion>;
begin
  if AClip = nil then Exit;
  id := AClip.Id;
  nm := AClip.EffectName;
  off := AClip.EffectOffsetSeconds;
  len := AClip.EffectLengthSeconds;
  col := AClip.Color;
  regs := Copy(AClip.EffectRegions);
  SetLength(FJobUndo, Length(FJobUndo) + 1);
  FJobUndo[High(FJobUndo)] :=
    procedure
    var
      c: TTimelineClip;
    begin
      if FProject = nil then Exit;
      c := FProject.Timeline.ClipById(id);
      if c = nil then Exit;
      c.EffectName := nm;
      c.EffectOffsetSeconds := off;
      c.EffectLengthSeconds := len;
      c.Color := col;
      c.EffectRegions := regs;
    end;
end;

{ Esc: undoes what the job did through commands, puts back its direct edits, drops sources
  nothing uses any more, deletes the files it rendered and the decoded copies of them, and
  forgets what was undone (it must not be redoable). Returns how many files were deleted. }
function TfrmMain.JobRollback: Integer;
var
  guard, i, undone: Integer;
begin
  Result := 0;
  guard := 0;
  undone := 0;
  while (FCmds <> nil) and (FCmds.UndoCount > FJobUndoMark) and FCmds.CanUndo and (guard < 100000) do
  begin
    FCmds.Undo;
    Inc(guard);
    Inc(undone);
  end;
  for i := High(FJobUndo) downto 0 do
    try
      FJobUndo[i]();
    except
      // a clip that no longer exists has nothing to restore
    end;
  FJobUndo := nil;
  if (undone > 0) and (FCmds <> nil) then FCmds.DiscardRedo;
  if (Length(FJobFiles) > 0) and (FProject <> nil) then FProject.Timeline.RemoveUnusedSources;
  for i := 0 to High(FJobFiles) do
    if FileExists(FJobFiles[i]) then
      try
        if DeleteFile(FJobFiles[i]) then Inc(Result);
      except
        // still in use: the next cleanup of the recordings folder will catch it
      end;
  if Length(FJobFiles) > 0 then
  begin
    if FTlCacheHolder <> nil then FTlCacheHolder.InvalidateAll;   // decoded copies of the deleted files
    FJobFiles := nil;
  end;
  TlPruneSelection;
  if (undone > 0) or (Result > 0) then RefreshTimelineTab;
end;

{ forgets selected / pressed / dragged clips that no longer exist (an undo, a cancelled job or a
  failed import can remove the clip the selection still names) }
procedure TfrmMain.TlPruneSelection;
var
  tl: TTimeline;
  i: Integer;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  for i := High(FTlSelClipIds) downto 0 do
    if tl.ClipById(FTlSelClipIds[i]) = nil then Delete(FTlSelClipIds, i, 1);
  if (FTlSelClipId >= 0) and (tl.ClipById(FTlSelClipId) = nil) then
  begin
    if Length(FTlSelClipIds) > 0 then
    begin
      FTlSelClipId := FTlSelClipIds[0];
      Delete(FTlSelClipIds, 0, 1);
    end
    else
      FTlSelClipId := -1;
  end;
  if (FTlPressClipId >= 0) and (tl.ClipById(FTlPressClipId) = nil) then FTlPressClipId := -1;
  for i := High(FTlDragIds) downto 0 do
    if tl.ClipById(FTlDragIds[i]) = nil then Delete(FTlDragIds, i, 1);
end;

procedure TfrmMain.JobCancelNow;
var
  deleted: Integer;
begin
  { FTlJobCancelled stays set until the next JobBegin, so a job that swallows the
    exception per item still stops at its very next progress call }
  HideStatusProgress;
  deleted := JobRollback;
  if deleted > 0 then
    stbMain.SimpleText := Format('Job CANCELLED (Esc) - all changes were discarded and %d rendered file(s) were deleted.', [deleted])
  else
    stbMain.SimpleText := 'Job CANCELLED (Esc) - all changes were discarded.';
  raise EJobCancelled.Create('cancelled with Esc - changes discarded');
end;

{ Create to Score (lane right-click): mixes every unmuted audio clip of the lane into
  one mono signal on the project's timeline, transcribes it, and commits the result
  as a MIDI clip on a new MIDI track. That clip is a normal project clip, so it is
  saved with the project and the Score tab shows it as that lane's score line. }
procedure TfrmMain.pmTlCreateScoreClick(Sender: TObject);
const
  SCORE_SR = 22050;
var
  tl: TTimeline;
  trk: TTimelineTrack;
  c: TTimelineClip;
  src: TMediaSource;
  player: TTimelinePlayer;
  dec: TDecodedSource;
  mono: TAudioSampleArray;
  notes: TSeqNotes;
  opts: TA2MOptions;
  seq: TMidiSequence;
  mtr: TMidiTrackSeq;
  mn: TMidiNote;
  modeText, laneName: string;
  ci, i, k, f, f0, f1, o0, o1, o, ch, total, used, ppq: Integer;
  ratio, endSec, acc: Double;
begin
  if (FProject = nil) or (FTlCtxTrackId < 0) then Exit;
  tl := FProject.Timeline;
  trk := tl.TrackById(FTlCtxTrackId);
  if (trk = nil) or (trk.Kind = tkMidi) then Exit;
  laneName := trk.Name;
  endSec := 0;
  for ci := 0 to trk.ClipCount - 1 do
  begin
    c := trk.GetClip(ci);
    if (not c.IsMidiClip) and (not c.Muted) then endSec := Max(endSec, c.EndSeconds);
  end;
  if endSec <= 0 then
  begin
    memTimeline.Lines.Insert(0, 'Create to Score: the lane has no audio.');
    Exit;
  end;
  modeText := 'mono';
  if not PromptValueBelow('Create to Score',
    'Transcription mode: "mono" (single melody / bass line) or "poly" (chords):', modeText) then Exit;
  try
    FTlJobCancelled := False;
    {$IFNDEF FPC}
    GetAsyncKeyState(VK_ESCAPE);   // clear the "pressed since last call" bit (e.g. from closing the prompt)
    {$ENDIF}
    ShowStatusProgress('Create to Score - reading lane audio...', 400);
    total := Ceil(endSec * SCORE_SR);
    SetLength(mono, total);
    for i := 0 to total - 1 do mono[i] := 0;
    used := 0;
    player := TTimelinePlayer.Create(tl);
    try
      player.EnsureSourcesLoaded;
      for ci := 0 to trk.ClipCount - 1 do
      begin
        c := trk.GetClip(ci);
        if c.IsMidiClip or c.Muted then Continue;
        src := tl.SourceById(c.SourceId);
        if src = nil then Continue;
        dec := player.GetDecodedSource(src.Id);
        if (dec = nil) or dec.Failed or (dec.FrameCount = 0) or (dec.SampleRate <= 0) then Continue;
        ch := Max(1, dec.Channels);
        ratio := dec.SampleRate / SCORE_SR;
        o0 := Max(0, Round(c.StartSeconds * SCORE_SR));
        o1 := Min(total, Round(c.EndSeconds * SCORE_SR));
        for o := o0 to o1 - 1 do
        begin
          if (o and $3FFF = 0) and TlJobCancelled then Abort;
          { box-average the source frames this output sample spans (no aliasing) }
          f0 := Round((c.SourceOffsetSeconds + (o - o0) / SCORE_SR) * dec.SampleRate);
          f1 := Max(f0 + 1, Round(f0 + ratio));
          if (f0 < 0) or (f0 >= dec.FrameCount) then Continue;
          f1 := Min(f1, dec.FrameCount);
          acc := 0;
          for f := f0 to f1 - 1 do
            for k := 0 to ch - 1 do acc := acc + dec.Data[k][f];
          mono[o] := mono[o] + acc / ((f1 - f0) * ch);
        end;
        Inc(used);
        UpdateStatusProgress(Round(300 * (ci + 1) / trk.ClipCount), 'Create to Score - reading lane audio...');
        if TlJobCancelled then Abort;
      end;
    finally
      player.Free;
    end;
    if used = 0 then
    begin
      HideStatusProgress;
      memTimeline.Lines.Insert(0, 'Create to Score: no audio in the lane could be decoded.');
      Exit;
    end;
    UpdateStatusProgress(300, 'Create to Score - listening to the lane...');
    if TlJobCancelled then Abort;
    opts := TA2MOptions.Default;
    opts.Bpm := FProject.TempoBPM;
    if SameText(Trim(modeText), 'poly') then opts.Mode := a2mPoly else opts.Mode := a2mMono;
    notes := AudioToMidi(mono, SCORE_SR, opts, TlScoreProgress);
    if FTlJobCancelled then Abort;
    if Length(notes) = 0 then
    begin
      HideStatusProgress;
      memTimeline.Lines.Insert(0, 'Create to Score: no notes detected (try poly mode or a louder lane).');
      Exit;
    end;
    UpdateStatusProgress(380, Format('Create to Score - writing %d notes...', [Length(notes)]));
    if TlJobCancelled then Abort;
    ppq := MIDI_DEFAULT_PPQ;
    seq := TMidiSequence.Create(ppq);
    try
      seq.SetInitialBPM(FProject.TempoBPM);
      mtr := seq.AddTrack('Score');
      for i := 0 to High(notes) do
      begin
        mn := Default(TMidiNote);
        mn.StartTick := Round(notes[i].Beat * ppq);
        mn.LengthTick := Max(Round(notes[i].Length * ppq), 1);
        mn.Note := EnsureRange(notes[i].Key, 0, 127);
        mn.Velocity := EnsureRange(notes[i].Velocity, 1, 127);
        mtr.AddNote(mn);
      end;
      mtr.SortNotes;
    except
      seq.Free;
      raise;
    end;
    FCmds.Perform(TCommitMidiTakeCommand.Create(FProject, 0, seq, 'Score: ' + laneName, 0,
      'Score: ' + laneName, endSec));
    EnsureMixerStripsForTimelineTracks;   // the score lane gets its mixer strip too
    { the lane's own audio would play over its score line: mute it (un-mute from the lane menu) }
    trk.Muted := True;
    FProject.Touch;
    RefreshTimelineTab;
    HideStatusProgress;
    memTimeline.Lines.Insert(0, Format(
      'Create to Score: %d notes from "%s" saved as MIDI track "Score: %s" (see the Score tab); the original lane is muted.',
      [Length(notes), laneName, laneName]));
  except
    on EAbort do
    begin
      { Escape: nothing was committed (the clip is only added at the very end), the lane is untouched }
      HideStatusProgress;
      stbMain.SimpleText := 'Create to Score CANCELLED (Esc) - no changes were made.';
      memTimeline.Lines.Insert(0, 'Create to Score: cancelled with Esc - no changes were made.');
    end;
    on E: Exception do
    begin
      HideStatusProgress;
      memTimeline.Lines.Insert(0, 'Create to Score FAILED: ' + E.Message);
    end;
  end;
end;

{ Metronome button: takes effect immediately on a running Timeline player,
  and is picked up at the start of every later Play. }
procedure TfrmMain.TlSetMetronome(AOn: Boolean);
begin
  FMetronomeOn := AOn;
  if (FTlPlayer <> nil) and (FProject <> nil) then
  begin
    FTlPlayer.SetMetronome(FMetronomeOn, FProject.TempoBPM, 4, -12);
    FTlPlayer.SetTempoMap(FProject.TempoBPM, FProject.TempoMap);
  end;
end;

{ Warp markers (see UDAW.Timeline.Warp). Markers live per selected clip for the
  session; "Apply" bakes them into a new source through the undoable
  source-swap command, so the original file is never touched and Undo restores
  the previous audio. Tags: 1 add at playhead, 2 snap to nearest beat,
  3 auto-detect, 4 apply, 5 clear. }
procedure TfrmMain.TlWarpMenuClick(Sender: TObject);
var
  tl: TTimeline;
  c: TTimelineClip;
  src: TMediaSource;
  newSrc: TMediaSource;
  player: TTimelinePlayer;
  dec: TDecodedSource;
  planar, warped: TAudioPlanar;
  mono: TAudioSampleArray;
  onsets: TArray<Double>;
  usable: TWarpMarkers;
  sr, ch, i, k, startFrame, frameCount, outFrames, idx: Integer;
  rel, spb, beatAbs, lenSec, v: Double;
  fileName: string;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  c := tl.ClipById(FTlSelClipId);
  if (c = nil) or c.IsMidiClip then
  begin
    memTimeline.Lines.Insert(0, 'Warp: select an audio clip first.');
    Exit;
  end;
  if FWarpClipId <> c.Id then
  begin
    FWarpClipId := c.Id;
    SetLength(FWarpMarkers, 0);
  end;
  rel := tl.PlayheadSeconds - c.StartSeconds;
  spb := 60.0 / Max(FProject.TempoBPM, 20.0);
  case TMenuItem(Sender).Tag of
    1: begin
         if (rel <= WARP_MIN_SEGMENT_SEC) or (rel >= c.LengthSeconds - WARP_MIN_SEGMENT_SEC) then
         begin
           memTimeline.Lines.Insert(0, 'Warp: put the playhead inside the selected clip first.');
           Exit;
         end;
         AddWarpMarker(FWarpMarkers, rel, rel);
         memTimeline.Lines.Insert(0, Format('Warp: marker added at %.3f s (%d marker(s)).',
           [rel, Length(FWarpMarkers)]));
       end;
    2: begin
         idx := NearestWarpMarker(FWarpMarkers, rel, 0.3);
         if idx < 0 then
         begin
           if (rel <= WARP_MIN_SEGMENT_SEC) or (rel >= c.LengthSeconds - WARP_MIN_SEGMENT_SEC) then
           begin
             memTimeline.Lines.Insert(0, 'Warp: put the playhead on the audio event to pin first.');
             Exit;
           end;
           AddWarpMarker(FWarpMarkers, rel, rel);
           idx := NearestWarpMarker(FWarpMarkers, rel, 0.02);
         end;
         beatAbs := Round((c.StartSeconds + FWarpMarkers[idx].SrcSec) / spb) * spb;
         FWarpMarkers[idx].DstSec := beatAbs - c.StartSeconds;
         NormalizeWarpMarkers(FWarpMarkers);
         memTimeline.Lines.Insert(0, Format('Warp: marker snapped to the beat grid (%d marker(s)).',
           [Length(FWarpMarkers)]));
       end;
    3, 4:
       begin
         if FTlPlaying or FGraphPlaying or FWavPlaying or FTrkPlaying then
         begin
           memTimeline.Lines.Insert(0, 'Warp: stop playback first.');
           Exit;
         end;
         if (TMenuItem(Sender).Tag = 4) and (Length(FWarpMarkers) = 0) then
         begin
           memTimeline.Lines.Insert(0, 'Warp: no markers - add some or use Auto-Detect.');
           Exit;
         end;
         try
           ShowStatusProgress('Warp - reading source...', 300);
           player := TTimelinePlayer.Create(tl);
           try
             player.EnsureSourcesLoaded;
             src := tl.SourceById(c.SourceId);
             if src = nil then Exit;
             dec := player.GetDecodedSource(src.Id);
             if (dec = nil) or dec.Failed or (dec.FrameCount = 0) then Exit;
             sr := dec.SampleRate;
             ch := dec.Channels;
             startFrame := Max(Round(c.SourceOffsetSeconds * sr), 0);
             frameCount := Min(Round(c.LengthSeconds * sr), dec.FrameCount - startFrame);
             if frameCount < 4096 then Exit;
             EnsurePlanar(planar, ch, frameCount);
             for i := 0 to ch - 1 do
               Move(dec.Data[i][startFrame], planar[i][0], frameCount * SizeOf(Single));
           finally
             player.Free;
           end;
           lenSec := frameCount / sr;
           if TMenuItem(Sender).Tag = 3 then
           begin
             UpdateStatusProgress(100, 'Warp - detecting beats...');
             Application.ProcessMessages;
             SetLength(mono, frameCount);
             for i := 0 to frameCount - 1 do
             begin
               v := 0;
               for k := 0 to ch - 1 do v := v + planar[k][i];
               mono[i] := v / ch;
             end;
             onsets := DetectOnsets(mono, sr);
             FWarpMarkers := AutoWarpMarkers(onsets, FProject.TempoBPM, c.StartSeconds);
             memTimeline.Lines.Insert(0, Format('Warp: %d onset(s) found, %d pinned to the grid. ' +
               'Use "Warp: Apply Markers" to render.', [Length(onsets), Length(FWarpMarkers)]));
             HideStatusProgress;
             Exit;
           end;
           { keep only markers that leave room for the tail segment }
           SetLength(usable, 0);
           for i := 0 to High(FWarpMarkers) do
             if (FWarpMarkers[i].SrcSec < lenSec - WARP_MIN_SEGMENT_SEC) and
                (FWarpMarkers[i].DstSec < lenSec - WARP_MIN_SEGMENT_SEC) then
             begin
               SetLength(usable, Length(usable) + 1);
               usable[High(usable)] := FWarpMarkers[i];
             end;
           NormalizeWarpMarkers(usable);
           if Length(usable) = 0 then
           begin
             HideStatusProgress;
             memTimeline.Lines.Insert(0, 'Warp: no usable markers (too close together or too extreme).');
             Exit;
           end;
           UpdateStatusProgress(150, Format('Warp - stretching %d segment(s)...', [Length(usable) + 1]));
           Application.ProcessMessages;
           JobAwait(
             procedure
             begin
               RenderWarp(planar, ch, frameCount, sr, usable, warped, outFrames);
             end, False);
           UpdateStatusProgress(250, 'Warp - writing audio file...');
           ForceDirectories(IncludeTrailingPathDelimiter(RecordingRootPath));
           fileName := IncludeTrailingPathDelimiter(RecordingRootPath) +
             Format('warp-clip%d-%s.wav', [c.Id, FormatDateTime('yyyymmdd-hhnnsszzz', Now)]);
           SaveWavFile(fileName, warped, ch, sr, Min(outFrames, frameCount), wsfPCM24);
           JobNoteFile(fileName);
           newSrc := tl.AddSource(fileName, sr, ch, Min(outFrames, frameCount));
           FCmds.Perform(TSetTimelineClipSourceCommand.Create(FProject, c.Id, newSrc.Id, 0));
           JobNoteClip(c);
           c.EffectName := 'Warp';
           c.Color := TlEffectColor('Warp');
           SetLength(FWarpMarkers, 0);
           memTimeline.Lines.Insert(0, Format('Warp applied: %d marker(s) rendered (undoable).', [Length(usable)]));
           RefreshTimelineTab;
           HideStatusProgress;
         except
           on E: Exception do
           begin
             HideStatusProgress;
             memTimeline.Lines.Insert(0, 'Warp FAILED: ' + E.Message);
           end;
         end;
       end;
    5: begin
         SetLength(FWarpMarkers, 0);
         memTimeline.Lines.Insert(0, 'Warp: markers cleared.');
       end;
  end;
end;

procedure TfrmMain.TlFxFadeInClick(Sender: TObject);
begin
  TlApplyEffectToRange('@fadein', '', 'Fade In');
end;

procedure TfrmMain.TlFxFadeOutClick(Sender: TObject);
begin
  TlApplyEffectToRange('@fadeout', '', 'Fade Out');
end;

{ The fixed-setting Timeline effects, by menu Tag (the same presets the
  Mixer tab's insert palette offers). Effects that ask for a value first
  (Amplify, Balance, Pitch Shift, ...) are handled in TlFxMenuClick. }
function TfrmMain.TlFxPreset(ATag: Integer; out AKind, AParams, AName: string): Boolean;
begin
  Result := FxPresetByTag(ATag, AKind, AParams, AName);
end;

{ Kind + starting settings for a Timeline effect by its display name - used
  by "Edit Effect" when a region was saved before its settings were kept.
  Value-prompt effects start from the prompt's own default. }
function TfrmMain.TlFxPresetByName(const AName: string; out AKind, AParams: string): Boolean;
var
  tag: Integer;
  n: string;
begin
  Result := True;
  for tag := 1 to 130 do
    if TlFxPreset(tag, AKind, AParams, n) and SameText(n, AName) then Exit;
  AKind := '';
  AParams := '';
  if SameText(AName, 'Amplify') then begin AKind := 'gain'; AParams := 'db=6'; end
  else if SameText(AName, 'Balance') then begin AKind := 'pan'; AParams := 'pos=0'; end
  else if SameText(AName, 'Pitch Shift') then begin AKind := 'pitchshift'; AParams := 'semitones=2'; end
  else if SameText(AName, 'Noise Reduction') then begin AKind := '@denoise'; AParams := 'reduce=12'; end
  else if SameText(AName, 'Auto-Tune') then begin AKind := '@autotune'; AParams := 'scale=C major;strength=1'; end
  else if SameText(AName, 'Convolution Reverb') then begin AKind := '@convolve'; AParams := 'ir=;mix=0.3'; end
  else if SameText(AName, 'Fade In') then begin AKind := '@fadein'; AParams := ''; end
  else if SameText(AName, 'Fade Out') then begin AKind := '@fadeout'; AParams := ''; end
  else
    Result := False;
end;

{ Loudness & Phase Report: measures every clip slice inside the marked range and writes the
  numbers to the Timeline log (nothing is changed or rendered). }
procedure TfrmMain.TlMeasureRangeReport;
var
  tl: TTimeline;
  trk: TTimelineTrack;
  tids: TArray<Integer>;
  tid, j, i, sr, ch, startFrame, frameCount, n: Integer;
  c: TTimelineClip;
  src: TMediaSource;
  player: TTimelinePlayer;
  dec: TDecodedSource;
  slice: TAudioPlanar;
  rep: TAudioMeterReport;
  ambi: TAmbisonicReport;
  s0, s1: Double;
begin
  if (FProject = nil) or not FTlRangeActive then
  begin
    memTimeline.Lines.Insert(0, 'Loudness & Phase Report: mark a range on the ruler first.');
    Exit;
  end;
  tl := FProject.Timeline;
  tids := TlRangeTrackIds;
  n := 0;
  player := TTimelinePlayer.Create(tl);
  try
    player.EnsureSourcesLoaded;
    for tid in tids do
    begin
      trk := tl.TrackById(tid);
      if trk = nil then Continue;
      for j := 0 to trk.ClipCount - 1 do
      begin
        c := trk.GetClip(j);
        s0 := Max(c.StartSeconds, FTlRangeStartSec);
        s1 := Min(c.EndSeconds, FTlRangeEndSec);
        if s1 - s0 <= TIMELINE_MIN_CLIP_SECONDS then Continue;
        src := tl.SourceById(c.SourceId);
        if src = nil then Continue;
        dec := player.GetDecodedSource(src.Id);
        if (dec = nil) or dec.Failed or (dec.FrameCount = 0) then Continue;
        sr := dec.SampleRate;
        ch := dec.Channels;
        if (sr <= 0) or (ch <= 0) then Continue;
        startFrame := Max(0, Round(c.SourceOffsetSeconds * sr) + Round((s0 - c.StartSeconds) * sr));
        frameCount := Round((s1 - s0) * sr);
        if startFrame + frameCount > dec.FrameCount then frameCount := dec.FrameCount - startFrame;
        if frameCount <= 0 then Continue;
        SetLength(slice, ch);
        for i := 0 to ch - 1 do
        begin
          SetLength(slice[i], frameCount);
          Move(dec.Data[i][startFrame], slice[i][0], frameCount * SizeOf(Single));
        end;
        MeasureAudio(slice, ch, frameCount, sr, rep);
        if MeasureAmbisonics(slice, ch, frameCount, ambi) then
          memTimeline.Lines.Insert(0, Format('    Ambisonics (W Y Z X): %.1f / %.1f / %.1f / %.1f dB   source direction: azimuth %.0f deg, elevation %.0f deg, directivity %.2f (1 = single source, 0 = diffuse)',
            [ambi.ChannelRmsDb[0], ambi.ChannelRmsDb[1], ambi.ChannelRmsDb[2], ambi.ChannelRmsDb[3],
             ambi.AzimuthDeg, ambi.ElevationDeg, ambi.Directivity], TFormatSettings.Invariant));
        { newest line sits on top of the log, so the three lines go in reverse }
        memTimeline.Lines.Insert(0, Format('    stereo correlation %.2f (1 = mono, 0 = wide, below 0 = phase problems)   side vs mid %.1f dB   DC offset %.5f',
          [rep.Correlation, rep.SideToMidDb, rep.DcOffset], TFormatSettings.Invariant));
        memTimeline.Lines.Insert(0, Format('    sample peak %.1f dBFS   true peak %.1f dBTP   RMS %.1f dBFS',
          [rep.SamplePeakDb, rep.TruePeakDb, rep.RmsDb], TFormatSettings.Invariant));
        memTimeline.Lines.Insert(0, Format('Loudness & Phase Report - clip %d (%.1f s): integrated %.1f LUFS   momentary max %.1f LUFS   short-term max %.1f LUFS',
          [c.Id, s1 - s0, rep.IntegratedLufs, rep.MomentaryMaxLufs, rep.ShortTermMaxLufs], TFormatSettings.Invariant));
        Inc(n);
      end;
    end;
  finally
    player.Free;
  end;
  if n = 0 then
    memTimeline.Lines.Insert(0, 'Loudness & Phase Report: no clips with audio in the selected range.');
end;

{ True when one of the lanes the range effect would touch is a MIDI / Instrument lane }
function TfrmMain.TlRangeHasMidiLane: Boolean;
var
  tid: Integer;
  trk: TTimelineTrack;
begin
  Result := False;
  if FProject = nil then Exit;
  for tid in TlRangeTrackIds do
  begin
    trk := FProject.Timeline.TrackById(tid);
    if (trk <> nil) and (trk.Kind in [tkMidi, tkInstrument]) then Exit(True);
  end;
end;

{ Effects > Plug-in...: loads a VST2 / VST3 (or CLAP) plug-in from a file and applies it to the
  marked range of the selected lane(s), like any built-in effect (offline render, undoable,
  Esc cancels). The plug-in runs with its own saved settings.

  An effect works on the audio lanes it is applied to.  A plug-in that takes MIDI (an instrument, or an
  effect on a MIDI lane) is rendered over the range instead: the MIDI lanes under the range play it, the
  audio lanes under the range are its sample input, and the result lands on a new audio track. }
procedure TfrmMain.TlFxPluginClick(Sender: TObject);
var
  fn, ext, pathB64, plugName, loadError, kind, params: string;
  paramCount: Integer;
  clapProbe: TCLAPHost;
  isInst, wantsMidi: Boolean;
begin
  if FProject = nil then Exit;
  if not FTlRangeActive then
  begin
    memTimeline.Lines.Insert(0, 'Plug-in: mark a time range on the lane first (drag in the ruler or lanes), then choose Effects > Plug-in.');
    Exit;
  end;
  if not dlgOpenVst.Execute then Exit;
  fn := dlgOpenVst.FileName;
  ext := LowerCase(ExtractFileExt(fn));
  plugName := '';
  params := '';
  isInst := False;
  wantsMidi := False;
  pathB64 := TNetEncoding.Base64.EncodeBytesToString(TEncoding.UTF8.GetBytes(fn));
  try
    if ext = '.clap' then
    begin
      clapProbe := TCLAPHost.Create;
      try
        clapProbe.LoadOnly(fn);
        plugName := clapProbe.EffectName;
      finally
        clapProbe.Free;
      end;
      kind := 'clap';
      params := Format('path=%s;state=', [pathB64]);
    end
    else
    begin
      if not ProbePluginFile(fn, kind, plugName, paramCount, isInst, wantsMidi, loadError) then
      begin
        MessageDlg('Not a usable plugin:'#13#10 + fn + #13#10#13#10 + loadError, mtError, [mbOK], 0);
        Exit;
      end;
      params := Format('path=%s;state=;paramcount=%d', [pathB64, paramCount]);
    end;
  except
    on E: Exception do
    begin
      MessageDlg('Not a usable plugin:'#13#10 + fn + #13#10#13#10 + E.Message, mtError, [mbOK], 0);
      Exit;
    end;
  end;
  if plugName = '' then plugName := ChangeFileExt(ExtractFileName(fn), '');
  if isInst or (wantsMidi and TlRangeHasMidiLane) then
    TlRenderPluginToRange(kind, params, plugName, isInst)
  else
    TlApplyEffectToRange(kind, params, plugName);
end;

{ Renders a plug-in that takes MIDI over the marked range, offline:
    MIDI         - the notes and controllers of the MIDI / Instrument lanes selected under the range
    sample input - the audio lanes selected under the range, mixed, are the plug-in's audio input
  The result becomes a new clip on a new audio track at the start of the range (undoable); the lanes it
  was made from are left untouched.  Progress is shown in the status bar. }
procedure TfrmMain.TlRenderPluginToRange(const AKind, AParams, AName: string; AInstrument: Boolean);
var
  tl: TTimeline;
  trk: TTimelineTrack;
  c: TTimelineClip;
  src, newSrc: TMediaSource;
  player: TTimelinePlayer;
  dec: TDecodedSource;
  midiTids, audTids: TArray<Integer>;
  midi: TTimedMidiArray;
  input, rendered: TAudioPlanar;
  req: TPluginRenderRequest;
  addCmd: TAddTimelineClipCommand;
  tid, j, i, k, sr, ch, frames, outFrames, srcStart, dstStart, cnt, trackId, used: Integer;
  st, en, ovS, ovE: Double;
  dir, fileName: string;
begin
  if (FProject = nil) or not FTlRangeActive then Exit;
  tl := FProject.Timeline;
  st := Min(FTlRangeStartSec, FTlRangeEndSec);
  en := Max(FTlRangeStartSec, FTlRangeEndSec);
  if en - st < 0.01 then Exit;
  sr := FProject.SampleRate;
  if sr <= 0 then sr := UDAW_DEFAULT_SAMPLE_RATE;
  ch := 2;
  frames := Round((en - st) * sr);

  midiTids := nil;
  audTids := nil;
  for tid in TlRangeTrackIds do
  begin
    trk := tl.TrackById(tid);
    if trk = nil then Continue;
    if trk.Kind in [tkMidi, tkInstrument] then midiTids := midiTids + [tid]
    else if trk.Kind = tkAudio then audTids := audTids + [tid];
  end;
  midi := CollectRangeMidi(tl, FProject.Midi, midiTids, st, en, sr);
  if AInstrument and (Length(midi) = 0) then
  begin
    memTimeline.Lines.Insert(0, AName + ' is an instrument: select a MIDI or Instrument lane with notes under ' +
      'the marked range (add an audio lane too if it should hear it).');
    Exit;
  end;

  ShowStatusProgress(AName + ' - preparing...', 100);
  try
    try
      { the audio lanes under the range, mixed, are the plug-in's sample input }
      SetLength(input, 0);
      if Length(audTids) > 0 then
      begin
        player := TTimelinePlayer.Create(tl);
        try
          player.EnsureSourcesLoaded;
          EnsurePlanar(input, ch, frames);
          for i := 0 to ch - 1 do FillChar(input[i][0], frames * SizeOf(Single), 0);
          used := 0;
          for tid in audTids do
          begin
            trk := tl.TrackById(tid);
            if trk = nil then Continue;
            for j := 0 to trk.ClipCount - 1 do
            begin
              c := trk.GetClip(j);
              ovS := Max(c.StartSeconds, st);
              ovE := Min(c.EndSeconds, en);
              if (c.Muted) or (ovE - ovS <= TIMELINE_MIN_CLIP_SECONDS) then Continue;
              src := tl.SourceById(c.SourceId);
              if src = nil then Continue;
              dec := player.GetDecodedSource(src.Id);
              if (dec = nil) or dec.Failed or (dec.FrameCount = 0) or (dec.Channels <= 0) then Continue;
              if dec.SampleRate <> sr then
              begin
                memTimeline.Lines.Insert(0, Format('%s: clip %d runs at %d Hz, not the project''s %d Hz - left out of the input.',
                  [AName, c.Id, dec.SampleRate, sr]));
                Continue;
              end;
              srcStart := Round((c.SourceOffsetSeconds + (ovS - c.StartSeconds)) * sr);
              dstStart := Round((ovS - st) * sr);
              cnt := Min(Round((ovE - ovS) * sr), Min(dec.FrameCount - srcStart, frames - dstStart));
              if (cnt <= 0) or (srcStart < 0) or (dstStart < 0) then Continue;
              for i := 0 to ch - 1 do
                for k := 0 to cnt - 1 do
                  input[i][dstStart + k] := input[i][dstStart + k] +
                    dec.Data[Min(i, dec.Channels - 1)][srcStart + k];
              Inc(used);
            end;
          end;
          if used = 0 then SetLength(input, 0);
        finally
          player.Free;
        end;
      end;
      if (Length(midi) = 0) and (Length(input) = 0) then
      begin
        memTimeline.Lines.Insert(0, AName + ': nothing to play it with - select a MIDI / Instrument lane or an ' +
          'audio lane that has something under the marked range.');
        Exit;
      end;

      req := TPluginRenderRequest.Make(AKind, AParams, AName, sr, ch, frames);
      req.Tempo := FProject.TempoBPM;
      if req.Tempo < 1 then req.Tempo := 120;
      req.StartPpq := st * req.Tempo / 60.0;
      memTimeline.Lines.Insert(0, Format('%s: rendering %.2f s%s%s through the plug-in...',
        [AName, en - st, IfThen(Length(midi) > 0, Format(' with %d MIDI messages', [Length(midi)]), ''),
         IfThen(Length(input) > 0, ' and the highlighted audio as its input', '')]));
      rendered := RenderPluginToPlanar(req, input, midi,
        procedure(APct: Integer)
        begin
          UpdateStatusProgress(APct, Format('%s - rendering the range (%d%%)', [AName, APct]));
          Application.ProcessMessages;
        end, outFrames);
      if outFrames <= 0 then
      begin
        memTimeline.Lines.Insert(0, AName + ': the plug-in produced no audio.');
        Exit;
      end;

      UpdateStatusProgress(95, AName + ' - writing the audio file...');
      dir := IncludeTrailingPathDelimiter(RecordingRootPath);
      ForceDirectories(dir);
      fileName := dir + Format('fx-%s-render-%s.wav',
        [SafeSunoFileName(AName), FormatDateTime('yyyymmdd-hhnnsszzz', Now)]);
      SaveWavFile(fileName, rendered, ch, sr, outFrames, wsfPCM24);
      JobNoteFile(fileName);
      newSrc := tl.AddSource(fileName, sr, ch, outFrames);
      trackId := TlNewAudioTrackId;
      addCmd := TAddTimelineClipCommand.Create(FProject, trackId, newSrc.Id, AName, st, 0, outFrames / sr);
      FCmds.Perform(addCmd);
      FTlSelClipId := addCmd.CreatedId;
      memTimeline.Lines.Insert(0, Format('%s rendered to a new audio clip (%.2f s).', [AName, outFrames / sr]));
      RefreshTimelineTab;
    except
      on E: Exception do
        memTimeline.Lines.Insert(0, AName + ' FAILED: ' + E.Message);
    end;
  finally
    HideStatusProgress;
  end;
end;

procedure TfrmMain.TlFxMenuClick(Sender: TObject);
var
  kind, params, name, gainText: string;
  gainDb: Double;
begin
  if TMenuItem(Sender).Tag = 11 then
  begin
    TlApplySilenceToRange;
    Exit;
  end;
  case TMenuItem(Sender).Tag of
    12: begin
          { Amplify: plain gain in dB, positive to boost and negative to cut }
          gainText := '6';
          if not PromptValueBelow('Amplify',
            'Gain in dB to apply to the selection (negative values reduce the level):',
            gainText) then Exit;
          if not TryStrToFloat(Trim(gainText), gainDb, TFormatSettings.Invariant) then
            if not TryStrToFloat(Trim(gainText), gainDb) then Exit;
          kind := 'gain';
          params := 'db=' + FloatToStr(EnsureRange(gainDb, -60, 60), TFormatSettings.Invariant);
          name := 'Amplify';
        end;
    21: begin
          { Balance: -100 = full left, 0 = centre, 100 = full right (constant-power pan law) }
          gainText := '0';
          if not PromptValueBelow('Balance',
            'Balance from -100 (left) to 100 (right); 0 is centre:', gainText) then Exit;
          if not TryStrToFloat(Trim(gainText), gainDb, TFormatSettings.Invariant) then
            if not TryStrToFloat(Trim(gainText), gainDb) then Exit;
          kind := 'pan';
          params := 'pos=' + FloatToStr(EnsureRange(gainDb, -100, 100) / 100, TFormatSettings.Invariant);
          name := 'Balance';
        end;
    30: begin
          { Pitch Shift: semitones, positive up, negative down }
          gainText := '2';
          if not PromptValueBelow('Pitch Shift',
            'Semitones to shift the selection (negative values go down, e.g. -12 is one octave):',
            gainText) then Exit;
          if not TryStrToFloat(Trim(gainText), gainDb, TFormatSettings.Invariant) then
            if not TryStrToFloat(Trim(gainText), gainDb) then Exit;
          kind := 'pitchshift';
          params := 'semitones=' + FloatToStr(EnsureRange(gainDb, -24, 24), TFormatSettings.Invariant);
          name := 'Pitch Shift';
        end;
    35: begin
          gainText := '12';
          if not PromptValueBelow('Noise Reduction',
            'Reduction in dB (the first 0.4 s of the selection must be noise only - it is used as the noise profile):',
            gainText) then Exit;
          if not TryStrToFloat(Trim(gainText), gainDb, TFormatSettings.Invariant) then
            if not TryStrToFloat(Trim(gainText), gainDb) then Exit;
          kind := '@denoise';
          params := 'reduce=' + FloatToStr(EnsureRange(gainDb, 1, 40), TFormatSettings.Invariant);
          name := 'Noise Reduction';
        end;
    36: begin
          gainText := 'C major';
          if not PromptValueBelow('Auto-Tune',
            'Target scale (e.g. "C major", "A minor", "F# major", or "chromatic"):',
            gainText) then Exit;
          kind := '@autotune';
          params := 'scale=' + Trim(gainText) + ';strength=1';
          name := 'Auto-Tune';
        end;
    37: begin
          if not dlgOpenWav.Execute then Exit;
          kind := '@convolve';
          params := 'ir=' + dlgOpenWav.FileName + ';mix=0.3';
          name := 'Convolution Reverb';
        end;
    38: begin TlSplitStemsSelected; Exit; end;
    39: begin TlAudioToMidiSelected; Exit; end;
    114: begin TlSplitSpeechMusicSelected; Exit; end;
    218: begin TlScanLoopSegments; Exit; end;
    113: begin TlMeasureRangeReport; Exit; end;
  else
    if not TlFxPreset(TMenuItem(Sender).Tag, kind, params, name) then Exit;
  end;
  TlApplyEffectToRange(kind, params, name);
end;

{ Removes every selected clip - the multi-selection (FTlSelClipIds) as well as
  the primary (FTlSelClipId) - so a rubber-band/Ctrl-click selection of
  several clips deletes as one gesture, like any arrangement view. }
procedure TfrmMain.btnTlDeleteClipClick(Sender: TObject);
var
  i: Integer;
begin
  if (FProject = nil) or (FTlSelClipId < 0) then Exit;
  try
    for i := 0 to High(FTlSelClipIds) do
      FCmds.Perform(TRemoveTimelineClipCommand.Create(FProject, FTlSelClipIds[i]));
    FCmds.Perform(TRemoveTimelineClipCommand.Create(FProject, FTlSelClipId));
    TlSetSingleSelection(-1);
    RefreshTimelineTab;
  except
    on E: Exception do
      memTimeline.Lines.Insert(0, 'Remove element FAILED: ' + E.Message);
  end;
end;

{ Removes the whole track under the last click/right-click (FTlCtxTrackId,
  set in pbTimelineMouseDown) - as opposed to "Remove Element", which only
  removes the single clip at that position. }
procedure TfrmMain.btnTlRemoveTrackClick(Sender: TObject);
begin
  if (FProject = nil) or (FTlCtxTrackId < 0) then Exit;
  try
    FCmds.Perform(TRemoveTimelineTrackCommand.Create(FProject, FTlCtxTrackId));
    FTlSelClipId := -1;
    if FTlSelectedTrackId = FTlCtxTrackId then
      FTlSelectedTrackId := -1;
  FRecInsertSeconds := 0;
    FTlCtxTrackId := -1;
    RefreshTimelineTab;
  except
    on E: Exception do
      memTimeline.Lines.Insert(0, 'Remove timeline FAILED: ' + E.Message);
  end;
end;

procedure TfrmMain.BuildDemoArrangement;
const
  SR = 48000;

  procedure WriteTone(const AFileName: string; AFreq, ASeconds, AAmp: Double;
    ANoise: Boolean);
  var
    planar: TAudioPlanar;
    n, i: Integer;
    ph, env: Double;
    rnd: Cardinal;
  begin
    n := Round(SR * ASeconds);
    SetLength(planar, 2);
    SetLength(planar[0], n);
    SetLength(planar[1], n);
    rnd := 22222;
    for i := 0 to n - 1 do
    begin
      { simple AD envelope so each hit looks like a real transient }
      env := FastExp(-3.0 * (i / SR) / ASeconds);
      if ANoise then
      begin
        rnd := Cardinal((UInt64(rnd) * 1664525 + 1013904223) and $FFFFFFFF);
        ph := (Integer(rnd shr 8) / 8388608.0) - 1.0;
        planar[0][i] := AAmp * env * ph;
        planar[1][i] := AAmp * env * ph * 0.9;
      end
      else
      begin
        ph := 2 * Pi * AFreq * i / SR;
        planar[0][i] := AAmp * env * FastSin(ph);
        planar[1][i] := AAmp * env * FastSin(ph * 1.001);
      end;
    end;
    SaveWavFile(AFileName, planar, 2, SR, n, wsfFloat32);
  end;

var
  tl: TTimeline;
  dir, drumsFn, bassFn, leadFn: string;
  sDrums, sBass, sLead: TMediaSource;
  tDrums, tBass, tLead: TTimelineTrack;
  i: Integer;
begin
  if FProject = nil then Exit;
  dir := IncludeTrailingPathDelimiter(App.Paths.Cache);
  drumsFn := dir + 'udaw-demo-drums.wav';
  bassFn  := dir + 'udaw-demo-bass.wav';
  leadFn  := dir + 'udaw-demo-lead.wav';
  WriteTone(drumsFn, 0,     0.9, 0.8, True);
  WriteTone(bassFn,  55.0,  1.0, 0.7, False);
  WriteTone(leadFn,  440.0, 2.0, 0.5, False);

  tl := FProject.Timeline;
  tl.Clear;
  FTlSelClipId := -1;

  sDrums := tl.AddSource(drumsFn, SR, 2, Round(SR * 0.9));
  sBass  := tl.AddSource(bassFn,  SR, 2, Round(SR * 1.0));
  sLead  := tl.AddSource(leadFn,  SR, 2, Round(SR * 2.0));

  tDrums := tl.AddTrack(tkAudio, 'Drums');
  tBass  := tl.AddTrack(tkAudio, 'Bass');
  tLead  := tl.AddTrack(tkInstrument, 'Lead');

  { a 4-bar drum pattern: a hit on every beat (0.5 s at 120 BPM) }
  for i := 0 to 15 do
    tl.AddClip(tDrums.Id, sDrums.Id, Format('kick %d', [i + 1]), i * 0.5, 0, 0.45);
  { bass note per bar }
  for i := 0 to 3 do
    tl.AddClip(tBass.Id, sBass.Id, Format('bass %d', [i + 1]), i * 2.0, 0, 1.9);
  { a lead phrase over bars 2-4 with fades }
  with tl.AddClip(tLead.Id, sLead.Id, 'lead A', 2.0, 0, 4.0) do
  begin
    FadeInSeconds := 0.1;
    FadeOutSeconds := 0.5;
    GainDb := -2.0;
  end;

  tl.AddMarker('Intro', 0.0);
  tl.AddMarker('Verse', 4.0);
  tl.AddRegion('Lead phrase', 2.0, 4.0);
  tl.PlayheadSeconds := 0;

  FProject.Touch;
  FTlView.SetZoom(120);
  FTlView.ScrollToSeconds(0);
  Logger.Info('ui', 'timeline demo arrangement built');
end;

procedure TfrmMain.btnTlDemoClick(Sender: TObject);
begin
  try
    BuildDemoArrangement;
    RefreshTimelineTab;
  except
    on E: Exception do
      memTimeline.Lines.Insert(0, 'Demo build FAILED: ' + E.Message);
  end;
end;

{ ---- Timeline keyboard layer (Timeline tab only, never while typing) ----
    S split at playhead      M marker at playhead     L loop on / off
    [ ] loop start / end     F zoom to fit            Z zoom to selection
    + -  zoom in / out       , .  previous / next marker
    Left / Right  nudge selected clips (or the playhead) by the snap step;
    Shift = four steps. }
function TfrmMain.TlHotKey(var Key: Word; Shift: TShiftState): Boolean;
begin
  Result := True;
  if FProject = nil then Exit(False);
  if Shift = [] then
    case Key of
      Ord('S'): btnTlSplitClick(Self);
      Ord('M'): btnTlAddMarkerHereClick(Self);
      Ord('L'): btnTlLoopToggleClick(Self);
      VK_OEM_4: btnTlLoopStartClick(Self);
      VK_OEM_6: btnTlLoopEndClick(Self);
      Ord('F'): btnTlZoomFitClick(Self);
      Ord('Z'): TlZoomToSelection;
      VK_OEM_PLUS, VK_ADD: btnTlZoomInClick(Self);
      VK_OEM_MINUS, VK_SUBTRACT: btnTlZoomOutClick(Self);
      VK_OEM_COMMA: TlGotoMarker(-1);
      VK_OEM_PERIOD: TlGotoMarker(1);
      VK_LEFT: TlNudge(-1, False);
      VK_RIGHT: TlNudge(1, False);
    else
      Result := False;
    end
  else if Shift = [ssShift] then
    case Key of
      VK_LEFT: TlNudge(-1, True);
      VK_RIGHT: TlNudge(1, True);
    else
      Result := False;
    end
  else
    Result := False;
end;

{ one step along the snap grid (or a few pixels when snapping is off) }
{ Lock / Unlock the selected clip(s): a locked clip cannot be moved, trimmed, split, cut or otherwise
  edited until it is unlocked. All the selected clips take the opposite of the first one's state. }
procedure TfrmMain.btnTlLockClipClick(Sender: TObject);
var
  tl: TTimeline;
  ids: TArray<Integer>;
  i: Integer;
  c: TTimelineClip;
  newState: Boolean;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  SetLength(ids, 0);
  if FTlSelClipId >= 0 then ids := [FTlSelClipId];
  for i := 0 to High(FTlSelClipIds) do ids := ids + [FTlSelClipIds[i]];
  if Length(ids) = 0 then Exit;
  c := tl.ClipById(ids[0]);
  if c = nil then Exit;
  newState := not c.Locked;
  for i := 0 to High(ids) do
    if tl.ClipById(ids[i]) <> nil then tl.SetClipLocked(ids[i], newState);
  FProject.Touch;
  memTimeline.Lines.Insert(0, Format('%d clip(s) %s.', [Length(ids), IfThen(newState, 'locked', 'unlocked')]));
  RefreshTimelineTab;
end;

{ Clamp to Last / Next Segment (Tag 1 / 2): slides each selected clip along its own lane so it sits
  snug against the end of the previous clip (Last) or so its end meets the start of the next clip
  (Next) - gapless playback. Locked clips and clips with no neighbour on that side are skipped. }
procedure TfrmMain.TlClampToClick(Sender: TObject);
var
  ids: TArray<Integer>;
  i, moved, skipped: Integer;
begin
  if FProject = nil then Exit;
  SetLength(ids, 0);
  if FTlSelClipId >= 0 then ids := [FTlSelClipId];
  for i := 0 to High(FTlSelClipIds) do ids := ids + [FTlSelClipIds[i]];
  if Length(ids) = 0 then Exit;
  TlClampClips(ids, (Sender as TComponent).Tag = 1, moved, skipped);
end;

{ the work of Clamp to Last / Next Segment, for the menu (the selected clips) and for AI tools
  (clips named by id) alike }
procedure TfrmMain.TlClampClips(const ids: TArray<Integer>; toLast: Boolean; out moved, skipped: Integer);
var
  tl: TTimeline;
  trk: TTimelineTrack;
  c, o, nb: TTimelineClip;
  i, j: Integer;
  newStart: Double;
begin
  moved := 0;
  skipped := 0;
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  for i := 0 to High(ids) do
  begin
    c := tl.ClipById(ids[i], trk);
    if (c = nil) or c.Locked then begin Inc(skipped); Continue; end;
    nb := nil;
    for j := 0 to trk.ClipCount - 1 do
    begin
      o := trk.GetClip(j);
      if o = c then Continue;
      if toLast then
      begin
        if (o.StartSeconds < c.StartSeconds) and ((nb = nil) or (o.StartSeconds > nb.StartSeconds)) then nb := o;
      end
      else if (o.StartSeconds > c.StartSeconds) and ((nb = nil) or (o.StartSeconds < nb.StartSeconds)) then
        nb := o;
    end;
    if nb = nil then begin Inc(skipped); Continue; end;
    if toLast then newStart := nb.EndSeconds
    else newStart := nb.StartSeconds - c.LengthSeconds;
    if newStart < 0 then begin Inc(skipped); Continue; end;
    try
      if FCmds.Perform(TMoveTimelineClipCommand.Create(FProject, ids[i], newStart, 0)) then Inc(moved);
    except
      on E: Exception do
      begin
        Inc(skipped);
        memTimeline.Lines.Insert(0, 'Clamp FAILED: ' + E.Message);
      end;
    end;
  end;
  memTimeline.Lines.Insert(0, Format('Clamp to %s Segment: %d clip(s) moved, %d skipped.',
    [IfThen(toLast, 'Last', 'Next'), moved, skipped]));
  RefreshTimelineTab;
end;

{ Delete Cache (the Timeline's transport bar): removes the files in the local cache folder that
  nothing uses - not this project (as it is right now, saved or not) and not any of the recent
  projects, which keep their own rendered files in the same folder. Files written in the last few
  minutes are left alone (a render may still be using them). Asks first, shows progress on the
  status bar, and Esc stops it. }
procedure TfrmMain.TlDeleteCache;
const
  RECENT_SKIP_SECONDS = 600;
var
  cacheDir, haystack, low, p, txt: string;
  files, doomed: TArray<string>;
  recent: TArray<string>;
  i, total: Integer;
  bytes: Int64;
  stamp: TDateTime;

  procedure AddProjectText(const AFile: string);
  begin
    if (AFile = '') or not FileExists(AFile) then Exit;
    try
      haystack := haystack + #10 + LowerCase(TFile.ReadAllText(AFile, TEncoding.UTF8));
    except
      // an unreadable project cannot protect anything; the others still do
    end;
  end;

begin
  if FProject = nil then Exit;
  if FCacheThread <> nil then
  begin
    MessageDlg('A cache clearing is already in progress. Wait for it to finish (Esc stops it).',
      mtInformation, [mbOK], 0);
    Exit;
  end;
  if FTlPlaying then
  begin
    MessageDlg('Stop the Timeline first - rendered files may be playing.', mtInformation, [mbOK], 0);
    Exit;
  end;
  cacheDir := IncludeTrailingPathDelimiter(App.Paths.Cache);
  if (Length(cacheDir) < 6) or not DirectoryExists(cacheDir) then
  begin
    MessageDlg('There is no cache folder to clean.', mtInformation, [mbOK], 0);
    Exit;
  end;

  { everything the open project names, plus what the recent projects name }
  haystack := LowerCase(ProjectToString(FProject));
  for i := 0 to 9 do
  begin
    p := App.Config.GetString('project', 'recent_' + IntToStr(i), '');
    if (p <> '') and not SameText(p, FProject.FileName) then recent := recent + [p];
  end;
  for p in recent do AddProjectText(p);
  if (FProject.FileName <> '') then AddProjectText(FProject.FileName);

  ShowStatusProgress('Delete Cache - looking for unused files...', 100);
  try
  try
    UpdateStatusProgress(10, 'Delete Cache - listing the cache folder...');
    files := TDirectory.GetFiles(cacheDir, '*', TSearchOption.soAllDirectories);
    doomed := nil;
    bytes := 0;
    for i := 0 to High(files) do
    begin
      if (i and 63) = 0 then
        UpdateStatusProgress(10 + (i * 80) div Max(1, Length(files)), 'Delete Cache - checking what is used...');
      low := LowerCase(files[i]);
      if Pos(low, haystack) > 0 then Continue;
      if FileAge(files[i], stamp) and (Abs(Now - stamp) * 86400 < RECENT_SKIP_SECONDS) then Continue;
      doomed := doomed + [files[i]];
      bytes := bytes + TFile.GetSize(files[i]);
    end;
  except
    on EJobCancelled do Exit;   // nothing has been deleted yet
  end;
  finally
    HideStatusProgress;
  end;

  if Length(doomed) = 0 then
  begin
    MessageDlg('The cache folder holds nothing this project, or your recent projects, no longer use.',
      mtInformation, [mbOK], 0);
    Exit;
  end;
  txt := Format('%d file(s), %.1f MB, in the cache folder are not used by this project or your recent projects:' +
    sLineBreak + sLineBreak + '%s' + sLineBreak + sLineBreak + 'Delete them?',
    [Length(doomed), bytes / (1024 * 1024), cacheDir]);
  if MessageDlg(txt, mtConfirmation, [mbYes, mbNo], 0, mbNo) <> mrYes then Exit;

  { the deleting runs on a thread of its own, so the window stays free to use; the thread never
    touches the window - it queues its progress, and CacheClearDone finishes the job on the main
    thread when it is over }
  FCacheCancel := False;
  FCacheDeleted := 0;
  FCacheFailed := 0;
  FCacheFreed := 0;
  FCacheStopped := False;
  total := Length(doomed);
  prgStatus.Style := pbstNormal;
  prgStatus.Min := 0;
  prgStatus.Max := Max(1, total);
  prgStatus.Position := 0;
  prgStatus.Visible := True;
  stbMain.SimpleText := 'Delete Cache - deleting unused files';
  FCacheThread := UDAWAnonymousThread('delete cache',
    procedure
    var
      j: Integer;
      last: UInt64;
      size: Int64;
      dirs: TArray<string>;
    begin
      last := GetTickCount64;
      for j := 0 to High(doomed) do
      begin
        if FCacheCancel then
        begin
          FCacheStopped := True;
          Break;
        end;
        try
          size := TFile.GetSize(doomed[j]);
          if DeleteFile(doomed[j]) then
          begin
            Inc(FCacheDeleted);
            Inc(FCacheFreed, size);
          end
          else
            Inc(FCacheFailed);
        except
          Inc(FCacheFailed);
        end;
        if (GetTickCount64 - last >= 80) or (j = High(doomed)) then
        begin
          last := GetTickCount64;
          CacheClearReport(j + 1, total);
        end;
      end;
      { folders the clean-up emptied (the top-level cache folders themselves stay) }
      try
        dirs := TDirectory.GetDirectories(cacheDir, '*', TSearchOption.soAllDirectories);
        for j := High(dirs) downto 0 do   // parents come before children, so this is deepest first
          if Length(TDirectory.GetFileSystemEntries(dirs[j])) = 0 then RemoveDir(dirs[j]);
      except
        // a folder that cannot be listed or removed is simply left
      end;
    end);
  FCacheThread.OnTerminate := CacheClearDone;   // runs on the main thread; the thread frees itself after it
  FCacheThread.Start;
end;

{ main thread: a progress step queued by the Delete Cache thread }
procedure TfrmMain.CacheClearProgress(ADone, ATotal: Integer);
begin
  if FCacheThread = nil then Exit;   // already finished
  prgStatus.Position := ADone;
end;

{ the thread's side of the above: hands the step to the main thread }
procedure TfrmMain.CacheClearReport(ADone, ATotal: Integer);
begin
  TThread.Queue(nil,
    procedure
    begin
      CacheClearProgress(ADone, ATotal);
    end);
end;

{ main thread, when the Delete Cache thread has finished (or stopped): closes the progress bar,
  forgets the thread so the next request can start, and reports the outcome }
procedure TfrmMain.CacheClearDone(Sender: TObject);
var
  txt: string;
begin
  FCacheThread := nil;
  if not FSyncProgressActive then   // another job may be using the bar by now
  begin
    prgStatus.Visible := False;
    prgStatus.Position := 0;
  end;
  txt := Format('Delete Cache: %d unused file(s) deleted, %.1f MB freed%s%s.', [FCacheDeleted, FCacheFreed / (1024 * 1024),
    IfThen(FCacheFailed > 0, Format(', %d could not be deleted (in use)', [FCacheFailed]), ''),
    IfThen(FCacheStopped, ' - stopped with Esc', '')]);
  memTimeline.Lines.Insert(0, txt);
  stbMain.SimpleText := txt;
  Logger.Info('ui', txt);
end;

{ the Markers / Chords lane item (marker, scene region or chord) under the last right-click }
procedure TfrmMain.pmMkLockClick(Sender: TObject);
var
  tl: TTimeline;
  i: Integer;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  case FLaneCtxKind of
    1: for i := 0 to tl.MarkerCount - 1 do
         if tl.GetMarker(i).Id = FLaneCtxId then tl.GetMarker(i).Locked := not tl.GetMarker(i).Locked;
    2: for i := 0 to tl.RegionCount - 1 do
         if tl.GetRegion(i).Id = FLaneCtxId then tl.GetRegion(i).Locked := not tl.GetRegion(i).Locked;
    3: for i := 0 to tl.ChordCount - 1 do
         if tl.GetChord(i).Id = FLaneCtxId then tl.GetChord(i).Locked := not tl.GetChord(i).Locked;
  else
    Exit;
  end;
  FProject.Touch;
  RefreshTimelineTab;
end;

{ True when the marker / scene / chord being dragged is locked: it stays where it is }
function TfrmMain.TlLaneEditLocked: Boolean;
var
  tl: TTimeline;
  i: Integer;
begin
  Result := False;
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  case FLaneEdit of
    1: for i := 0 to tl.MarkerCount - 1 do
         if tl.GetMarker(i).Id = FLaneEditId then Exit(tl.GetMarker(i).Locked);
    2, 3, 4: for i := 0 to tl.RegionCount - 1 do
         if tl.GetRegion(i).Id = FLaneEditId then Exit(tl.GetRegion(i).Locked);
    5, 7: for i := 0 to tl.ChordCount - 1 do
         if tl.GetChord(i).Id = FLaneEditId then Exit(tl.GetChord(i).Locked);
  end;
end;

procedure TfrmMain.TlNudge(ADir: Integer; ACoarse: Boolean);
var
  tl: TTimeline;
  ids: TArray<Integer>;
  i, k, reps: Integer;
  c, c0: TTimelineClip;
  target, delta, stepSec, newStart: Double;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  reps := IfThen(ACoarse, 4, 1);
  SetLength(ids, 0);
  if FTlSelClipId >= 0 then ids := [FTlSelClipId];
  for i := 0 to High(FTlSelClipIds) do ids := ids + [FTlSelClipIds[i]];
  stepSec := 4 / Max(1.0, FTlView.PixelsPerSecond);
  if Length(ids) = 0 then
  begin
    target := tl.PlayheadSeconds;
    for k := 1 to reps do
      if FTlView.SnapEnabled and (Abs(FTlView.SnapDir(target, ADir) - target) > 1e-6) then
        target := FTlView.SnapDir(target, ADir)
      else
        target := target + ADir * stepSec;
    if target < 0 then target := 0;
    tl.PlayheadSeconds := target;
    FRecInsertSeconds := target;
    RefreshTimelineTab;
    Exit;
  end;
  c0 := tl.ClipById(ids[0]);
  if c0 = nil then Exit;
  target := c0.StartSeconds;
  for k := 1 to reps do
    if FTlView.SnapEnabled and (Abs(FTlView.SnapDir(target, ADir) - target) > 1e-6) then
      target := FTlView.SnapDir(target, ADir)
    else
      target := target + ADir * stepSec;
  delta := target - c0.StartSeconds;
  try
    for i := 0 to High(ids) do
    begin
      c := tl.ClipById(ids[i]);
      if (c = nil) or c.Locked then Continue;
      newStart := Max(0.0, c.StartSeconds + delta);
      FCmds.Perform(TMoveTimelineClipCommand.Create(FProject, ids[i], newStart, 0));
    end;
  except
    on E: Exception do memTimeline.Lines.Insert(0, 'Nudge FAILED: ' + E.Message);
  end;
  RefreshTimelineTab;
end;

{ jump the playhead to the previous / next marker and bring it into view }
{ Go to the start (0) or the end (the last clip's end) of the Timeline: works while playing,
  the player reads the playhead live; the view scrolls to keep it on screen. }
procedure TfrmMain.TlGotoEnd(AToEnd: Boolean);
var
  tl: TTimeline;
  target, x: Double;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  if AToEnd then target := tl.LastClipEndSeconds else target := 0;
  tl.PlayheadSeconds := Max(0.0, target);
  FRecInsertSeconds := tl.PlayheadSeconds;
  x := FTlView.SecondsToX(tl.PlayheadSeconds);
  if (x < FTlView.HeaderWidth + 20) or (x > pbTimeline.Width - 20) then
    FTlView.ScrollToSeconds(Max(0.0, tl.PlayheadSeconds - 2));
  RefreshTimelineTab;
end;

procedure TfrmMain.TlGotoMarker(ADir: Integer);
var
  tl: TTimeline;
  i: Integer;
  best, s, x: Double;
  found: Boolean;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  found := False;
  best := 0;
  for i := 0 to tl.MarkerCount - 1 do
  begin
    s := tl.GetMarker(i).Seconds;
    if ((ADir > 0) and (s > tl.PlayheadSeconds + 1e-4) and (not found or (s < best))) or
       ((ADir < 0) and (s < tl.PlayheadSeconds - 1e-4) and (not found or (s > best))) then
    begin
      best := s;
      found := True;
    end;
  end;
  if not found then Exit;
  tl.PlayheadSeconds := best;
  FRecInsertSeconds := best;
  x := FTlView.SecondsToX(best);
  if (x < FTlView.HeaderWidth + 20) or (x > pbTimeline.Width - 20) then
    FTlView.ScrollToSeconds(Max(0.0, best - 2));
  RefreshTimelineTab;
end;

{ zoom so the highlighted range (or the selected clips) fills the lanes }
procedure TfrmMain.TlZoomToSelection;
var
  tl: TTimeline;
  a, b: Double;
  i: Integer;
  c: TTimelineClip;
  ids: TArray<Integer>;
  have: Boolean;
begin
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  have := False;
  a := 0;
  b := 0;
  if FTlRangeActive then
  begin
    a := FTlRangeStartSec;
    b := FTlRangeEndSec;
    have := True;
  end
  else
  begin
    SetLength(ids, 0);
    if FTlSelClipId >= 0 then ids := [FTlSelClipId];
    for i := 0 to High(FTlSelClipIds) do ids := ids + [FTlSelClipIds[i]];
    for i := 0 to High(ids) do
    begin
      c := tl.ClipById(ids[i]);
      if c = nil then Continue;
      if not have then
      begin
        a := c.StartSeconds;
        b := c.EndSeconds;
        have := True;
      end
      else
      begin
        a := Min(a, c.StartSeconds);
        b := Max(b, c.EndSeconds);
      end;
    end;
  end;
  if not have or (b - a < 0.01) then Exit;
  FTlView.SetZoom(TlLaneWidth / ((b - a) * 1.1));
  FTlView.ScrollToSeconds(Max(0.0, a - (b - a) * 0.05));
  RefreshTimelineTab;
end;

{ ---- Loop bar: the bottom strip of the ruler. Drag an edge to resize the loop,
  drag its body to move it, drag over empty strip to make a new one, double-click
  to switch it on / off. Everything snaps to the grid. ---- }
function TfrmMain.TlLoopBarMouseDown(X, Y: Integer; Shift: TShiftState): Boolean;
var
  tl: TTimeline;
  x1, x2, sec: Double;
begin
  Result := False;
  if (FProject = nil) or (Y < LANE_RULER_H - 9) or (Y >= LANE_RULER_H) then Exit;
  tl := FProject.Timeline;
  sec := Max(0.0, FTlView.XToSeconds(X));
  Result := True;
  if ssDouble in Shift then
  begin
    if tl.LoopLengthSeconds > 0 then tl.LoopEnabled := not tl.LoopEnabled;
    FProject.Touch;
    RefreshTimelineTab;
    Exit;
  end;
  FTlLoopDrag := 1;
  FTlLoopAnchorSec := FTlView.Snap(sec);
  FTlLoopMoved := False;
  if tl.LoopLengthSeconds > 0 then
  begin
    x1 := FTlView.SecondsToX(tl.LoopStartSeconds);
    x2 := FTlView.SecondsToX(tl.LoopStartSeconds + tl.LoopLengthSeconds);
    if Abs(X - x1) <= 6 then FTlLoopDrag := 3
    else if Abs(X - x2) <= 6 then FTlLoopDrag := 4
    else if (X > x1) and (X < x2) then
    begin
      FTlLoopDrag := 2;
      FTlLoopGrabSec := sec - tl.LoopStartSeconds;
    end;
  end;
end;

procedure TfrmMain.TlLoopBarMove(X: Integer);
var
  tl: TTimeline;
  sec, s, e: Double;
begin
  tl := FProject.Timeline;
  sec := FTlView.Snap(Max(0.0, FTlView.XToSeconds(X)));
  case FTlLoopDrag of
    1:
      begin
        s := Min(FTlLoopAnchorSec, sec);
        e := Max(FTlLoopAnchorSec, sec);
        if e - s < 0.01 then Exit;
        tl.LoopStartSeconds := s;
        tl.LoopLengthSeconds := e - s;
        tl.LoopEnabled := True;
      end;
    2:
      tl.LoopStartSeconds := FTlView.Snap(Max(0.0, FTlView.XToSeconds(X) - FTlLoopGrabSec));
    3:
      begin
        e := tl.LoopStartSeconds + tl.LoopLengthSeconds;
        s := Min(sec, e - 0.05);
        tl.LoopStartSeconds := s;
        tl.LoopLengthSeconds := e - s;
      end;
    4:
      tl.LoopLengthSeconds := Max(0.05, sec - tl.LoopStartSeconds);
  end;
  FTlLoopMoved := True;
  FTlSnapGuideOn := FTlView.SnapEnabled;
  FTlSnapGuideSec := sec;
  RefreshTimelineTab;
end;

procedure TfrmMain.pbTimelineMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  tl: TTimeline;
  c: TTimelineClip;
  trkForIdx: TTimelineTrack;
  sec, rngStart, rngEnd: Double;
  ti, i: Integer;
  edge: TClipEdge;
  multi: Boolean;
  ids: TArray<Integer>;
begin
  { The timeline is a TPaintBox and can't take focus, so a text box clicked
    earlier (BPM, a rename, the log memo) kept it - and FormKeyDown ignores
    every hotkey while a text field is focused. That is why Delete/Insert/
    Home/End "randomly" stopped working. Clicking the timeline hands focus
    to the page control so the hotkeys are live again. }
  if (ActiveControl is TCustomEdit) or (ActiveControl is TCustomMemo) or (ActiveControl is TGLEdit) then
  begin
    if ActiveControl = edtTlTempo then
      edtTlTempoExit(edtTlTempo);   // commit a half-typed BPM like leaving the box would
    ActiveControl := pgc;
  end;
  { a press cancels a menu still waiting out the double-click time; the second press of a
    double-click (ssDouble) opens the effect window on release instead }
  tmrTlEffMenu.Enabled := False;
  FTlDblPress := (Button = mbLeft) and (ssDouble in Shift);
  { double-click the spectrum in the top-left corner: the big analyser window }
  if FTlDblPress and (X < FTlView.HeaderWidth) and (Y < LANE_RULER_H) then
  begin
    TlOpenSpectrumWindow;
    Exit;
  end;
  if FProject = nil then Exit;
  tl := FProject.Timeline;
  FTlView.SetViewportWidth(pbTimeline.Width);
  TlApplyViewMetrics;

  { Clip Stage column (scene buttons + one launch slot per track) }
  if TlStageMouseDown(X, Y, Button) then Exit;
  { Markers / Tempo / Signature lanes }
  if TlLaneMouseDown(X, Y, Shift, Button) then Exit;
  { Ctrl + drag a scene's start / end line over the lanes: resize the scene }
  if (Button = mbLeft) and (ssCtrl in Shift) and (X >= FTlView.HeaderWidth) and
     (Y >= FTlView.RulerHeight) and TlSceneEdgeGrab(X) then Exit;
  { the "+ Add channel" placeholder under the last track }
  if (Button = mbLeft) and (FTlMode = 0) and (Y >= FTlView.RulerHeight) and
     PtInRect(TlAddChannelRect, Point(X, Y)) then
  begin
    btnTlAddTrackClick(nil);
    Exit;
  end;
  { "Back to arrangement" on a launched track's banner }
  if (Button = mbLeft) and (Length(FStageLaunches) > 0) and (X >= FTlView.HeaderWidth) and
     TlTrackAtY(Y, ti) and (TlStageLaunchIndex(tl.GetTrack(ti).Id) >= 0) and
     PtInRect(TlStageBackRect(TlTrackTop(ti), tl.GetTrack(ti).Height), Point(X, Y)) then
  begin
    TlStageBack;
    Exit;
  end;

  { Shift + left-click on a lane marks out the whole region (the scene) under the click, on that
    lane; with no scene there, the clip under the click is marked end to end }
  if (Button = mbLeft) and (ssShift in Shift) and not (ssCtrl in Shift) and
     (X >= FTlView.HeaderWidth) and (Y >= LANE_RULER_H) and TlTrackAtY(Y, ti) then
  begin
    sec := FTlView.XToSeconds(X);
    if sec < 0 then sec := 0;
    rngStart := -1;
    rngEnd := -1;
    for i := 0 to tl.RegionCount - 1 do
      if (sec >= tl.GetRegion(i).StartSeconds) and (sec < tl.GetRegion(i).EndSeconds) and
         ((rngStart < 0) or (tl.GetRegion(i).LengthSeconds < rngEnd - rngStart)) then
      begin
        rngStart := tl.GetRegion(i).StartSeconds;
        rngEnd := tl.GetRegion(i).EndSeconds;
      end;
    if rngStart < 0 then
    begin
      c := TlClipAtPoint(X, Y);
      if c <> nil then
      begin
        rngStart := c.StartSeconds;
        rngEnd := c.EndSeconds;
      end;
    end;
    if rngStart >= 0 then
    begin
      FTlCtxTrackId := tl.GetTrack(ti).Id;
      FTlExtraTrackIds := nil;
      FTlSelectedTrackId := FTlCtxTrackId;
      FTlEffCtxActive := False;
      FTlRulerCtxActive := False;
      TlSetSingleSelection(-1);
      FTlRangeActive := True;
      FTlRangeStartSec := rngStart;
      FTlRangeEndSec := rngEnd;
      RefreshTimelineTab;
      Exit;
    end;
  end;

  { track under the cursor, header column included, so right-clicking a
    track's header (or an empty lane) can still target it for "Remove
    Timeline" - unlike clip selection, which needs the lane area. This is
    just bookkeeping for the context menu and never mutates the model, so
    it runs for every button, not only the left one. }
  if TlTrackAtY(Y, ti) then
  begin
    FTlCtxTrackId := tl.GetTrack(ti).Id;
    if Button = mbLeft then
    begin
      if (ssCtrl in Shift) or (ssShift in Shift) then
      begin
        { multi-select: keep the previous primary highlighted as an extra }
        if FTlSelectedTrackId <> FTlCtxTrackId then
        begin
          if TlExtraTrackIndex(FTlCtxTrackId) >= 0 then
            TlExtraTrackRemove(FTlCtxTrackId)
          else
          begin
            if (FTlSelectedTrackId >= 0) and
               (TlExtraTrackIndex(FTlSelectedTrackId) < 0) then
              FTlExtraTrackIds := FTlExtraTrackIds + [FTlSelectedTrackId];
            FTlSelectedTrackId := FTlCtxTrackId;
          end;
        end;
      end
      else
      begin
        { a plain click on a lane title (header column) toggles: select it, click it
          again and it is unselected }
        if (X < TlHdrW - 8) and (FTlSelectedTrackId = FTlCtxTrackId) and
           (Length(FTlExtraTrackIds) = 0) then
        begin
          FTlSelectedTrackId := -1;
          RefreshTimelineTab;
          Exit;
        end;
        FTlExtraTrackIds := nil;
        FTlSelectedTrackId := FTlCtxTrackId;
      end;
    end;
  end
  else
    FTlCtxTrackId := -1;

  if Button = mbMiddle then
  begin
    { middle-mouse-drag pans the timeline horizontally, FL-Studio-style;
      it never touches selection/track targeting or opens a popup. }
    FTlMiddlePanning := True;
    FTlMiddlePanLastX := X;
    pbTimeline.Cursor := crHSplit;
    Exit;
  end;

  { grab zone lies wholly on the header side of the boundary so the lane area
    (X >= HeaderWidth) never conflicts with range/clip selection }
  if (Button = mbLeft) and (X >= TlHdrW - 8) and (X < TlHdrW) then
  begin
    { left-drag on the header/lane boundary resizes the track-header column -
      see UDAW.Timeline.Model.TTimeline.HeaderWidth, persisted per-project. }
    FTlHeaderResizing := True;
    FTlHeaderResizeStartX := X;
    FTlHeaderResizeStartWidth := TlHdrW;
    pbTimeline.Cursor := crSizeWE;
    Exit;
  end;

  { the icon at the left end of a clip's header opens that clip's editor (video clips are
    edited on the Timeline itself, so they have no such click) }
  if (Button = mbLeft) and (X >= FTlView.HeaderWidth) and TlClipIconAt(X, Y, c) then
  begin
    TlSetSingleSelection(c.Id);
    TlOpenClipEditor(c);
    RefreshTimelineTab;
    Exit;
  end;

  { pressing an effect's name in a channel's title band highlights exactly the
    section that effect covers, on that channel only, as the range, and on
    release (pbTimelineMouseUp) pops up pmTlEffect - Edit / Undo for just that
    effect region. }
  FTlEffCtxActive := False;
  if ((Button = mbLeft) or (Button = mbRight)) and (X >= FTlView.HeaderWidth) and
     TlEffectLabelAtPoint(X, Y, ti, rngStart, rngEnd, FTlEffCtx) then
  begin
    FTlEffCtxActive := True;
    FTlRulerCtxActive := False;
    FTlExtraTrackIds := nil;
    FTlSelectedTrackId := ti;
    TlSetSingleSelection(-1);
    FTlRangeActive := True;
    FTlRangeStartSec := rngStart;
    FTlRangeEndSec := rngEnd;
    RefreshTimelineTab;
    Exit;
  end;

  { a double left-click on an audio clip: its audio opens in the audio file editor }
  if FTlDblPress and (X >= FTlView.HeaderWidth) then
  begin
    c := TlClipAtPoint(X, Y);
    if (c <> nil) and (TlClipKind(c) = ckAudio) then
    begin
      FTlDblPress := False;
      { inside a marked range, the range is the selected section: that segment opens }
      sec := FTlView.XToSeconds(X);
      if FTlRangeActive and (sec >= Min(FTlRangeStartSec, FTlRangeEndSec)) and
         (sec <= Max(FTlRangeStartSec, FTlRangeEndSec)) and (FTlCtxTrackId >= 0) and
         ((FTlCtxTrackId = FTlSelectedTrackId) or (TlExtraTrackIndex(FTlCtxTrackId) >= 0)) then
        TlEditLaneClick(nil)
      else
      begin
        TlSetSingleSelection(c.Id);
        TlEditClipAudio(c);
      end;
      RefreshTimelineTab;
      Exit;
    end;
  end;

  if Button <> mbLeft then
  begin
    { A right-click landing in the ruler (Y < RulerHeight) is a completely
      different context than one on a clip/lane - see pbTimelineMouseUp,
      which shows pmTimelineRuler instead of pmTimeline for it. Moving the
      playhead here first (snapped, same as a plain ruler left-click) means
      every ruler-menu command below - Add Marker/Set Loop Start/Set Loop
      End - can just act on tl.PlayheadSeconds like their existing toolbar
      counterparts (btnTlLoopStartClick etc.) instead of needing their own
      separate "clicked position" plumbing. }
    if (X >= FTlView.HeaderWidth) and (Y < LANE_RULER_H) then
    begin
      FTlRulerCtxActive := True;
      sec := FTlView.XToSeconds(X);
      if sec < 0 then sec := 0;
      tl.PlayheadSeconds := FTlView.Snap(sec);
    FRecInsertSeconds := tl.PlayheadSeconds;
      RefreshTimelineTab;
      Exit;
    end;
    FTlRulerCtxActive := False;

    { right-button down inside the lane with a range selected cancels and
      clears the range immediately (no popup on release) }
    FTlRangeCancelled := False;
    if (Button = mbRight) and FTlRangeActive and (X >= FTlView.HeaderWidth) then
    begin
      FTlRangeActive := False;
      FTlRangeCancelled := True;
      RefreshTimelineTab;
      Exit;
    end;

    { right/middle click must never start a drag/trim before the popup
      shows, but it should still re-target selection to whatever clip is
      under the cursor - like any DAW, right-clicking an unselected clip
      selects it so Cut/Copy/Split/Delete act on the thing you pointed at,
      not on a stale earlier left-click selection. A right-click on a clip
      that is already part of a multi-selection keeps the whole group
      selected, so context actions like Delete apply to all of them. }
    if X >= FTlView.HeaderWidth then
    begin
      c := TlClipAtPoint(X, Y);
      if (c <> nil) and not TlIsClipSelected(c.Id) then
      begin
        TlSetSingleSelection(c.Id);
        RefreshTimelineTab;
      end;
    end;
    Exit;
  end;

  if X < FTlView.HeaderWidth then
  begin
    { M / S / R, "BPM ?", volume and pan are widgets in the header column now
      (TGLTrackHeader); what reaches here is the narrow strip between the
      headers and the Clip Stage column. }
    RefreshTimelineTab;  // show the Browser import destination immediately
    Exit;
  end;

  sec := FTlView.XToSeconds(X);
  if sec < 0 then sec := 0;

  if (Button = mbLeft) and TlLoopBarMouseDown(X, Y, Shift) then Exit;

  if Y < LANE_RULER_H then
  begin
    { ruler click -> move the playhead (snapped); a left-drag from here
      instead defines a time-range "section" selection spanning every
      track, highlighted in pbTimelinePaint and consumed by the ruler
      context menu's range actions (Split at Range Edges / Delete Range /
      Set Loop to Selection). A drag that never actually moves collapses
      back to the plain click behaviour in pbTimelineMouseUp. }
    tl.PlayheadSeconds := FTlView.Snap(sec);
    FRecInsertSeconds := tl.PlayheadSeconds;
    FTlRangeDragging := True;
    FTlRangeAnchorSec := FTlView.Snap(sec);
    FTlRangeStartSec := FTlRangeAnchorSec;
    FTlRangeEndSec := FTlRangeAnchorSec;
    RefreshTimelineTab;
    Exit;
  end;

  FTlTrimming := False;
  FTlFadeDragging := False;
  FTlRubberSelecting := False;
  FTlRangeActive := False;   { any lane interaction below clears a pending range selection }
  { Ctrl+left-drag anywhere in the lanes (even over clips) highlights a time
    range, same as the ruler / empty-lane drag. Shift remains multi-select. }
  if (ssCtrl in Shift) or (FTlTool = 1) then
  begin
    FTlRangeDragging := True;
    FTlRangeAnchorSec := FTlView.Snap(sec);
    FTlRangeStartSec := FTlRangeAnchorSec;
    FTlRangeEndSec := FTlRangeAnchorSec;
    RefreshTimelineTab;
    Exit;
  end;
  { Split / Erase tools: one click on a clip cuts it at the pointer / deletes it }
  if FTlTool in [2, 3] then
  begin
    c := TlClipAtPoint(X, Y);
    if (c <> nil) and (not c.Locked) and TlTrackAtY(Y, ti) then
    begin
      if FTlTool = 2 then TlSplitTrackAt(tl.GetTrack(ti), FTlView.Snap(sec))
      else
      begin
        TlSetSingleSelection(c.Id);
        btnTlDeleteClipClick(nil);
      end;
      RefreshTimelineTab;
    end;
    Exit;
  end;
  multi := ssShift in Shift;
  c := TlClipAtPoint(X, Y);
  FTlPressX := X;
  FTlPressY := Y;
  FTlPressMoved := False;
  FTlPressClipId := -1;
  if c <> nil then
  begin
    FTlPressClipId := c.Id;
    if multi then
      TlToggleSelection(c.Id)
    else if not TlIsClipSelected(c.Id) then
      TlSetSingleSelection(c.Id);
    { else: clicking an already-selected clip in a multi-selection keeps the
      whole group selected, so the drag below moves all of them together }

    if (not c.Locked) and TlHitTestFadeHandle(c, ti, X, Y, edge) then
    begin
      FTlFadeDragging := True;
      FTlFadeClipId := c.Id;
      FTlFadeEdge := edge;
    end
    else if (not c.Locked) and TlHitTestClipEdge(c, X, edge) then
    begin
      FTlTrimming := True;
      FTlTrimClipId := c.Id;
      FTlTrimEdge := edge;
    end
    else if not c.Locked then
    begin
      FTlDragging := True;
      FTlDragMouseStartSec := sec;
      FTlDragClipStartSec := c.StartSeconds;
      FTlDragStartTrackIdx := ti;   // track index under the cursor, i.e. c's own track (set by TlTrackAtY above)

      { Alt+drag duplicates the selection in place first (see
        TlDuplicateSelectedClips), then drags the copies - the originals
        stay put. Falls back to a normal move if duplication produced
        nothing (e.g. the clip vanished between hit-test and here). }
      ids := nil;
      if (ssAlt in Shift) and not c.Locked then
        ids := TlDuplicateSelectedClips;

      { snapshot every selected clip's start (and track index, so a vertical
        drag can carry the whole group to a different track together), for
        the move in pbTimelineMouseMove }
      if Length(ids) = 0 then
      begin
        SetLength(ids, 0);
        if FTlSelClipId >= 0 then
        begin
          SetLength(ids, Length(ids) + 1);
          ids[High(ids)] := FTlSelClipId;
        end;
        for i := 0 to High(FTlSelClipIds) do
        begin
          SetLength(ids, Length(ids) + 1);
          ids[High(ids)] := FTlSelClipIds[i];
        end;
      end;
      { a locked clip in a multi-selection stays where it is while the others move }
      for i := High(ids) downto 0 do
        if (tl.ClipById(ids[i]) <> nil) and tl.ClipById(ids[i]).Locked then
          Delete(ids, i, 1);
      FTlDragIds := ids;
      SetLength(FTlMultiDragStartSecs, Length(ids));
      SetLength(FTlMultiDragStartTrackIdx, Length(ids));
      for i := 0 to High(ids) do
      begin
        FTlMultiDragStartSecs[i] := tl.ClipById(ids[i]).StartSeconds;
        tl.ClipById(ids[i], trkForIdx);
        FTlMultiDragStartTrackIdx[i] := TlTrackIndexById(trkForIdx.Id);
      end;
    end;
  end
  else if (FTlRubberBandMods <> []) and (FTlRubberBandMods <= Shift) then
  begin
    { rubber-band hook (FTlRubberBandMods, default Shift) on empty space: extend the current selection with a
      rubber band instead of clearing it }
    FTlRubberSelecting := True;
    FTlRubberStartX := X; FTlRubberStartY := Y;
    FTlRubberX := X; FTlRubberY := Y;
  end
  else
  begin
    { plain left-drag on empty lane space highlights a time range (worked on
      by the range menu actions); the playhead is only positioned from the
      ruler, never from the lane }
    TlSetSingleSelection(-1);
    FTlRangeDragging := True;
    FTlRangeAnchorSec := FTlView.Snap(sec);
    FTlRangeStartSec := FTlRangeAnchorSec;
    FTlRangeEndSec := FTlRangeAnchorSec;
  end;
  RefreshTimelineTab;
end;

const
  { pixels a left press on a clip must travel before it becomes a move/trim/
    fade drag (the range-move drag uses the same 3px dead zone) }
  TL_DRAG_THRESHOLD = 3;

{ A decoded preview frame arrived (queued from the thumbnailer's thread). }
procedure TfrmMain.TlThumbReady;
begin
  if FTlThumbActive then pbTimeline.Invalidate;
end;

procedure TfrmMain.pbTimelineMouseLeave(Sender: TObject);
begin
  if FTlThumbActive then
  begin
    FTlThumbActive := False;
    pbTimeline.Invalidate;
  end;
end;

{ Hover preview: while the mouse rests on a video clip, ask for the frame of the
  source at that point; pbTimelinePaint draws it next to the pointer. }
procedure TfrmMain.TlUpdateVideoHover(AX, AY: Integer);
var
  c: TTimelineClip;
  src: TMediaSource;
  sec: Double;
  wasActive: Boolean;
begin
  wasActive := FTlThumbActive;
  FTlThumbActive := False;
  if (FProject <> nil) and (FTlThumbnailer <> nil) and (AX >= FTlView.HeaderWidth) then
  begin
    c := TlClipAtPoint(AX, AY);
    if (c <> nil) and (c.SourceId >= 0) and not c.IsMidiClip then
    begin
      src := FProject.Timeline.SourceById(c.SourceId);
      if (src <> nil) and (src.Kind = mkVideoFile) and (src.Path <> '') and FileExists(src.Path) then
      begin
        sec := EnsureRange(FTlView.XToSeconds(AX), c.StartSeconds, c.EndSeconds);
        FTlThumbPath := src.Path;
        FTlThumbSec := c.VideoSourceSecondsAt(sec, FProject.TempoBPM);
        FTlThumbX := AX;
        FTlThumbY := AY;
        FTlThumbActive := True;
        FTlThumbnailer.Request(FTlThumbPath, FTlThumbSec);
      end;
    end;
  end;
  { while the transport runs the per-tick refresh repaints anyway }
  if (FTlThumbActive or wasActive) and not FTlPlaying then pbTimeline.Invalidate;
end;

procedure TfrmMain.pbTimelineMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
var
  delta, newStart, sec, newFade, rawSec: Double;
  c: TTimelineClip;
  edge: TClipEdge;
  i, ti: Integer;
begin
  if FProject = nil then Exit;
  TlStageUpdateHint(X, Y);

  if FLaneDragging then
  begin
    FLaneDragCurSec := FTlView.Snap(Max(0.0, FTlView.XToSeconds(X)));
    pbTimeline.Invalidate;
    Exit;
  end;

  if FTlLoopDrag <> 0 then
  begin
    TlLoopBarMove(X);
    Exit;
  end;

  if FLaneEdit <> 0 then
  begin
    TlLaneEditMove(X);
    Exit;
  end;

  if FTempoDrag then
  begin
    TlTempoDragMove(X, Y, ssShift in Shift);
    Exit;
  end;

  if FTlMiddlePanning then
  begin
    FTlView.ScrollByPixels(FTlMiddlePanLastX - X);
    FTlMiddlePanLastX := X;
    RefreshTimelineTab;
    Exit;
  end;

  if FTlHeaderResizing then
  begin
    FProject.Timeline.HeaderWidth := FTlHeaderResizeStartWidth + (X - FTlHeaderResizeStartX);
    RefreshTimelineTab;
    Exit;
  end;

  if FTlRangeMoving then
  begin
    if Abs(X - FTlRangeMoveDownX) > 3 then FTlRangeMoveMoved := True;
    if FTlRangeMoveMoved then
    begin
      rawSec := FTlView.XToSeconds(X);
      delta := rawSec - FTlRangeMoveLastSec;
      if FTlRangeStartSec + delta < 0 then delta := -FTlRangeStartSec;
      FTlRangeStartSec := FTlRangeStartSec + delta;
      FTlRangeEndSec := FTlRangeEndSec + delta;
      FTlRangeMoveLastSec := FTlRangeMoveLastSec + delta;
      RefreshTimelineTab;
    end;
    Exit;
  end;

  if FTlRangeDragging then
  begin
    sec := FTlView.Snap(FTlView.XToSeconds(X));
    if sec < 0 then sec := 0;
    FTlRangeStartSec := Min(FTlRangeAnchorSec, sec);
    FTlRangeEndSec := Max(FTlRangeAnchorSec, sec);
    FTlRangeActive := (FTlRangeEndSec - FTlRangeStartSec) > 0.0005;
    RefreshTimelineTab;
    Exit;
  end;

  { a clip move/trim/fade only begins once the mouse has really travelled -
    otherwise the (snapped) move would run on the very first mouse-move of a
    plain click and jump an off-grid clip, edge or fade to the grid }
  if (FTlDragging or FTlTrimming or FTlFadeDragging) and not FTlPressMoved then
  begin
    if (Abs(X - FTlPressX) <= TL_DRAG_THRESHOLD) and (Abs(Y - FTlPressY) <= TL_DRAG_THRESHOLD) then
      Exit;
    FTlPressMoved := True;
  end;

  if FTlFadeDragging and (FTlFadeClipId >= 0) then
  begin
    c := FProject.Timeline.ClipById(FTlFadeClipId);
    if c = nil then
    begin
      FTlFadeDragging := False;
      Exit;
    end;
    rawSec := FTlView.XToSeconds(X);   { fades are fine-grained: never snapped to the grid }
    if FTlFadeEdge = ceStart then
      newFade := rawSec - c.StartSeconds
    else
      newFade := c.EndSeconds - rawSec;
    newFade := EnsureRange(newFade, 0, c.LengthSeconds);
    try
      FCmds.Perform(TSetTimelineClipFadeCommand.Create(FProject, FTlFadeClipId, FTlFadeEdge, newFade));
    except
      on E: Exception do
      begin
        FTlFadeDragging := False;
        memTimeline.Lines.Insert(0, 'Fade FAILED: ' + E.Message);
      end;
    end;
    RefreshTimelineTab;
    Exit;
  end;

  if FTlRubberSelecting then
  begin
    FTlRubberX := X; FTlRubberY := Y;
    TlSelectRubberBand;
    RefreshTimelineTab;
    Exit;
  end;

  if FTlTrimming and (FTlTrimClipId >= 0) then
  begin
    sec := FTlView.Snap(FTlView.XToSeconds(X));
    if sec < 0 then sec := 0;
    FTlSnapGuideOn := FTlView.SnapEnabled;
    FTlSnapGuideSec := sec;
    try
      FCmds.Perform(TTrimTimelineClipCommand.Create(FProject, FTlTrimClipId, FTlTrimEdge, sec));
    except
      on E: Exception do
      begin
        FTlTrimming := False;
        memTimeline.Lines.Insert(0, 'Trim FAILED: ' + E.Message);
      end;
    end;
    RefreshTimelineTab;
    Exit;
  end;

  if not FTlDragging or (FTlSelClipId < 0) then
  begin
    { hover feedback: a resize cursor over a draggable clip edge, or a
      diagonal-resize cursor over a fade handle corner }
    c := TlClipAtPoint(X, Y);
    if (X >= TlHdrW - 8) and (X < TlHdrW) then
      pbTimeline.Cursor := crSizeWE
    else if TlTempoLaneAt(X, Y) then
      pbTimeline.Cursor := crSizeNS
    else if (c <> nil) and not c.Locked and TlTrackAtY(Y, ti) and
       TlHitTestFadeHandle(c, ti, X, Y, edge) then
      pbTimeline.Cursor := crSizeAll
    else if (c <> nil) and not c.Locked and TlHitTestClipEdge(c, X, edge) then
      pbTimeline.Cursor := crSizeWE
    else
      pbTimeline.Cursor := crDefault;
    TlUpdateVideoHover(X, Y);
    Exit;
  end;

  { group move: every clip captured in FTlDragIds/FTlMultiDragStartSecs at
    mouse-down rides the same delta, so a multi-selected drag keeps the
    clips' relative offsets exactly as they were - like every other DAW's
    playlist/arrangement view. Dragging a clip (or a whole selection) never
    changes lane: a clip always stays on its own track however far
    the cursor strays vertically - moving clips to another channel is done with the
    clip menu, which validates the destination. }
  delta := FTlView.XToSeconds(X) - FTlDragMouseStartSec;
  try
    for i := 0 to High(FTlDragIds) do
    begin
      newStart := FTlView.Snap(FTlMultiDragStartSecs[i] + delta);
      if newStart < 0 then newStart := 0;
      if i = 0 then
      begin
        FTlSnapGuideOn := FTlView.SnapEnabled;
        FTlSnapGuideSec := newStart;
      end;
      FCmds.Perform(TMoveTimelineClipCommand.Create(FProject, FTlDragIds[i], newStart, 0));   // 0 = keep the clip's own track
    end;
  except
    on E: Exception do
    begin
      FTlDragging := False;
      memTimeline.Lines.Insert(0, 'Move FAILED: ' + E.Message);
    end;
  end;
  RefreshTimelineTab;
end;

{ The audio of the pressed effect region as it was before the effect, from the original the
  first rendered effect kept on the clip (OrigSourceId / OrigDelta). False when no original
  was kept or it can't be read. }
function TfrmMain.TlRegionAudioBefore(out APlanar: TAudioPlanar; out ARate: Integer): Boolean;
var
  tl: TTimeline;
  trk: TTimelineTrack;
  c: TTimelineClip;
  o: TMediaSource;
  player: TTimelinePlayer;
  odec: TDecodedSource;
  j, i, ch, startFrame, n: Integer;
  s0, s1: Double;
begin
  Result := False;
  APlanar := nil;
  ARate := 0;
  if (FProject = nil) or not FTlRangeActive then Exit;
  tl := FProject.Timeline;
  trk := tl.TrackById(FTlSelectedTrackId);
  if trk = nil then Exit;
  for j := 0 to trk.ClipCount - 1 do
  begin
    c := trk.GetClip(j);
    s0 := Max(c.StartSeconds, FTlRangeStartSec);
    s1 := Min(c.EndSeconds, FTlRangeEndSec);
    if (s1 - s0 <= TIMELINE_MIN_CLIP_SECONDS) or not c.HasOrig then Continue;
    o := tl.SourceById(c.OrigSourceId);
    if (o = nil) or ((o.Path <> '') and not FileExists(o.Path)) then Continue;
    player := TTimelinePlayer.Create(tl);
    try
      player.EnsureSourcesLoaded;
      odec := player.GetDecodedSource(o.Id);
      if (odec = nil) or odec.Failed or (odec.FrameCount = 0) or (odec.SampleRate <= 0) then Continue;
      ARate := odec.SampleRate;
      ch := odec.Channels;
      startFrame := Round((c.SourceOffsetSeconds + c.OrigDelta + (s0 - c.StartSeconds)) * ARate);
      n := Round((s1 - s0) * ARate);
      if (startFrame < 0) or (ch < 1) then Continue;
      if startFrame + n > odec.FrameCount then n := odec.FrameCount - startFrame;
      if n < 2 then Continue;
      SetLength(APlanar, ch);
      for i := 0 to ch - 1 do
      begin
        SetLength(APlanar[i], n);
        Move(odec.Data[i][startFrame], APlanar[i][0], n * SizeOf(Single));
      end;
      Exit(True);
    finally
      player.Free;
    end;
  end;
end;

{ A right click opens the Edit / Undo menu at once. A left click waits out the double-click
  time first: a second press inside it is a double-click, which opens the effect window
  instead (tmrTlEffMenu shows the menu when no second press came). }
procedure TfrmMain.TlEffectMenuOrEdit(AButton: TMouseButton; AX, AY: Integer);
begin
  if AButton <> mbLeft then
  begin
    TlShowEffectMenu(AX, AY);
    Exit;
  end;
  if FTlDblPress then
  begin
    FTlDblPress := False;
    tmrTlEffMenu.Enabled := False;
    pmTlEffEditClick(nil);
    Exit;
  end;
  FTlEffMenuPt := Point(AX, AY);
  tmrTlEffMenu.Enabled := False;
  tmrTlEffMenu.Interval := Integer(GetDoubleClickTime) + 40;
  tmrTlEffMenu.Enabled := True;
end;

procedure TfrmMain.tmrTlEffMenuTimer(Sender: TObject);
begin
  tmrTlEffMenu.Enabled := False;
  if (FProject <> nil) and FTlRangeActive then TlShowEffectMenu(FTlEffMenuPt.X, FTlEffMenuPt.Y);
end;

{ Pops up pmTlEffect (Edit / Undo) for FTlEffCtx at a pbTimeline point.
  Shown manually for the same menu-loop reason as pmTimeline in
  pbTimelineMouseUp. }
procedure TfrmMain.TlShowEffectMenu(AX, AY: Integer);
var
  pt: TPoint;
begin
  pt := pbTimeline.ClientToScreen(Point(AX, AY));
  FMenuLoopActive := True;
  try
    GLShowPopup(pmTlEffect, pt.X, pt.Y);
  finally
    FMenuLoopActive := False;
  end;
end;

procedure TfrmMain.pbTimelineMouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  pt: TPoint;
  plainClick: Boolean;
  c: TTimelineClip;
  trk: TTimelineTrack;
  rngStart, rngEnd: Double;
begin
  if FLaneDragging then
  begin
    TlLaneMouseUp;
    Exit;
  end;
  if FLaneEdit <> 0 then
  begin
    TlLaneEditEnd;
    Exit;
  end;
  if FTempoDrag then
  begin
    FTempoDrag := False;
    FTlSnapGuideOn := False;
    RefreshTimelineTab;
    Exit;
  end;
  if FTlLoopDrag <> 0 then
  begin
    FTlLoopDrag := 0;
    FTlSnapGuideOn := False;
    if FTlLoopMoved and (FProject <> nil) then FProject.Touch;
    RefreshTimelineTab;
    Exit;
  end;
  FTlSnapGuideOn := False;
  { a plain left click on a clip body (pressed, never dragged, no modifier) }
  plainClick := (Button = mbLeft) and FTlDragging and not FTlPressMoved and
    (FTlPressClipId >= 0) and ([ssShift, ssCtrl, ssAlt] * Shift = []);
  FTlDragging := False;
  FTlTrimming := False;
  FTlFadeDragging := False;
  FTlRangeDragging := False;
  if plainClick and (FProject <> nil) then
  begin
    { clicking inside an applied effect's region highlights exactly that
      region, on that channel only, and offers Edit / Undo for it }
    c := FProject.Timeline.ClipById(FTlPressClipId, trk);
    if (c <> nil) and (trk <> nil) and
       TlClipRegionAtSec(c, FTlView.XToSeconds(X), rngStart, rngEnd, FTlEffCtx) then
    begin
      FTlExtraTrackIds := nil;
      FTlSelectedTrackId := trk.Id;
      FTlRangeActive := True;
      FTlRangeStartSec := rngStart;
      FTlRangeEndSec := rngEnd;
      RefreshTimelineTab;
      TlEffectMenuOrEdit(Button, X, Y);
      Exit;
    end;
  end;
  if FTlRangeCancelled and (Button = mbRight) then
  begin
    FTlRangeCancelled := False;
    Exit;   // the press cleared the range - no context menu
  end;
  if FTlRangeMoving then
  begin
    FTlRangeMoving := False;
    if (Button = mbRight) and FTlRangeMoveMoved then
    begin
      FTlRangeMoveMoved := False;
      RefreshTimelineTab;
      Exit;   // it was a drag, not a click - no context menu
    end;
  end;
  if FTlMiddlePanning then
  begin
    FTlMiddlePanning := False;
    pbTimeline.Cursor := crDefault;
  end;
  if FTlHeaderResizing then
  begin
    FTlHeaderResizing := False;
    pbTimeline.Cursor := crDefault;
    if FProject <> nil then FProject.Touch;   // commits the resized width to the project's dirty/undo-save state
  end;
  if FTlRubberSelecting then
  begin
    FTlRubberSelecting := False;
    RefreshTimelineTab;
  end;
  if FTlEffCtxActive and ((Button = mbLeft) or (Button = mbRight)) then
  begin
    { an effect name was pressed (pbTimelineMouseDown already highlighted its
      region): offer Edit / Undo for that region only }
    FTlEffCtxActive := False;
    TlEffectMenuOrEdit(Button, X, Y);
    Exit;
  end;
  if Button = mbRight then
  begin
    { pmTimeline is shown manually here, on purpose, instead of via the
      pbTimeline.PopupMenu property VCL would otherwise auto-invoke: a
      popup shown that way is tracked through Vcl.Menus' own hidden helper
      window, not this form, so WM_ENTERMENULOOP/WM_EXITMENULOOP never
      reached TfrmMain for it - FMenuLoopActive stayed False the entire
      time the menu was open, so nothing was ever actually stopping
      tmrUITimer's per-tick pbTimeline.Invalidate from repainting
      underneath the live popup (the fix that was supposed to prevent the
      blank/flickering menu never engaged for THIS menu, only for the main
      menu bar's Timeline dropdown, which genuinely is owned by the form).
      Popup(...) blocks until the menu closes, so wrapping the one call
      that actually matters here sidesteps the whole hidden-window problem
      instead of depending on which window Windows happens to route those
      messages to. }
    pt := pbTimeline.ClientToScreen(Point(X, Y));
    FMenuLoopActive := True;
    try
      if FTlRulerCtxActive then
        GLShowPopup(pmTimelineRuler, pt.X, pt.Y)
      else
        GLShowPopup(pmTimeline, pt.X, pt.Y);
    finally
      FMenuLoopActive := False;
    end;
  end;
end;

procedure TfrmMain.pbTimelinePaint(Sender: TObject);
const
  CLIP_HEADER_H = 15;
  EDGE_R = 5;
var
  cv: TGLCanvas;
  w, h, ti, j, top, laneH, x, x2, cw: Integer;
  tl: TTimeline;
  grid: TGridContext;
  trk: TTimelineTrack;
  clip: TTimelineClip;
  src: TMediaSource;
  barSec, tSec, sx: Double;
  barIdx: Integer;
  cols: TWavePeakArray;
  midY, halfH, px, colFirstSec, spc, srcScale: Double;
  ch, colX, nWaveCh: Integer;
  colSample: Int64;
  waveHalf, colMin, colMax: Double;
  waveMid: array[0..1] of Double;
  stereoWave, haveCol: Boolean;
  pk: TWavePeak;
  isSel: Boolean;
  trackHasEffects: Boolean;
  clipBackground: TColor;
  fadeX: Integer;
  playX, loopX1, loopX2, rngX1, rngX2: Double;
  theme: TUDAWTheme;
  bodyTop: Integer;
  titleRect: TRect;
  smallFontH: Integer;
  clipLabel: string;
  trkColor, hdrColor, bodyColor: TColor;
  hdrW, launchIdx: Integer;
  belowTop, beatIdx: Integer;
  beatSec: Double;

  function IsLight(AColor: TColor): Boolean;
  var
    c: LongInt;
  begin
    c := ColorToRGB(AColor);
    Result := ((c and $FF) * 299 + ((c shr 8) and $FF) * 587 + ((c shr 16) and $FF) * 114) div 1000 > 140;
  end;

  procedure DrawFittedLabel(const AText: string; AX, AY, ARight, ABottom: Integer);
  var
    labelText: string;
    lo, hi, mid, available: Integer;
    bounds: TRect;
  begin
    available := ARight - AX;
    if (available <= 0) or (ABottom <= AY) then Exit;
    labelText := AText;
    if cv.TextWidth(labelText) > available then
    begin
      if cv.TextWidth('...') > available then Exit;
      lo := 0;
      hi := Length(AText);
      while lo < hi do
      begin
        mid := (lo + hi + 1) div 2;
        if cv.TextWidth(Copy(AText, 1, mid) + '...') <= available then lo := mid
        else hi := mid - 1;
      end;
      if (lo > 0) and (Ord(AText[lo]) >= $D800) and (Ord(AText[lo]) <= $DBFF) then Dec(lo);
      labelText := Copy(AText, 1, lo) + '...';
    end;
    bounds := Rect(AX, AY, ARight, ABottom);
    cv.TextRect(bounds, AX, AY, labelText);
  end;

  procedure VLine(AX, AY1, AY2: Integer; AColor: TColor);
  begin
    cv.Pen.Color := AColor;
    cv.MoveTo(AX, AY1);
    cv.LineTo(AX, AY2);
  end;

  { blend two TColor values by T in [0,1]; goes through ColorToRGB (not
    GetRValue/RGB, which live in Winapi.Windows and aren't available under
    FPC/LCL) so this works unchanged on both build targets. }
  function Mix(A, B: TColor; T: Double): TColor;
  var
    ca, cb: LongInt;
    ar, ag, ab, br, bg, bb: Byte;
  begin
    ca := ColorToRGB(A);
    cb := ColorToRGB(B);
    ar := ca and $FF; ag := (ca shr 8) and $FF; ab := (ca shr 16) and $FF;
    br := cb and $FF; bg := (cb shr 8) and $FF; bb := (cb shr 16) and $FF;
    Result := TColor(Byte(Round(ar + (br - ar) * T)) or
      (Byte(Round(ag + (bg - ag) * T)) shl 8) or
      (Byte(Round(ab + (bb - ab) * T)) shl 16));
  end;

  { beat (faint) and bar (stronger) grid lines over [AY1, AY2) of the lane area }
  procedure DrawGrid(AY1, AY2: Integer);
  var
    bi: Integer;
    gx: Double;
    beatCol: TColor;
  begin
    if (AY2 <= AY1) or not grid.IsValid then Exit;
    beatCol := Mix(theme.Grid, theme.Background, 0.55);
    if beatSec * FTlView.PixelsPerSecond >= 14 then
    begin
      bi := Max(0, Trunc(SecondsToBeats(grid, FTlView.VisibleStartSeconds)) - 1);
      repeat
        gx := FTlView.SecondsToX(BeatsToSeconds(grid, bi));
        if (gx >= FTlView.HeaderWidth) and (bi mod Max(1, grid.TSigNum) <> 0) then
          VLine(Round(gx), AY1, AY2, beatCol);
        Inc(bi);
      until gx > w;
    end;
    bi := Max(0, Trunc(SecondsToBars(grid, FTlView.VisibleStartSeconds)) - 1);
    repeat
      gx := FTlView.SecondsToX(BarsToSeconds(grid, bi));
      if gx >= FTlView.HeaderWidth then VLine(Round(gx), AY1, AY2, theme.Grid);
      Inc(bi);
    until gx > w;
  end;

begin
  w := pbTimeline.Width;
  h := pbTimeline.Height;
  if (w <= 0) or (h <= 0) then Exit;
  { pbTimeline is an OpenGL 3.3 surface (TGLView): every call below is
    recorded into one batched vertex stream and drawn, then buffer-swapped, once
    per paint - no flicker and no per-line GDI cost during playback. }
  cv := pbTimeline.GL;
  theme := CurrentTheme;
  cv.Brush.Color := theme.Background;
  cv.Brush.Style := bsSolid;
  cv.FillRect(Rect(0, 0, w, h));

  if FProject = nil then TlHeaderTick;   { clears the header widgets of a closed project }
  if FProject <> nil then
  begin
  tl := FProject.Timeline;
  grid := TimelineGrid;
  hdrW := TlHdrW;
  TlApplyViewMetrics;
  FTlView.SetGrid(grid);
  FTlView.SetViewportWidth(w);
  TlHeaderTick;
  barSec := 1;
  beatSec := 1;
  if grid.IsValid then
  begin
    barSec := grid.SecondsPerBar;
    beatSec := grid.SecondsPerBeat;
  end;

  { ---- ruler band: a darker strip that reads as its own header ---- }
  cv.Brush.Style := bsSolid;
  cv.Brush.Color := Mix(theme.PanelBackground, theme.Background, 0.5);
  cv.FillRect(Rect(FTlView.HeaderWidth, 0, w, LANE_RULER_H));

  { ---- loop region shading on the ruler ---- }
  if tl.LoopLengthSeconds > 0 then
  begin
    loopX1 := FTlView.SecondsToX(tl.LoopStartSeconds);
    loopX2 := FTlView.SecondsToX(tl.LoopStartSeconds + tl.LoopLengthSeconds);
    if (loopX2 >= FTlView.HeaderWidth) and (loopX1 <= w) then
    begin
      if loopX1 < FTlView.HeaderWidth then loopX1 := FTlView.HeaderWidth;
      if loopX2 > w then loopX2 := w;
      cv.Brush.Style := bsSolid;
      if tl.LoopEnabled then
        cv.Brush.Color := theme.Accent
      else
        cv.Brush.Color := theme.SecondaryText;
      cv.Pen.Style := psClear;
      cv.Rectangle(Round(loopX1), 0, Round(loopX2), LANE_RULER_H);
      cv.Pen.Style := psSolid;
      { grab handles on both edges }
      cv.Brush.Color := theme.Background;
      cv.FillRect(Rect(Round(loopX1), LANE_RULER_H - 9, Round(loopX1) + 3, LANE_RULER_H));
      cv.FillRect(Rect(Round(loopX2) - 3, LANE_RULER_H - 9, Round(loopX2), LANE_RULER_H));
    end;
  end;

  { ---- range/section selection: a tinted ruler-strip fill so a drag-
    selected time range reads at a glance, distinct from the loop-region
    fill above (Selection is a different theme colour from Accent). The
    full-height dashed boundary lines are drawn later, after the clips, so
    they stay visible over waveforms/clip bodies instead of being painted
    under them. ---- }
  if FTlRangeActive then
  begin
    rngX1 := FTlView.SecondsToX(FTlRangeStartSec);
    rngX2 := FTlView.SecondsToX(FTlRangeEndSec);
    if (rngX2 >= FTlView.HeaderWidth) and (rngX1 <= w) then
    begin
      if rngX1 < FTlView.HeaderWidth then rngX1 := FTlView.HeaderWidth;
      if rngX2 > w then rngX2 := w;
      cv.Brush.Style := bsSolid;
      cv.Brush.Color := Mix(theme.Selection, theme.Background, 0.25);
      cv.Pen.Style := psClear;
      cv.Rectangle(Round(rngX1), 0, Round(rngX2), LANE_RULER_H);
      cv.Pen.Style := psSolid;
    end;
  end;

  { ---- ruler: bar numbers, m:ss time under them, bar + beat ticks ---- }
  if grid.IsValid then
  begin
    if beatSec * FTlView.PixelsPerSecond >= 14 then
    begin
      beatIdx := Max(0, Trunc(SecondsToBeats(grid, FTlView.VisibleStartSeconds)) - 1);
      repeat
        sx := FTlView.SecondsToX(BeatsToSeconds(grid, beatIdx));
        if (sx >= FTlView.HeaderWidth) and (beatIdx mod Max(1, grid.TSigNum) <> 0) then
          VLine(Round(sx), LANE_RULER_H - 4, LANE_RULER_H, theme.Grid);
        Inc(beatIdx);
      until sx > w;
    end;
    barIdx := Trunc(SecondsToBars(grid, FTlView.VisibleStartSeconds)) - 1;
    if barIdx < 0 then barIdx := 0;
    repeat
      tSec := BarsToSeconds(grid, barIdx);
      sx := FTlView.SecondsToX(tSec);
      if sx > w then Break;
      if sx >= FTlView.HeaderWidth then
      begin
        VLine(Round(sx), LANE_RULER_H - 9, LANE_RULER_H, theme.SecondaryText);
        cv.Brush.Style := bsClear;
        cv.Font.Color := theme.Text;
        cv.TextOut(Round(sx) + 3, 2, IntToStr(barIdx + 1));
        if barSec * FTlView.PixelsPerSecond >= 64 then
        begin
          cv.Font.Color := theme.SecondaryText;
          cv.TextOut(Round(sx) + 3, 14, Format('%d:%.2d', [Trunc(tSec) div 60, Trunc(tSec) mod 60]));
        end;
        cv.Brush.Style := bsSolid;
      end;
      Inc(barIdx);
    until sx > w;
  end;

  { ---- ruler baseline ---- }
  cv.Pen.Color := theme.Border;
  cv.MoveTo(0, LANE_RULER_H);
  cv.LineTo(w, LANE_RULER_H);

  { ---- master spectrum in the top-left corner (resizes with HeaderWidth) ---- }
  DrawTimelineSpectrum(cv, Rect(0, 0, hdrW - 1, LANE_RULER_H - 1));
  if FStageVisible then TlStagePaintSceneHeader(cv);
  if FLanesVisible then TlPaintLaneStack(cv, w);

  { ---- markers (in the ruler only while the Markers lane is hidden) ---- }
  if not FLanesVisible then
  for j := 0 to tl.MarkerCount - 1 do
  begin
    sx := FTlView.SecondsToX(tl.GetMarker(j).Seconds);
    if (sx >= FTlView.HeaderWidth) and (sx <= w) then
    begin
      cv.Brush.Color := theme.Automation;
      cv.Pen.Color := theme.Automation;
      cv.Polygon([Point(Round(sx), 4), Point(Round(sx) - 5, 14), Point(Round(sx) + 5, 14)]);
      cv.Brush.Color := theme.Background;
      cv.Brush.Style := bsClear;
      cv.Font.Color := theme.Text;
      cv.TextOut(Round(sx) + 6, 3, tl.GetMarker(j).Name);
      cv.Brush.Style := bsSolid;
    end;
  end;

  { ---- tracks ----
    Clipped to [RulerHeight, h] for the whole loop: with the vertical
    scrollbar (sbTlVert/FTlVScrollY), a track's title band/content can land
    above the ruler while scrolling, and without this it would paint straight
    over the ruler - which must stay a fixed, un-scrolled "sticky header" at
    all times. }
  cv.PushClip(Rect(0, FTlView.RulerHeight, w, h));
  try
    for ti := 0 to tl.TrackCount - 1 do
    begin
      trk := tl.GetTrack(ti);
      top := TlTrackTop(ti);
      trkColor := TlTrackAccent(trk, ti);
      trackHasEffects := FProject.Mixer.SourceHasEffects(trk.Id);
      laneH := trk.Height;
      if top > h then Break;
      if top + laneH < FTlView.RulerHeight then Continue;

    { per-channel title band: sits directly over this track, above its own
      header/name and above the clip filename in its lane - not the global
      ruler at the very top of the timeline - so section titles and "effect
      added" names for THIS channel are never confused with another track's,
      and never collide with the ruler's numerical bar labels. Small font,
      one line, saved with the project on TTimelineTrack.Title. }
    titleRect := TlTrackTitleRect(top, w);
    if titleRect.Bottom > titleRect.Top then
    begin
      cv.Brush.Style := bsSolid;
      cv.Brush.Color := Mix(theme.PanelBackground, theme.Background, 0.45);
      cv.FillRect(titleRect);
      cv.Pen.Color := theme.Border;
      cv.MoveTo(titleRect.Left, titleRect.Bottom); cv.LineTo(titleRect.Right, titleRect.Bottom);
      { The track-wide trk.Title is deliberately NOT drawn: it held a stale
        comma-joined list of every effect ever added (saved in older projects),
        piled at the channel start. Only the per-region names below are shown,
        each where that effect is actually present. }
      { each rendered-effect region is named here, at the region's own start,
        in that effect's colour }
      smallFontH := cv.Font.Height;
      cv.Font.Height := Round(smallFontH * 0.8);
      cv.Brush.Style := bsClear;
      for j := 0 to trk.ClipCount - 1 do
      begin
        clip := trk.GetClip(j);
        if (clip.EndSeconds < FTlView.XToSeconds(FTlView.HeaderWidth)) or
           (clip.StartSeconds > FTlView.XToSeconds(w)) then Continue;
        for var reg in TlClipRegions(clip) do
        begin
          var regEnd := clip.EndSeconds;
          if reg.LengthSeconds > 0 then
            regEnd := Min(clip.EndSeconds, clip.StartSeconds + reg.OffsetSeconds + reg.LengthSeconds);
          x := Round(FTlView.SecondsToX(
            Max(clip.StartSeconds + Min(reg.OffsetSeconds, clip.LengthSeconds),
              FTlView.XToSeconds(FTlView.HeaderWidth))));
          x2 := Round(FTlView.SecondsToX(Min(regEnd, FTlView.XToSeconds(w))));
          cv.Font.Color := reg.Color;
          DrawFittedLabel(reg.Name, x + 3, titleRect.Top + 1,
            Min(x2, titleRect.Right) - 2, titleRect.Bottom - 1);
        end;
      end;
      cv.Font.Height := smallFontH;
    end;

    { header, with a subtle divider below and a slightly lighter fill so it
      reads as a distinct control column rather than more lane background }
    if (trk.Id = FTlSelectedTrackId) or TlTrackHasSelectedClip(trk) then
      cv.Brush.Color := Mix(theme.Selection, theme.PanelBackground, 0.6)
    else
      cv.Brush.Color := Mix(theme.PanelBackground, theme.Background, 0.15);
    cv.Brush.Style := bsSolid;
    cv.FillRect(Rect(0, top, hdrW, top + laneH));
    cv.Pen.Color := theme.Border;
    cv.MoveTo(0, top + laneH); cv.LineTo(w, top + laneH);
    cv.MoveTo(hdrW, top); cv.LineTo(hdrW, top + laneH);
    { horizontal splitter: a 5px grab strip at the header/stage boundary,
      inside the header column so it clears both the header content and the
      channel data. }
    cv.Brush.Color := Mix(theme.Border, theme.PanelBackground, 0.5);
    cv.FillRect(Rect(hdrW - 5, top, hdrW, top + laneH));
    { track colour stripe down the header's left edge, wider when selected }
    cv.Brush.Color := trkColor;
    cv.FillRect(Rect(0, top, IfThen(trk.Id = FTlSelectedTrackId, 6, 3), top + laneH));

    { the header content - avatar, name, sub-label, M / S / R, volume, pan, "BPM ?" -
      is a TGLTrackHeader widget laid over this strip (see TlHeaderTick) }

    { Clip Stage launch slots for this track, between its header and its lane }
    if FStageVisible then TlStagePaintCells(cv, trk, top, laneH, trkColor);

    { lane background, every other lane a touch lighter, then its grid }
    if Odd(ti) then cv.Brush.Color := Mix(theme.Background, theme.PanelBackground, 0.18)
    else cv.Brush.Color := theme.Background;
    cv.FillRect(Rect(FTlView.HeaderWidth, top, w, top + laneH));
    DrawGrid(top, top + laneH);

    { clips }
    for j := 0 to trk.ClipCount - 1 do
    begin
      clip := trk.GetClip(j);
      { Clamp both edges to the viewport BEFORE any further math: a clip far
        outside the visible window (long clip during fast playback
        auto-scroll, or a very high zoom level) can make SecondsToX return a
        pixel offset well beyond Integer's range, and Round() truncating an
        out-of-range value wraps to an arbitrary small number instead of
        raising - which could then slip past the old bounds check and get
        drawn (fade lines/handles included) at a bogus on-screen position
        that has nothing to do with the clip's real, off-screen location.
        Clamping the SECONDS-domain value first keeps every pixel coordinate
        computed below inside [HeaderWidth, w], so nothing can wrap. }
      x := Round(FTlView.SecondsToX(
        Max(clip.StartSeconds, FTlView.XToSeconds(FTlView.HeaderWidth) - 1)));
      x2 := Round(FTlView.SecondsToX(
        Min(clip.EndSeconds, FTlView.XToSeconds(w) + 1)));
      if (clip.EndSeconds < FTlView.XToSeconds(FTlView.HeaderWidth)) or
         (clip.StartSeconds > FTlView.XToSeconds(w)) then Continue;
      if x < FTlView.HeaderWidth then x := FTlView.HeaderWidth;
      if x2 > w then x2 := w;
      cw := x2 - x;
      if cw < 1 then cw := 1;

      { rounded body, a thin header strip carrying the name, subtle border,
        brighter+accent-bordered when selected (single or multi), dimmed when muted }
      isSel := TlIsClipSelected(clip.Id);
      bodyColor := Mix(trkColor, theme.Background, 0.7);
      if clip.HasEffects or trackHasEffects then
        clipBackground := Mix(bodyColor, theme.ClipEffectsBackground, 0.4)
      else clipBackground := bodyColor;
      if isSel then clipBackground := Mix(clipBackground, theme.Selection, 0.35);
      if clip.Muted then clipBackground := Mix(clipBackground, theme.Background, 0.5);
      cv.Brush.Color := clipBackground;
      if isSel then cv.Pen.Color := theme.Selection
      else cv.Pen.Color := Mix(trkColor, clBlack, 0.35);
      cv.Pen.Width := IfThen(isSel, 2, 1);
      cv.RoundRect(x, top + 2, x2, top + laneH - 2, EDGE_R, EDGE_R);
      cv.Pen.Width := 1;

      bodyTop := top + 2 + CLIP_HEADER_H;
      if bodyTop < top + laneH - 2 then
      begin
        { header strip stays neutral; an applied effect's colour is confined to
          its own region (below), not the whole clip }
        hdrColor := trkColor;
        if clip.Muted then hdrColor := Mix(hdrColor, theme.Background, 0.5);
        cv.Brush.Color := hdrColor;
        if (clip.EffectName = '') and (clip.Color <> 0) then
          cv.Brush.Color := clip.Color;
        cv.Pen.Color := cv.Brush.Color;
        cv.RoundRect(x, top + 2, x2, bodyTop, EDGE_R, EDGE_R);
        { every applied effect keeps its own coloured span, in application order }
        for var reg in TlClipRegions(clip) do
          if reg.Color <> 0 then
          begin
            var fxX1 := EnsureRange(Round(FTlView.SecondsToX(clip.StartSeconds + reg.OffsetSeconds)), x, x2);
            var fxX2 := x2;
            if reg.LengthSeconds > 0 then
              fxX2 := EnsureRange(Round(FTlView.SecondsToX(
                clip.StartSeconds + reg.OffsetSeconds + reg.LengthSeconds)), x, x2);
            if fxX2 > fxX1 then
            begin
              cv.Brush.Color := reg.Color;
              cv.FillRect(Rect(fxX1, top + 3, fxX2, bodyTop));
            end;
          end;
        cv.Pen.Color := Mix(trkColor, clBlack, 0.35);
        cv.MoveTo(x + 1, bodyTop); cv.LineTo(x2 - 1, bodyTop);
      end
      else
        hdrColor := trkColor;

      cv.Brush.Style := bsClear;
      if IsLight(hdrColor) then cv.Font.Color := Mix(trkColor, clBlack, 0.85)
      else cv.Font.Color := clWhite;
      { the effect's name, right at the clip's own start (region start point)
        rather than a fixed screen position - x is recomputed every paint
        from FTlView's current scroll/zoom, so this moves with the clip and
        tracks live playback scroll exactly like the clip body itself; the
        header strip behind it is already painted in that effect's assigned
        colour (clip.Color, set by TlApplyEffectToRange/TlApplySilenceToRange
        via TlEffectColor) }
      clipLabel := clip.Name;
      { the icon that says what the clip is; a click on it opens the clip's editor }
      var iconR := TlClipIconRect(clip, ti);
      var labelX := x + 4;
      if iconR.Right > iconR.Left then
      begin
        TlDrawClipIcon(cv, iconR, TlClipKind(clip), cv.Font.Color);
        labelX := iconR.Right + 4;
      end;
      { a clip set to loop shows a loop icon at the right end of its header }
      var loopRight := x2 - 4;
      if clip.Locked then loopRight := x2 - 18;
      if clip.Loop and (x2 - x >= 64) then
      begin
        TGLIconBar.DrawIcon(cv, 'loop', Rect(loopRight - 16, top + 2, loopRight, top + 2 + 15), cv.Font.Color);
        cv.Brush.Style := bsClear;
        loopRight := loopRight - 18;
      end;
      DrawFittedLabel(clipLabel, labelX, top + 3, loopRight, bodyTop);
      if clip.Locked and (cw >= 18) then
      begin
        TGLIconBar.DrawIcon(cv, 'lock', Rect(x2 - 19, top + 2, x2 - 3, top + 2 + 15), theme.LockColor);
        cv.Brush.Style := bsClear;
      end;
      cv.Brush.Style := bsSolid;

      { ---- real waveform from the peak cache ---- }
      if (CurrentFadeDisplay <> fdmCurves) and (bodyTop < top + laneH - 3) and (cw > 4) then
      begin
        if clip.FadeInSeconds > 0 then
        begin
          fadeX := EnsureRange(Round(FTlView.SecondsToX(
            Min(clip.StartSeconds + clip.FadeInSeconds, FTlView.XToSeconds(w) + 1))), x, x2);
          cv.Brush.Color := theme.FadeInBackground;
          if isSel then cv.Brush.Color := Mix(cv.Brush.Color, theme.Selection, 0.25);
          if clip.Muted then cv.Brush.Color := Mix(cv.Brush.Color, theme.Background, 0.5);
          cv.FillRect(Rect(x + 2, bodyTop + 1, Min(x2 - 2, Max(x + 2, fadeX)), top + laneH - 3));
        end;
        if clip.FadeOutSeconds > 0 then
        begin
          fadeX := EnsureRange(Round(FTlView.SecondsToX(
            Max(clip.EndSeconds - clip.FadeOutSeconds, FTlView.XToSeconds(FTlView.HeaderWidth) - 1))), x, x2);
          cv.Brush.Color := theme.FadeOutBackground;
          if isSel then cv.Brush.Color := Mix(cv.Brush.Color, theme.Selection, 0.25);
          if clip.Muted then cv.Brush.Color := Mix(cv.Brush.Color, theme.Background, 0.5);
          cv.FillRect(Rect(Max(x + 2, Min(x2 - 2, fadeX)), bodyTop + 1, x2 - 2, top + laneH - 3));
        end;
      end;
      src := nil;
      if clip.SourceId >= 0 then src := tl.SourceById(clip.SourceId);
      { Usually a no-op: WarmClipWaveform already built this at import time.
        Still needed for a clip whose source was reloaded from an older
        project file, where nothing has called it yet - but this runs inside
        OnPaint, which WarmClipWaveform is NOT safe to call from: it shows a
        status-bar progress bracket and its per-chunk callback both pump
        Application.ProcessMessages, and ProcessMessages inside a paint
        handler can dispatch another paint (or the playback timer's own
        Invalidate) before this one returns - re-entering this same loop for
        the same still-nil Waveform and recursing again, each level pumping
        messages that spawn a deeper level. That reentrant loop is what made
        adding/playing a real clip look permanently frozen with the progress
        bar flickering at 0%, never advancing. Building the cache directly
        with no progress callback avoids ProcessMessages entirely - a bare,
        synchronous, one-time-per-source decode, exactly like any other paint
        work that happens to be slow the first time. }
      { Video clips have no waveform: draw a film-strip body (dark band with
        sprocket holes) and a VIDEO tag instead, so they read as video at a
        glance next to audio clips. }
      if (src <> nil) and (src.Kind = mkVideoFile) and (bodyTop < top + laneH - 3) and (cw > 4) then
      begin
        cv.Brush.Color := Mix($00401818, clBlack, 0.3);
        cv.FillRect(Rect(x + 2, bodyTop + 1, x2 - 2, top + laneH - 3));
        cv.Brush.Color := $00A0A0A0;
        { Phase the sprockets from the clip's true start, not the clamped
          viewport edge x: once the clip's left side has scrolled out of view x
          stays pinned at HeaderWidth, so holes anchored to it never moved
          while the audio lanes scrolled past. }
        var holeX := Round(FTlView.SecondsToX(clip.StartSeconds)) + 6;
        if holeX < x + 2 then
          Inc(holeX, ((x + 2 - holeX + 13) div 14) * 14);
        while holeX < x2 - 8 do
        begin
          cv.FillRect(Rect(holeX, bodyTop + 3, holeX + 5, bodyTop + 8));
          cv.FillRect(Rect(holeX, top + laneH - 11, holeX + 5, top + laneH - 6));
          Inc(holeX, 14);
        end;
        { The tag sits at the clip's true start so it scrolls with the clip (and
          with the audio lanes during playback); TextRect clips it to the
          visible part of the clip body. }
        cv.Brush.Style := bsClear;
        cv.Font.Color := $00E0C080;
        var tagX := Round(FTlView.SecondsToX(clip.StartSeconds)) + 8;
        var tagY := bodyTop + (top + laneH - bodyTop) div 2 - 7;
        cv.TextRect(Rect(x + 2, bodyTop + 1, x2 - 2, top + laneH - 3), tagX, tagY, 'VIDEO');
        cv.Brush.Style := bsSolid;
      end;
      if (src <> nil) and (src.Waveform = nil) and (src.Kind <> mkVideoFile) then
        try
          src.EnsureWaveform;
        except
          on E: Exception do
            Logger.Warn('ui', 'waveform build failed: ' + E.Message);
        end;

      midY := bodyTop + (top + laneH - 2 - bodyTop) / 2;
      halfH := (top + laneH - 2 - bodyTop - 4) / 2;
      { MIDI clip: its notes as piano-roll dashes (time across, pitch up) }
      if clip.IsMidiClip and (bodyTop < top + laneH - 4) and (cw > 4) then
        TlDrawMidiDashes(cv, clip, Rect(x + 2, bodyTop + 2, x2 - 2, top + laneH - 4),
          FTlView.XToSeconds(x + 2), FTlView.XToSeconds(x2 - 2),
          Mix(trkColor, clWhite, IfThen(isSel, 0.8, 0.6)), IfThen(laneH >= 70, 3, 2));
      var isTrkClip := (bodyTop < top + laneH - 4) and (cw > 4) and
        TlDrawTrackerNotation(cv, clip, src, Rect(x + 2, bodyTop + 2, x2 - 2, top + laneH - 4),
          Mix(trkColor, clWhite, IfThen(isSel, 0.8, 0.6)), IfThen(laneH >= 70, 3, 2));
      if isTrkClip then
        { notation drawn - no waveform }
      else if (src <> nil) and (src.Waveform <> nil) and (src.SampleRate > 0) and (halfH > 2) then
      begin
        { A tempo-conformed clip plays the stretched copy, so one timeline
          second covers 1/factor seconds of the original file (factor = source
          BPM / project BPM, the same rule as the player's ClipStretchFactor).
          Without this the waveform showed the un-stretched file and ran past
          where the stretched audio actually ends. }
        srcScale := 1.0;
        if (clip.SourceBPM > 0) and (FProject.TempoBPM > 0) and not clip.IsMidiClip then
        begin
          spc := clip.SourceBPM / FProject.TempoBPM;
          if (Abs(spc - 1.0) >= 0.001) and (spc >= 0.25) and (spc <= 4.0) then
            srcScale := 1.0 / spc;
        end;
        spc := srcScale * src.SampleRate / FTlView.PixelsPerSecond;
        if spc < 1 then spc := 1;
        colFirstSec := clip.SourceOffsetSeconds +
          ((x - FTlView.SecondsToX(clip.StartSeconds)) / FTlView.PixelsPerSecond) * srcScale;
        { waveform: the effect's colour only inside the effect region }
        var regs := TlClipRegions(clip);
        { the region's own tint behind the wave, selected or not }
        for var ri := 0 to High(regs) do
          if regs[ri].Color <> 0 then
          begin
            var tx1 := EnsureRange(Round(FTlView.SecondsToX(clip.StartSeconds + regs[ri].OffsetSeconds)), x, x2);
            var tx2 := x2;
            if regs[ri].LengthSeconds > 0 then
              tx2 := EnsureRange(Round(FTlView.SecondsToX(
                clip.StartSeconds + regs[ri].OffsetSeconds + regs[ri].LengthSeconds)), x, x2);
            if tx2 > tx1 then
            begin
              cv.Brush.Color := Mix(clipBackground, regs[ri].Color, 0.3);
              cv.FillRect(Rect(Max(tx1, x + 2), bodyTop + 1, Min(tx2, x2 - 2), top + laneH - 3));
            end;
          end;
        var baseCol := Mix(trkColor, clWhite, 0.4);
        if isSel then baseCol := Mix(baseCol, clWhite, 0.3);
        { stereo audio shows both channels, left above right, in every clip of the lane; a lane
          too short for two traces shows the combined peaks of the channels instead }
        nWaveCh := Min(src.Waveform.Channels, 2);
        stereoWave := (nWaveCh >= 2) and (top + laneH - 2 - bodyTop >= 36);
        waveHalf := (top + laneH - 2 - bodyTop - 7) / 4;
        waveMid[0] := bodyTop + 2 + waveHalf;
        waveMid[1] := waveMid[0] + 2 * waveHalf + 3;
        if stereoWave then
        begin
          cv.Pen.Color := Mix(clipBackground, trkColor, 0.25);
          cv.MoveTo(x + 2, Round(waveMid[0] + waveHalf + 1));
          cv.LineTo(x2 - 2, Round(waveMid[0] + waveHalf + 1));
        end;
        for colX := 0 to cw - 1 do
        begin
          cv.Pen.Color := baseCol;
          { the most recently applied region covering this column wins }
          var colSec := FTlView.XToSeconds(x + colX);
          for var ri := High(regs) downto 0 do
            if (regs[ri].Color <> 0) and (colSec >= clip.StartSeconds + regs[ri].OffsetSeconds) and
               ((regs[ri].LengthSeconds <= 0) or
                (colSec <= clip.StartSeconds + regs[ri].OffsetSeconds + regs[ri].LengthSeconds)) then
            begin
              { lifted a little even when not selected, so a dark swatch still reads on the clip body }
              cv.Pen.Color := Mix(regs[ri].Color, clWhite, IfThen(isSel, 0.3, 0.12));
              Break;
            end;
          px := colFirstSec + colX / FTlView.PixelsPerSecond * srcScale;
          if clip.Reversed then
            colSample := Round((clip.SourceOffsetSeconds + clip.LengthSeconds * srcScale -
              (px - clip.SourceOffsetSeconds)) * src.SampleRate)
          else
            colSample := Round(px * src.SampleRate);
          haveCol := False;
          colMin := 0;
          colMax := 0;
          for ch := 0 to nWaveCh - 1 do
          begin
            src.Waveform.GetColumns(ch, colSample, Round(spc), 1, cols);
            if Length(cols) = 0 then Continue;
            pk := cols[0];
            { A source can genuinely exceed +-1.0 (e.g. an unnormalized tracker
              bounce) - clamp the drawn line to the clip's own body rect rather
              than letting it paint into the lane above/below. }
            if stereoWave then
            begin
              cv.MoveTo(x + colX, EnsureRange(Round(waveMid[ch] - pk.MaxV * waveHalf), bodyTop, top + laneH - 2));
              cv.LineTo(x + colX, EnsureRange(Round(waveMid[ch] - pk.MinV * waveHalf), bodyTop, top + laneH - 2));
            end
            else
            begin
              if not haveCol then begin colMin := pk.MinV; colMax := pk.MaxV; end
              else begin colMin := Min(colMin, Double(pk.MinV)); colMax := Max(colMax, Double(pk.MaxV)); end;
              haveCol := True;
            end;
          end;
          if haveCol then
          begin
            cv.MoveTo(x + colX, EnsureRange(Round(midY - colMax * halfH), bodyTop, top + laneH - 2));
            cv.LineTo(x + colX, EnsureRange(Round(midY - colMin * halfH), bodyTop, top + laneH - 2));
          end;
        end;
      end
      else if not clip.IsMidiClip then
      begin
        { no cache (missing file / generated) - a flat centre line, never a fake wave }
        cv.Pen.Color := theme.SecondaryText;
        cv.MoveTo(x + 1, Round(midY));
        cv.LineTo(x2 - 1, Round(midY));
      end;

      { Optional curve display uses the same ramp function as audio playback. }
      if CurrentFadeDisplay <> fdmColours then
      begin
        cv.Pen.Color := theme.Automation;
        for colX := x to x2 do
        begin
          px := FTlView.XToSeconds(colX);
          if (clip.FadeInSeconds > 0) and (px >= clip.StartSeconds) and
            (px <= clip.StartSeconds + clip.FadeInSeconds) then
          begin
            halfH := ShapeRamp(clip.FadeInShape, (px - clip.StartSeconds) / clip.FadeInSeconds);
            fadeX := Round(top + laneH - 3 - halfH * (top + laneH - 3 - bodyTop));
            if (colX = x) or (FTlView.XToSeconds(colX - 1) < clip.StartSeconds) then
              cv.MoveTo(colX, fadeX)
            else cv.LineTo(colX, fadeX);
          end;
          if (clip.FadeOutSeconds > 0) and (px >= clip.EndSeconds - clip.FadeOutSeconds) and
            (px <= clip.EndSeconds) then
          begin
            halfH := ShapeRamp(clip.FadeOutShape, (clip.EndSeconds - px) / clip.FadeOutSeconds);
            fadeX := Round(top + laneH - 3 - halfH * (top + laneH - 3 - bodyTop));
            if (colX = x) or (FTlView.XToSeconds(colX - 1) < clip.EndSeconds - clip.FadeOutSeconds) then
              cv.MoveTo(colX, fadeX)
            else cv.LineTo(colX, fadeX);
          end;
        end;
        if (bodyTop < top + laneH - 2) and (cw >= 12) then
        begin
          cv.Brush.Color := theme.Automation;
          cv.Pen.Color := Mix(theme.Automation, clBlack, 0.3);
          cv.Rectangle(x, bodyTop, x + 6, bodyTop + 6);
          cv.Rectangle(x2 - 6, bodyTop, x2, bodyTop + 6);
        end;
      end;

      { trim-edge hover handles - thin bright strips at each end, echoing the
        ~6px hit zone used by TlHitTestClipEdge }
      cv.Pen.Color := Mix(trkColor, clBlack, 0.4);
      VLine(x + 2, top + 3, top + laneH - 3, Mix(trkColor, clBlack, 0.4));
      VLine(x2 - 2, top + 3, top + laneH - 3, Mix(trkColor, clBlack, 0.4));
    end;
    TlPaintVideoFx(cv, trk, top, laneH, w);
    launchIdx := TlStageLaunchIndex(trk.Id);
    if launchIdx >= 0 then TlStagePaintBanner(cv, trk, launchIdx, top, laneH, w, trkColor);
    end;
  finally
    cv.PopClip;
  end;

  { grid continues through the empty area under the last track }
  if tl.TrackCount > 0 then
    belowTop := TlTrackTop(tl.TrackCount - 1) + tl.GetTrack(tl.TrackCount - 1).Height
  else
    belowTop := FTlView.RulerHeight;
  DrawGrid(Max(belowTop, FTlView.RulerHeight + 1), h);

  { placeholder for the next channel; clicking it adds one (pbTimelineMouseDown) }
  if FTlMode = 0 then
  begin
    cv.PushClip(Rect(0, FTlView.RulerHeight, w, h));
    try
      titleRect := TlAddChannelRect;
      cv.Brush.Style := bsClear;
      cv.Pen.Style := psSolid;
      cv.Pen.Color := theme.Border;
      cv.Pen.Style := psDash;
      cv.Rectangle(titleRect.Left, titleRect.Top, titleRect.Right, titleRect.Bottom);
      cv.Pen.Style := psSolid;
      cv.Font.Color := theme.SecondaryText;
      cv.TextOut(titleRect.Left + (titleRect.Right - titleRect.Left - cv.TextWidth('+ Add channel')) div 2,
        titleRect.Top + (titleRect.Bottom - titleRect.Top - cv.TextHeight('+ Add channel')) div 2,
        '+ Add channel');
    finally
      cv.PopClip;
    end;
    cv.Brush.Style := bsSolid;
  end;

  { ---- playhead: bold, bright accent line with a drop-triangle on the ruler -
    3px wide (not the hairline every other line in this paint uses) so it
    reads clearly against the grid/waveforms/clip borders at any zoom level,
    matching a real DAW's transport cursor rather than blending into the
    background. }
  playX := FTlView.SecondsToX(tl.PlayheadSeconds);
  if (playX >= FTlView.HeaderWidth) and (playX <= w) then
  begin
    cv.Pen.Width := 2;
    VLine(Round(playX), 0, h, theme.Accent);
    cv.Pen.Width := 1;
    cv.Brush.Color := theme.Accent;
    cv.Pen.Color := theme.Accent;
    cv.Polygon([Point(Round(playX) - 6, 0), Point(Round(playX) + 6, 0), Point(Round(playX), 10)]);
  end;

  { ---- snap guide: a dashed line at the grid position a drag / trim / loop edit is snapping to ---- }
  if FTlSnapGuideOn then
  begin
    x := Round(FTlView.SecondsToX(FTlSnapGuideSec));
    if (x >= FTlView.HeaderWidth) and (x <= w) then
    begin
      cv.Pen.Style := psDash;
      VLine(x, LANE_RULER_H, h, theme.Accent);
      cv.Pen.Style := psSolid;
    end;
  end;

  { ---- range/section selection: dashed boundary lines spanning every
    track, drawn last so they stay visible over clip bodies/waveforms. ---- }
  if FTlRangeActive then
  begin
    rngX1 := FTlView.SecondsToX(FTlRangeStartSec);
    rngX2 := FTlView.SecondsToX(FTlRangeEndSec);
    if (rngX2 >= FTlView.HeaderWidth) and (rngX1 <= w) then
    begin
      cv.Pen.Style := psDash;
      if rngX1 >= FTlView.HeaderWidth then VLine(Round(rngX1), FTlView.RulerHeight, h, theme.Selection);
      if rngX2 <= w then VLine(Round(rngX2), FTlView.RulerHeight, h, theme.Selection);
      cv.Pen.Style := psSolid;
    end;
  end;

  { ---- the picked scene: its start and end shown as coloured lines with handles; Ctrl + drag one to resize ---- }
  begin
    var sc := TlPickedScene;
    if sc <> nil then
    begin
      var sIdx := 0;
      for sIdx := 0 to tl.RegionCount - 1 do
        if tl.GetRegion(sIdx).Id = sc.Id then Break;
      var scCol := TlStageSceneColor(Min(sIdx, tl.RegionCount - 1));
      rngX1 := FTlView.SecondsToX(sc.StartSeconds);
      rngX2 := FTlView.SecondsToX(sc.EndSeconds);
      if (rngX2 >= FTlView.HeaderWidth) and (rngX1 <= w) then
      begin
        cv.Pen.Width := 2;
        if rngX1 >= FTlView.HeaderWidth then
        begin
          VLine(Round(rngX1), FTlView.RulerHeight, h, scCol);
          cv.Brush.Color := scCol;
          cv.FillRect(Rect(Round(rngX1) - 1, FTlView.RulerHeight, Round(rngX1) + 7, FTlView.RulerHeight + 14));
        end;
        if rngX2 <= w then
        begin
          VLine(Round(rngX2), FTlView.RulerHeight, h, scCol);
          cv.Brush.Color := scCol;
          cv.FillRect(Rect(Round(rngX2) - 7, FTlView.RulerHeight, Round(rngX2) + 1, FTlView.RulerHeight + 14));
        end;
        cv.Pen.Width := 1;
      end;
    end;
  end;

  { ---- rubber-band selection rectangle ---- }
  if FTlRubberSelecting then
  begin
    cv.Brush.Style := bsClear;
    cv.Pen.Color := theme.Accent;
    cv.Pen.Style := psDash;
    cv.Rectangle(FTlRubberStartX, FTlRubberStartY, FTlRubberX, FTlRubberY);
    cv.Pen.Style := psSolid;
    cv.Brush.Style := bsSolid;
  end;

  { ---- hover preview: the video frame under the mouse, with its source time ---- }
  if FTlThumbActive and (FTlThumbnailer <> nil) and
     FTlThumbnailer.TryGet(FTlThumbPath, FTlThumbSec, FTlThumbBmp) then
  begin
    var thumbCap := FormatTimecode(FTlThumbSec);
    var thumbW := FTlThumbBmp.Width + 6;
    var thumbH := FTlThumbBmp.Height + cv.TextHeight(thumbCap) + 10;
    var thumbL := FTlThumbX + 14;
    var thumbT := FTlThumbY + 18;
    if thumbL + thumbW > w then thumbL := FTlThumbX - 14 - thumbW;
    if thumbT + thumbH > h then thumbT := FTlThumbY - 12 - thumbH;
    thumbL := Max(thumbL, FTlView.HeaderWidth);
    thumbT := Max(thumbT, 0);
    cv.Brush.Color := theme.PanelBackground;
    cv.Pen.Color := theme.Border;
    cv.Rectangle(thumbL, thumbT, thumbL + thumbW, thumbT + thumbH);
    cv.Draw(thumbL + 3, thumbT + 3, FTlThumbBmp);
    cv.Brush.Style := bsClear;
    cv.Font.Color := theme.Text;
    cv.TextOut(thumbL + 4, thumbT + FTlThumbBmp.Height + 5, thumbCap);
    cv.Brush.Style := bsSolid;
  end;
  end;

end;

{ Fast attack / slow release ballistics for FTlMeterL/R, called once per UI
  tick (~30fps) while FTlPlaying - jumping straight to a new peak reads as a
  flicker on a bar graph, so releases decay 15%/tick instead of snapping to
  the next (possibly much lower) instantaneous peak. }
procedure TfrmMain.UpdateTimelineMeterChannel(var AMeter: Single; APeak: Single);
begin
  if APeak > 1 then APeak := 1
  else if APeak < 0 then APeak := 0;
  if APeak > AMeter then AMeter := APeak
  else AMeter := AMeter * 0.85;
end;

{ Timeline "Out L"/"Out R" level graphs (pbTlMeters, next to the master-vol
  slider). FTlMeterL/FTlMeterR are updated once per UI tick while FTlPlaying
  (see the tmrUITimer block) and pinned to 0 by StopTimelinePlayback, so this
  only moves during playback and goes flat the instant it stops. Painted
  into FTlMeterBuffer and blitted in one shot - the same double-buffer +
  csOpaque trick pbTimelinePaint/pbMixerPaint use - so the 30fps invalidate
  during playback never flickers. }
procedure TfrmMain.pnlTlVideoResize(Sender: TObject);
begin
  if FTlVideo <> nil then FTlVideo.HostResized;
end;

{ A double left-click on the video pane (or on the effect picture over it) pops the video out
  into its own window. Spotted by timing the two presses - the renderer draws straight into
  the pane's window, which is not set up to receive double-click messages. }
procedure TfrmMain.pnlTlVideoMouseDown(Sender: TObject; Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
var
  pt: TPoint;
  now_: UInt64;
begin
  if Button <> mbLeft then Exit;
  pt := TControl(Sender).ClientToScreen(Point(X, Y));
  now_ := GetTickCount64;
  if (ssDouble in Shift) or
     ((FVideoClickTick <> 0) and (now_ - FVideoClickTick <= GetDoubleClickTime) and
      (Abs(pt.X - FVideoClickPos.X) <= GetSystemMetrics(SM_CXDOUBLECLK)) and
      (Abs(pt.Y - FVideoClickPos.Y) <= GetSystemMetrics(SM_CYDOUBLECLK))) then
  begin
    FVideoClickTick := 0;
    TlVideoPopOut;
  end
  else
  begin
    FVideoClickTick := now_;
    FVideoClickPos := pt;
  end;
end;

{ the picture is on screen: in its pane, or in the pop-out window }
function TfrmMain.TlVideoActive: Boolean;
begin
  Result := pnlTlVideo.Visible or ((FVideoWindow <> nil) and FVideoWindow.Visible);
end;

{ the video plays, at its own size, in a window with nothing but a close button }
procedure TfrmMain.TlVideoPopOut;
var
  w, h: Integer;
begin
  if FTlVideo = nil then Exit;
  if FVideoWindow = nil then
  begin
    FVideoWindow := TfrmVideoPlayer.Create(Self);
    FVideoWindow.OnClosed := TlVideoWindowClosed;
    FVideoWindow.OnVideoResized := TlVideoWindowResized;
  end;
  if FVideoWindow.Visible then
  begin
    FVideoWindow.BringToFront;
    Exit;
  end;
  FVideoWindow.Show;
  if FTlVideo.NativeVideoSize(w, h) then FVideoWindow.FitToVideo(w, h);
  FTlVideo.SetHost(FVideoWindow.pnlVideo);
  FTlVideo.HostResized;
end;

procedure TfrmMain.TlVideoWindowClosed(Sender: TObject);
begin
  if FTlVideo <> nil then
  begin
    FTlVideo.SetHost(pnlTlVideo);   // back into the Timeline's own pane
    FTlVideo.HostResized;
  end;
end;

procedure TfrmMain.TlOpenSpectrumWindow;
begin
  if FSpectrumWindow = nil then FSpectrumWindow := TfrmSpectrum.Create(Self);
  if FSpectrumWindow.Visible then
    FSpectrumWindow.BringToFront
  else
    FSpectrumWindow.Show;
end;

procedure TfrmMain.TlVideoWindowResized(Sender: TObject);
begin
  if FTlVideo <> nil then FTlVideo.HostResized;
end;

procedure TfrmMain.pbTlMetersPaint(Sender: TObject);
const
  LABEL_W = 16;
  SEGMENT_COUNT = 20;
  SEGMENT_W = 6;
  SEGMENT_GAP = 1;
  PAD = 2;          // margin round the LEDs
  DEPTH = 3;        // room under the LEDs for their shadow
  UNLIT_COLOR = $00282828;
var
  cv: TGLCanvas;
  w, h, barH, gap, y, bodyH: Integer;
  face: TColor;
  par: TWinControl;

  function Blend(A, B: TColor; T: Double): TColor;
  var
    ca, cb: Integer;
  begin
    ca := ColorToRGB(A);
    cb := ColorToRGB(B);
    Result := RGB(Round(GetRValue(ca) + (GetRValue(cb) - GetRValue(ca)) * T),
      Round(GetGValue(ca) + (GetGValue(cb) - GetGValue(ca)) * T),
      Round(GetBValue(ca) + (GetBValue(cb) - GetBValue(ca)) * T));
  end;

  { Classic LED-ladder meter in a raised housing: a FIXED-size gauge - exactly SEGMENT_COUNT (20)
    blocks, each SEGMENT_W px wide, never stretched to fill the control. Each LED is a little lens:
    a lit one has a glow around it, a bright top edge and a darker underside; an unlit one is
    sunk into the housing. }
  procedure DrawLed(AX0, AY0, AX1, AY1: Integer; ALit: Boolean; AColor: TColor);
  begin
    { each LED casts its own soft shadow - there is no box around the meter }
    cv.Brush.Color := clBlack;
    cv.Alpha := 0.30;
    cv.FillRect(Rect(AX0, AY0 + 1, AX1 + 1, AY1 + 3));
    cv.Alpha := 0.45;
    cv.FillRect(Rect(AX0 + 1, AY0 + 2, AX1 + 1, AY1 + 2));
    cv.Alpha := 1;
    if ALit then
    begin
      { glow spilling onto the housing }
      cv.Brush.Color := AColor;
      cv.Alpha := 0.22;
      cv.FillRect(Rect(AX0 - 1, AY0 - 1, AX1 + 1, AY1 + 1));
      cv.Alpha := 1;
      cv.GradientRect(Rect(AX0, AY0, AX1, AY1), Blend(AColor, clWhite, 0.45), Blend(AColor, clBlack, 0.35));
      cv.Brush.Color := clWhite;
      cv.Alpha := 0.55;
      cv.FillRect(Rect(AX0, AY0, AX1, AY0 + 1));
      cv.Alpha := 1;
    end
    else
    begin
      cv.GradientRect(Rect(AX0, AY0, AX1, AY1), Blend(UNLIT_COLOR, clBlack, 0.55), UNLIT_COLOR);
      cv.Brush.Color := clWhite;
      cv.Alpha := 0.10;
      cv.FillRect(Rect(AX0, AY1 - 1, AX1, AY1));   // the lip catching light under the recess
      cv.Alpha := 1;
    end;
  end;

  procedure DrawBar(const ALabel: string; ALevel: Single; AY: Integer);
  var
    litCount, i, segX0: Integer;
    segColor: TColor;
  begin
    cv.Brush.Style := bsClear;
    cv.Font.Color := clSilver;
    cv.TextOut(PAD + 2, AY + (barH - cv.TextHeight(ALabel)) div 2, ALabel);
    cv.Brush.Style := bsSolid;
    cv.Pen.Style := psClear;
    litCount := Round(ALevel * SEGMENT_COUNT);
    for i := 0 to SEGMENT_COUNT - 1 do
    begin
      segX0 := PAD + LABEL_W + i * (SEGMENT_W + SEGMENT_GAP);
      if i >= SEGMENT_COUNT - 2 then segColor := clRed
      else if i >= SEGMENT_COUNT - 5 then segColor := clYellow
      else segColor := clLime;
      DrawLed(segX0, AY, segX0 + SEGMENT_W, AY + barH, i < litCount, segColor);
    end;
  end;

begin
  w := pbTlMeters.Width;
  h := pbTlMeters.Height;
  if (w <= 0) or (h <= 0) then Exit;
  cv := pbTlMeters.GL;
  cv.Brush.Style := bsSolid;
  cv.Pen.Style := psClear;
  { the meter has no background of its own: this is only the colour the strip behind it is painted
    with (the active style's face colour, or the colour of the panel it sits on), so nothing shows }
  if not GLParentBackdrop(pbTlMeters, face) then
  begin
    face := ColorToRGB(StyleServices.GetSystemColor(clBtnFace));
    par := pbTlMeters.Parent;
    while par <> nil do
    begin
      if (par is TGLPanel) and (TGLPanel(par).Color <> clBtnFace) then
      begin
        face := ColorToRGB(StyleServices.GetSystemColor(TGLPanel(par).Color));
        Break;
      end;
      par := par.Parent;
    end;
  end;
  cv.Brush.Color := face;
  cv.FillRect(Rect(0, 0, w, h));
  bodyH := h - DEPTH;
  gap := 2;
  barH := (bodyH - 2 * PAD - gap) div 2;
  if barH > 0 then
  begin
    y := PAD;
    DrawBar('L', FTlMeterL, y);
    Inc(y, barH + gap);
    DrawBar('R', FTlMeterR, y);
  end;
end;

{ One master-output spectrum (log frequency, 0..-90 dB) filling ARect - the
  Timeline's header-column corner. Follows the mixer because the tap is the
  engine's post-mixer output. Flat while not playing. }
procedure TfrmMain.DrawTimelineSpectrum(ACanvas: TGLCanvas; const ARect: TRect);
const
  MIN_HZ = 30.0;
  TOP_DB = 0.0;
  BOT_DB = -90.0;
var
  w, h, x, n, bin, prevBin, b: Integer;
  nyq, hz0, hz1, db, mx: Double;
begin
  w := ARect.Right - ARect.Left;
  h := ARect.Bottom - ARect.Top;
  if (w < 8) or (h < 4) then Exit;
  ACanvas.Brush.Color := clBlack;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.FillRect(ARect);
  n := Length(FTlSpecDb);
  if (not FTlSpecActive) or (n < 2) or (FTlSpecRate <= 0) then Exit;
  nyq := FTlSpecRate / 2;
  ACanvas.Pen.Style := psSolid;
  ACanvas.Pen.Color := clLime;
  prevBin := 0;
  for x := 0 to w - 1 do
  begin
    hz0 := MIN_HZ * FastExp(FastLn(nyq / MIN_HZ) * x / w);
    hz1 := MIN_HZ * FastExp(FastLn(nyq / MIN_HZ) * (x + 1) / w);
    bin := Round(hz0 / nyq * (n - 1));
    b := Round(hz1 / nyq * (n - 1));
    if bin < prevBin then bin := prevBin;
    if b < bin then b := bin;
    if b > n - 1 then b := n - 1;
    if bin > n - 1 then bin := n - 1;
    mx := BOT_DB;
    for prevBin := bin to b do
    begin
      db := FTlSpecDb[prevBin];
      if db > mx then mx := db;
    end;
    prevBin := b;
    if mx > TOP_DB then mx := TOP_DB;
    b := Round((mx - BOT_DB) / (TOP_DB - BOT_DB) * (h - 1));
    if b > 0 then
    begin
      ACanvas.MoveTo(ARect.Left + x, ARect.Bottom - 1);
      ACanvas.LineTo(ARect.Left + x, ARect.Bottom - 1 - b);
    end;
  end;
end;

function SlicePlanarLocal(const ASrc: TAudioPlanar; AStart, ACount: Integer): TAudioPlanar;
var
  ch, i: Integer;
begin
  SetLength(Result, Length(ASrc));
  for ch := 0 to High(ASrc) do
  begin
    SetLength(Result[ch], ACount);
    for i := 0 to ACount - 1 do
      Result[ch][i] := ASrc[ch][AStart + i];
  end;
end;

{ Live recording: the audio callback feeds a bounded ring; the dedicated writer
  drains and finalizes the take before the UI commits it to the timeline. }

function TfrmMain.BuildRecordSettings: TRecordSettings;
begin
  Result := TRecordSettings.Default;
  Result.SampleRate := App.Audio.Granted.SampleRate;
  Result.Channels := App.Audio.Granted.CaptureChannels;
  if Result.Channels = 1 then Result.ChannelMode := rcmMono
  else if Result.Channels = 2 then Result.ChannelMode := rcmStereo
  else Result.ChannelMode := rcmMultichannel;
  case cboRecFormat.ItemIndex of
    1: Result.TakeFormat := wsfPCM24;
    2: Result.TakeFormat := wsfPCM16;
  else Result.TakeFormat := wsfFloat32;
  end;

  Result.InputMonitoring := chkRecMonitor.Checked;
  Result.MonitorGainDb := 0;

  Result.PreRollSeconds := Max(0, StrToFloatDef(Trim(edtRecPreRoll.Text), 0));
  Result.CountInBeats := Max(0, StrToIntDef(Trim(edtRecCountIn.Text), 0));
  if FProject <> nil then Result.TempoBPM := FProject.TempoBPM
  else Result.TempoBPM := 120;

  case cboRecPunch.ItemIndex of
    1: Result.PunchMode := pmPunchIn;
    2: Result.PunchMode := pmPunchInOut;
  else Result.PunchMode := pmOff;
  end;
  Result.PunchInSeconds := Max(0, StrToFloatDef(Trim(edtRecPunchIn.Text), 0));
  Result.PunchOutSeconds := Max(0, StrToFloatDef(Trim(edtRecPunchOut.Text), 0));

  Result.LoopRecord := chkRecLoop.Checked;
  Result.LoopStartSeconds := Max(0, StrToFloatDef(Trim(edtRecLoopStart.Text), 0));
  Result.LoopEndSeconds := Max(0, StrToFloatDef(Trim(edtRecLoopEnd.Text), 0));

  Result.Validate;
end;

function TfrmMain.RecordingRootPath: string;
begin
  Result := Trim(App.Config.GetString(CFG_SEC_PATHS, CFG_PATH_RECORDINGS, ''));
  { Recorded/generated audio is real user content that outlives the session -
    it must not default into Cache, which the OS or a cleanup tool can
    legitimately purge out from under a project that still references it. }
  if Result = '' then Result := IncludeTrailingPathDelimiter(App.Paths.Data) + 'recordings';
end;

function TfrmMain.RecordingPosition: Double;
begin
  Result := 0;
  if FProject = nil then Exit;
  if FTlRangeActive then Result := Max(0, FTlRangeStartSec)
  else Result := Max(0, FRecInsertSeconds);
end;

procedure TfrmMain.cboRecPunchChange(Sender: TObject);
var
  on_: Boolean;
begin
  on_ := cboRecPunch.ItemIndex > 0;
  edtRecPunchIn.Enabled := on_;
  edtRecPunchOut.Enabled := cboRecPunch.ItemIndex = 2;
end;

procedure TfrmMain.chkRecLoopClick(Sender: TObject);
begin
  edtRecLoopStart.Enabled := chkRecLoop.Checked;
  edtRecLoopEnd.Enabled := chkRecLoop.Checked;
end;

procedure TfrmMain.btnRecArmClick(Sender: TObject);
var
  settings: TRecordSettings;
begin
  if FRecWriter <> nil then
  begin
    StopLiveRecording;
    Exit;
  end;
  if (App = nil) or (App.Audio = nil) or (FProject = nil) then Exit;
  if (FRec.TakeCount > 0) and not FRecCommitted then
  begin
    MessageDlg('Add the pending take to the timeline before starting another recording.', mtInformation, [mbOK], 0);
    Exit;
  end;
  try
    if (App.Audio.Granted.CaptureChannels <= 0) or
       (Pos('software', LowerCase(App.Audio.BackendName)) > 0) then
      RaiseUDAW(errInvalidState, 'Recording',
        'Select a real input device and enable capture in Settings, then reopen Audio.');
    if App.Audio.State <> aesRunning then App.Audio.Start;
    if App.Audio.State <> aesRunning then
      RaiseUDAW(errInvalidState, 'Recording', 'The input device is not running.');
    if FTlPlaying then btnTlStopClick(nil);
    settings := BuildRecordSettings;
    App.Audio.Stop;
    FRec.Disarm;
    if not SameText(FRec.RecordingRoot, RecordingRootPath) then
    begin
      FreeAndNil(FRec);
      FRec := TRecordingEngine.Create(RecordingRootPath);
      FreeAndNil(FRecovery2);
      FRecovery2 := TRecordingRecovery.Create(RecordingRootPath);
    end;
    FRec.ClearTakes;
    FRec.Configure(settings);
    FRec.Arm;
    FRecTrackId := TlArmedAudioTrackId;   // a track armed with its header R button wins
    if FRecTrackId = 0 then FRecTrackId := Max(0, TlSelectedAudioTrackId);
    FRecCommitted := False;
    FRec.Start(RecordingPosition);
    FRecRing := TAudioRing.Create(settings.Channels, settings.SampleRate * 4);
    FRecWriter := TRecordingWriterThread.Create(FRec, FRecRing);
    App.Audio.SetCaptureRing(FRecRing);
    App.Audio.SetInputMonitoring(settings.InputMonitoring, settings.MonitorGainDb);
    FRecStarted := GetTickCount64;
    FSyncProgressActive := True;
    App.Audio.Start;
    if App.Audio.State <> aesRunning then
      RaiseUDAW(errInvalidState, 'Recording', 'Could not start the input device.');
    RefreshRecordingTab;
  except
    on E: Exception do
    begin
      if FRecWriter <> nil then StopLiveRecording
      else FreeAndNil(FRecRing);
      FSyncProgressActive := False;
      memRec.Lines.Text := 'Recording failed: ' + E.Message;
      MessageDlg(memRec.Lines.Text, mtError, [mbOK], 0);
    end;
  end;
end;

procedure TfrmMain.StopLiveRecording;
var
  captureError: string;
  overruns: Integer;
begin
  if FRecWriter = nil then Exit;
  captureError := '';
  App.Audio.Stop; { quiesce producer before final drain and ring release }
  App.Audio.SetCaptureRing(nil);
  App.Audio.SetInputMonitoring(False);
  ShowStatusProgress('Finishing recording: draining and saving complete audio...', 3);
  try
    FRecWriter.Stop;
    captureError := FRecWriter.LastError;
    overruns := FRecWriter.RingOverruns;
    if overruns > 0 then
      captureError := captureError + Format(' Capture buffer overflow (%d); audio was lost.', [overruns]);
    FreeAndNil(FRecWriter);
    FreeAndNil(FRecRing);
    UpdateStatusProgress(1, 'Finishing recording: saving complete take...');
    UpdateStatusProgress(2, 'Adding recording to the timeline...');
    if FRec.TakeCount > 0 then btnRecCommitClick(nil)
    else if App.Audio.CaptureMismatchCount > 0 then
      captureError := captureError + Format(
        ' No audio frames were received: the input device''s channel count changed ' +
        'after arming (%d block(s) dropped) - re-arm the recording.', [App.Audio.CaptureMismatchCount])
    else
      captureError := captureError + ' No audio frames were received.';
    UpdateStatusProgress(3, 'Recording saved.');
  except
    on E: Exception do captureError := captureError + ' ' + E.Message;
  end;
  HideStatusProgress;
  RefreshRecordingTab;
  if captureError <> '' then
  begin
    memRec.Lines.Insert(0, 'Recording needs attention: ' + captureError);
    Logger.Error('Recording', captureError);
    MessageDlg('Recording needs attention: ' + captureError, mtWarning, [mbOK], 0);
  end;
  App.Audio.Start;
end;

procedure TfrmMain.btnRecSavedClick(Sender: TObject);
var
  trackId: Integer;
begin
  if (FRecWriter <> nil) or (FProject = nil) then Exit;
  dlgRecSaved.InitialDir := RecordingRootPath;
  if not dlgRecSaved.Execute then Exit;
  trackId := TlSelectedAudioTrackId;
  if trackId < 0 then trackId := TlNewAudioTrackId;
  if ImportBrowserFileToTimeline(dlgRecSaved.FileName, trackId, RecordingPosition) then
    RefreshTimelineTab
  else MessageDlg('Audio could not be imported. See the Timeline readout for details.', mtError, [mbOK], 0);
end;

procedure TfrmMain.btnRecCommitClick(Sender: TObject);
var
  lane: TTakeLane;
  comp: TTakeComp;
  cmd: TCommitTakeCommand;
  clip: TTimelineClip;
  specs: TRecordedClipSpecArray;
  i: Integer;
begin
  if (FRec = nil) or (FProject = nil) or (FRecWriter <> nil) or FRecCommitted then Exit;
  if FRec.TakeCount = 0 then
  begin
    memRec.Lines.Insert(0, 'record a take first');
    Exit;
  end;
  lane := TTakeLane.Create('Recorded');
  comp := nil;
  try
    for i := 0 to FRec.TakeCount - 1 do
      lane.AddTake(FRec.GetTake(i));
    comp := TTakeComp.Create(lane);
    { commit every take as its own clip so stacked loop passes are all visible }
    SetLength(specs, FRec.TakeCount);
    for i := 0 to FRec.TakeCount - 1 do
    begin
      specs[i].SourceWavFile := FRec.GetTake(i).WavFile;
      specs[i].SampleRate := FRec.GetTake(i).SampleRate;
      specs[i].Channels := FRec.GetTake(i).Channels;
      specs[i].SourceFrameCount := FRec.GetTake(i).FrameCount;
      specs[i].Name := FRec.GetTake(i).Name;
      specs[i].TimelineStartSeconds := FRec.GetTake(i).TimelineStartSeconds;
      specs[i].SourceOffsetSeconds := 0;
      specs[i].LengthSeconds := FRec.GetTake(i).LengthSeconds;
    end;
    cmd := TCommitTakeCommand.Create(FProject, FRecTrackId, specs, 'Recorded');
    FCmds.Perform(cmd);
    FRecCommitted := True;
    if Length(cmd.ClipIds) > 0 then
    begin
      TlSetSingleSelection(cmd.ClipIds[0]);
      clip := FProject.Timeline.ClipById(cmd.ClipIds[0]);
      if clip <> nil then
      begin
        if cmd.CreatedTrackId > 0 then FTlSelectedTrackId := cmd.CreatedTrackId
        else FTlSelectedTrackId := FRecTrackId;
        FTlView.EnsureVisible(clip.StartSeconds);
        WarmClipWaveform(clip.SourceId);
      end;
    end;
    Logger.Info('ui', Format('committed %d recorded clip(s) to the timeline', [Length(specs)]));
    RefreshRecordingTab;
    RefreshTimelineTab;
  finally
    comp.Free;
    lane.Free;
  end;
end;

{ Copies the selected take's own WAV file to a user-chosen path - independent
  of the timeline entirely. A plain stream copy, not a re-encode: the take's
  WavFile is already a complete, valid WAV written by the recording engine. }
procedure TfrmMain.btnRecSaveTakeClick(Sender: TObject);
var
  idx: Integer;
  tk: TRecordedTake;
  src, dst: TFileStream;
begin
  if not RequireRegistration('Exporting a recorded take') then Exit;
  if (FRec = nil) or (FRecWriter <> nil) then Exit;
  idx := RecSelectedTakeIndex;
  if idx < 0 then
  begin
    memRec.Lines.Insert(0, 'Select a take above first.');
    Exit;
  end;
  tk := FRec.GetTake(idx);
  if (tk.WavFile = '') or not FileExists(tk.WavFile) then
  begin
    memRec.Lines.Insert(0, 'Selected take has no recorded audio file to save.');
    Exit;
  end;
  dlgRecSaveTake.InitialDir := RecordingRootPath;
  dlgRecSaveTake.FileName := tk.Name;
  if not dlgRecSaveTake.Execute then Exit;
  try
    src := TFileStream.Create(tk.WavFile, fmOpenRead or fmShareDenyWrite);
    try
      dst := TFileStream.Create(dlgRecSaveTake.FileName, fmCreate);
      try
        dst.CopyFrom(src, 0);
      finally
        dst.Free;
      end;
    finally
      src.Free;
    end;
    memRec.Lines.Insert(0, 'Saved take to: ' + dlgRecSaveTake.FileName);
  except
    on E: Exception do
      memRec.Lines.Insert(0, 'Save FAILED: ' + E.Message);
  end;
end;

{ Adds just the selected take to the timeline as its own clip, at the take's
  own TimelineStartSeconds (the position it was actually captured at) - unlike
  btnRecCommitClick, which commits every take in the current session at once. }
procedure TfrmMain.btnRecAddTakeToTimelineClick(Sender: TObject);
var
  idx, trackId: Integer;
  tk: TRecordedTake;
begin
  if (FRec = nil) or (FProject = nil) or (FRecWriter <> nil) then Exit;
  idx := RecSelectedTakeIndex;
  if idx < 0 then
  begin
    memRec.Lines.Insert(0, 'Select a take above first.');
    Exit;
  end;
  tk := FRec.GetTake(idx);
  if (tk.WavFile = '') or not FileExists(tk.WavFile) then
  begin
    memRec.Lines.Insert(0, 'Selected take has no recorded audio file to add.');
    Exit;
  end;
  trackId := FRecTrackId;
  if trackId <= 0 then trackId := TlSelectedAudioTrackId;
  if trackId < 0 then trackId := TlNewAudioTrackId;
  if ImportBrowserFileToTimeline(tk.WavFile, trackId, tk.TimelineStartSeconds) then
  begin
    memRec.Lines.Insert(0, Format('Added take "%s" to the timeline at %.3f s.',
      [tk.Name, tk.TimelineStartSeconds]));
    RefreshTimelineTab;
  end
  else
    memRec.Lines.Insert(0, 'Add to timeline FAILED. See the Timeline readout for details.');
end;

procedure TfrmMain.btnRecScanClick(Sender: TObject);
var
  pending, recovered: TRecordedTakeArray;
  outDir: string;
  i: Integer;
begin
  if (FRecovery2 = nil) or (FRecWriter <> nil) then Exit;
  FreeAndNil(FRecovery2);
  FRecovery2 := TRecordingRecovery.Create(RecordingRootPath);
  pending := FRecovery2.ScanUnfinished;
  if Length(pending) = 0 then
  begin
    memRec.Lines.Text := 'No unfinished takes found - nothing to recover.';
    Exit;
  end;
  outDir := IncludeTrailingPathDelimiter(RecordingRootPath) + 'Recovered';
  recovered := FRecovery2.RecoverAll(outDir);
  memRec.Lines.Clear;
  memRec.Lines.Add(Format('Recovered %d unfinished take(s) into:', [Length(recovered)]));
  memRec.Lines.Add('  ' + outDir);
  for i := 0 to High(recovered) do
    memRec.Lines.Add('  ' + recovered[i].Describe);
  Logger.Info('ui', Format('recording recovery: %d take(s) rebuilt', [Length(recovered)]));
end;

procedure TfrmMain.RefreshRecordingTab;
var
  sb: TStringBuilder;
  i: Integer;
begin
  if FRec = nil then Exit;
  if (App <> nil) and (App.Audio <> nil) and
     (App.Audio.State = aesRunning) and (App.Audio.Granted.CaptureChannels > 0) and
     (Pos('software', LowerCase(App.Audio.BackendName)) = 0) then
  begin
    if FRecWriter <> nil then
      lblRecMicState.Caption := 'Microphone: ON | Recording: ON'
    else
      lblRecMicState.Caption := 'Microphone: ON | Recording: OFF';
    lblRecMicState.Hint := App.Audio.Granted.CaptureDeviceName;
  end
  else
    lblRecMicState.Caption := 'Microphone: OFF | Recording: OFF';
  btnRecSaved.Enabled := FRecWriter = nil;
  btnRecScan.Enabled := FRecWriter = nil;
  cboRecFormat.Enabled := FRecWriter = nil;
  cboRecPunch.Enabled := FRecWriter = nil;
  chkRecLoop.Enabled := FRecWriter = nil;
  chkRecMonitor.Enabled := FRecWriter = nil;
  edtRecPreRoll.Enabled := FRecWriter = nil;
  edtRecCountIn.Enabled := FRecWriter = nil;
  if FRecWriter = nil then
  begin
    { restore each edit's own enabled state from its combo/checkbox, rather
      than force-enabling ones that should stay greyed out (e.g. punch-out
      when punch mode is "Punch-in" only). }
    cboRecPunchChange(nil);
    chkRecLoopClick(nil);
  end
  else
  begin
    edtRecPunchIn.Enabled := False;
    edtRecPunchOut.Enabled := False;
    edtRecLoopStart.Enabled := False;
    edtRecLoopEnd.Enabled := False;
  end;
  if FRecWriter <> nil then
  begin
    btnRecArm.Caption := 'Stop and add to timeline';
    mnuRecArm.Caption := btnRecArm.Caption;
    pmRecArm.Caption := btnRecArm.Caption;
    btnRecCommit.Enabled := False;
    mnuRecCommit.Enabled := False;
    pmRecCommit.Enabled := False;
    btnRecSaveTake.Enabled := False;
    btnRecAddTakeToTimeline.Enabled := False;
    lblRecDestination.Caption := Format('Capturing %.1f s | %d Hz | %d channels | target track %d',
      [FRecWriter.FramesConsumed / FRec.Settings.SampleRate, FRec.Settings.SampleRate,
       FRec.Settings.Channels, FRecTrackId]);
    stbMain.SimpleText := lblRecDestination.Caption;
    Exit; { no access to takes while the writer owns the engine }
  end;
  btnRecArm.Caption := 'Start live recording';
  mnuRecArm.Caption := btnRecArm.Caption;
  pmRecArm.Caption := btnRecArm.Caption;
  lblRecDestination.Caption := Format('Insert at %.3f s. Selected audio track, or a new track. Full input until Stop.', [RecordingPosition]);
  mnuRecCommit.Enabled := (FRec.TakeCount > 0) and not FRecCommitted;
  btnRecCommit.Enabled := mnuRecCommit.Enabled;
  pmRecCommit.Enabled := mnuRecCommit.Enabled;
  btnRecSaveTake.Enabled := RecSelectedTakeIndex >= 0;
  btnRecAddTakeToTimeline.Enabled := btnRecSaveTake.Enabled;

  sb := TStringBuilder.Create;
  try
    sb.AppendLine(FRec.Describe);
    if (FRecovery2 <> nil) and FRecovery2.HasUnfinishedTakes then
      sb.AppendLine(#10'** unfinished take container(s) present - press "Scan for recovery" **');
    if FProject <> nil then
    begin
      sb.AppendLine('');
      sb.AppendLine(Format('project timeline: %d track(s), %d clip(s)',
        [FProject.Timeline.TrackCount, FProject.Timeline.ClipCountTotal]));
    end;
    for i := 0 to FRec.TakeCount - 1 do
      if FRec.GetTake(i).WavFile <> '' then
        sb.AppendLine('  wav: ' + FRec.GetTake(i).WavFile);
    memRec.Lines.Text := sb.ToString;
  finally
    sb.Free;
  end;
  pbRecTakes.Invalidate;
end;

{ Paints into FRecBuffer and blits it in one shot instead of drawing every
  take rectangle straight to the screen DC - this box is invalidated at
  near-frame rate by tmrUI while recording (see RefreshRecordingTab), and
  drawing directly flickered badly; mirrors pbMixerPaint and
  pbMixerPaint/FMixBuffer. FRecTakeRects/FRecTakeIds are rebuilt on every
  paint so pbRecTakesMouseDown can hit-test a click against the take actually
  on screen right now, exactly like FMixStripRects. }
procedure TfrmMain.pbRecTakesPaint(Sender: TObject);
var
  cv: TGLCanvas;
  w, h, i, y, x1, x2: Integer;
  span, s: Double;
  tk: TRecordedTake;
  selected: Boolean;
begin
  w := pbRecTakes.Width;
  h := pbRecTakes.Height;
  if (w <= 0) or (h <= 0) then Exit;
  cv := pbRecTakes.GL;
  cv.Brush.Color := $00202020;
  cv.Brush.Style := bsSolid;
  cv.FillRect(Rect(0, 0, w, h));
  SetLength(FRecTakeRects, 0);
  SetLength(FRecTakeIds, 0);
  if FRecWriter <> nil then
  begin
    Exit;
  end;
  if (FRec = nil) or (FRec.TakeCount = 0) then
  begin
    cv.Brush.Style := bsClear;
    cv.Font.Color := $00A0A0A0;
    cv.TextOut(10, 10, 'Select a timeline destination, then start live recording or add saved audio.');
    Exit;
  end;

  span := 1.0;
  for i := 0 to FRec.TakeCount - 1 do
  begin
    tk := FRec.GetTake(i);
    s := tk.TimelineStartSeconds + tk.LengthSeconds;
    if s > span then span := s;
  end;
  span := span * 1.05;

  cv.Brush.Style := bsClear;
  cv.Font.Color := $00808080;
  cv.TextOut(4, 2, Format('0 s', []));
  cv.TextOut(w - 48, 2, Format('%.2f s', [span]));

  { Ctrl+drag highlighted region, behind the takes }
  if FRecRegionActive then
  begin
    cv.Brush.Style := bsSolid;
    cv.Brush.Color := $00584838;
    cv.FillRect(Rect(Min(FRecRegionX0, FRecRegionX1), 0,
      Max(FRecRegionX0, FRecRegionX1), h));
  end;

  SetLength(FRecTakeRects, FRec.TakeCount);
  SetLength(FRecTakeIds, FRec.TakeCount);
  for i := 0 to FRec.TakeCount - 1 do
  begin
    tk := FRec.GetTake(i);
    FRecTakeIds[i] := tk.Id;
    y := 22 + i * 26;
    if y > h - 52 then
    begin
      FRecTakeRects[i] := Rect(0, 0, 0, 0);
      Continue;
    end;
    x1 := Round(tk.TimelineStartSeconds / span * (w - 12)) + 6;
    x2 := Round((tk.TimelineStartSeconds + tk.LengthSeconds) / span * (w - 12)) + 6;
    if x2 <= x1 then x2 := x1 + 1;
    FRecTakeRects[i] := Rect(x1, y, x2, y + 20);
    selected := (FRecSelectedTakeId <> '') and (tk.Id = FRecSelectedTakeId);
    cv.Brush.Style := bsSolid;
    if selected then cv.Brush.Color := $006A8AC0 else cv.Brush.Color := $00505A78;
    cv.Pen.Color := IfThen(selected, $00D0E0FF, $0090A8D0);
    cv.Pen.Width := IfThen(selected, 2, 1);
    cv.Rectangle(x1, y, x2, y + 20);
    cv.Pen.Width := 1;
    cv.Brush.Style := bsClear;
    cv.Font.Color := $00F0F0F0;
    cv.TextOut(x1 + 4, y + 3, Format('%s  (%.2f s, pass %d)',
      [tk.Name, tk.LengthSeconds, tk.PassIndex]));
  end;
  { comp lane (the swipe-comp result) and the swipe in progress }
  EnsureComp;
  FRecSpan := span;
  if FComp <> nil then
  begin
    y := h - 26;
    cv.Brush.Style := bsClear;
    cv.Font.Color := $00A0A0A0;
    cv.TextOut(4, y - 16, 'Comp (swipe across a take to choose it for that stretch):');
    for i := 0 to FComp.SegmentCount - 1 do
    begin
      x1 := Round(FComp.GetSegment(i).StartSeconds / span * (w - 12)) + 6;
      x2 := Round(FComp.GetSegment(i).EndSeconds / span * (w - 12)) + 6;
      if x2 <= x1 then x2 := x1 + 1;
      cv.Brush.Style := bsSolid;
      cv.Brush.Color := TColor($00405060 + (FComp.GetSegment(i).TakeIndex mod 5) * $00181008);
      cv.Pen.Color := $0090D0A0;
      cv.Rectangle(x1, y, x2, y + 20);
      cv.Brush.Style := bsClear;
      cv.Font.Color := $00F0F0F0;
      cv.TextOut(x1 + 4, y + 3, Format('take %d', [FComp.GetSegment(i).TakeIndex + 1]));
    end;
  end;
  if FCompSwipeOn then
  begin
    cv.Brush.Style := bsClear;
    cv.Pen.Color := $0040E0FF;
    cv.Pen.Width := 2;
    cv.Rectangle(Min(FCompSwipeX0, FCompSwipeX1), 20, Max(FCompSwipeX0, FCompSwipeX1), h - 4);
    cv.Pen.Width := 1;
  end;
end;

{ Click-to-select a take, so "Save Selected Take As..." / "Add Selected Take
  to Timeline" have something to act on. Clicking empty space clears the
  selection, matching the Mixer strip picker's click-to-select/click-away
  behaviour. }
procedure TfrmMain.pbRecTakesMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  i: Integer;
  hit: string;
begin
  hit := '';
  FCompSwipeOn := False;
  FRecRegionActive := False;
  if (Button = mbLeft) and (ssCtrl in Shift) then
  begin
    FRecRegionDragging := True;
    FRecRegionX0 := X;
    FRecRegionX1 := X;
    pbRecTakes.Invalidate;
    Exit;
  end;
  for i := 0 to High(FRecTakeRects) do
    if PtInRect(FRecTakeRects[i], Point(X, Y)) then
    begin
      hit := FRecTakeIds[i];
      { start a comp swipe on this take row }
      FCompSwipeOn := True;
      FCompSwipeTake := i;
      FCompSwipeX0 := X;
      FCompSwipeX1 := X;
      Break;
    end;
  if hit <> FRecSelectedTakeId then
  begin
    FRecSelectedTakeId := hit;
    RefreshRecordingTab;
  end;
end;

{ ---- Comping: swipe across a take row to make that stretch of the comp play
  from that take (Pro-Tools/Logic style), see UDAW.Recording.Takes.TTakeComp.
  The comp lane is drawn under the takes; "Commit Comp to Timeline" turns the
  comp into one undoable clip per segment. }
procedure TfrmMain.EnsureComp;
var
  i: Integer;
begin
  if (FRec = nil) or (FRec.TakeCount = 0) then
  begin
    FreeAndNil(FComp);
    FreeAndNil(FCompLane);
    FCompTakeCount := 0;
    Exit;
  end;
  if (FComp <> nil) and (FCompTakeCount = FRec.TakeCount) then Exit;
  FreeAndNil(FComp);
  FreeAndNil(FCompLane);
  FCompLane := TTakeLane.Create('Comp');
  for i := 0 to FRec.TakeCount - 1 do
    FCompLane.AddTake(FRec.GetTake(i));
  FComp := TTakeComp.Create(FCompLane);
  FCompTakeCount := FRec.TakeCount;
end;

function TfrmMain.RecXToSeconds(X: Integer): Double;
begin
  if pbRecTakes.Width <= 12 then Exit(0);
  Result := (X - 6) / (pbRecTakes.Width - 12) * FRecSpan;
end;

procedure TfrmMain.pbRecTakesMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
begin
  if FRecRegionDragging then
  begin
    FRecRegionX1 := X;
    FRecRegionActive := Abs(FRecRegionX1 - FRecRegionX0) >= 3;
    pbRecTakes.Invalidate;
    Exit;
  end;
  if FCompSwipeOn then
  begin
    FCompSwipeX1 := X;
    pbRecTakes.Invalidate;
  end;
end;

procedure TfrmMain.pbRecTakesMouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  t0, t1: Double;
begin
  if FRecRegionDragging then
  begin
    FRecRegionDragging := False;
    Exit;
  end;
  if not FCompSwipeOn then Exit;
  FCompSwipeOn := False;
  FCompSwipeX1 := X;
  if Abs(FCompSwipeX1 - FCompSwipeX0) >= 6 then
  begin
    EnsureComp;
    if FComp <> nil then
    begin
      t0 := RecXToSeconds(Min(FCompSwipeX0, FCompSwipeX1));
      t1 := RecXToSeconds(Max(FCompSwipeX0, FCompSwipeX1));
      FComp.SetActiveTake(t0, t1, FCompSwipeTake);
      memRec.Lines.Insert(0, Format('Comp: %.2f-%.2f s now plays from take %d.',
        [t0, t1, FCompSwipeTake + 1]));
    end;
  end;
  pbRecTakes.Invalidate;
end;

procedure TfrmMain.btnRecResetCompClick(Sender: TObject);
begin
  EnsureComp;
  if FComp <> nil then
  begin
    FComp.Reset;
    memRec.Lines.Insert(0, 'Comp reset to take 1 for the whole lane.');
  end;
  pbRecTakes.Invalidate;
end;

procedure TfrmMain.btnRecCommitCompClick(Sender: TObject);
var
  specs: TRecordedClipSpecArray;
  i, trackId: Integer;
  tl: TTimeline;
  src: TMediaSource;
  srcIds: TDictionary<string, Integer>;
  srcId: Integer;
begin
  if (FRec = nil) or (FProject = nil) or (FRecWriter <> nil) then Exit;
  EnsureComp;
  if FComp = nil then
  begin
    memRec.Lines.Insert(0, 'Comp: no takes to comp yet.');
    Exit;
  end;
  specs := FComp.FlattenToClipSpecs;
  if Length(specs) = 0 then
  begin
    memRec.Lines.Insert(0, 'Comp: no segment has a recorded audio file.');
    Exit;
  end;
  trackId := FRecTrackId;
  if trackId <= 0 then trackId := TlSelectedAudioTrackId;
  if trackId < 0 then trackId := TlNewAudioTrackId;
  tl := FProject.Timeline;
  srcIds := TDictionary<string, Integer>.Create;
  try
    for i := 0 to High(specs) do
    begin
      if not srcIds.TryGetValue(specs[i].SourceWavFile, srcId) then
      begin
        src := tl.AddSource(specs[i].SourceWavFile, specs[i].SampleRate,
          specs[i].Channels, specs[i].SourceFrameCount);
        srcId := src.Id;
        srcIds.Add(specs[i].SourceWavFile, srcId);
      end;
      FCmds.Perform(TAddTimelineClipCommand.Create(FProject, trackId, srcId,
        specs[i].Name, specs[i].TimelineStartSeconds, specs[i].SourceOffsetSeconds,
        specs[i].LengthSeconds));
    end;
  finally
    srcIds.Free;
  end;
  memRec.Lines.Insert(0, Format('Comp committed: %d clip(s) added to the timeline (undoable).', [Length(specs)]));
  RefreshTimelineTab;
end;

function TfrmMain.RecSelectedTakeIndex: Integer;
var
  i: Integer;
begin
  Result := -1;
  if (FRec = nil) or (FRecSelectedTakeId = '') then Exit;
  for i := 0 to FRec.TakeCount - 1 do
    if FRec.GetTake(i).Id = FRecSelectedTakeId then
      Exit(i);
end;

{ ================= Mixer tab ================= }

function TfrmMain.SelectedMixStripId: Integer;
begin
  Result := 0;
  if (cboMixStrip.ItemIndex >= 0) then
    Result := Integer(NativeInt(cboMixStrip.Items.Objects[cboMixStrip.ItemIndex]));
end;

{ TfrmMixInsertParams only understands an insert's own Kind/Params text (see
  its header comment) - it knows nothing about TMixInsert.SidechainStripId,
  a separate model field the engine reads to key a dynamics insert off
  another strip's post-fader signal (UDAW.Mixer.Engine.ProcessStrip step 5).
  Rather than add a whole new designer control + strip-picker to that shared
  dialog for one field, a strip id typed as an ordinary "sidechain=<id>" row
  is recognised as a pseudo-param here, pulled back out of AParams before it
  is ever stored as a real DSP node param, and applied separately via
  TSetMixInsertSidechainCommand. Returns -1 (not 0) when no such row was
  present, so callers can tell "leave it alone" apart from "explicitly
  cleared to none" (sidechain=0). }
function TfrmMain.ExtractSidechainParam(var AParams: string): Integer;
var
  parts: TArray<string>;
  p: string;
  kept: string;
  val: Integer;
begin
  Result := -1;
  kept := '';
  parts := AParams.Split([';']);
  for p in parts do
  begin
    if p = '' then Continue;
    if StartsText('sidechain=', p) then
    begin
      if not TryStrToInt(Copy(p, Length('sidechain=') + 1, MaxInt), val) then val := 0;
      Result := val;
      Continue;
    end;
    if kept <> '' then kept := kept + ';';
    kept := kept + p;
  end;
  AParams := kept;
end;

procedure TfrmMain.RefreshMixAutomationParams(AStrip: TMixStrip);
var
  i, j, n, keepTarget, keepSub: Integer;
  keepParam: TAutomationParam;
  snd: TMixSend;
  ins: TMixInsert;
  pyNames: TArray<string>;

  function InsertInt(const AText, AKey: string; ADefault: Integer): Integer;
  var
    parts: TArray<string>;
    p: string;
    eq: Integer;
  begin
    Result := ADefault;
    parts := AText.Split([';']);
    for p in parts do
    begin
      eq := Pos('=', p);
      if (eq > 0) and SameText(Copy(p, 1, eq - 1), AKey) then
      begin
        if not TryStrToInt(Copy(p, eq + 1, MaxInt), Result) then Result := ADefault;
        Exit;
      end;
    end;
  end;

  procedure AddParam(const ACaption: string; AParam: TAutomationParam;
    ATarget, ASub: Integer);
  var
    k: Integer;
  begin
    k := Length(FMixAutoParams);
    SetLength(FMixAutoParams, k + 1);
    SetLength(FMixAutoTargets, k + 1);
    SetLength(FMixAutoSubs, k + 1);
    FMixAutoParams[k] := AParam;
    FMixAutoTargets[k] := ATarget;
    FMixAutoSubs[k] := ASub;
    cboMixAutoParam.Items.Add(ACaption);
  end;

begin
  keepParam := FMixAutoParam;
  keepTarget := FMixAutoTarget;
  keepSub := FMixAutoSub;
  cboMixAutoParam.Items.BeginUpdate;
  try
    cboMixAutoParam.Items.Clear;
    SetLength(FMixAutoParams, 0);
    SetLength(FMixAutoTargets, 0);
    SetLength(FMixAutoSubs, 0);
    AddParam('Fader', apFader, 0, 0);
    AddParam('Pan', apPan, 0, 0);
    AddParam('Mute', apMute, 0, 0);
    if AStrip <> nil then
    begin
      for i := 0 to AStrip.SendCount - 1 do
      begin
        snd := AStrip.GetSend(i);
        AddParam(Format('Send to strip %d', [snd.TargetStripId]), apSendGain,
          snd.TargetStripId, 0);
      end;
      for i := 0 to AStrip.InsertCount - 1 do
      begin
        ins := AStrip.GetInsert(i);
        if SameText(ins.Kind, 'python') then
        begin
          pyNames := PyDecode(PyParamGet(ins.Params, 'pn')).Split([#10]);
          for j := 0 to High(pyNames) do
            if pyNames[j] <> '' then
              AddParam(Format('Python %d: %s', [i + 1, pyNames[j]]), apInsertParam, i, j);
          Continue;
        end;
        if not (SameText(ins.Kind, 'vst2') or SameText(ins.Kind, 'vst3')) then Continue;
        n := InsertInt(ins.Params, 'paramcount', 0);
        if n < 0 then n := 0 else if n > 16384 then n := 16384;
        for j := 0 to n - 1 do
          AddParam(Format('VST %d parameter %d', [i + 1, j]), apInsertParam, i, j);
      end;
    end;
  finally
    cboMixAutoParam.Items.EndUpdate;
  end;
  cboMixAutoParam.ItemIndex := 0;
  for i := 0 to High(FMixAutoParams) do
    if (FMixAutoParams[i] = keepParam) and
       (FMixAutoTargets[i] = keepTarget) and (FMixAutoSubs[i] = keepSub) then
    begin
      cboMixAutoParam.ItemIndex := i;
      Break;
    end;
  cboMixAutoParamChange(cboMixAutoParam);
end;

{ Keeps the Mixer in sync with the Timeline: the Mixer must always have one
  skAudioTrack strip per Timeline audio channel (plus its always-present
  Master strip), so a channel newly added on the Timeline - or one loaded
  from an older project that predates this guarantee - never lands on a
  fader that does nothing. Creates and links (TSetMixStripInputCommand) a
  strip for every audio channel that isn't already claimed by one; a no-op
  once every channel has its strip. }
procedure TfrmMain.EnsureMixerStripsForTimelineTracks;
var
  i, j: Integer;
  trk: TTimelineTrack;
  claimed: Boolean;
  cmd: TAddMixStripCommand;
begin
  if (FProject = nil) or (FCmds = nil) then Exit;
  for i := 0 to FProject.Timeline.TrackCount - 1 do
  begin
    trk := FProject.Timeline.GetTrack(i);
    { audio lanes, and MIDI / instrument lanes too (their strip carries the lane's fader and pan) }
    if not (trk.Kind in [tkAudio, tkMidi, tkInstrument]) then Continue;
    claimed := False;
    for j := 0 to FProject.Mixer.StripCount - 1 do
      if FProject.Mixer.GetStrip(j).InputSourceId = trk.Id then
      begin
        claimed := True;
        Break;
      end;
    if claimed then Continue;
    try
      cmd := TAddMixStripCommand.Create(FProject, skAudioTrack, trk.Name);
      FCmds.Perform(cmd);
      FCmds.Perform(TSetMixStripInputCommand.Create(FProject, cmd.CreatedId, trk.Id));
    except
      on E: EUDAWError do ;  // strip may still exist even if the link failed
    end;
  end;
end;

procedure TfrmMain.RefreshMixerTab;
var
  m: TMixerModel;
  i, keepId: Integer;
  s: TMixStrip;
  sb: TStringBuilder;
begin
  if (FProject = nil) or FMixRefreshing then Exit;
  if FMixViewTracker then
    EnsureTrackerMixerStrips(FProject.TrackerMixer, FProject.Tracker.Channels, FProject.Tracker)
  else
    EnsureMixerStripsForTimelineTracks;
  FMixRefreshing := True;
  try
    m := MixCur;
    keepId := SelectedMixStripId;
    MixEqSync;
    if cboMixEqPreset.Text = '' then cboMixEqPreset.Text := 'My preset';
    if cboMixEqPreset.Items.Count = 0 then MixEqRefreshPresets;

    cboMixStrip.Items.BeginUpdate;
    try
      cboMixStrip.Items.Clear;
      for i := 0 to m.StripCount - 1 do
      begin
        s := m.GetStrip(i);
        cboMixStrip.Items.AddObject(
          Format('%s  [%s]', [s.Name, MixStripKindDisplay(s.Kind)]),
          TObject(NativeInt(s.Id)));
      end;
    finally
      cboMixStrip.Items.EndUpdate;
    end;
    cboMixStrip.ItemIndex := cboMixStrip.Items.Count - 1;
    for i := 0 to cboMixStrip.Items.Count - 1 do
      if Integer(NativeInt(cboMixStrip.Items.Objects[i])) = keepId then
        cboMixStrip.ItemIndex := i;

    cboMixRoute.Items.BeginUpdate;
    try
      cboMixRoute.Items.Clear;
      cboMixRoute.Items.AddObject('-> Master (default)', TObject(NativeInt(0)));
      for i := 0 to m.StripCount - 1 do
      begin
        s := m.GetStrip(i);
        if s.AcceptsBusInput and (s.Id <> SelectedMixStripId) then
          cboMixRoute.Items.AddObject('-> ' + s.Name, TObject(NativeInt(s.Id)));
      end;
    finally
      cboMixRoute.Items.EndUpdate;
    end;

    s := m.StripById(SelectedMixStripId);
    RefreshMixAutomationParams(s);
    if s <> nil then
    begin
      edtMixFader.Text := FormatFloat('0.###', s.FaderDb);
      edtMixPan.Text := FormatFloat('0.###', s.Pan);
      chkMixMute.Checked := s.Muted;
      chkMixSolo.Checked := s.Soloed;
      cboMixRoute.ItemIndex := 0;
      for i := 0 to cboMixRoute.Items.Count - 1 do
        if Integer(NativeInt(cboMixRoute.Items.Objects[i])) = s.OutputTargetId then
          cboMixRoute.ItemIndex := i;
      mnuMixRemove.Enabled := s.Kind <> skMaster;
      pmMixRemove.Enabled := s.Kind <> skMaster;
      cboMixAutoMode.ItemIndex := Ord(s.AutomationMode);
    end
    else
    begin
      mnuMixRemove.Enabled := False;
      pmMixRemove.Enabled := False;
    end;

    { "Link track": only meaningful for an skAudioTrack strip - that's the only
      kind TTimelinePlayer.AttachMixer will ever route a Timeline track through
      (see UDAW.Timeline.Playback.RefreshLinkedTracks). Without this control
      there was no way to set TMixStrip.InputSourceId at all, so a strip's
      fader/pan/inserts/sends/VST plugins never actually reached the Timeline's
      output - the Mixer tab was a dead end no matter how the engine wired it
      up underneath. }
    cboMixTrackLink.Items.BeginUpdate;
    try
      cboMixTrackLink.Items.Clear;
      cboMixTrackLink.Items.AddObject('(none)', TObject(NativeInt(0)));
      if (FProject <> nil) and (s <> nil) and (s.Kind = skAudioTrack) then
        for i := 0 to FProject.Timeline.TrackCount - 1 do
          with FProject.Timeline.GetTrack(i) do
            cboMixTrackLink.Items.AddObject(Name, TObject(NativeInt(Id)));
    finally
      cboMixTrackLink.Items.EndUpdate;
    end;
    cboMixTrackLink.Enabled := (s <> nil) and (s.Kind = skAudioTrack);
    cboMixTrackLink.ItemIndex := 0;
    if s <> nil then
      for i := 0 to cboMixTrackLink.Items.Count - 1 do
        if Integer(NativeInt(cboMixTrackLink.Items.Objects[i])) = s.InputSourceId then
          cboMixTrackLink.ItemIndex := i;

    s := m.MasterStrip;
    if s <> nil then
      lblMixMasterLoudness.Caption := Format(
        'Master:  %.1f / %.1f dBFS   M %.1f LUFS   I %.1f LUFS',
        [s.MeterPeakDbL, s.MeterPeakDbR, s.MeterLufs, s.MeterLufsIntegrated]);
    edtMixMeterHold.Text := FormatFloat('0', m.MeterHoldMs);
    edtMixMeterDecay.Text := FormatFloat('0.##', m.MeterHoldDecayDbPerSec);

    mnuMixUndo.Enabled := FCmds.CanUndo;
    pmMixUndo.Enabled := FCmds.CanUndo;
    mnuMixRedo.Enabled := FCmds.CanRedo;
    pmMixRedo.Enabled := FCmds.CanRedo;

    sb := TStringBuilder.Create;
    try
      sb.AppendLine(MixCur.Describe);
      sb.AppendLine('');
      sb.AppendLine('--- preview ---');
      sb.AppendLine(FMixPreview);
      memMix.Lines.Text := sb.ToString;
    finally
      sb.Free;
    end;
  finally
    FMixRefreshing := False;
  end;
  pbMixer.Invalidate;
  pbMixAuto.Invalidate;
end;

