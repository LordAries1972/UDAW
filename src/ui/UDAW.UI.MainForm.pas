var
  i: Integer;
begin
  i := ACombo.Items.IndexOf(AValue);
  if i < 0 then i := ACombo.Items.Add(AValue);
  ACombo.ItemIndex := i;
end;

procedure TfrmMain.ApplyDirDialogs;
begin
  TfrmEffectEditor.PresetsFolder := Trim(edDirPresets.Text);
  { plug-ins started from now on save and load their presets there (a running one keeps its folder) }
  if (App <> nil) and (PyPluginsFolder <> '') then
  begin
    if Trim(edDirPresets.Text) <> '' then
      PyPresetsFolder := ExcludeTrailingPathDelimiter(Trim(edDirPresets.Text))
    else
      PyPresetsFolder := IncludeTrailingPathDelimiter(PluginsDir) + 'Presets';
  end;
  { the saved equaliser presets in that folder fill the Mixer's preset box from the start }
  MixEqRefreshPresets;
  if edDirAudioLib.Text <> '' then
  begin
    dlgOpenMp3.InitialDir := edDirAudioLib.Text;
    dlgOpenWav.InitialDir := edDirAudioLib.Text;
    dlgOpenMp4.InitialDir := edDirAudioLib.Text;
  end;
  if edDirExport.Text <> '' then
  begin
    dlgSaveMp3.InitialDir := edDirExport.Text;
    dlgSaveWav.InitialDir := edDirExport.Text;
  end;
  if edDirProjects.Text <> '' then
  begin
    dlgOpenProject.InitialDir := edDirProjects.Text;
    dlgSaveProject.InitialDir := edDirProjects.Text;
  end;
  if edDirScripts.Text <> '' then dlgOpenPy.InitialDir := edDirScripts.Text;
  { a different plug-ins folder: the helper module and bundled plug-ins go there and the menu follows }
  if (App <> nil) and (PyPluginsFolder <> '') and not SameText(PyPluginsFolder, PluginsDir) then
  begin
    PyPluginsFolder := '';
    PyPluginSetup;
    RefreshPluginsMenu(True);
  end;
end;

procedure TfrmMain.RefreshInputDeviceCombo(const ASelectedDeviceId: string);
var
  devices: TAudioDeviceList;
  i, selIdx: Integer;
  displayName: string;
begin
  if App = nil then Exit;
  cboSetInDevice.Items.Clear;
  SetLength(FInputDeviceIds, 1);
  FInputDeviceIds[0] := '';
  cboSetInDevice.Items.Add('Default (system)');
  selIdx := 0;

  devices := App.Audio.EnumerateInputs;
  for i := 0 to High(devices) do
  begin
    displayName := devices[i].Name;
    if devices[i].IsDefault then
      displayName := displayName + ' (default)';
    SetLength(FInputDeviceIds, Length(FInputDeviceIds) + 1);
    FInputDeviceIds[High(FInputDeviceIds)] := devices[i].Id;
    cboSetInDevice.Items.Add(displayName);
    if (ASelectedDeviceId <> '') and SameText(devices[i].Id, ASelectedDeviceId) then
      selIdx := High(FInputDeviceIds);
  end;
  cboSetInDevice.ItemIndex := selIdx;
end;

{ the playback device picker: same pattern as RefreshInputDeviceCombo. The choice is saved as
  [audio] output_device and used by every playback path (Timeline, WAV editor, tracker, graph, tone) }
procedure TfrmMain.RefreshOutputDeviceCombo(const ASelectedDeviceId: string);
var
  devices: TAudioDeviceList;
  i, selIdx: Integer;
  displayName: string;
begin
  if App = nil then Exit;
  cboSetOutDevice.Items.Clear;
  SetLength(FOutputDeviceIds, 1);
  FOutputDeviceIds[0] := '';
  cboSetOutDevice.Items.Add('Default (system)');
  selIdx := 0;

  devices := App.Audio.EnumerateOutputs;
  for i := 0 to High(devices) do
