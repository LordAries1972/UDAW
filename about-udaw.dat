<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>UDAW - Help Centre</title>
<style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
        margin: 0;
        padding: 0;
        background: #14181F;
        color: #E5E7EB;
        font-family: "Segoe UI", Tahoma, Verdana, Arial, sans-serif;
        line-height: 1.55;
    }

    /* Dark-theme scrollbars (embedded MSHTML + modern engines) */
    html, body, .udaw-nav, .udaw-code, .udaw-main {
        scrollbar-base-color: #1B2029;
        scrollbar-face-color: #2C3341;
        scrollbar-3dlight-color: #2C3341;
        scrollbar-highlight-color: #2C3341;
        scrollbar-track-color: #14181F;
        scrollbar-arrow-color: #C9CDD3;
        scrollbar-shadow-color: #14181F;
        scrollbar-dark-shadow-color: #14181F;
    }
    * { scrollbar-width: thin; scrollbar-color: #2C3341 #14181F; }
    ::-webkit-scrollbar { width: 12px; height: 12px; }
    ::-webkit-scrollbar-track { background: #14181F; }
    ::-webkit-scrollbar-thumb {
        background: #2C3341;
        border-radius: 6px;
        border: 3px solid #14181F;
    }
    ::-webkit-scrollbar-thumb:hover { background: #37404F; }
    ::-webkit-scrollbar-corner { background: #14181F; }
    a { color: #60A5FA; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .udaw-shell {
        display: flex;
        align-items: flex-start;
        gap: 28px;
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 20px 64px 20px;
    }
    .udaw-nav {
        flex: 0 0 274px;
        position: sticky;
        top: 16px;
        align-self: flex-start;
        background: #1B2029;
        border: 1px solid #2C3341;
        border-radius: 10px;
        padding: 16px;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
    }
    .udaw-nav h3 {
        margin: 0 0 10px 0;
        color: #60A5FA;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: .05em;
    }
    .udaw-nav ul { list-style: none; margin: 0 0 14px 0; padding: 0; }
    .udaw-nav ul.udaw-nav-sub { margin: 2px 0 8px 10px; }
    .udaw-nav li { margin: 0; }
    .udaw-nav a {
        display: block;
        color: #C9CDD3;
        padding: 5px 8px;
        border-radius: 6px;
        font-size: 13.5px;
    }
    .udaw-nav ul.udaw-nav-sub a { font-size: 12.5px; color: #9AA3B2; }
    .udaw-nav a:hover, .udaw-nav a:focus {
        background: #262C38;
        color: #60A5FA;
        text-decoration: none;
    }

    .udaw-main { flex: 1 1 auto; min-width: 0; padding-left: 14px; }
    .udaw-hero {
        text-align: center;
        padding: 8px 0 26px 0;
        border-bottom: 1px solid #2C3341;
        margin-bottom: 24px;
    }
    .udaw-hero .udaw-mark {
        display: inline-block;
        padding: 4px 12px;
        border: 1px solid #2C3341;
        border-radius: 999px;
        color: #7DD3FC;
        background: #10141A;
        font-size: 12px;
        letter-spacing: .12em;
        text-transform: uppercase;
    }
    .udaw-hero h1 { margin: 12px 0 4px 0; color: #ffffff; font-size: 28px; }
    .udaw-hero p { color: #A9AFB8; margin: 0; font-size: 15px; }
    .udaw-hero p.udaw-build-info {
        margin-top: 10px;
        font-size: 12px;
        letter-spacing: .03em;
        color: #7A7F87;
        font-family: Consolas, "Courier New", monospace;
    }

    section { margin-bottom: 34px; padding-bottom: 6px; }
    section h2 {
        color: #60A5FA;
        font-size: 21px;
        border-bottom: 1px solid #2C3341;
        padding-bottom: 8px;
        margin-bottom: 14px;
        scroll-margin-top: 20px;
    }
    section h3 { color: #ffffff; font-size: 16.5px; margin: 18px 0 8px 0; scroll-margin-top: 20px; }
    section h4 { color: #E9EAEE; font-size: 14px; margin: 14px 0 6px 0; text-transform: uppercase; letter-spacing: .04em; }

    .udaw-card {
        background: #1B2029;
        border: 1px solid #2C3341;
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 16px;
    }
    p { color: #C9CDD3; margin: 0 0 10px 0; }
    ul, ol { color: #C9CDD3; margin: 8px 0; padding-left: 22px; }
    li { margin-bottom: 5px; }
    strong { color: #E9EAEE; }

    code, .kbd {
        background: #262C38;
        border: 1px solid #37404F;
        border-radius: 4px;
        padding: 1px 6px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 90%;
        color: #93C5FD;
    }
    .kbd { color: #E9EAEE; }

    .udaw-note {
        background: #182636;
        border-left: 4px solid #3B82F6;
        border-radius: 6px;
        padding: 12px 16px;
        margin: 12px 0;
        color: #CFE3F5;
    }
    .udaw-warn {
        background: #3A2A18;
        border-left: 4px solid #F59E0B;
        border-radius: 6px;
        padding: 12px 16px;
        margin: 12px 0;
        color: #F5DEB3;
    }
    .udaw-safe {
        background: #17301F;
        border-left: 4px solid #22C55E;
        border-radius: 6px;
        padding: 12px 16px;
        margin: 12px 0;
        color: #CBEBD3;
    }
    .udaw-code {
        background: #10141A;
        border: 1px solid #2C3341;
        border-radius: 6px;
        padding: 12px 16px;
        margin: 10px 0;
        color: #93C5FD;
        font-family: Consolas, "Courier New", monospace;
        font-size: 90%;
        line-height: 1.5;
        overflow-x: auto;
        white-space: pre;
    }


    /* nothing may be wider than its container: long words, code and images wrap or scroll inside the page */
    .udaw-main { overflow-wrap: break-word; }
    .udaw-main img, .udaw-main video, .udaw-main iframe { max-width: 100%; height: auto; }
    table.udaw-table td, table.udaw-table th { overflow-wrap: anywhere; word-break: break-word; }
    table.udaw-table code, .udaw-main p code, .udaw-main li code { overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
    .udaw-code { max-width: 100%; box-sizing: border-box; }
    .udaw-note { overflow-wrap: break-word; }
    table.udaw-table { width: 100%; max-width: 100%; border-collapse: collapse; margin: 12px 0; table-layout: fixed; }
    table.udaw-table th, table.udaw-table td {
        text-align: left;
        padding: 8px 10px;
        border-bottom: 1px solid #2C3341;
        font-size: 13.5px;
        color: #C9CDD3;
        vertical-align: top;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    table.udaw-table th { color: #60A5FA; font-weight: 600; }
    table.udaw-table code { white-space: normal; }
    table.udaw-table.udaw-col-30 th:first-child, table.udaw-table.udaw-col-30 td:first-child { width: 30%; }
    table.udaw-table.udaw-col-22 th:first-child, table.udaw-table.udaw-col-22 td:first-child { width: 22%; }

    .udaw-faq dt { color: #ffffff; font-weight: 600; margin-top: 14px; }
    .udaw-faq dd { color: #C9CDD3; margin: 4px 0 0 0; }

    .udaw-purpose {
        background: #191F2A;
        border: 1px solid #2C3341;
        border-left: 4px solid #60A5FA;
        border-radius: 6px;
        padding: 9px 14px;
        margin: 8px 0 12px 0;
    }
    .udaw-purpose p { margin: 3px 0; color: #AEB6C2; font-size: 13px; }
    .udaw-purpose b {
        color: #7DD3FC;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-size: 11px;
        margin-right: 6px;
    }

    .udaw-pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11.5px; font-weight: 600; letter-spacing: .02em; }
    .udaw-pill.info { background: #10263B; color: #7DD3FC; border: 1px solid #1E3A5F; }
    .udaw-pill.act  { background: #33221A; color: #FBBF77; border: 1px solid #5A3A22; }
    .udaw-pill.crit { background: #3A1A1F; color: #FCA5A5; border: 1px solid #5F2330; }

    .udaw-back-top { margin: 10px 0 0 0; text-align: right; }
    .udaw-back-top a {
        display: inline-block;
        padding: 5px 9px;
        color: #60A5FA;
        background: #1B2029;
        border: 1px solid #2C3341;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }
    .udaw-back-top a:hover { background: #262C38; text-decoration: none; }

    .udaw-footer {
        text-align: center;
        color: #7A7F87;
        font-size: 12.5px;
        border-top: 1px solid #2C3341;
        padding-top: 18px;
        margin-top: 42px;
    }

    .udaw-search {
        position: sticky;
        top: 0;
        z-index: 5;
        background: #14181F;
        padding: 8px 0 14px 0;
        margin-bottom: 8px;
        border-bottom: 1px solid #2C3341;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }
    .udaw-search input {
        flex: 1 1 auto;
        background: #10141A;
        border: 1px solid #37404F;
        border-radius: 6px;
        color: #E5E7EB;
        padding: 8px 10px;
        font-size: 13.5px;
        font-family: inherit;
    }
    .udaw-search input:focus { outline: none; border-color: #3B82F6; }
    .udaw-search button {
        background: #1B2029;
        border: 1px solid #37404F;
        border-radius: 6px;
        color: #C9CDD3;
        padding: 8px 11px;
        font-size: 13px;
        cursor: pointer;
    }
    .udaw-search button:hover { background: #262C38; color: #60A5FA; }
    .udaw-search .udaw-count { color: #7A7F87; font-size: 12.5px; min-width: 54px; text-align: right; }

    /* Google Translate widget in the header bar: dark, compact, and without Google's top banner */
    .udaw-translate { margin-left: auto; display: flex; align-items: center; gap: 6px; min-height: 30px; }
    .udaw-translate .udaw-translate-label { color: #7A7F87; font-size: 12.5px; white-space: nowrap; }
    .udaw-translate .goog-te-gadget { font-size: 0; color: transparent; }
    .udaw-translate .goog-te-gadget span { display: none; }
    .udaw-translate .goog-te-gadget .goog-te-combo {
        display: inline-block; margin: 0; padding: 5px 8px; min-width: 150px;
        background: #1B2029; color: #E5E7EB; border: 1px solid #2C3341; border-radius: 6px;
        font-family: inherit; font-size: 13px; cursor: pointer;
    }
    .udaw-translate .goog-te-gadget .goog-te-combo:focus { outline: none; border-color: #3B82F6; }
    .goog-te-banner-frame, iframe.goog-te-banner-frame, .skiptranslate > iframe { display: none !important; }
    body { top: 0 !important; }
    .goog-tooltip, .goog-tooltip:hover { display: none !important; }
    .goog-text-highlight { background: none !important; box-shadow: none !important; }
    mark.udaw-hit { background: #3B3410; color: #FDE68A; border-radius: 2px; }
    mark.udaw-hit.udaw-current { background: #B45309; color: #fff; }

    @media (max-width: 900px) {
        .udaw-shell { flex-direction: column; }
        .udaw-nav { position: static; flex-basis: auto; width: 100%; max-height: none; }
    }
</style>
