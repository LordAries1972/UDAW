    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
    <Target Name="AfterBuild">
        <!-- TaurusTLS lazy-loads OpenSSL from the exe's own directory (or PATH) on
             first use (see UDAW.Web.HelpClient) - copy the two runtime DLLs there
             on every build so they never need a separate manual step or a system
             PATH change. -->
        <ItemGroup>
            <OpenSSLDlls Include="ThirdParty\OpenSSL\Win64\*.dll" />
            <SplashLogo Include="udaw-icon-image.png" />
        </ItemGroup>
        <Copy SourceFiles="@(OpenSSLDlls)" DestinationFolder="$(DCC_ExeOutput)" SkipUnchangedFiles="true" Condition="'$(Platform)'=='Win64'" />
        <Copy SourceFiles="@(SplashLogo)" DestinationFolder="$(DCC_ExeOutput)" SkipUnchangedFiles="true" Condition="'$(Platform)'=='Win64'" />
    </Target>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
    </ProjectExtensions>
</Project>
